{#
calendar/_invite_card.html.twig
─────────────────────────────────────────────────────────────────────────────
The invitation a message carries, above the message it came in.

Rendered from a MessageInvite (App\Domain\DTO\Calendar\MessageInvite), which
InviteReader assembles — the event, the people on it, and which of those people
is the account reading. Everything below is a read of that DTO; nothing here
reaches into the JSCalendar object, because a template that does that ends up
asking `participants.roles.owner is defined` and quietly answering wrong.

The event it describes is the CURRENT one, not the one this message described.
When an update has arrived since, the original invitation is still where a
person goes to answer, and the answer belongs to the meeting as it now stands.

Variables:
  invite  MessageInvite
#}

{% set event  = invite.event %}
{% set status = invite.myStatus %}

{# Whether answering can change anything: a card with buttons on it. #}
{% set answerable = (invite.canRespond or invite.isOffer) and not invite.isCancellation %}

{# An offer is calendar data that names nobody here — a file somebody attached.
   It gets two answers instead of three, worded as what they do to the calendar
   rather than as a reply, because no reply is sent. #}
{% set wording = invite.isOffer ? 'calendar.invite.offer.' : null %}

{# Yes and Maybe put the meeting on the calendar (see InviteResponder), so a
   meeting answered either way is already drawn and has nowhere to travel to. #}
{% set drawn = status.value in ['accepted', 'tentative'] %}

{# The card's own date line, as one phrase, for the announcement a screen
   reader hears once the meeting is in the calendar. #}
{% set when = event.isAllDay
    ? event.startsAt|intl_date('EEEdMMMy', false)
    : event.startsAt|intl_date('EEEdMMMy') ~ ', ' ~ event.startsAt|date(clock.time) %}

{# calendar--invite: what answering looks like from the calendar's side — the
   slot outlined while an answer is hovered, the answer flying there at Full
   motion, and the calendar redrawn in place once the server has it. Instants
   in UTC, because the grid may be drawn on another clock than the reader's and
   only the grid knows which; the controller converts. #}
<div id="invite_card_{{ invite.message.id }}"
     class="mb-4 rounded-pane border border-line overflow-hidden"
     {% if answerable %}
     data-controller="calendar--invite"
     data-calendar--invite-event-value="{{ event.id }}"
     data-calendar--invite-starts-value="{{ event.startsAt|date('c', 'UTC') }}"
     data-calendar--invite-ends-value="{{ (event.endsAt ?? event.startsAt)|date('c', 'UTC') }}"
     data-calendar--invite-all-day-value="{{ event.isAllDay ? 'true' : 'false' }}"
     data-calendar--invite-drawn-value="{{ drawn ? 'true' : 'false' }}"
     data-calendar--invite-placed-value="{{ 'calendar.invite.placed'|trans({ '%title%': event.title, '%when%': when }) }}"
     {% endif %}>

    {# The calendar's own colour on the edge, so an invitation is recognisably
       the same object as the chip it became in the calendar. #}
    <div class="border-l-4 px-4 py-3" style="border-color: {{ event.calendar.color }}">

        <div class="flex items-start gap-3">
            <i class="fa-regular fa-calendar-check mt-0.5 text-ink-faint" aria-hidden="true"></i>

            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-ink {{ invite.isCancellation ? 'line-through' : '' }}">
                    {{ event.title }}
                </p>

                <p class="text-xs text-ink-muted mt-0.5">
                    {% if event.isAllDay %}
                        {# `false` leaves the value in its own zone. An all-day
                           event is floating — a wall date at midnight, no zone
                           — so converting it to the reader's clock moves it,
                           and west of UTC that prints the day before. #}
                        {{ event.startsAt|intl_date('EEEdMMMy', false) }} · {{ 'calendar.event.all_day'|trans }}
                    {% else %}
                        {{ event.startsAt|intl_date('EEEdMMMy') }} ·
                        {{ event.startsAt|date(clock.time) }}–{{ event.endsAt|date(clock.time) }}
                    {% endif %}
                </p>

                {% if event.location %}
                    <p class="text-xs text-ink-faint mt-0.5 truncate">
                        <i class="fa-solid fa-location-dot mr-1 text-[10px]" aria-hidden="true"></i>
                        {{ event.location }}
                    </p>
                {% endif %}

                {% if invite.organiser %}
                    <p class="text-xs text-ink-faint mt-0.5 truncate">
                        {{ 'calendar.invite.organiser'|trans({ '%name%': invite.organiser.displayName }) }}
                    </p>
                {% endif %}
            </div>

            {# The answer as it stands. Shown whether or not it can be changed:
               on an invitation somebody else organised this is the user's own
               reply, and on one they organised it is the row for their own
               attendance, which is the only status they can speak for. #}
            {% if status.isAnswer %}
                <span class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] font-medium bg-raised text-ink-muted">
                    <i class="{{ status.icon }} text-[10px]" aria-hidden="true"></i>
                    {{ (wording ? wording ~ 'status.' ~ status.value|replace({ '-': '_' }) : status.label)|trans }}
                </span>
            {% endif %}
        </div>

        {% if invite.isHeld %}
            {# A change this message asked for and did not get — see
               MessageInvite::$isHeld. Said in a sentence rather than with a
               warning colour: nothing has gone wrong, and most of the time the
               message is from a colleague rather than an attacker. One
               button, a plain form post, so the state after the click is
               whatever the server says it is. No RSVP beside it: the card
               shows the event as it stands, and this message is not the one
               to answer it through. #}
            <p class="mt-3 text-xs text-ink-muted">
                <i class="fa-solid fa-circle-info mr-1 text-ink-faint" aria-hidden="true"></i>
                {{ 'calendar.invite.held.hint'|trans({ '%sender%': invite.message.fromAddress }) }}
            </p>
            <form method="post" class="mt-3"
                  action="{{ path('app_calendar_invite_apply', { id: invite.message.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('calendar_invite_apply' ~ invite.message.id) }}">
                <button type="submit"
                        class="inline-flex items-center gap-1.5 px-3 h-8 rounded-lg text-xs font-medium transition-colors cursor-pointer
                               border border-line text-ink-muted hover:bg-hover hover:text-ink">
                    <i class="fa-solid fa-check text-[10px]" aria-hidden="true"></i>
                    {{ 'calendar.invite.held.apply'|trans }}
                </button>
            </form>
        {% elseif invite.isCancellation %}
            <p class="mt-3 text-xs text-danger">
                <i class="fa-solid fa-circle-exclamation mr-1" aria-hidden="true"></i>
                {{ 'calendar.invite.cancelled'|trans }}
            </p>
        {% elseif invite.canRespond or invite.isOffer %}
            {% if invite.isOffer and not status.isAnswer %}
                <p class="mt-3 text-xs text-ink-faint">{{ 'calendar.invite.offer.hint'|trans }}</p>
            {% endif %}

            {# One form per answer rather than one form with three submit
               buttons: a submit button's value only travels when it is the
               button that was pressed, which is exactly the sort of thing that
               works until a browser autofills or a script submits the form. #}
            <div class="mt-3 flex flex-wrap items-center gap-2">
                {% for answer in calendar_invite_answers()|filter(answer => not invite.isOffer or answer.value != 'tentative') %}
                    {# Hovering or focusing an answer that would put the
                       meeting on the calendar outlines the slot it would take.
                       No, and the answer already given, outline nothing. #}
                    {% set previews = not drawn and answer.value in ['accepted', 'tentative'] %}

                    <form method="post"
                          action="{{ path('app_calendar_invite_respond', { id: invite.message.id }) }}"
                          data-action="submit->calendar--invite#answer">
                        <input type="hidden" name="_token" value="{{ csrf_token('calendar_invite' ~ invite.message.id) }}">
                        <input type="hidden" name="status" value="{{ answer.value }}">

                        <button type="submit"
                                {% if previews %}
                                data-action="mouseenter->calendar--invite#preview focus->calendar--invite#preview
                                             mouseleave->calendar--invite#unpreview blur->calendar--invite#unpreview"
                                {% endif %}
                                class="inline-flex items-center gap-1.5 px-3 h-8 rounded-lg text-xs font-medium transition-colors cursor-pointer
                                       {{ answer == status
                                           ? 'bg-accent text-accent-ink'
                                           : 'border border-line text-ink-muted hover:bg-hover hover:text-ink' }}">
                            <i class="{{ answer.icon }} text-[10px]" aria-hidden="true"></i>
                            {{ (wording ? wording ~ answer.value : answer.action)|trans }}
                        </button>
                    </form>
                {% endfor %}
            </div>

            {# The meeting as the calendar will draw it: the face of the slot
               outline, of the answer in flight, and of what it leaves behind
               until the grid comes back from the server. The tall, stacked
               shape of calendar/_event_chip.html.twig, copied rather than
               included because an unanswered invitation has no occurrence to
               hand that partial — keep the two alike. The time is on the
               reader's clock, which the real block replaces within a moment. #}
            <template data-calendar--invite-target="face">
                <div class="relative h-full rounded-md overflow-hidden ring-1 ring-line shadow-sm block-tint text-left"
                     style="--block-tint: {{ event.calendar.color }}1a; --block-stripe: {{ event.calendar.color }}2e; --block-edge: {{ event.calendar.color }}b3; --invite-slot-colour: {{ event.calendar.color }}">
                    <div class="w-full h-full grid grid-cols-[max-content_minmax(0,1fr)] gap-x-1.5 content-start items-start px-1.5 py-0.5 overflow-hidden">
                        {% if not event.isAllDay %}
                            <span class="shrink-0 text-[11px] tabular-nums text-ink-faint col-start-2 row-start-1 leading-4">
                                {{- event.startsAt|date(clock.timeCompact) -}}
                            </span>
                        {% endif %}
                        <span class="shrink-0 rounded-full w-1 self-stretch col-start-1 row-span-full"
                              style="background-color: {{ event.calendar.color }}"
                              aria-hidden="true"></span>
                        <span class="min-w-0 text-xs text-ink col-start-2 whitespace-normal break-words line-clamp-2 leading-4">
                            {%- if event.kind is not null -%}
                                <i class="{{ event.kind.icon }} mr-1 text-[10px] text-ink-faint" aria-hidden="true"></i>
                            {%- endif -%}
                            {{ event.title }}
                        </span>
                    </div>
                </div>
            </template>
        {% endif %}

        {% if invite.participants|length > 1 %}
            {# A <details>, because on a wide invitation this list is longer
               than the message it sits above — and the one thing everybody
               wants from it (how many said yes) is in the summary. #}
            <details class="mt-3 group/attendees">
                <summary class="text-xs text-ink-faint cursor-pointer list-none select-none hover:text-ink-muted transition-colors">
                    <i class="fa-solid fa-chevron-right text-[9px] mr-1 transition-transform group-open/attendees:rotate-90" aria-hidden="true"></i>
                    {{ 'calendar.invite.attendees'|trans({ '%count%': invite.participants|length }) }}
                </summary>

                <ul class="mt-2 space-y-1">
                    {% for participant in invite.participants %}
                        <li class="flex items-center gap-2 text-xs min-w-0">
                            <i class="{{ participant.status.icon }} text-[10px] text-ink-faint shrink-0"
                               title="{{ participant.status.label|trans }}"
                               aria-hidden="true"></i>

                            <span class="truncate {{ participant.isMe ? 'text-ink font-medium' : 'text-ink-muted' }}">
                                {{ participant.displayName }}
                            </span>

                            {% if participant.isOrganiser %}
                                <span class="shrink-0 text-[10px] text-ink-faint">
                                    {{ 'calendar.invite.organiser_tag'|trans }}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}
    </div>
</div>
