{#
Month: a six-week grid that fills its container.

Always six weeks, never five-or-six. The range enum asks for 42 days from the
Monday on or before the first, so the grid does not change height between
months — a calendar that reflows as you page through it is disorienting, and it
means the surrounding layout never has to reserve for the taller case.

`grid-rows-6` with `h-full` is what makes the six weeks share the height evenly
instead of each row shrinking to its busiest cell, which left a ragged block of
empty space under the grid.
#}

{% set dayKeys = days|keys %}
{% set anchorMonth = anchor|date('n') %}
{# The view's clock, not the reader's: the day keys are grouped in it, so
   asking a different one which day is today highlights the wrong cell for
   however many hours the two are apart. #}
{% set today = 'now'|date('Y-m-d', range.zone) %}

<div class="h-full min-h-0 flex flex-col">
    <div class="grid grid-cols-7 shrink-0 border-b border-line">
        {% for dayKey in dayKeys|slice(0, 7) %}
            <div class="px-2 py-1.5 text-[10px] uppercase tracking-wide text-ink-faint">
                {{ dayKey|date('D') }}
            </div>
        {% endfor %}
    </div>

    <div class="flex-1 min-h-0 grid grid-cols-7 grid-rows-6 gap-px bg-line">
        {% for dayKey in dayKeys %}
            {% set dayEvents = days[dayKey] %}
            {% set isToday = dayKey == today %}
            {% set isWeekend = dayKey|date('N') >= 6 %}
            {% set isOtherMonth = dayKey|date('n') != anchorMonth %}

            {# The spill-in days are dimmed as a whole cell, not just by their
               date number: a neighbouring month's events rendered at full
               strength read as part of this month. #}
            <div class="group/cell min-h-0 min-w-0 flex flex-col p-1 gap-0.5 overflow-hidden
                        {{ isToday ? 'bg-accent/5' : (isWeekend ? 'bg-sunken/40' : 'bg-surface') }}
                        {{ isOtherMonth ? 'opacity-55' : '' }}">

                <div class="flex items-center justify-between shrink-0 px-0.5">
                    {% if isToday %}
                        <span class="w-5 h-5 flex items-center justify-center rounded-full
                                     bg-accent text-white text-xs font-semibold tabular-nums">
                            {{ dayKey|date('j') }}
                        </span>
                    {% else %}
                        <span class="text-xs tabular-nums {{ isOtherMonth ? 'text-ink-faint' : 'text-ink-muted' }}">
                            {{ dayKey|date('j') }}
                        </span>
                    {% endif %}

                    <button type="button"
                       data-controller="ui--modal"
                       data-action="click->ui--modal#open"
                       data-ui--modal-src-value="{{ path('app_calendar_event_new', { start: dayKey ~ ' 09:00' }) }}"
                       data-ui--modal-title-value="{{ 'calendar.event.new'|trans }}"
                       aria-label="{{ 'calendar.event.new_on'|trans({ '%date%': dayKey|date('D j M') }) }}"
                       class="w-5 h-5 flex items-center justify-center rounded-md text-[10px] text-ink-faint
                              opacity-0 group-hover/cell:opacity-100 focus:opacity-100
                              hover:bg-hover transition-opacity
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    ><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                </div>

                {# Three, then a count. A month cell that grows to fit everything
                   makes every other row taller for one busy day. #}
                <div class="min-h-0 flex-1 space-y-0.5 overflow-hidden">
                    {% for cluster in dayEvents|slice(0, 3) %}
                        {% include 'calendar/_event_chip.html.twig' %}
                    {% endfor %}
                </div>

                {% if dayEvents|length > 3 %}
                    <a href="{{ path('app_calendar_view', { view: 'day', date: dayKey }) }}{{ isPane|default(false) ? '?pane=1' : '' }}"
                       {% if frame|default(null) %}data-turbo-frame="{{ frame }}"{% endif %}
                       class="shrink-0 px-1.5 text-[11px] text-ink-faint hover:text-ink hover:underline">
                        {{ 'calendar.more_count'|trans({ '%count%': dayEvents|length - 3 }) }}
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
