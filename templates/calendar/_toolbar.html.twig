{#
The toolbar of the calendar you own.

The row itself — the steps, the position label, the four-view switcher — is
calendar/_toolbar_shell.html.twig, which the public shared-calendar page renders
through as well. What is left here is this calendar's routing and the one control
a read-only calendar has no use for: the button that creates an event.

Every step and every view is a URL because a view is a URL. The shared page's
steps run out at the ends of its published window and pass null for them; this
calendar has no ends, so it never does.
#}

{% set compact = compact|default(false) %}
{% set paneQuery = compact ? '?pane=1' : '' %}

{# Agenda steps a day at a time like day view: it is a rolling list, not a page. #}
{% set step = view.value == 'month' ? '1 month' : (view.value == 'week' ? '7 days' : '1 day') %}

{% set viewUrls = {} %}
{% for candidate in enum('App\\Domain\\Enum\\Calendar\\CalendarView').cases() %}
    {% set viewUrls = viewUrls|merge({
        (candidate.value): path('app_calendar_view', {
            view: candidate.value,
            date: anchor|date('Y-m-d'),
        }) ~ paneQuery,
    }) %}
{% endfor %}

{% embed 'calendar/_toolbar_shell.html.twig' with {
    view:      view,
    anchor:    anchor,
    rangeFrom: range.from,
    rangeTo:   range.to,
    prevUrl:   path('app_calendar_view', {
                   view: view.value,
                   date: anchor|date_modify('-' ~ step)|date('Y-m-d'),
               }) ~ paneQuery,
    nextUrl:   path('app_calendar_view', {
                   view: view.value,
                   date: anchor|date_modify('+' ~ step)|date('Y-m-d'),
               }) ~ paneQuery,
    todayUrl:  path('app_calendar_view', {
                   view: view.value,
                   date: 'now'|date('Y-m-d'),
               }) ~ paneQuery,
    viewUrls:  viewUrls,
    compact:   compact,
    frame:     frame|default(null),
} %}
    {% block toolbar_actions %}
        <button type="button"
           data-controller="ui--modal"
           data-action="click->ui--modal#open"
           data-ui--modal-src-value="{{ path('app_calendar_event_new') }}"
           data-ui--modal-title-value="{{ 'calendar.event.new'|trans }}"
           class="w-7 h-7 flex items-center justify-center rounded-lg shrink-0
                  bg-accent text-accent-ink hover:opacity-90 transition-opacity"
           aria-label="{{ 'calendar.event.new'|trans }}"
        ><i class="fa-solid fa-plus text-xs" aria-hidden="true"></i></button>
    {% endblock %}
{% endembed %}
