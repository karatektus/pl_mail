{# templates/security/password_required.html.twig

   Choosing your own password because somebody else chose the current one.
   Rendered by App\Controller\Auth\RequiredPasswordController, and the only
   page App\Security\PasswordChangeRequiredListener lets the person reach until
   they have — which is why it carries the way out (sign out) and nothing else.

   Accepts:
       form  a RequiredPasswordType

   Shaped like the login and code pages, because it is the last step of
   signing in rather than a page of the application.

   The new password is stretched in the browser and never posted — see
   controllers/auth/password_form_controller.js and NewPasswordType.
#}
{% extends '_layout/app.html.twig' %}

{% set min_length = constant('App\\Entity\\User\\User::PASSWORD_MIN_LENGTH') %}

{% block title %}{{ 'password_required.page_title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center app-bg px-4">
        <div class="w-full max-w-sm">

            <div class="flex flex-col items-center mb-8">
                <div class="flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-key text-accent text-2xl" aria-hidden="true"></i>
                    <span class="text-xl font-semibold text-ink">{{ 'app.name'|trans }}</span>
                </div>
                <p class="text-sm text-ink-muted text-center">{{ 'password_required.tagline'|trans }}</p>
            </div>

            <div class="bg-surface rounded-pane shadow-sm border border-line p-8">
                <p class="text-sm text-ink-soft mb-6">{{ 'password_required.explanation'|trans }}</p>

                {# Full page load, for the reason the login form gives: Turbo
                   swaps only the <body>, and the inbox this leads to needs the
                   appearance the server renders onto <html>. #}
                {{ form_start(form, { attr: {
                    'data-turbo': 'false',
                    'data-controller': 'auth--password-form',
                    'data-action': 'submit->auth--password-form#submit input->auth--password-form#clearValidity',
                    'data-auth--password-form-min-length-value': min_length,
                    'data-auth--password-form-too-short-message-value': 'settings.password.too_short'|trans({ '{{ limit }}': min_length }, 'validators'),
                    'data-auth--password-form-mismatch-message-value': 'settings.password.mismatch'|trans({}, 'validators'),
                    'data-auth--password-form-busy-label-value': 'password_required.submitting'|trans,
                } }) }}
                    {{ form_widget(form) }}

                    <button type="submit"
                            data-auth--password-form-target="submit"
                            class="mt-6 w-full bg-accent hover:bg-accent-strong text-accent-ink text-sm font-medium py-2 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 ring-offset-surface disabled:opacity-60 disabled:cursor-not-allowed">
                        {{ 'password_required.submit'|trans }}
                    </button>
                {{ form_end(form) }}
            </div>

            {# A div, not a p: a <p> cannot hold the form below. #}
            <div class="text-center text-sm text-ink-muted mt-6">
                {# A POST form like the user menu's: logout checks a CSRF token. #}
                <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="text-accent font-medium hover:underline cursor-pointer">
                        {{ 'password_required.sign_out'|trans }}
                    </button>
                </form>
            </div>

        </div>
    </div>
{% endblock %}
