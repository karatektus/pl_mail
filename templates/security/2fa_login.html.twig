{# templates/security/2fa_login.html.twig

   The code form between password and session. Rendered by scheb's
   FormController — see config/routes/scheb_2fa.yaml — so the variables here
   are the ones it passes, not ours to add to.

   A recovery code goes in the same field as a TOTP code: scheb tries each
   configured provider against whatever was submitted, so a second input would
   only make the user decide which box to use while locked out of their mail.
#}
{% extends '_layout/app.html.twig' %}

{% block title %}{{ 'two_factor.page_title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center app-bg px-4">
        <div class="w-full max-w-sm">

            {# Logo #}
            <div class="flex flex-col items-center mb-8">
                <div class="flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-shield-halved text-accent text-2xl" aria-hidden="true"></i>
                    <span class="text-xl font-semibold text-ink">{{ 'app.name'|trans }}</span>
                </div>
                <p class="text-sm text-ink-muted">{{ 'two_factor.tagline'|trans }}</p>
            </div>

            {% if authenticationError %}
                <div class="mb-4 px-4 py-3 rounded-lg alert-danger text-sm text-danger">
                    {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                </div>
            {% endif %}

            <div class="bg-surface rounded-pane shadow-sm border border-line p-8">

                {# Full page load on submit, for the same reason as the login
                   form: Turbo swaps only the <body>, so the appearance the
                   server renders onto <html> would be ignored. #}
                {# Once, however many times it is pressed. The second submit
                   arrives after the first has already completed the login, so
                   there is no two-factor process left for it to finish — see
                   App\Security\TwoFactor\CompletedTwoFactorRedirect, which
                   catches the ones that get sent anyway. #}
                <form method="post" data-turbo="false"
                      data-controller="core--submit-once"
                      data-action="submit->core--submit-once#guard"
                      data-core--submit-once-busy-label-value="{{ 'two_factor.form.submitting'|trans }}"
                      action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}">

                    <div class="space-y-4">
                        <div>
                            <label for="_auth_code" class="block text-sm font-medium text-ink-soft mb-1.5">
                                {{ 'two_factor.form.code'|trans }}
                            </label>
                            <input
                                type="text"
                                id="_auth_code"
                                name="{{ authCodeParameterName }}"
                                autocomplete="one-time-code"
                                inputmode="numeric"
                                autofocus
                                required
                                class="w-full px-3 py-2 text-center text-lg font-mono tracking-[0.3em] rounded-lg border border-field bg-field text-ink placeholder:text-ink-faint placeholder:tracking-normal placeholder:font-sans placeholder:text-sm focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-colors"
                                placeholder="000000"
                            >
                            <p class="mt-1.5 text-xs text-ink-faint">
                                {{ 'two_factor.form.code_hint'|trans }}
                            </p>
                        </div>

                        {% if displayTrustedOption %}
                            <label class="flex items-start gap-2 text-sm text-ink-soft select-none cursor-pointer">
                                <input
                                    type="checkbox"
                                    id="_trusted"
                                    name="{{ trustedParameterName }}"
                                    value="1"
                                    class="mt-0.5 h-4 w-4 rounded border-field bg-field text-accent focus:outline-none focus:ring-2 focus:ring-accent cursor-pointer"
                                >
                                <span>
                                    {{ 'two_factor.form.trust_device'|trans }}
                                    <span class="block text-xs text-ink-faint">
                                        {{ 'two_factor.form.trust_device_hint'|trans }}
                                    </span>
                                </span>
                            </label>
                        {% endif %}
                    </div>

                    {% if isCsrfProtectionEnabled %}
                        <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                    {% endif %}

                    <button
                        type="submit"
                        data-core--submit-once-target="button"
                        class="mt-6 w-full bg-accent hover:bg-accent-strong text-accent-ink text-sm font-medium py-2 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 ring-offset-surface disabled:opacity-60 disabled:cursor-not-allowed"
                    >
                        {{ 'two_factor.form.submit'|trans }}
                    </button>

                </form>
            </div>

            <p class="text-center text-sm text-ink-muted mt-6">
                {{ 'two_factor.recovery_hint'|trans }}
                <a href="{{ logoutPath }}" class="block text-accent font-medium hover:underline mt-2">
                    {{ 'two_factor.cancel'|trans }}
                </a>
            </p>

        </div>
    </div>
{% endblock %}
