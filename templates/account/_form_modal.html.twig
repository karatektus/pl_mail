{% extends '_layout/app.html.twig' %}

{% block body %}
    <turbo-frame id="modal">
        <template data-ui--modal-frame-title>{{ 'account.add_title'|trans }}</template>

        {{ form_start(form, {
            attr: {
                'data-turbo': 'true',
                'data-controller': 'settings--account-form settings--imap-preset settings--connection-test',
                'data-settings--connection-test-url-value': path('app_account_test_connection'),
                'data-settings--connection-test-csrf-value': csrf_token('account_test'),
                'data-settings--connection-test-failed-value': 'account.test.request_failed'|trans,
                class: 'flex-1 min-h-0 flex flex-col',
            }
        }) }}

        {# ── Tab bar ─────────────────────────────────────────────────────── #}
        <div class="flex border-b border-line px-5 -mt-px bg-sunken">
            <button
                type="button"
                data-settings--account-form-target="tab"
                data-action="click->settings--account-form#switchTab"
                data-panel="imap"
                class="tab-btn active-tab px-1 py-3 mr-5px text-sm font-medium border-b-2 transition-colors duration-100 cursor-pointer"
            >{{ 'account.tabs.imap'|trans }}</button>
            <button
                type="button"
                data-settings--account-form-target="tab"
                data-action="click->settings--account-form#switchTab"
                data-panel="oauth"
                class="tab-btn px-1 py-3 text-sm font-medium border-b-2 border-transparent -mb-px text-ink-faint hover:text-ink transition-colors duration-100 cursor-pointer"
            >{{ 'account.tabs.oauth'|trans }}</button>
        </div>

        {# ── Scrollable body ─────────────────────────────────────────────── #}
        <div class="flex-1 min-h-0 overflow-y-auto">

            {# IMAP / SMTP panel #}
            <div data-settings--account-form-target="panel" data-panel="imap" class="px-5 py-5 space-y-5">
                {% include 'account/_fields.html.twig' with { form: form, mode: 'new' } %}
            </div>

            {# OAuth panel #}
            <div data-settings--account-form-target="panel" data-panel="oauth" class="hidden px-5 py-5 space-y-4">

                <div class="flex items-start gap-3 rounded-xl
                            alert-info
                            px-4 py-3 text-sm text-accent">
                    <i class="fa-solid fa-circle-info mt-0.5 shrink-0 text-accent/70" aria-hidden="true"></i>
                    <p>{{ 'account.oauth.info'|trans }}</p>
                </div>

                {# What the account is for (#575). Asked here, before the
                   provider's consent screen, because the answer decides what
                   that screen asks for: a Google account wanted for its
                   calendar never sees a request to read every message. The
                   ticks are carried onto the links by settings--oauth-services;
                   see that controller for why they are not a form. #}
                <div data-controller="settings--oauth-services" class="space-y-4">
                    <fieldset class="space-y-1.5">
                        <legend class="mb-1.5 text-sm font-medium text-ink">{{ 'account.oauth.services.legend'|trans }}</legend>
                        {% for service in account_services() %}
                            <label class="flex items-center gap-2.5 text-sm text-ink-soft cursor-pointer">
                                <input type="checkbox" value="{{ service.value }}" checked
                                       data-settings--oauth-services-target="service"
                                       data-action="settings--oauth-services#update"
                                       class="rounded border-field-border">
                                <i class="{{ service.icon }} w-4 text-center text-ink-faint" aria-hidden="true"></i>
                                {{ service.labelKey|trans }}
                            </label>
                        {% endfor %}
                        <p class="pt-1 text-xs text-ink-faint">{{ 'account.oauth.services.help'|trans }}</p>
                    </fieldset>

                    <div class="space-y-2.5">
                        {% for provider in [{ key: 'google', icon: 'fa-brands fa-google', label: 'account.oauth.google' }, { key: 'microsoft', icon: 'fa-brands fa-microsoft', label: 'account.oauth.microsoft' }] %}
                            <a
                                href="{{ path('app_oauth_connect', { provider: provider.key }) }}"
                                data-base-href="{{ path('app_oauth_connect', { provider: provider.key }) }}"
                                data-settings--oauth-services-target="link"
                                data-turbo="false"
                                class="flex items-center gap-3 w-full px-4 py-2.5 rounded-xl
                                border border-line
                                text-sm font-medium text-ink-soft
                                hover:bg-hover transition-colors"
                                >
                                <i class="{{ provider.icon }} shrink-0" aria-hidden="true"></i>
                                {{ provider.label|trans }}
                            </a>
                        {% endfor %}
                    </div>
                </div>

            </div>

        </div>

        {# ── Footer ──────────────────────────────────────────────────────── #}
        <div class="flex items-center justify-end gap-2 px-5 py-3.5">
            <button type="button" data-action="click->ui--modal#close"
                    class="px-3 h-9 rounded-lg text-sm font-medium text-ink-soft hover:bg-hover transition-colors cursor-pointer">
                {{ 'form.cancel'|trans }}
            </button>
            <button type="submit"
                    data-settings--account-form-target="submitBtn"
                    class="px-4 h-9 rounded-lg text-sm font-medium bg-accent hover:bg-accent-strong text-accent-ink transition-colors cursor-pointer">
                {{ 'form.submit'|trans }}
            </button>
        </div>

        {{ form_end(form) }}
    </turbo-frame>
{% endblock %}
