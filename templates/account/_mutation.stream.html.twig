{# Closes the modal (if open), toasts, and refreshes both the sidebar list
   and the settings pane. Streams targeting an absent id are no-ops, so this
   works whether the mutation came from the sidebar or the settings screen.

   `jobsChanged` redraws the jobs indicator too, for a mutation that has just
   queued one (removing an account, #672), so the work shows at once rather
   than when the worker first reports. #}

<turbo-stream action="update" target="modal">
    <template></template>
</turbo-stream>

{% include '_partials/_toast.stream.html.twig' with { message: toastMessage|trans, type: 'success' } only %}

{% include 'account/_lists.stream.html.twig' %}

{% if jobsChanged|default(false) %}
    <turbo-stream action="replace" target="jobs-indicator">
        <template>
            {{ include('mail/_jobs_indicator.html.twig', { jobs: background_jobs(), imports: mail_imports() }) }}
        </template>
    </turbo-stream>
{% endif %}
