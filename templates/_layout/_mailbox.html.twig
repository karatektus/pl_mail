{% extends '_layout/app.html.twig' %}

{# The list/reading pane switch belongs to these pages alone: its targets are
   further down this file, and it throws on connect wherever they are not. #}
{% block body_controllers %}{{ parent() }} mail--mail-pane{% endblock %}

{% set selectedMessage = selectedMessage|default(null) %}

{#
Subclasses can override these blocks:
  inbox_tabs      — tabs / heading row above the toolbar (renders before toolbar)
  inbox_toolbar   — override the entire toolbar (rarely needed)
  message_list    — the <li> items inside the <ul>
  list_scope      — space-separated special-use roles this view shows, so a
                    Mercure mailbox.synced update knows whether to refresh
                    ("inbox", "sent", … or "*" for every mailbox; default "*")
  reading_pane    — the reading pane content
  pane_open       — "true"/"false" string (default false)
  list_hidden     — extra CSS classes to hide list on direct-load pages
  reading_hidden  — extra CSS classes (default: "hidden")

Pagination variables expected from the controller (all optional, fallback to 0/1):
  page, total, per_page
#}

{% block body %}
    {#
    sidebar-drawer wraps the entire page so the controller can manage
    the drawer state from any trigger (burger button in the topbar, backdrop).
    #}
    <div
        class="h-screen overflow-hidden app-bg"
        data-controller="ui--sidebar-drawer"
    >
        {# ── Mobile backdrop ──────────────────────────────────────────────── #}
        <div
            data-ui--sidebar-drawer-target="backdrop"
            data-action="click->ui--sidebar-drawer#backdropClick"
            class="md:hidden fixed inset-0 z-30 bg-black/40 backdrop-blur-sm
                   opacity-0 pointer-events-none transition-opacity duration-200"
            aria-hidden="true"
        ></div>

        {# ── Mobile sidebar drawer ────────────────────────────────────────── #}
        {#
        On mobile: fixed, full-height, slides in from the left.
        On md+: hidden (the normal sidebar is in the flex row below).
        #}
        <div
            data-ui--sidebar-drawer-target="drawer"
            class="md:hidden fixed inset-y-0 left-0 z-40 w-64 p-3
                   -translate-x-full transition-transform duration-200 ease-out"
            aria-label="{{ 'sidebar.nav.inbox'|trans }}"
        >
            {% include '_partials/_sidebar.html.twig' with { _drawerMode: true } %}
        </div>

        {# ui--split spans the topbar as well as the panes: the calendar
           toggle lives in the topbar, and a Stimulus action only reaches a
           controller mounted on an ancestor. #}
        <div class="shell-frame flex h-full flex-col p-gutter gap-gutter"
             {% if app.user %}
             style="--calendar-pane-width: {{ app.user.calendarPaneWidth }}px"
             data-controller="ui--split"
             data-ui--split-state-url-value="{{ path('app_calendar_pane_state') }}"
             data-ui--split-token-value="{{ csrf_token('calendar_pane_state') }}"
             data-ui--split-min-value="{{ constant('App\\Entity\\User\\User::CALENDAR_PANE_MIN_WIDTH') }}"
             data-ui--split-max-value="{{ constant('App\\Entity\\User\\User::CALENDAR_PANE_MAX_WIDTH') }}"
             data-ui--split-mode-value="{{ app.user.calendarPaneMode.value }}"
             {# Rendered as `mail` whatever the preference says, and corrected by the
                controller on connect if the window is wide enough to hold the
                remembered position. The attribute drives every layout rule below,
                and landing on a full-width calendar is not what anyone means by
                opening plMail on a phone. #}
             data-calendar-mode="mail"
             {# The pane reloads its body through a Turbo Frame, and the view it
                lands on decides how much room it wants — see
                CalendarView::minimumPaneWidth(). turbo:frame-load bubbles, so
                the boundary's own controller can hear it from up here. #}
             data-action="turbo:frame-load->ui--split#paneLoaded"
             {% endif %}
        >

            {# Full-width topbar #}
            {% include '_partials/_topbar.html.twig' %}

            {# Sidebar + content #}
            <div class="flex flex-1 gap-gutter overflow-hidden">

                {# Sidebar — desktop only (hidden on mobile, shown in drawer) #}
                <div class="hidden md:flex">
                    {% include '_partials/_sidebar.html.twig' %}
                </div>

                {# Main content. Targeted by ui--split so the drag can enforce a
                   minimum on this side too — the pane knows how much room it is
                   taking only by measuring what is left. #}
                <div class="flex flex-1 overflow-hidden relative main-pane"
                     {% if app.user %}data-ui--split-target="main"{% endif %}>

                    {# List pane #}
                    <div
                        id="message-list"
                        data-sync-scope="{% block list_scope %}*{% endblock %}"
                        data-mail--mail-pane-target="list"
                        {# @container, so the rows below switch to their stacked
                           layout on the LIST's width. They used to switch on the
                           viewport's, which is a different number entirely once
                           the calendar pane is docked: a 1440px window with a
                           wide pane leaves the list narrower than a phone, and
                           every row stayed on one line and truncated to nothing. #}
                        class="@container flex flex-col flex-1 overflow-hidden {% block list_hidden %}{% endblock %}"
                    >
                        <turbo-frame id="inbox-list-frame" data-turbo-action="advance" class="contents">

                            {# ── Gmail-style toolbar ──────────────────────── #}
                            {% block inbox_toolbar %}
                                {% include '_partials/_list_toolbar.html.twig' with {
                                    page:     page     ?? 1,
                                    total:    total    ?? 0,
                                    per_page: per_page ?? 50,
                                } %}
                            {% endblock %}

                            {# Optional tabs row (inbox only) #}
                            {% block inbox_tabs %}{% endblock %}

                            <ul class="flex-1 overflow-y-auto divide-y divide-line">
                                {% block message_list %}{% endblock %}
                            </ul>

                        </turbo-frame>
                    </div>

                    {# Reading pane #}
                    <div
                        data-mail--mail-pane-target="reading"
                        class="flex flex-col flex-1 overflow-hidden {% block reading_hidden %}hidden{% endblock %}"
                    >
                        {% block reading_pane %}
                            {% if selectedMessage is not null %}
                                {% include 'mail/_message_content.html.twig' with { message: selectedMessage } %}
                            {% endif %}
                        {% endblock %}
                    </div>

                </div>

                {# Calendar — a sibling of .main-pane, so the handle between
                   them splits the row's width rather than shrinking one into
                   the other. Below lg it is absent and the sidebar link goes
                   to the full page instead. #}
                {% if app.user %}
                    {% include '_partials/_calendar_pane.html.twig' %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
