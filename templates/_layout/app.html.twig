<!DOCTYPE html>
<html class="{{ appearance_class() }}"
      data-theme="{{ appearance_theme() }}"
      style="{{ appearance_vars() }}">
<head>
    <meta charset="UTF-8">
    {# Without this the browser assumes a ~980px desktop canvas and scales the
       whole app down. `viewport-fit=cover` lets the gradient run under the
       notch; the safe-area padding in app.css keeps content clear of it.
       Zoom is pinned so the app behaves like an installed PWA rather than a
       page — see the 16px form-control rule in app.css, which is what actually
       stops iOS zooming on focus (it ignores user-scalable).
       `interactive-widget=resizes-content`: Android's default (resizes-visual)
       shrinks only the visual viewport for the keyboard and leaves the layout
       viewport — where fixed elements live — at full height, so the page
       behind the fullscreen compose window stayed pannable and showed through
       below it. Resizing the content instead means fixed elements end above
       the keyboard and there is nothing to pan. iOS ignores this keyword; the
       compose controller's visualViewport tracking stays as its fallback. #}
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% include '_partials/_favicon.html.twig' %}
    {# PWA: iOS only offers Web Push to apps added to the Home Screen, and it
       needs the apple-touch-icon specifically — it ignores the manifest icons. #}
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    {# The token the fetch-based endpoints check. Stimulus controllers that
       build their own request body cannot carry a form field, so they read this
       and send it as X-CSRF-Token. Every such endpoint validates against the
       same 'ajax' id — until this tag existed they all sent an empty string. #}
    <meta name="csrf-token" content="{{ csrf_token('ajax') }}">
    <meta name="theme-color" content="#2563eb">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="plMail">

    <script>
        // The appearance is rendered onto <html>, and the server only knows it
        // once the user is authenticated. Mirror it into localStorage so the
        // logged-out screens (login above all) already paint in the theme the
        // user picked instead of the defaults.
        (function () {
            const root = document.documentElement;
            const key = 'plmail:appearance';

            try {
                {% if app.user %}
                localStorage.setItem(key, JSON.stringify({
                    class: root.className,
                    theme: root.dataset.theme,
                    style: root.getAttribute('style') || '',
                }));
                {% else %}
                const saved = JSON.parse(localStorage.getItem(key) || 'null');

                if (saved) {
                    root.className = saved.class;
                    root.dataset.theme = saved.theme;

                    // A custom background is served from behind the firewall,
                    // so it would 404 here; every other variable replays fine.
                    root.setAttribute('style', saved.style
                        .split(';')
                        .filter((part) => part.indexOf('/settings/appearance/') === -1)
                        .join(';'));
                }
                {% endif %}
            } catch (e) {}
        })();

        if (document.documentElement.dataset.theme === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }

        // Collapsed-sidebar state lives in localStorage, so it has to be applied
        // before first paint or the wide sidebar flashes on every load.
        try {
            if (localStorage.getItem('plmail:sidebarRail') === '1') {
                document.documentElement.classList.add('sidebar-rail');
            }
        } catch (e) {}
    </script>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
{# One topic, named once: it is both what we subscribe to and what the cookie
   authorizes, and the two drifting apart is a silent no-updates bug. #}
{% set mercure_topics = app.user ? ['mail/user/' ~ app.user.id] : [] %}
<body
    {% if app.user %}
        data-controller="{% block body_controllers %}core--mercure mail--mail-pane{% endblock %}"
        {# URL only. The cookie that authorizes this subscription is attached by
           MercureCookieSubscriber — passing `subscribe:` here would mint it too,
           but that helper throws for a hub on another domain and would take the
           whole page down with it. #}
        data-core--mercure-url-value="{{ mercure(mercure_topics) }}"
        data-core--mercure-auth-url-value="{{ path('mercure_auth') }}"
        data-action="core--mercure:mailbox-synced->mail--mail-pane#onMailboxSynced"
        data-mail--mail-pane-open-value="{% block pane_open %}false{% endblock %}"
    {% endif %}
>
    {% block body %}{% endblock %}
    {% block javascripts_body %}{% endblock %}
    {% include '_partials/_modal.html.twig' %}
    {# After the modal, and only ever for a signed-in user who has not been
       through setup: it drives the dialog above, so that has to exist first. #}
    {% if app.user %}
        {% include 'onboarding/_boot.html.twig' %}
    {% endif %}
    {# `z-50` on the frame, not just on the window inside it: a fixed element
       creates a stacking context, so the window's own z-index only ever
       ordered it against its siblings here. Left at `auto` the whole dock
       painted below the topbar (z-20) and the mobile drawer (z-40) — which
       the fullscreen compose window below md has to cover. #}
    <turbo-frame id="compose_dock" class="fixed bottom-4 right-6 z-50 flex items-end gap-3"></turbo-frame>
    <div id="toast-region" class="fixed bottom-4 left-4 z-[60] flex flex-col gap-2 items-end"></div>
</body>
</html>
