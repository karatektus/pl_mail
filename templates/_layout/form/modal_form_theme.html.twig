{#
── Field container ────────────────────────────────────────────────────────────

Symfony wraps every row of a compound form in one bare <div>. That div is a
single child of whatever holds the form, so a space-y-* on the modal body sets
the gap around the whole field block and never between the fields — they sit
flush no matter how far that number is raised. The rhythm has to live here, on
the wrapper that actually has the rows as children.

Root form only. A compound child — a repeated password, a date's three selects,
a collection row — is one field to the reader and should stay tight.
#}
{% block form_widget_compound %}
    {% if form is rootform %}
        {% set attr = attr|merge({ class: (attr.class|default('') ~ ' space-y-5')|trim }) %}
    {% endif %}
    <div {{ block('widget_container_attributes') }}>
        {%- if form is rootform -%}
            {{ form_errors(form) }}
        {%- endif -%}
        {{- block('form_rows') -}}
        {{- form_rest(form) -}}
    </div>
{% endblock %}

{# ── Row wrapper ─────────────────────────────────────────────────────────── #}
{% block form_row %}
    <div class="flex flex-col gap-2">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{# ── Label ───────────────────────────────────────────────────────────────── #}
{% block form_label %}
    {% if label is not same as(false) %}
        {% set label = label ?? (name|humanize) %}
        <label
            for="{{ id }}"
            class="block text-[13px] font-medium leading-none text-ink-soft"
            {% if required %}{% endif %}
        >
            {{ label|trans({}, translation_domain) }}
            {% if required %}
                <span class="ml-0.5 text-danger" aria-hidden="true">*</span>
            {% endif %}
        </label>
    {% endif %}
{% endblock %}

{# ── Text / email / password / number / url / search inputs ─────────────── #}
{#
   Password managers may only touch fields that are actually credentials.

   They classify by `autocomplete`, so a name field marked `given-name` reads to
   Bitwarden as an *identity* field and it draws its overlay into it, offering to
   fill a person's name on a self-hosted install screen. `autocomplete="off"` is
   ignored by all of them; the vendor attributes below are the documented opt-out
   (see App\Form\PasswordManagerIgnore, which is the same list for fields built
   in PHP).

   Applied by default and withdrawn only for the real credentials, because the
   safe direction is opt-in: a new field that should be filled will be noticed
   immediately, whereas one that should not be is exactly the bug this fixes and
   nobody sees it until an extension misbehaves on someone else's machine.
#}
{% block text_widget %}
    {% if attr.autocomplete|default('') not in ['username', 'email', 'current-password', 'new-password', 'one-time-code'] %}
        {% set attr = attr|merge({
            'data-bwignore':  'true',
            'data-1p-ignore': 'true',
            'data-lpignore':  'true',
            'data-form-type': 'other',
        }) %}
    {% endif %}

    {% set attr = attr|merge({
        class: 'block w-full h-9 rounded-lg border border-field
            bg-field
            px-3 text-sm text-ink
            placeholder:text-ink-faint
            shadow-sm shadow-zinc-950/5
            focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent
            transition-colors duration-100
            disabled:opacity-50 disabled:cursor-not-allowed
            ' ~ (attr.class ?? '')
    }) %}
    {{ block('form_widget_simple') }}
{% endblock %}

{% block email_widget    %}{% set type = 'email'    %}{{ block('text_widget') }}{% endblock %}
{% block password_widget %}{% set type = 'password' %}{{ block('text_widget') }}{% endblock %}
{% block url_widget      %}{% set type = 'url'      %}{{ block('text_widget') }}{% endblock %}
{% block search_widget   %}{% set type = 'search'   %}{{ block('text_widget') }}{% endblock %}
{% block tel_widget      %}{% set type = 'tel'      %}{{ block('text_widget') }}{% endblock %}

{# ── Number ──────────────────────────────────────────────────────────────── #}
{% block number_widget %}
    {% set attr = attr|merge({
        class: 'block w-full h-9 rounded-lg border border-field
            bg-field
            px-3 text-sm text-ink
            placeholder:text-ink-faint
            shadow-sm shadow-zinc-950/5
            focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent
            transition-colors duration-100
            disabled:opacity-50 disabled:cursor-not-allowed
            [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none
            ' ~ (attr.class ?? '')
    }) %}
    <input type="number" {{ block('widget_attributes') }} value="{{ value != '' ? value }}">
{% endblock %}

{% block integer_widget %}{{ block('number_widget') }}{% endblock %}

{# ── Textarea ────────────────────────────────────────────────────────────── #}
{% block textarea_widget %}
    {% set attr = attr|merge({
        class: 'block w-full rounded-lg border border-field
            bg-field
            px-3 py-2 text-sm text-ink
            placeholder:text-ink-faint
            shadow-sm shadow-zinc-950/5
            focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent
            resize-y transition-colors duration-100
            disabled:opacity-50 disabled:cursor-not-allowed
            ' ~ (attr.class ?? ''),
        rows: attr.rows ?? 3,
    }) %}
    <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{% endblock %}

{# ── Select ──────────────────────────────────────────────────────────────── #}
{% block choice_widget_collapsed %}
    {% set attr = attr|merge({
        class: 'block w-full h-9 rounded-lg border border-field
            bg-field
            pl-3 pr-8 text-sm text-ink
            shadow-sm shadow-zinc-950/5 appearance-none
            focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent
            transition-colors duration-100
            cursor-pointer
            disabled:opacity-50 disabled:cursor-not-allowed
            ' ~ (attr.class ?? '')
    }) %}
    <div class="relative">
        <select {{ block('widget_attributes') }}>
            {% if placeholder is not none %}
                <option value=""{% if not value %} selected{% endif %} disabled>{{ placeholder|trans({}, translation_domain) }}</option>
            {% endif %}
            {% if preferred_choices|length > 0 %}
                {% set options = preferred_choices %}
                {{ block('choice_widget_options') }}
                {% if choices|length > 0 and separator is not none %}
                    <option disabled>{{ separator }}</option>
                {% endif %}
            {% endif %}
            {% set options = choices %}
            {{ block('choice_widget_options') }}
        </select>
        {# Not drawn for an autocomplete field. TomSelect replaces the <select>
           with its own control and brings its own caret, so this one ended up
           floating in a box of its own beside it — visible on the account
           step's provider picker. #}
        {% if 'symfony--ux-autocomplete' not in (attr['data-controller']|default('')) %}
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5 text-ink-faint">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
                </svg>
            </div>
        {% endif %}
    </div>
{% endblock %}

{# ── File ────────────────────────────────────────────────────────────────────
   The browser default ("Datei auswählen — keine ausgewählt") is unstyleable and
   reads as a fragment of some other application. The real input stays in the
   DOM for the form to submit; the label is what the user sees and clicks, and
   the controller writes the chosen filename into it.
#}
{% block file_widget %}
    {% set attr = attr|merge({ class: 'sr-only ' ~ (attr.class ?? '') }) %}
    <label
        data-controller="ui--file-field"
        class="flex items-center gap-3 rounded-lg border border-dashed border-field
               bg-field px-3.5 py-3 text-sm text-ink-muted
               hover:bg-hover hover:border-accent/40 cursor-pointer transition-colors"
    >
        <span class="shrink-0 flex items-center justify-center size-9 rounded-full bg-sunken overflow-hidden">
            <img data-ui--file-field-target="preview" alt="" hidden class="size-9 object-cover">
            <i data-ui--file-field-target="icon" class="fa-solid fa-image text-ink-faint" aria-hidden="true"></i>
        </span>

        <span class="min-w-0 flex-1">
            <span data-ui--file-field-target="name" class="block truncate text-ink">{{ 'form.file.choose'|trans }}</span>
            <span class="block text-xs text-ink-faint">{{ 'form.file.hint'|trans }}</span>
        </span>

        <input type="file" {{ block('widget_attributes') }}
               data-ui--file-field-target="input"
               data-action="change->ui--file-field#pick">
    </label>
{% endblock %}

{# ── Checkbox ────────────────────────────────────────────────────────────── #}
{#
   Rendered directly rather than through form_widget_simple, which was the bug
   here: that block emits neither type="checkbox" nor checked, so every checkbox
   in a modal form came out as an empty text input. Nothing had used one yet, so
   it stayed latent until the integration forms needed a toggle.
#}
{% block checkbox_widget %}
    {% set attr = attr|merge({
        class: 'size-4 rounded border-field
            text-accent
            bg-field
            focus:ring-2 focus:ring-accent focus:ring-offset-0
            cursor-pointer
            ' ~ (attr.class ?? '')
    }) %}
    <input type="checkbox" {{ block('widget_attributes') }}
           {%- if value is defined and value is not empty %} value="{{ value }}"{% endif %}
           {%- if checked %} checked="checked"{% endif %}>
{% endblock %}

{% block radio_widget %}
    {% set attr = attr|merge({
        class: 'size-4 border-field
            text-accent
            bg-field
            focus:ring-2 focus:ring-accent focus:ring-offset-0
            cursor-pointer
            ' ~ (attr.class ?? '')
    }) %}
    <input type="radio" {{ block('widget_attributes') }}
           {%- if value is defined and value is not empty %} value="{{ value }}"{% endif %}
           {%- if checked %} checked="checked"{% endif %}>
{% endblock %}

{% block checkbox_row %}
    <div class="flex items-center gap-2.5">
        {{ form_widget(form) }}
        {# The parentheses are the whole point. `??` binds looser than a filter
           chain, so `label ?? (name|humanize)|trans(...)` translates only the
           fallback and prints a supplied label verbatim — which is why every
           checkbox in a modal form showed its translation key instead of its
           text. #}
        <label for="{{ id }}" class="text-sm text-ink-soft cursor-pointer leading-none">
            {{ (label ?? (name|humanize))|trans({}, translation_domain) }}
        </label>
    </div>
    {{ form_errors(form) }}
    {{ form_help(form) }}
{% endblock %}

{# ── Field-level errors ──────────────────────────────────────────────────── #}
{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="space-y-0.5">
            {% for error in errors %}
                <li class="flex items-center gap-1.5 text-[12px] text-danger leading-snug">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="currentColor" class="size-3 shrink-0" aria-hidden="true">
                        <path fill-rule="evenodd" d="M6 1a5 5 0 1 0 0 10A5 5 0 0 0 6 1Zm-.75 2.75a.75.75 0 0 1 1.5 0v2.5a.75.75 0 0 1-1.5 0v-2.5Zm.75 5a.75.75 0 1 0 0-1 .75.75 0 0 0 0 1Z" clip-rule="evenodd"/>
                    </svg>
                    {{ error.message }}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{# ── Help text ───────────────────────────────────────────────────────────── #}
{% block form_help %}
    {% if help is not empty %}
        {# text-ink-faint, not -muted: help is subordinate to its field, and at
           the same weight as a label it competed with the next one. #}
        <p class="text-[12px] text-ink-faint leading-snug">
            {{ help|trans({}, translation_domain) }}
        </p>
    {% endif %}
{% endblock %}
