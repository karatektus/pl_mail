{#
_tasks_pane.html.twig — the tasks docked beside the mail panes.

The container, the handle and the sizing are _side_pane.html.twig's. Its boundary
is a ui--side-split on this wrapper, for the reason the address book's is: the
shell's ui--split is the calendar's, and Stimulus gives a target to the nearest
controller of its name. Whether it is open, and what it asks the calendar and the
address book for, is tasks--pane's, on the shell.

Two positions rather than the other panes' three. The full-width position exists
for a calendar's month grid and a contact's form; a list of tasks has no use for a
screen's width, and the page below lg already gives it the row where it needs it.
#}

{% set paneOpen = tasksPaneBody is defined or app.user.tasksPaneOpen %}

{% embed '_partials/_side_pane.html.twig' with {
    name: 'tasks',
    open: paneOpen,
    widthVar: '--tasks-pane-width',
    width: app.user.tasksPaneWidth,
    handleLabel: 'tasks.pane.resize'|trans,
    controller: 'ui--side-split',
    attrs: 'data-tasks--pane-target="dock"'
        ~ ' data-controller="ui--side-split"'
        ~ ' data-ui--side-split-modes-value="false"'
        ~ ' data-ui--side-split-variable-value="--tasks-pane-width"'
        ~ ' data-ui--side-split-main-selector-value="[data-ui--split-target=&quot;main&quot;]"'
        ~ ' data-ui--side-split-state-url-value="' ~ path('app_tasks_pane_state') ~ '"'
        ~ ' data-ui--side-split-token-value="' ~ csrf_token('tasks_pane_state') ~ '"'
        ~ ' data-ui--side-split-min-value="' ~ constant('App\\Entity\\User\\User::TASKS_PANE_MIN_WIDTH') ~ '"'
        ~ ' data-ui--side-split-max-value="' ~ constant('App\\Entity\\User\\User::TASKS_PANE_MAX_WIDTH') ~ '"'
        ~ ' data-ui--side-split-default-value="' ~ constant('App\\Entity\\User\\User::TASKS_PANE_DEFAULT_WIDTH') ~ '"',
} %}
    {% block side_pane_body %}
        {# With the page when it will be seen on first paint, lazy and empty
           otherwise — the calendar pane's reasoning. #}
        {% if tasksPaneBody is defined %}
            {{ tasksPaneBody }}
        {% elseif open %}
            {{ render(controller('App\\Controller\\Task\\TaskController::index', { _tasks_pane: true })) }}
        {% else %}
            <turbo-frame id="tasks-pane-frame" loading="lazy" class="flex flex-col min-h-0 flex-1">
                <div class="flex items-center justify-center h-24 text-ink-faint" aria-live="polite">
                    <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
                </div>
            </turbo-frame>
        {% endif %}
    {% endblock %}
{% endembed %}
