{#
    The snooze menu.

    Labels come from here because they are translated; the wake times are filled
    in by mail--snooze-menu once the page is running, because only the browser
    knows what timezone "tomorrow morning" is in. Each option therefore carries a
    data-snooze-key rather than a value, and the controller matches on it.

    Parameters:
      controller — the Stimulus identifier handling the click, e.g.
                   "mail--message-row". Used for both the action and the
                   namespaced url param.
      method     — the action method on it, e.g. "snooze"
      url        — optional endpoint for the url param; the toolbar omits it and
                   derives per-row URLs itself
      snoozed    — whether the target is currently snoozed, which is the only
                   thing that puts "Unsnooze" on the menu
      align      — "left" to open from the button's left edge. The default
                   opens from its right, which suits a button at the end of a
                   row and runs off the pane from one at the start of a toolbar
      shared     — the one menu every list row opens (mail--row-menus, #496)
                   rather than a menu inside a ui--dropdown. It then has an id
                   for the rows' buttons to point at, is placed by its host
                   rather than by CSS, and always carries "Unsnooze", which the
                   host shows or hides for the row it was opened for.
#}
{% set snoozed = snoozed|default(false) %}
{% set shared = shared|default(false) %}
{% set url = url|default(null) %}
{% set fire = 'click->' ~ controller ~ '#' ~ method ~ (shared ? '' : ' click->ui--dropdown#close') %}

<div {% if shared %}id="row-snooze-menu" role="menu" aria-label="{{ 'thread_row.actions.snooze'|trans }}"
     data-mail--row-menus-target="snooze"
     class="fixed z-50 min-w-56 popover py-1"
     {% else %}data-ui--dropdown-target="menu"
     data-action="ui--dropdown:opened->mail--snooze-menu#refresh"
     class="absolute top-full mt-1 {{ 'left' == align|default('right') ? 'left-0' : 'right-0' }} z-20 min-w-56 popover py-1"
     {% endif %}
     hidden
     data-controller="mail--snooze-menu">

    <p class="px-3 py-1 text-[10px] font-semibold uppercase tracking-wide text-ink-faint">
        {{ 'thread_row.actions.snooze'|trans }}
    </p>

    {% for key in ['later_today', 'tomorrow', 'this_weekend', 'next_week'] %}
        <button type="button"
                hidden
                data-mail--snooze-menu-target="option"
                data-snooze-key="{{ key }}"
                {% if url %}data-{{ controller }}-snooze-url-param="{{ url }}"{% endif %}
                data-action="{{ fire }}"
                {% if shared %}role="menuitem"{% endif %}
                class="w-full flex items-center justify-between gap-3 px-3 py-2 text-sm text-ink-muted
                       hover:bg-hover hover:text-ink transition-colors text-left">
            <span class="whitespace-nowrap">{{ ('snooze.' ~ key)|trans }}</span>
            {#
                nowrap and shrink-0, because the wake time is not always the
                same shape: anything more than two days out carries the date as
                well ("Sat, Aug 29, 08:00"), and inside min-w-56 that wrapped to
                a second line. The two distant options were then visibly taller
                than the two near ones, which reads as a spacing bug rather than
                as a longer string. The menu widens to fit instead — it is an
                absolutely positioned dropdown, so it costs nothing.

                The date itself stays: it is there because a bare weekday was
                once misread as today. See snooze_menu_controller#format.
            #}
            <span data-snooze-when class="text-xs text-ink-faint tabular-nums whitespace-nowrap shrink-0"></span>
        </button>
    {% endfor %}

    {% if snoozed or shared %}
        <div class="my-1 border-t border-line" {% if shared %}data-mail--row-menus-target="unsnooze"{% endif %}></div>
        {# No until param at all: its absence is what clears the snooze. #}
        <button type="button"
                {% if shared %}role="menuitem" data-mail--row-menus-target="unsnooze"{% endif %}
                {% if url %}data-{{ controller }}-snooze-url-param="{{ url }}"{% endif %}
                data-action="{{ fire }}"
                class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-ink-muted
                       hover:bg-hover hover:text-ink transition-colors text-left">
            <i class="fa-solid fa-arrow-rotate-left w-4 text-center" aria-hidden="true"></i>
            <span>{{ 'snooze.unsnooze'|trans }}</span>
        </button>
    {% endif %}
</div>
