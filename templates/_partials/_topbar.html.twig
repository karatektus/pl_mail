<header class="flex items-center gap-2 px-4 h-14 flex-shrink-0 pane shell-chrome relative z-20">

    {# Burger — opens the drawer on mobile, collapses to the icon rail on md+ #}
    <button
        type="button"
        class="flex items-center justify-center w-9 h-9 rounded-lg
               text-ink-muted
               hover:bg-hover
               transition-colors flex-shrink-0"
        aria-label="{{ 'sidebar.toggle'|trans }}"
        title="{{ 'sidebar.toggle'|trans }}"
        data-action="click->ui--sidebar-drawer#toggle"
    >
        <i class="fa-solid fa-bars text-base" aria-hidden="true"></i>
    </button>

    {# Logo #}
    <a
        href="{{ path('app_mail_inbox') }}"
        class="flex items-center gap-2 flex-shrink-0 md:w-52 no-underline"
        aria-label="{{ 'app.name'|trans }}"
    >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="32" height="32" aria-hidden="true">
            <defs>
                <clipPath id="logo-clip">
                    <rect width="48" height="48" rx="10"/>
                </clipPath>
            </defs>
            <g clip-path="url(#logo-clip)" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="15" y1="10" x2="15" y2="38" stroke="#4285F4" stroke-width="5.5"/>
                <path d="M15 10 Q15 6 19 6 L25 6 Q31 6 31 12" stroke="#EA4335" stroke-width="5.5"/>
                <line x1="31" y1="12" x2="31" y2="26" stroke="#FBBC04" stroke-width="5.5"/>
                <path d="M31 26 Q31 30 25 30 L19 30 Q15 30 15 26" stroke="#34A853" stroke-width="5.5"/>
                <line x1="37" y1="7" x2="37" y2="26" stroke="#EA4335" stroke-width="5.5"/>
                <line x1="37" y1="26" x2="37" y2="35" stroke="#4285F4" stroke-width="5.5"/>
                <path d="M37 35 Q37 42 44 42" stroke="#FBBC04" stroke-width="5.5"/>
            </g>
        </svg>
        <span class="hidden sm:inline font-semibold text-ink text-sm tracking-wide">{{ 'app.name'|trans }}</span>

        {# Are live updates actually arriving? The failure is otherwise
           invisible — the mail list has no other refresh path, so a dead
           stream looks exactly like a quiet mailbox and the inbox simply stops
           changing. A dot rather than a word because it is true nearly all the
           time; the tooltip carries what it means, since a coloured dot on its
           own explains nothing. #}
        <span
            class="stream-dot"
            role="status"
            data-controller="core--stream-status"
            data-label-connecting="{{ 'mercure.status.connecting'|trans }}"
            data-label-connected="{{ 'mercure.status.connected'|trans }}"
            data-label-offline="{{ 'mercure.status.offline'|trans }}"
        ></span>
    </a>

    {# ── Search + calendar ─────────────────────────────────────────────── #}
    <div class="flex-1 max-w-2xl mx-auto flex items-center gap-2 min-w-0">
    <div
        class="flex-1 relative min-w-0"
        data-controller="mail--search"
    >
        <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-sm pointer-events-none" aria-hidden="true"></i>
            <input
                type="search"
                name="q"
                value="{{ app.request.query.get('q', '') }}"
                placeholder="{{ 'header.search.placeholder'|trans }}"
                autocomplete="off"
                data-mail--search-target="input"
                data-action="keydown->mail--search#onKeydown focus->mail--search#onFocus input->mail--search#onInput"
                class="w-full pl-10 pr-4 py-2 text-sm
                       bg-sunken
                       border border-transparent rounded-xl
                       text-ink
                       placeholder:text-ink-faint
                       focus:outline-none focus:ring-2 focus:ring-accent
                       focus:bg-field
                       transition-colors"
            >
        </div>

        {# Recent searches, and operator/contact suggestions while typing —
           one list, since only one of the two is ever relevant. #}
        <div
            data-mail--search-target="dropdown"
            class="hidden absolute left-0 right-0 top-full mt-1 z-50
                   bg-surface
                   border border-line
                   rounded-pane shadow-xl overflow-hidden"
        >
            <div class="flex items-center justify-between px-3 py-1.5 border-b border-line">
                <span data-mail--search-target="dropdownTitle"
                      class="text-[11px] font-semibold uppercase tracking-wider text-ink-faint">Recent searches</span>
                <button
                    type="button"
                    data-mail--search-target="clear"
                    data-action="click->mail--search#clearRecents"
                    class="text-[11px] text-gray-400 hover:text-ink-soft transition-colors"
                >
                    Clear
                </button>
            </div>
            <ul data-mail--search-target="recentsList" class="py-1 max-h-56 overflow-y-auto"></ul>
        </div>
    </div>

    {# ── Happening soon ────────────────────────────────────────────────
       Everything due within the fortnight — the flights, deliveries,
       reservations and tickets plMail read out of mail, and the appointments
       the owner entered — opened as a panel in the shared modal frame.

       Only rendered when there is something to open. A control that is always
       there and usually opens "nothing coming up" trains people not to press
       it; one that appears when a parcel is due is a piece of news. It is also
       what keeps the cost honest — see CalendarGlobal::getSoonest(), which asks
       for one row rather than the panel's worth.

       It wears the NEXT thing's icon rather than a dot. A dot beside the
       calendar button already says "there is a reason to look"; a plane says
       that and says what, in the same nine pixels, and two dots in one corner
       of a topbar say neither. A row with no extraction kind falls back to a
       plain calendar mark — see HappeningSoonRow::icon(), which is where both
       this and the panel read it from so the two cannot disagree. See
       HappeningSoonController for why this is here rather than a page or a
       mailbox panel. #}
    {% set soonest = calendar.soonest %}
    {% if soonest %}
        <button
            type="button"
            data-controller="ui--modal"
            data-action="click->ui--modal#open"
            data-ui--modal-src-value="{{ path('app_calendar_soon') }}"
            data-ui--modal-title-value="{{ 'calendar.soon.title'|trans }}"
            class="flex cursor-pointer items-center justify-center w-9 h-9 rounded-lg
                   transition-colors flex-shrink-0
                   text-ink-muted hover:bg-hover"
            aria-label="{{ 'calendar.soon.open'|trans }}"
            title="{{ soonest.event.title ~ ' · ' ~ soonest.startsAt|intl_date('EEEdMMM', soonest.event.isAllDay ? false : null) }}"
        >
            <i class="{{ soonest.icon }} text-base" aria-hidden="true"></i>
        </button>
    {% endif %}

    {# ── Calendar ──────────────────────────────────────────────────────
       Icon only, and here rather than in the sidebar: the sidebar is a
       list of places mail lives, and a control that slides a panel in and
       out beside that mail is not one of them — it read as a nav item that
       did not navigate.

       Beside the search box rather than in the right-hand group: it acts on
       what is below it, not on the account.

       The dot only appears when something is still ahead TODAY, and its
       colour is how soon. Three bands, not a countdown: a colour you have to
       read a number off is not a dot. See UpcomingEventIndicator.

       **A three-way switch, not a toggle.** Mail → split → calendar → mail,
       and it wraps, so three presses always return you to where you were. The
       middle position is the one that used to be the only one; the third is
       what made a full-width calendar reachable without navigating to a
       different page and losing the mail behind it. See CalendarPaneMode, and
       ui--split, which also arrives at these positions from the drag handle.

       All three icons are rendered and the two that are not current carry
       `hidden` — the ATTRIBUTE, written by the server and toggled by the
       controller, not a stylesheet rule. That is deliberate and was learned the
       hard way: a first version picked the icon with a CSS selector on the
       shell's mode, and on a stack whose Tailwind build had not been rerun all
       three drew at once, on top of each other. An icon control has to be right
       from the markup alone. Same for the accented state, which is two utility
       classes the controller adds and removes rather than a new rule.

       Below lg the split position looks like the calendar position — the row
       cannot hold both — but the switch still has three stops, because the
       width is not a property of the preference.

       The href is still a real URL so middle-click reaches the page;
       ui--split#toggle suppresses the navigation. #}
    {% set upcoming = calendar.upcoming %}
    {% set paneMode = app.user.calendarPaneMode %}
    <a
        href="{{ path('app_calendar_index') }}"
        data-calendar-toggle
        data-action="click->ui--split#toggle"
        class="relative flex cursor-pointer items-center justify-center w-9 h-9 rounded-lg
               transition-colors flex-shrink-0
               text-ink-muted hover:bg-hover"
        aria-label="{{ 'sidebar.nav.calendar'|trans }}"
        title="{{ upcoming
            ? upcoming.title ~ ' · ' ~ upcoming.startsAt|date(clock.time)
            : 'sidebar.nav.calendar'|trans }}"
    >
        {# The server renders `mail` whatever the preference says — see
           _mailbox.html.twig — and the controller corrects both this and the
           layout on connect. So the icon that starts visible is the one that
           matches what is actually on screen at first paint. #}
        {% for candidate in enum('App\\Domain\\Enum\\Calendar\\CalendarPaneMode').cases() %}
            <i class="{{ candidate.icon }} text-base"
               data-calendar-mode-icon="{{ candidate.value }}"
               {{ candidate.value == 'mail' ? '' : 'hidden' }}
               aria-hidden="true"></i>
        {% endfor %}

        {# What pressing this does next, which is the only part of the control a
           screen reader cannot get from the icon. The three names are rendered
           once, translated, and the controller copies the right one into the
           live label — so the strings exist in the template and not in the
           JavaScript. #}
        <span class="sr-only" data-calendar-mode-label>{{ paneMode.nextTransKey|trans }}</span>
        <span hidden>
            {% for candidate in enum('App\\Domain\\Enum\\Calendar\\CalendarPaneMode').cases() %}
                <span data-calendar-mode-name="{{ candidate.value }}">{{ ('calendar.pane.mode.' ~ candidate.value)|trans }}</span>
            {% endfor %}
        </span>

        {% if upcoming %}
            <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full
                         ring-2 ring-surface
                         {{ {
                             'imminent': 'bg-danger',
                             'soon':     'bg-warning',
                             'later':    'bg-success',
                         }[upcoming.state] ?? 'bg-success' }}"
                  aria-hidden="true"></span>
            <span class="sr-only">
                {{ ('calendar.upcoming.' ~ upcoming.state)|trans }}
            </span>
        {% endif %}
    </a>
    </div>

    {# Right actions #}
    <div class="flex items-center gap-1 flex-shrink-0">
        {# TEMPORARY: manual sync trigger (app:mail:sync) #}
        <button
            type="button"
            data-controller="mail--sync-now"
            data-mail--sync-now-url-value="{{ path('app_mail_sync_run') }}"
            data-mail--sync-now-status-url-value="{{ path('app_mail_sync_status') }}"
            data-action="click->mail--sync-now#run"
            class="flex cursor-pointer items-center justify-center w-9 h-9 rounded-lg
                   text-ink-muted hover:bg-hover transition-colors flex-shrink-0
                   disabled:cursor-default disabled:opacity-60"
            aria-label="Sync now"
            title="Sync now"
        >
            <i class="fa-solid fa-rotate text-base" data-mail--sync-now-target="icon" aria-hidden="true"></i>
        </button>

        {# User menu #}
        {#
        Outlined when something has been logged at warning or worse that this
        admin has not looked at yet — the log browser is behind this menu, and
        an error nobody opens the admin panel to find is an error nobody sees.
        Amber for warnings, red once anything reached error. Admins only;
        logAlert answers null for everyone else.
        #}
        {% set unseenLogs = logAlert.unseen %}
        {% set attention  = accountHealth.attention %}
        <div class="relative ml-1"
             data-controller="ui--user-menu admin--log-alert"
             {# The log browser is a frame; this is not in it, so opening or
                clearing the log leaves the outline exactly where it was until
                the next full render. It says when it has been read, and the
                outline goes then. #}
             data-action="admin--log-seen:seen@document->admin--log-alert#clear">
            <button id="user-menu-btn"
                    data-admin--log-alert-target="ring"
                    data-action="click->ui--user-menu#toggle"
                    class="flex cursor-pointer items-center justify-center w-8 h-8 rounded-full bg-accent hover:ring-2 hover:ring-accent/60 hover:ring-offset-1 ring-offset-surface text-accent-ink text-xs font-semibold transition-all
                           {% if unseenLogs %}ring-2 ring-offset-1 {{ unseenLogs.tone == 'danger' ? 'ring-red-500' : 'ring-amber-500' }}{% endif %}"
                    aria-label="{{ 'header.user_menu.label'|trans({ '%email%': app.user.email }) }}"
                    {# Account health outranks the log line in the tooltip: it is
                       the user's own mail, and it is the one a non-admin can
                       ever see. The log wording stays for the admin case. #}
                    title="{{ attention
                        ? 'header.user_menu.account_attention'|trans({ '%count%': attention.count })
                        : (unseenLogs
                            ? ('header.user_menu.unseen_logs.' ~ unseenLogs.tone)|trans({ '%count%': unseenLogs.count })
                            : app.user.email) }}">
                {# The initial is the fallback, not the design: an avatar is
                   optional and most users never set one. #}
                {% if app.user.avatar %}
                    <img src="{{ path('app_settings_profile_avatar', { filename: app.user.avatar }) }}"
                         alt=""
                         class="w-8 h-8 rounded-full object-cover">
                {% else %}
                    {{ app.user.email | first | upper }}
                {% endif %}
            </button>

            {#
                "Something about your accounts needs attention."

                A DOT, not a second ring, and that is the whole reason it is a
                separate element. logAlert already outlines this button for
                admins; a second ring on the same element would have meant one
                of the two silently winning, and they mean different things —
                that one is "there are unread errors in the log", this one is
                "your mail is not arriving". They can be true at once and an
                admin has to be able to tell them apart, so this sits in the
                corner and leaves the outline alone.

                Not dismissible, unlike the log outline: there is no seen-at
                counterpart here on purpose. See AccountHealthGlobal — "seen" is
                the right model for a record of what happened and the wrong one
                for a condition that is still true. It goes when the problem
                goes.

                aria-hidden with the count in the button's title instead: a
                screen reader gets one sentence rather than a floating number
                with no antecedent.
            #}
            {% if attention %}
                <span class="absolute -top-0.5 -right-0.5 flex items-center justify-center min-w-[0.875rem] h-3.5 px-1 rounded-full text-[9px] font-bold text-white ring-2 ring-surface pointer-events-none
                             {{ attention.tone == 'danger' ? 'bg-red-500' : 'bg-amber-500' }}"
                      aria-hidden="true">{{ attention.count }}</span>
            {% endif %}

            <div id="user-menu" data-ui--user-menu-target="menu"  class="hidden absolute right-0 mt-2 w-56 bg-surface border border-line rounded-pane shadow-lg py-1 z-[200]">
                <div class="px-4 py-2.5 border-b border-line">
                    {% set displayName = (app.user.nameFirst ~ ' ' ~ app.user.nameLast)|trim %}
                    {% if displayName is not empty %}
                        <p class="text-sm font-medium text-ink truncate">{{ displayName }}</p>
                        <p class="text-xs text-ink-faint truncate">{{ app.user.email }}</p>
                    {% else %}
                        <p class="text-xs text-gray-400">{{ 'header.user_menu.signed_in_as'|trans }}</p>
                        <p class="text-sm font-medium text-ink truncate">{{ app.user.email }}</p>
                    {% endif %}
                </div>
                <a href="{{ path('app_settings_index', { section: 'profile' }) }}"
                   id="user-menu-profile"
                   class="flex items-center gap-2 px-4 py-2 text-sm text-ink-soft hover:bg-hover">
                    <i class="fa-solid fa-user w-4 text-gray-400" aria-hidden="true"></i>
                    {{ 'header.user_menu.profile'|trans }}
                </a>
                {#
                    The dot on the avatar says something is wrong; this is where
                    it goes. Pointed straight at the health section rather than
                    at settings generally — the same choice the admin entry
                    below makes for the log browser, and for the same reason: an
                    indicator that lands you on a page where you still have to
                    hunt has only moved the hunting.
                #}
                <a href="{{ path('app_settings_index', attention ? { section: 'health' } : {}) }}"
                   id="user-menu-settings"
                   class="flex items-center gap-2 px-4 py-2 text-sm text-ink-soft hover:bg-hover">
                    <i class="fa-solid fa-gear w-4 text-gray-400" aria-hidden="true"></i>
                    {{ 'header.user_menu.settings'|trans }}
                    {% if attention %}
                        <span class="ml-auto inline-flex items-center gap-1.5 text-xs
                                     {{ attention.tone == 'danger' ? 'text-danger' : 'text-warning' }}">
                            <span class="w-1.5 h-1.5 rounded-full {{ attention.tone == 'danger' ? 'bg-red-500' : 'bg-amber-500' }}"
                                  aria-hidden="true"></span>
                            {{ attention.count }}
                        </span>
                    {% endif %}
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    {# The outline on the button says something is wrong; this
                       says where to go, and links straight to the log browser
                       rather than the dashboard it is a tab of. #}
                    <a href="{{ unseenLogs ? path('app_admin_dashboard', { section: 'logs' }) : path('app_admin_dashboard') }}"
                       class="flex items-center gap-2 px-4 py-2 text-sm text-ink-soft hover:bg-hover">
                        <i class="fa-solid fa-gauge-high w-4 text-gray-400" aria-hidden="true"></i>
                        {{ 'header.user_menu.admin'|trans }}
                        {% if unseenLogs %}
                            <span data-admin--log-alert-target="badge"
                                  class="ml-auto inline-flex items-center gap-1.5 text-xs
                                         {{ unseenLogs.tone == 'danger' ? 'text-danger' : 'text-warning' }}">
                                <span class="w-1.5 h-1.5 rounded-full {{ unseenLogs.tone == 'danger' ? 'bg-red-500' : 'bg-amber-500' }}"
                                      aria-hidden="true"></span>
                                {{ unseenLogs.count }}
                            </span>
                        {% endif %}
                    </a>
                {% endif %}
                {# Setup opens by itself once and never again, so this is the
                   only way back to it. A button rather than a link: it loads
                   into the shared modal instead of navigating. #}
                <button
                    type="button"
                    id="user-menu-rerun-setup"
                    data-controller="ui--modal"
                    data-ui--modal-src-value="{{ path('app_onboarding_start') }}"
                    data-ui--modal-title-value="{{ 'onboarding.title'|trans }}"
                    data-ui--modal-size-value="full"
                    data-action="click->ui--modal#open"
                    class="w-full flex items-center gap-2 px-4 py-2 text-sm text-ink-soft hover:bg-hover text-left cursor-pointer"
                >
                    <i class="fa-solid fa-wand-magic-sparkles w-4 text-gray-400" aria-hidden="true"></i>
                    {{ 'header.user_menu.rerun_setup'|trans }}
                </button>
                <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 text-sm text-ink-soft hover:bg-hover">
                    <i class="fa-solid fa-right-from-bracket w-4 text-gray-400" aria-hidden="true"></i>
                    {{ 'header.user_menu.sign_out'|trans }}
                </a>
            </div>
        </div>

    </div>
</header>
