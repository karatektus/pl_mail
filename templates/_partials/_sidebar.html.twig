{#
The badge is always rendered — hidden at zero rather than omitted — so the
sidebar controller can patch its text in place after a Mercure sync without
having to re-render the markup. `key` must match a key from
app_mail_sidebar_counts.
#}
{% macro unread_badge(count, key) %}
    <span class="rail-hide text-xs font-semibold px-1.5 py-0.5 rounded-full bg-accent text-white{{ count > 0 ? '' : ' hidden' }}"
          data-ui--sidebar-target="badge"
          data-count-key="{{ key }}">{{ count }}</span>
{% endmacro %}

{% macro label_dot(color) %}
    <span class="w-2.5 h-2.5 rounded-full shrink-0
        {{ {
        'gray':   'bg-ink-faint',
        'red':    'bg-red-500',
        'orange': 'bg-orange-500',
        'amber':  'bg-amber-500',
        'green':  'bg-green-500',
        'teal':   'bg-teal-500',
        'blue':   'bg-blue-500',
        'violet': 'bg-violet-500',
        'pink':   'bg-pink-500',
    }[color ?? 'gray'] ?? 'bg-ink-faint' }}"
          aria-hidden="true"></span>
{% endmacro %}

{#
Takes a Label directly — labels are user-scoped, so there is no per-account
merging left to do and no view model between the entity and the template.
#}
{#
Opens the edit modal for a label. Sits outside the row's <a> rather than
inside it — a button nested in an anchor is invalid HTML — and inside <summary>
it relies on ui--modal#open calling preventDefault(), which also stops the
disclosure toggling.

Hover-revealed, but focus-visible brings it back for keyboard users, and it
keeps its accessible name either way.
#}
{% macro label_edit(label) %}
    <button
        data-controller="ui--modal"
        data-action="click->ui--modal#open"
        data-ui--modal-title-value="{{ 'label.form.edit_title'|trans }}"
        data-ui--modal-src-value="{{ path('app_label_edit', { id: label.id }) }}"
        class="shrink-0 w-5 h-5 flex items-center justify-center rounded
               text-ink-faint hover:text-ink hover:bg-hover
               opacity-0 group-hover/label:opacity-100 focus-visible:opacity-100
               transition-opacity cursor-pointer"
        aria-label="{{ 'settings.labels.edit'|trans({ '%name%': label.name }) }}"
    >
        <i class="fa-solid fa-pen text-[9px]" aria-hidden="true"></i>
    </button>
{% endmacro %}

{% macro label_node(label, depth, drawerClose) %}
    {% import _self as macros %}
    {% set children = sidebarCounts.visibleChildrenOf(label) %}

    {% if children|length > 0 %}
        {# Keyed by full name so the controller can put the tree back the way
           the user left it after the sidebar re-renders. #}
        <details class="group/tree"
                 data-ui--sidebar-target="tree"
                 data-tree-key="{{ label.fullName }}"
                 data-action="toggle->ui--sidebar#rememberTree"
                 open>
            <summary class="nav-item group/label flex items-center gap-1 py-1.5 cursor-pointer list-none
                            transition-colors"
                     style="--label-depth: {{ depth * 14 }}px">
                <i class="fa-solid fa-chevron-right text-[9px] text-ink-faint w-3
                          transition-transform group-open/tree:rotate-90" aria-hidden="true"></i>
                {{ macros.label_dot(label.color) }}
                <a href="{{ path('app_mail_label_path', { path: label.fullName }) }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
                   class="flex-1 flex items-center justify-between gap-2 truncate"
                   data-ui--sidebar-target="link"
                   data-action="{{ drawerClose }}">
                    <span class="truncate">{{ label.name }}</span>
                    {{ macros.unread_badge(sidebarCounts.forLabel(label), 'label:' ~ label.id) }}
                </a>
                {{ macros.label_edit(label) }}
            </summary>
            <div class="space-y-0.5">
                {% for child in children %}
                    {{ macros.label_node(child, depth + 1, drawerClose) }}
                {% endfor %}
            </div>
        </details>
    {% else %}
        <div class="nav-item group/label flex items-center gap-2 py-1.5 transition-colors"
             style="--label-depth: {{ depth * 14 + 16 }}px">
            {{ macros.label_dot(label.color) }}
            <a href="{{ path('app_mail_label_path', { path: label.fullName }) }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
               class="flex-1 flex items-center justify-between gap-2 truncate min-w-0"
               data-ui--sidebar-target="link"
               data-action="{{ drawerClose }}">
                <span class="truncate">{{ label.name }}</span>
                {{ macros.unread_badge(sidebarCounts.forLabel(label), 'label:' ~ label.id) }}
            </a>
            {{ macros.label_edit(label) }}
        </div>
    {% endif %}
{% endmacro %}

{% import _self as macros %}

{#
_drawerMode is set to true when this sidebar is rendered inside the mobile drawer.
When true, nav links also dispatch a close action to the parent sidebar-drawer controller.
#}
{% set _drawerClose = _drawerMode is defined and _drawerMode ? 'click->ui--sidebar-drawer#close' : '' %}

{#
`shell-chrome` marks this as shell furniture rather than content, so a Layout
can restyle it (see .layout-flat in app.css). The drawer copy is deliberately
excluded: it floats over a dim backdrop and must stay an opaque card whatever
the layout.
#}
{#
Deliberately NOT data-turbo-permanent. Carrying the element across visits kept
it from moving, but it also froze what it says: after a data reset the deleted
labels stayed in the nav, linking to 404s, and a label created or renamed
anywhere else stayed invisible until a full reload. It re-renders per visit
now, and the two things anyone would notice moving are restored by the
controller instead — the scroll position and which trees are open.
#}
<aside id="{{ _drawerMode is defined and _drawerMode ? 'sidebar-drawer-inner' : 'sidebar' }}"
       data-controller="ui--sidebar"
       data-ui--sidebar-counts-url-value="{{ path('app_mail_sidebar_counts') }}"
       class="flex flex-col w-56 h-full flex-shrink-0 overflow-hidden pane
              transition-[width] duration-200
              {{ _drawerMode is defined and _drawerMode ? '' : 'shell-chrome' }}">

    {# Compose #}
    <div class="compose-wrap px-3 py-3 border-b border-line">
        <a href="{{ path('app_compose_new') }}"
           data-turbo-frame="compose_dock"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.compose'|trans }}"
           class="compose-link w-full flex items-center justify-center gap-2 bg-accent hover:bg-accent-strong text-white text-sm font-medium rounded-lg px-3 py-row transition-colors">
            <i class="fa-solid fa-plus w-4 h-4" aria-hidden="true"></i>
            <span class="rail-hide">{{ 'sidebar.compose'|trans }}</span>
        </a>
    </div>

    {# Nav #}
    <nav class="flex-1 overflow-y-auto px-2 py-2 space-y-0.5 text-sm"
         data-ui--sidebar-target="scroller"
         data-action="scroll->ui--sidebar#rememberScroll">

        <a href="{{ path('app_mail_inbox') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.inbox'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-inbox w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.inbox'|trans }}</span>
            </span>
            {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Inbox), 'role:inbox') }}
        </a>

        <a href="{{ path('app_mail_starred') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.starred'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-star w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.starred'|trans }}</span>
            </span>
            {{ macros.unread_badge(sidebarCounts.forStarred(), 'starred') }}
        </a>

        <a href="{{ path('app_mail_sent') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.sent'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-paper-plane w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.sent'|trans }}</span>
            </span>
            {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Sent), 'role:sent') }}
        </a>

        <a href="{{ path('app_mail_drafts') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.drafts'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-file-lines w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.drafts'|trans }}</span>
            </span>
            {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Drafts), 'role:drafts') }}
        </a>

        {# Drawer only. On a wide screen the calendar is a panel that slides in
           beside the mail, and a control for that is not a destination — as a
           nav row it read as a link that did not navigate. It lives in the
           topbar there instead. Below lg there is nowhere to dock it, so this
           is a plain link to the page like any other row here. #}
        {% if _drawerMode is defined and _drawerMode %}
            <a href="{{ path('app_calendar_index') }}"
               class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.calendar'|trans }}"
            >
                <span class="flex items-center gap-2">
                    <i class="fa-regular fa-calendar w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.calendar'|trans }}</span>
                </span>
            </a>
        {% endif %}
        {# Snoozed and Archive live behind a disclosure: both are real
           destinations, and neither is somewhere you go often enough to
           spend a permanent row on. Archive in particular had no entry at
           all unless its label had been switched visible in settings —
           the route existed and nothing linked to it.

           <details> rather than a controller: the open/closed state is
           exactly what the element is for, and it keeps working before any
           JavaScript has run.

           `open` when you are already on one of the pages inside it, and that
           is a bug fix rather than a nicety. The sidebar is deliberately not
           data-turbo-permanent, so every navigation re-renders it from
           scratch and the disclosure came back shut — click More, click
           Archive, and the menu snapped closed with the row you had just
           chosen hidden behind it again. It read as "the menu collapsed
           instead of doing anything". Decided here rather than remembered in
           localStorage like the label trees, because the honest answer to
           "should this be open?" is "are you in it?", and the server already
           knows. #}
        {% set _moreRoutes = ['app_mail_snoozed', 'app_mail_archive'] %}
        <details class="rail-hide" {{ app.request.attributes.get('_route') in _moreRoutes ? 'open' : '' }}>
            <summary class="nav-item flex items-center gap-2 px-3 py-2 rounded-lg cursor-pointer list-none transition-colors text-ink-muted">
                <i class="fa-solid fa-chevron-right w-4 text-xs transition-transform" aria-hidden="true"></i>
                <span>{{ 'sidebar.nav.more'|trans }}</span>
            </summary>
        {% if sidebarCounts.hasSnoozed %}
            <a href="{{ path('app_mail_snoozed') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
               class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.snoozed'|trans }}">
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-clock w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.snoozed'|trans }}</span>
                </span>
                {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Snoozed), 'role:snoozed') }}
            </a>
        {% endif %}
            <a href="{{ path('app_mail_archive') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
               class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.archive'|trans }}">
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-box-archive w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.archive'|trans }}</span>
                </span>
                {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Archive), 'role:archive') }}
            </a>
        </details>

        {# Behind the same eye toggle in label settings that Archive is behind,
           and for the same reason: plenty of installs have no junk folder
           worth a permanent row. It had no row at ALL before — no entry, no
           route, no translation key — so switching Spam visible in settings
           did nothing observable anywhere. Sits above Trash because that is
           where LabelRole::sortOrder() already put it. #}
        {% if sidebarCounts.hasVisibleRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Spam) %}
            <a href="{{ path('app_mail_spam') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
               class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.spam'|trans }}"
            >
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-ban w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.spam'|trans }}</span>
                </span>
                {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Spam), 'role:spam') }}
            </a>
        {% endif %}

        <a href="{{ path('app_mail_trash') }}"
           {# Only where that frame exists — the mailbox layout. The
              calendar page shares this sidebar and has no list frame;
              a targeted link there would go nowhere at all. #}
           {% if mailFrame|default(false) %}data-turbo-frame="inbox-list-frame"{% endif %}
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.trash'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-trash w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.trash'|trans }}</span>
            </span>
            {{ macros.unread_badge(sidebarCounts.forRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Trash), 'role:trash') }}
        </a>

        {# Labels section #}
        <div class="rail-hide pt-4 pb-1 px-3 flex items-center justify-between">
            <span class="text-xs font-semibold text-ink-faint uppercase tracking-wider">{{ 'sidebar.labels.heading'|trans }}</span>
            <button
                data-controller="ui--modal"
                data-action="click->ui--modal#open {{ _drawerClose }}"
                data-ui--modal-title-value="{{ 'sidebar.labels.add'|trans }}"
                data-ui--modal-src-value="{{ path('app_label_new') }}"
                class="p-1 rounded hover:bg-hover text-gray-400 hover:text-ink-soft transition-colors cursor-pointer"
                aria-label="{{ 'sidebar.labels.add'|trans }}"
            >
                <i class="fa-solid fa-plus w-3.5 h-3.5" aria-hidden="true"></i>
            </button>
        </div>

        <div id="{{ _drawerMode is defined and _drawerMode ? 'label-list-drawer' : 'label-list' }}" class="rail-hide space-y-0.5">
            {% set labelTree = sidebarCounts.userLabelTree() %}
            {% if labelTree|length == 0 %}
                <p class="px-3 py-1.5 text-xs text-ink-faint">{{ 'sidebar.labels.none'|trans }}</p>
            {% else %}
                {% for node in labelTree %}
                    {{ macros.label_node(node, 0, _drawerClose) }}
                {% endfor %}
            {% endif %}
        </div>

        {# Accounts section #}
        <div class="rail-hide pt-4 pb-1 px-3 flex items-center justify-between">
            <span class="text-xs font-semibold text-ink-faint uppercase tracking-wider">{{ 'sidebar.accounts.heading'|trans }}</span>
            <button
                data-controller="ui--modal"
                data-action="click->ui--modal#open {{ _drawerClose }}"
                data-ui--modal-title-value="{{ 'sidebar.accounts.add'|trans }}"
                data-ui--modal-src-value="{{ path('app_account_new') }}"
                class="p-1 rounded hover:bg-hover text-gray-400 hover:text-ink-soft transition-colors cursor-pointer"
                aria-label="{{ 'sidebar.accounts.add'|trans }}"
            >
                <i class="fa-solid fa-plus w-3.5 h-3.5" aria-hidden="true"></i>
            </button>
        </div>

        <div id="{{ _drawerMode is defined and _drawerMode ? 'account-list-drawer' : 'account-list' }}" class="rail-hide space-y-0.5">
            {% include '_partials/_account_list.html.twig' with { _drawerClose: _drawerClose } %}
        </div>

    </nav>
</aside>
