{#
The badge is always rendered — hidden at zero rather than omitted — so the
sidebar controller can patch its text in place after a Mercure sync without
having to re-render the markup. `key` must match a key from
app_mail_sidebar_counts.
#}
{% macro unread_badge(count, key) %}
    <span class="rail-hide text-xs font-semibold px-1.5 py-0.5 rounded-full bg-accent text-accent-ink{{ count > 0 ? '' : ' hidden' }}"
          data-ui--sidebar-target="badge"
          data-badge-kind="unread"
          aria-label="{{ 'sidebar.badge.unread'|trans({ '%count%': count }) }}"
          data-count-key="{{ key }}">{{ count }}</span>
{% endmacro %}

{#
The badge for a number that is a TOTAL rather than an unread count — Trash and
Drafts, see SidebarCounts::TOTAL_ROLES.

The rule is right: nobody triages a bin, and the useful number there is how much
is in it. What was wrong is that saying so relied on colour alone. Both numbers
were the same filled pill in the same place at the same size, one red and one a
faint grey, and a bare "5" in a pill is a bare "5" — the shape said "badge", not
"how many". Colour is also the one channel a person may not have.

So the two now differ in SHAPE as well as tone: unread is a filled round pill
(it is a call to action and looks like one), a total is an outlined rounded
rectangle that reads as a tally. And both carry an accessible name that says
which kind of number it is, because to a screen reader they were both the word
"five".
#}
{% macro total_badge(count, key) %}
    {# text-ink-SOFT, not muted. Muted is the caption ink and measured 3.07:1
       against the Solar sidebar at 12px — under half of what AA asks. The soft
       ink is 7.5:1 or better in every theme, and this is a number, not a
       caption: it is the content of the row's right-hand side. #}
    <span class="rail-hide text-xs font-medium tabular-nums px-1.5 py-0.5 rounded-md border border-line text-ink-soft{{ count > 0 ? '' : ' hidden' }}"
          data-ui--sidebar-target="badge"
          data-badge-kind="total"
          aria-label="{{ 'sidebar.badge.total'|trans({ '%count%': count }) }}"
          data-count-key="{{ key }}">{{ count }}</span>
{% endmacro %}

{% macro label_dot(color) %}
    <span class="w-2.5 h-2.5 rounded-full shrink-0
        {{ {
        'gray':   'bg-ink-faint',
        'red':    'bg-red-500',
        'orange': 'bg-orange-500',
        'amber':  'bg-amber-500',
        'green':  'bg-green-500',
        'teal':   'bg-teal-500',
        'blue':   'bg-blue-500',
        'violet': 'bg-violet-500',
        'pink':   'bg-pink-500',
    }[color ?? 'gray'] ?? 'bg-ink-faint' }}"
          aria-hidden="true"></span>
{% endmacro %}

{#
Takes a Label directly — labels are user-scoped, so there is no per-account
merging left to do and no view model between the entity and the template.
#}
{#
Opens the edit modal for a label. Sits outside the row's <a> rather than
inside it — a button nested in an anchor is invalid HTML — and inside <summary>
it relies on ui--modal#open calling preventDefault(), which also stops the
disclosure toggling.

Hover-revealed, but focus-visible brings it back for keyboard users, and it
keeps its accessible name either way.
#}
{% macro label_edit(label) %}
    <button
        data-controller="ui--modal"
        data-action="click->ui--modal#open"
        data-ui--modal-title-value="{{ 'label.form.edit_title'|trans }}"
        data-ui--modal-src-value="{{ path('app_label_edit', { id: label.id }) }}"
        class="shrink-0 w-5 h-5 flex items-center justify-center rounded
               text-ink-faint hover:text-ink hover:bg-hover
               opacity-0 group-hover/label:opacity-100 focus-visible:opacity-100
               transition-opacity cursor-pointer"
        aria-label="{{ 'settings.labels.edit'|trans({ '%name%': label|label_name }) }}"
    >
        <i class="fa-solid fa-pen text-[9px]" aria-hidden="true"></i>
    </button>
{% endmacro %}

{% macro label_node(label, depth, drawerClose) %}
    {% import _self as macros %}
    {% set children = sidebarCounts.visibleChildrenOf(label) %}

    {% if children|length > 0 %}
        {# Keyed by full name, in the same stored set as the two section
           headings — one key space, one endpoint, one handler, so a nested
           label and the section it lives in cannot end up behaving
           differently.

           `open` now comes from the server rather than from localStorage
           applied on connect. That is a fix, not just a move: restoring it
           after the first paint meant a collapsed tree was rendered open and
           then shut on every navigation, and the state was stuck to one
           browser. #}
        {% set _treeKey = 'label:' ~ label.fullName %}
        <details class="group/tree"
                 data-collapse-key="{{ _treeKey }}"
                 data-action="toggle->ui--sidebar#rememberCollapse"
                 {{ sidebarCounts.isCollapsed(_treeKey) ? '' : 'open' }}>
            <summary class="nav-item group/label flex items-center gap-1 py-1.5 cursor-pointer list-none
                            transition-colors"
                     aria-expanded="{{ sidebarCounts.isCollapsed(_treeKey) ? 'false' : 'true' }}"
                     data-ui--sidebar-target="collapseSummary"
                     style="--label-depth: {{ depth * 14 }}px">
                <i class="fa-solid fa-chevron-right text-[9px] text-ink-faint w-3
                          transition-transform group-open/tree:rotate-90" aria-hidden="true"></i>
                {{ macros.label_dot(label.color) }}
                <a href="{{ path('app_mail_label_path', { path: label.fullName }) }}"
                   class="flex-1 flex items-center justify-between gap-2 truncate"
                   data-ui--sidebar-target="link"
                   data-action="{{ drawerClose }}">
                    {# The dot travels with the NAME rather than being a third
                       child of this justify-between row, which would have
                       stranded it in the middle of the gap. The row reads
                       "what it is · something arrived — how much is unread".
                       The label's own colour dot on the far left is identity,
                       not status, which is why this cannot be folded into it. #}
                    <span class="min-w-0 flex items-center gap-1.5">
                        <span class="truncate">{{ label|label_name }}</span>
                        {{ macros.label_new_dot(label) }}
                    </span>
                    {{ macros.unread_badge(sidebarCounts.forLabel(label), 'label:' ~ label.id) }}
                </a>
                {{ macros.label_edit(label) }}
            </summary>
            <div class="space-y-0.5">
                {% for child in children %}
                    {{ macros.label_node(child, depth + 1, drawerClose) }}
                {% endfor %}
            </div>
        </details>
    {% else %}
        <div class="nav-item group/label flex items-center gap-2 py-1.5 transition-colors"
             style="--label-depth: {{ depth * 14 + 16 }}px">
            {{ macros.label_dot(label.color) }}
            <a href="{{ path('app_mail_label_path', { path: label.fullName }) }}"
               class="flex-1 flex items-center justify-between gap-2 truncate min-w-0"
               data-ui--sidebar-target="link"
               data-action="{{ drawerClose }}">
                <span class="truncate">{{ label|label_name }}</span>
                {{ macros.unread_badge(sidebarCounts.forLabel(label), 'label:' ~ label.id) }}
            </a>
            {{ macros.label_edit(label) }}
        </div>
    {% endif %}
{% endmacro %}

{#
A nav row's "something arrived here" dot.

Wrapped rather than calling the shared macro at each of the eight rows, because
the thing that must not drift is the KEY: it has to be the same string the
counts endpoint emits, and one spelling is easier to keep true than eight. See
App\Twig\NewMailMarkers::roleKey() and ::labelKey(), which build the other half.

`newMail` is a Twig global, and globals are the one thing a macro can still see
— which is also how label_node above reaches sidebarCounts.
#}
{% macro role_dot(role) %}
    {% import '_partials/_new_dot.html.twig' as shared %}
    {{ shared.new_dot(newMail.forRole(role), 'new:role:' ~ role.value, ('sidebar.nav.' ~ role.value)|trans) }}
{% endmacro %}

{% macro label_new_dot(label) %}
    {% import '_partials/_new_dot.html.twig' as shared %}
    {{ shared.new_dot(newMail.forLabel(label), 'new:label:' ~ label.id, label|label_name) }}
{% endmacro %}

{% macro starred_new_dot() %}
    {% import '_partials/_new_dot.html.twig' as shared %}
    {{ shared.new_dot(newMail.forStarred(), 'new:starred', 'sidebar.nav.starred'|trans) }}
{% endmacro %}

{% import _self as macros %}

{#
_drawerMode is set to true when this sidebar is rendered inside the mobile drawer.
When true, nav links also dispatch a close action to the parent sidebar-drawer controller.
#}
{% set _drawerClose = _drawerMode is defined and _drawerMode ? 'click->ui--sidebar-drawer#close' : '' %}

{#
`shell-chrome` marks this as shell furniture rather than content, so a Layout
can restyle it (see .layout-flat in app.css). The drawer copy is deliberately
excluded: it floats over a dim backdrop and must stay an opaque card whatever
the layout.
#}
{#
Deliberately NOT data-turbo-permanent. Carrying the element across visits kept
it from moving, but it also froze what it says: after a data reset the deleted
labels stayed in the nav, linking to 404s, and a label created or renamed
anywhere else stayed invisible until a full reload. It re-renders per visit
now, and the two things anyone would notice moving are restored by the
controller instead — the scroll position and which trees are open.
#}
<aside id="{{ _drawerMode is defined and _drawerMode ? 'sidebar-drawer-inner' : 'sidebar' }}"
       data-controller="ui--sidebar"
       data-ui--sidebar-counts-url-value="{{ path('app_mail_sidebar_counts') }}"
       data-ui--sidebar-collapse-url-value="{{ path('app_mail_sidebar_section_collapsed') }}"
       {# The badge names are patched on every sync alongside the numbers, so
          the strings have to reach the controller rather than being written in
          it. One JSON value, the way every other controller here takes them. #}
       data-ui--sidebar-i18n-value="{{ {
           unread: 'sidebar.badge.unread'|trans({ '%count%': '%count%' }),
           total:  'sidebar.badge.total'|trans({ '%count%': '%count%' }),
       }|json_encode }}"
       class="flex flex-col w-56 h-full flex-shrink-0 overflow-hidden pane
              transition-[width] duration-200
              {{ _drawerMode is defined and _drawerMode ? '' : 'shell-chrome' }}">

    {# Compose #}
    <div class="compose-wrap px-3 py-3 border-b border-line">
        <a href="{{ path('app_compose_new') }}"
           data-turbo-frame="compose_dock"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.compose'|trans }}"
           class="compose-link w-full flex items-center justify-center gap-2 bg-accent hover:bg-accent-strong text-accent-ink text-sm font-medium rounded-lg px-3 py-row transition-colors">
            <i class="fa-solid fa-plus w-4 h-4" aria-hidden="true"></i>
            <span class="rail-hide">{{ 'sidebar.compose'|trans }}</span>
        </a>
    </div>

    {# Nav #}
    <nav class="flex-1 overflow-y-auto px-2 py-2 space-y-0.5 text-sm"
         data-ui--sidebar-target="scroller"
         data-action="scroll->ui--sidebar#rememberScroll">

        <a href="{{ path('app_mail_inbox') }}"
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.inbox'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-inbox w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.inbox'|trans }}</span>
                {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Inbox) }}
            </span>
            {{ macros.unread_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Inbox), 'role:inbox') }}
        </a>

        <a href="{{ path('app_mail_starred') }}"
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.starred'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-star w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.starred'|trans }}</span>
                {{ macros.starred_new_dot() }}
            </span>
            {{ macros.unread_badge(sidebarCounts.forStarred(), 'starred') }}
        </a>

        <a href="{{ path('app_mail_sent') }}"
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.sent'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-paper-plane w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.sent'|trans }}</span>
                {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Sent) }}
            </span>
            {{ macros.unread_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Sent), 'role:sent') }}
        </a>

        <a href="{{ path('app_mail_drafts') }}"
           class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.drafts'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-file-lines w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.drafts'|trans }}</span>
                {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Drafts) }}
            </span>
            {{ macros.total_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Drafts), 'role:drafts') }}
        </a>

        {# Drawer only. On a wide screen the calendar is a panel that slides in
           beside the mail, and a control for that is not a destination — as a
           nav row it read as a link that did not navigate. It lives in the
           topbar there instead. Below lg there is nowhere to dock it, so this
           is a plain link to the page like any other row here. #}
        {% if _drawerMode is defined and _drawerMode %}
            <a href="{{ path('app_calendar_index') }}"
               class="nav-item flex items-center justify-between gap-2 px-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.calendar'|trans }}"
            >
                <span class="flex items-center gap-2">
                    <i class="fa-regular fa-calendar w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.calendar'|trans }}</span>
                </span>
            </a>
        {% endif %}
        {# Snoozed and Archive live behind a disclosure: both are real
           destinations, and neither is somewhere you go often enough to
           spend a permanent row on. Archive in particular had no entry at
           all unless its label had been switched visible in settings —
           the route existed and nothing linked to it.

           <details> rather than a controller: the open/closed state is
           exactly what the element is for, and it keeps working before any
           JavaScript has run.

           `open` when you are already on one of the pages inside it, and that
           is a bug fix rather than a nicety. The sidebar is deliberately not
           data-turbo-permanent, so every navigation re-renders it from
           scratch and the disclosure came back shut — click More, click
           Archive, and the menu snapped closed with the row you had just
           chosen hidden behind it again. It read as "the menu collapsed
           instead of doing anything". Decided here rather than remembered in
           localStorage like the label trees, because the honest answer to
           "should this be open?" is "are you in it?", and the server already
           knows. #}
        {% set _moreRoutes = ['app_mail_snoozed', 'app_mail_archive', 'app_mail_spam', 'app_mail_trash'] %}
        <details class="rail-hide group/more" {{ app.request.attributes.get('_route') in _moreRoutes ? 'open' : '' }}>
            <summary class="nav-item flex items-center gap-2 px-3 py-2 rounded-lg cursor-pointer list-none transition-colors text-ink-muted">
                {# transition-transform was here from the start, but nothing ever
                   set the open-state transform — the chevron had an animation
                   and no destination. group-open is the same recipe the label
                   tree uses. #}
                <i class="fa-solid fa-chevron-right w-4 text-xs transition-transform group-open/more:rotate-90" aria-hidden="true"></i>
                <span>{{ 'sidebar.nav.more'|trans }}</span>
            </summary>
        {% if sidebarCounts.hasSnoozed %}
            <a href="{{ path('app_mail_snoozed') }}"
               class="nav-item flex items-center justify-between gap-2 pl-9 pr-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.snoozed'|trans }}">
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-clock w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.snoozed'|trans }}</span>
                    {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Snoozed) }}
                </span>
                {{ macros.unread_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Snoozed), 'role:snoozed') }}
            </a>
        {% endif %}
            <a href="{{ path('app_mail_archive') }}"
               class="nav-item flex items-center justify-between gap-2 pl-9 pr-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.archive'|trans }}">
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-box-archive w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.archive'|trans }}</span>
                    {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Archive) }}
                </span>
                {{ macros.unread_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Archive), 'role:archive') }}
            </a>

        {# Behind the same eye toggle in label settings that Archive is behind,
           and for the same reason: plenty of installs have no junk folder
           worth a permanent row. It had no row at ALL before — no entry, no
           route, no translation key — so switching Spam visible in settings
           did nothing observable anywhere. Sits above Trash because that is
           where LabelRole::sortOrder() already put it. #}
        {% if sidebarCounts.hasVisibleRole(enum('App\\Domain\\Enum\\Mail\\LabelRole').Spam) %}
            <a href="{{ path('app_mail_spam') }}"
               class="nav-item flex items-center justify-between gap-2 pl-9 pr-3 py-2 rounded-lg transition-colors"
               data-ui--sidebar-target="link"
               data-action="{{ _drawerClose }}"
               title="{{ 'sidebar.nav.spam'|trans }}"
            >
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-ban w-4" aria-hidden="true"></i>
                    <span class="rail-hide">{{ 'sidebar.nav.spam'|trans }}</span>
                    {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Spam) }}
                </span>
                {{ macros.unread_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Spam), 'role:spam') }}
            </a>
        {% endif %}

        <a href="{{ path('app_mail_trash') }}"
           class="nav-item flex items-center justify-between gap-2 pl-9 pr-3 py-2 rounded-lg transition-colors"
           data-ui--sidebar-target="link"
           data-action="{{ _drawerClose }}"
           title="{{ 'sidebar.nav.trash'|trans }}"
        >
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-trash w-4" aria-hidden="true"></i>
                <span class="rail-hide">{{ 'sidebar.nav.trash'|trans }}</span>
                {{ macros.role_dot(enum('App\\Domain\\Enum\\Mail\\LabelRole').Trash) }}
            </span>
            {{ macros.total_badge(sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Trash), 'role:trash') }}
        </a>
        </details>

        {# ── Labels section ────────────────────────────────────────────────

           A <details>, which is what the "More" block above already is, and
           deliberately the same element rather than a second collapsing
           mechanism beside it: the chevron recipe, the summary.nav-item shape,
           Enter/Space activation, the accessible name and the expanded state a
           screen reader reads out are then all the ones this file already has,
           and none of them are re-implemented.

           What differs from More is only where "should this be open?" comes
           from. More asks the ROUTE — the honest answer there is "are you in
           it?". Here the honest answer is "how did you leave it", so it comes
           from the user's settings bag, and it is rendered into `open` on the
           server. That is the whole point of storing it per user rather than in
           localStorage: the sidebar re-renders on every visit, and a section
           collapsed by JavaScript after the first paint is a section the user
           watches snap shut on every single click.

           The section, rather than each label, is the unit — see the tree keys
           below, which remain for anyone who does nest. A wall of two dozen
           flat labels pushing the accounts off the bottom of the nav is the
           case this exists for, and per-label collapse does nothing for it. #}
        {% set _labelsCollapsed = sidebarCounts.isCollapsed(constant('App\\Entity\\User\\User::SIDEBAR_SECTION_LABELS')) %}
        <details class="rail-hide group/labels"
                 data-action="toggle->ui--sidebar#rememberCollapse"
                 data-collapse-key="{{ constant('App\\Entity\\User\\User::SIDEBAR_SECTION_LABELS') }}"
                 {{ _labelsCollapsed ? '' : 'open' }}>
            {# Named explicitly, because a summary takes its accessible name
               from its contents and this one contains a roll-up badge and the
               "Create label" button — unnamed, it read as "Labels 3 unread
               Create label". The same string as the visible heading, so a
               voice user asking for "Labels" still gets this. #}
            <summary class="pt-4 pb-1 px-3 flex items-center gap-2 cursor-pointer list-none rounded-lg transition-colors hover:bg-hover"
                     aria-label="{{ 'sidebar.labels.heading'|trans }}"
                     aria-expanded="{{ _labelsCollapsed ? 'false' : 'true' }}"
                     data-ui--sidebar-target="collapseSummary">
                <i class="fa-solid fa-chevron-right w-3 text-[9px] text-ink-faint transition-transform group-open/labels:rotate-90" aria-hidden="true"></i>
                <span class="flex-1 text-xs font-semibold text-ink-faint uppercase tracking-wider">{{ 'sidebar.labels.heading'|trans }}</span>

                {# The section's own number, and ONLY while it is shut. Open,
                   the per-label badges under it say it better and this would
                   be the same mail counted twice on screen — so the disclosure
                   hides it, via the group-open variant rather than by the
                   controller, which owns the plain `hidden` class and toggles
                   it purely on whether the count is zero. The two never fight:
                   both resolve to display:none, and they answer different
                   questions.

                   Rendered whether or not it is visible, so refreshCounts()
                   patches it by data-count-key like every other badge — a
                   collapsed section that stopped being patched would show a
                   number from three syncs ago the moment it was reopened. #}
                <span class="group-open/labels:hidden">{{ macros.unread_badge(sidebarCounts.unreadInLabels(), 'labels:unread') }}</span>

                <button
                    data-controller="ui--modal"
                    data-action="click->ui--modal#open {{ _drawerClose }}"
                    data-ui--modal-title-value="{{ 'sidebar.labels.add'|trans }}"
                    data-ui--modal-src-value="{{ path('app_label_new') }}"
                    class="p-1 rounded hover:bg-hover text-gray-400 hover:text-ink-soft transition-colors cursor-pointer"
                    aria-label="{{ 'sidebar.labels.add'|trans }}"
                >
                    <i class="fa-solid fa-plus w-3.5 h-3.5" aria-hidden="true"></i>
                </button>
            </summary>

            <div id="{{ _drawerMode is defined and _drawerMode ? 'label-list-drawer' : 'label-list' }}" class="space-y-0.5">
                {% set labelTree = sidebarCounts.userLabelTree() %}
                {% if labelTree|length == 0 %}
                    <p class="px-3 py-1.5 text-xs text-ink-faint">{{ 'sidebar.labels.none'|trans }}</p>
                {% else %}
                    {% for node in labelTree %}
                        {{ macros.label_node(node, 0, _drawerClose) }}
                    {% endfor %}
                {% endif %}
            </div>
        </details>

        {# ── Accounts section ──────────────────────────────────────────────

           The same disclosure, for the same reason and out of the same stored
           set. It does NOT replace or duplicate SETTING_SIDEBAR_ACCOUNT, which
           answers a different question: that one is *which* account is
           expanded, this one is whether the accounts are on screen at all.
           Collapsing takes the expanded account's folder list down with it and
           expanding brings the same account back still open, because neither
           setting is written when the other changes.

           No roll-up badge here, unlike LABELS, and not for symmetry's sake:
           there is no honest single number. Account rows count within one
           account, and only the expanded one's folders are ever loaded, so a
           heading total would either be a sum over lists that are not on the
           page or a count that silently means "the one account you happened to
           have open". #}
        {% set _accountsCollapsed = sidebarCounts.isCollapsed(constant('App\\Entity\\User\\User::SIDEBAR_SECTION_ACCOUNTS')) %}
        <details class="rail-hide group/accounts"
                 data-action="toggle->ui--sidebar#rememberCollapse"
                 data-collapse-key="{{ constant('App\\Entity\\User\\User::SIDEBAR_SECTION_ACCOUNTS') }}"
                 {{ _accountsCollapsed ? '' : 'open' }}>
            <summary class="pt-4 pb-1 px-3 flex items-center gap-2 cursor-pointer list-none rounded-lg transition-colors hover:bg-hover"
                     aria-label="{{ 'sidebar.accounts.heading'|trans }}"
                     aria-expanded="{{ _accountsCollapsed ? 'false' : 'true' }}"
                     data-ui--sidebar-target="collapseSummary">
                <i class="fa-solid fa-chevron-right w-3 text-[9px] text-ink-faint transition-transform group-open/accounts:rotate-90" aria-hidden="true"></i>
                <span class="flex-1 text-xs font-semibold text-ink-faint uppercase tracking-wider">{{ 'sidebar.accounts.heading'|trans }}</span>
                <button
                    data-controller="ui--modal"
                    data-action="click->ui--modal#open {{ _drawerClose }}"
                    data-ui--modal-title-value="{{ 'sidebar.accounts.add'|trans }}"
                    data-ui--modal-src-value="{{ path('app_account_new') }}"
                    class="p-1 rounded hover:bg-hover text-gray-400 hover:text-ink-soft transition-colors cursor-pointer"
                    aria-label="{{ 'sidebar.accounts.add'|trans }}"
                >
                    <i class="fa-solid fa-plus w-3.5 h-3.5" aria-hidden="true"></i>
                </button>
            </summary>

            <div id="{{ _drawerMode is defined and _drawerMode ? 'account-list-drawer' : 'account-list' }}" class="space-y-0.5">
                {# The same suffix the list containers either side of this use. Both
                   sidebars render this partial on every page, so without it each
                   account's folder frame and expand toggle existed twice under one
                   id — invalid HTML, and Turbo resolves a frame target BY id, so
                   the drawer and the desktop rail were one bad guess apart from
                   swapping folder lists. #}
                {% include '_partials/_account_list.html.twig' with {
                    _drawerClose: _drawerClose,
                    _idSuffix: _drawerMode is defined and _drawerMode ? '-drawer' : '',
                } %}
            </div>
        </details>

    </nav>
</aside>
