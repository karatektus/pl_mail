{#
_partials/_sidebar_clock.html.twig — the day at a glance in a sidebar: the
time, the date, and the next thing coming up, which opens the same Happening
Soon panel the topbar button does. Hidden in the rail, which has no width for
any of it.

Drawn by a sidebar of the user's own wherever they put its Clock row (#783),
and by the Mail sidebar, pinned under its nav, for somebody whose clock was
placed there before the clock became a row (ClockPlacement::Sidebar).

Accepts:
  _drawerClose  the drawer's close action, or ''
#}
{% set _drawerClose = _drawerClose ?? '' %}
    {% import '_partials/_clock.html.twig' as clockui %}
    {% set soonest = calendar.soonest %}
    <div class="rail-hide shrink-0 px-2 pb-2">
        <div {{ clockui.attrs() }}
             data-clock-placement="sidebar"
             class="flex flex-col gap-2 rounded-pane border border-line bg-surface/60 px-3.5 py-3">
            <div class="flex items-baseline gap-1.5 tabular-nums">
                <span data-ui--clock-target="bare"
                      class="text-3xl font-semibold tracking-tight leading-none text-ink">{{ clockui.bare() }}</span>
                {% if clock.is12Hour %}
                    <span data-ui--clock-target="meridiem" class="text-sm text-ink-faint">{{ clockui.meridiem() }}</span>
                {% endif %}
            </div>
            <div class="-mt-1 text-xs text-ink-muted">{{ clockui.longDate() }}</div>

            {% if soonest %}
                {# data-sidebar-peek-own: a clipped title leans the
                   sidebar out only while this button is hovered or
                   focused, not whenever the pointer is over the sidebar
                   (see "The peek" in app.css). #}
                <button type="button"
                        data-sidebar-peek-own
                        data-controller="ui--modal"
                        data-action="click->ui--modal#open {{ _drawerClose }}"
                        data-ui--modal-src-value="{{ path('app_calendar_soon') }}"
                        data-ui--modal-title-value="{{ 'calendar.soon.title'|trans }}"
                        data-ui--modal-size-value="wide"
                        class="flex min-w-0 items-start gap-2 rounded-lg bg-sunken px-2.5 py-1.5 text-left
                               hover:bg-hover transition-colors cursor-pointer
                               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                    <i class="{{ soonest.icon }} mt-0.5 text-xs text-ink-faint" aria-hidden="true"></i>
                    {# Both lines truncate, never wrap: the button is the
                       peek's hover target, and its box must be the same
                       shape out as in. A date line that wrapped narrow
                       and not wide made the button 16px shorter once the
                       peek was out, its top moved down from under a
                       pointer resting there, the peek closed, the line
                       wrapped again — and the sidebar flickered for as
                       long as the pointer stayed. #}
                    <span class="flex min-w-0 flex-col">
                        {# The day relative to today, the ladder the insights
                           pane uses (insight/_pane.html.twig): Today,
                           Tomorrow, a weekday within the week, then the
                           date. "Next · Tue, Nov 24, 10:00 am" was 150px in
                           a 136px line at the default width, and cutting
                           "am" to "…" saves nothing; this fits, in every
                           catalogue, down to a sidebar of about 205px.
                           Below that the truncate takes over and the peek
                           shows the rest. "Next" is still read out, just
                           not drawn: the card says it already.

                           An all-day event's start is a floating date, so
                           its day is read without moving it into a zone
                           (`false`), as the date itself always was. #}
                        {% set _tz      = soonest.event.isAllDay ? false : null %}
                        {% set _day     = soonest.startsAt|date('Y-m-d', _tz) %}
                        {% set _today   = 'now'|date('Y-m-d') %}
                        <span class="truncate text-[11px] text-ink-faint"><span class="sr-only">{{ 'calendar.soon.next'|trans }} · </span>
                            {%- if _day == _today -%}
                                {{ 'insights.pane.when.today'|trans }}
                            {%- elseif _day == 'now'|date_modify('+1 day')|date('Y-m-d') -%}
                                {{ 'insights.pane.when.tomorrow'|trans }}
                            {%- elseif _day <= 'now'|date_modify('+6 days')|date('Y-m-d') -%}
                                {{ soonest.startsAt|intl_date('EEE', _tz) }}
                            {%- else -%}
                                {{ soonest.startsAt|intl_date('dMMM', _tz) }}
                            {%- endif -%}
                            {%- if not soonest.event.isAllDay %} · {{ soonest.startsAt|date(clock.time) }}{% endif -%}
                        </span>
                        <span class="truncate text-xs font-medium text-ink">
                            {{- soonest.event.title ?: 'calendar.soon.untitled'|trans -}}
                        </span>
                    </span>
                </button>
            {% endif %}
        </div>
    </div>
