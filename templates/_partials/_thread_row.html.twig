{#
Renders one row in the message list.

Accepts either a MessageThread (`thread`) or a Message (`message`);
everything below normalises onto the same set of variables so the markup
is shared.

Draft handling: a row opens the compose dock instead of the reading pane
only when the row IS the draft — i.e. a thread holding a single draft
message, or a bare Message row flagged as a draft. A real conversation
carrying an unsent reply still opens the thread; that draft is edited from
inside the reading pane.

`draft_scope` (the Drafts list) overrides that: every row there is listed
because of its draft, so it opens that draft even when the thread also holds
the conversation it answers.
#}
{% set draft_scope = draft_scope|default(false) %}
{% set item = thread ?? message %}
{% set isThread = item.messages is defined %}

{% if isThread %}
    {% set type = 'thread' %}
    {% set unread = item.unreadCount > 0 %}
    {% set subject = item.subject ?: ('thread_row.no_subject'|trans) %}
    {% set starred = item.starredAt is not null %}
    {% set date = item.lastMessageAt %}
    {% set count = item.messageCount %}

    {% set latest = item.messages|last %}
    {# Everyone who has written in the conversation, oldest first — not the
       newest sender, which made every thread you had answered look like it
       came from you. #}
    {% set sender = thread_participants(item)|join(', ') %}
    {% set snippet = latest ? (latest.bodyText ?? '')|striptags|slice(0, 100) : '' %}

    {# `latest` comes from |last, which yields FALSE (not null) on an empty
       collection — so `is not null` passes and .isDraft blows up on a bool.
       A thread can legitimately end up with no messages (every message
       expunged provider-side), and this row is rendered for the whole inbox,
       so one such thread would 500 the entire list. #}
    {# Not `latest`: the collection is not ordered by date, so the draft is
       looked up by flag rather than assumed to be the last message. #}
    {% set draftMessage = item.messages|filter(m => m.isDraft)|last %}
    {% set draft = draftMessage
        and (draft_scope or item.messageCount == 1) %}
    {% set draftId = draft ? draftMessage.id : null %}

    {% set hasAttachment = item.attachmentCount > 0 %}
    {% set senderSeed = latest ? (latest.fromAddress ?: sender) : sender %}

    {% set href = path('app_mail_thread', { id: item.id }) %}
    {% set rowId = item.id %}
{% else %}
    {% set type = 'message' %}
    {% set unread = item.seenAt is null %}
    {% set subject = item.subject ?: ('thread_row.no_subject'|trans) %}
    {% set starred = item.starredAt is not null %}
    {% set date = item.receivedAt %}
    {% set count = 1 %}
    {% set sender = item.fromName ?: item.fromAddress %}
    {% set senderSeed = item.fromAddress ?: sender %}
    {% set snippet = (item.bodyText ?? '')|striptags|slice(0, 100) %}

    {% set hasAttachment = item.hasAttachments %}

    {% set draft = item.isDraft %}
    {% set draftId = item.id %}

    {% set href = path('app_mail_message', { id: item.id }) %}
    {% set rowId = item.id %}
{% endif %}

<li
    id="thread_{{ rowId }}"
    class="group relative hover:shadow-sm"
    data-controller="mail--message-row"
    data-mail--message-row-id-value="{{ rowId }}"
    data-unread="{{ unread ? 'true' : 'false' }}"
    data-starred="{{ starred ? 'true' : 'false' }}"
>
    {# Full-row clickable overlay #}
<a
    {% if false == draft %}
        href="{{ href }}"
        data-action="click->mail--mail-pane#open"
    {% else %}
        href="{{ path('app_compose_edit', { id: draftId }) }}"
        data-turbo-frame="compose_dock"
    {% endif %}
    data-turbo-prefetch="false"
    class="pointer-events-auto absolute inset-0 z-0"
    aria-label="{{ subject }}"
    tabindex="-1"
    ></a>

    <div
        class="pointer-events-auto flex items-center @xl:items-center gap-3 pl-3 pr-4 py-2.5 cursor-pointer transition-colors
            {{ unread ? 'bg-white/40 dark:bg-white/[0.03]' : 'bg-transparent' }}
            hover:bg-white/60 dark:hover:bg-white/[0.06]"
    >
        {# Avatar, doubling as the row's checkbox.
           The real input is still here and still named the same — the toolbar's
           select-all and every bulk action read [data-thread-select], and none
           of them should have to know the control became a circle. It is
           sr-only rather than removed so it stays focusable and keyboard
           users are not shut out; the avatar is its label, and `peer` drives
           the tick.

           Colour comes from the address and is never stored, so it is the same
           circle for the same person on every device — see
           SenderAvatarExtension. #}
        <label class="relative z-10 pointer-events-auto flex-shrink-0 cursor-pointer group/avatar">
            <input
                type="checkbox"
                data-action="change->mail--message-row#toggleSelect"
                data-thread-select value="{{ rowId }}"
                class="peer sr-only"
                aria-label="{{ 'thread_row.select'|trans({'%subject%': subject}) }}"
            >

            <span class="flex items-center justify-center rounded-full
                         w-9 h-9 text-sm font-semibold select-none
                         transition-opacity
                         peer-checked:opacity-0 group-hover/avatar:opacity-0
                         {{ senderSeed|avatar_tone }}"
                  aria-hidden="true">{{ sender|avatar_initial(senderSeed) }}</span>

            <span class="absolute inset-0 flex items-center justify-center rounded-full
                         bg-accent text-white
                         opacity-0 transition-opacity
                         peer-checked:opacity-100 group-hover/avatar:opacity-100
                         peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-1"
                  aria-hidden="true"><i class="fa-solid fa-check text-xs"></i></span>
        </label>

        {# Star — wide layout only; the stacked one lives in the meta column
           on the right, beside the time. #}
        <button
            type="button"
            data-action="click->mail--message-row#toggleStar"
            data-mail--message-row-star-url-param="{{ path('app_status_star', {'type': type, 'id': rowId}) }}"
            class="hidden @xl:block z-10 pointer-events-auto cursor-pointer flex-shrink-0 text-ink-faint hover:text-amber-400 transition-colors {{ starred ? '!text-amber-400' : '' }}"
            aria-label="{{ starred ? 'thread_row.unstar'|trans : 'thread_row.star'|trans }}"
        >
            <i class="fa-{{ starred ? 'solid' : 'regular' }} fa-star text-[18px]"></i>
        </button>

        {# Content — one line when the list is wide, three when it is not #}
        <div class="flex-1 min-w-0 flex flex-col @xl:flex-row @xl:items-center @xl:gap-4">

            {# Row 1 (stacked) / sender column (wide) #}
            <div class="flex items-center justify-between gap-2 @xl:justify-start @xl:w-40 @xl:flex-shrink-0">
                <span class="truncate text-sm {{ unread ? 'font-semibold text-ink' : 'font-normal text-ink-muted' }}">
                    {{ sender }}
                </span>
            </div>

            {# Rows 2 and 3 (stacked) / the rest of the line (wide).
               One structure for both: stacked it is subject, then labels and
               snippet beneath; wide the same three fall onto one line. #}
            <div class="min-w-0 flex-1 flex flex-col @xl:flex-row @xl:items-baseline @xl:gap-2">
                <span class="truncate text-sm @xl:flex-shrink-0 @xl:max-w-[45%]
                             {{ unread ? 'font-semibold text-ink' : 'font-normal text-ink-soft' }}">
                    {{ subject }}
                    {% if count > 1 %}
                        <span class="ml-1 text-xs font-medium text-ink-faint">{{ 'thread_row.message_count'|trans({'{ count }': count}) }}</span>
                    {% endif %}
                </span>

                <span class="min-w-0 flex-1 flex items-center gap-1.5 text-sm">
                    {% include '_partials/_thread_labels.html.twig' with { item: item } %}
                    <span class="truncate text-ink-faint">{{ snippet }}</span>
                </span>
            </div>
        </div>

        {# Meta column — stacked layout only.
           Mirrors the reference app: the time sits top-right and the row's
           three states hang under it. The star is duplicated rather than moved
           because the wide layout keeps it on the left, and only one of the two
           is ever rendered — display:none takes the other out of the
           accessibility tree, so a screen reader still finds exactly one. That
           is safe here because starring POSTs and the server re-renders the
           whole row; neither button holds state of its own. #}
        <div data-row-date="stacked"
             class="@xl:hidden flex flex-col items-end gap-1.5 shrink-0 ml-2 self-start pt-0.5">
            <span class="text-xs text-ink-faint whitespace-nowrap">
                {% if date %}
                    {% if date|date('Y-m-d') == 'now'|date('Y-m-d') %}
                        {{ date|date('g:i a') }}
                    {% elseif date|date('Y') == 'now'|date('Y') %}
                        {{ date|date('M j') }}
                    {% else %}
                        {{ date|date('M j Y') }}
                    {% endif %}
                {% endif %}
            </span>

            {# Attachment and star share a line, star outermost — it is the one
               you reach for, so it sits where the thumb already is, and the
               paperclip is a fact about the row rather than a control. #}
            <div class="flex items-center gap-2">
                {% if hasAttachment %}
                    <span class="text-ink-faint" title="{{ 'thread_row.has_attachment'|trans }}">
                        <i class="fa-solid fa-paperclip text-xs" aria-hidden="true"></i>
                        <span class="sr-only">{{ 'thread_row.has_attachment'|trans }}</span>
                    </span>
                {% endif %}

                <button
                    type="button"
                    data-action="click->mail--message-row#toggleStar"
                    data-mail--message-row-star-url-param="{{ path('app_status_star', {'type': type, 'id': rowId}) }}"
                    class="z-10 pointer-events-auto cursor-pointer text-ink-faint hover:text-amber-400 transition-colors {{ starred ? '!text-amber-400' : '' }}"
                    aria-label="{{ starred ? 'thread_row.unstar'|trans : 'thread_row.star'|trans }}"
                >
                    <i class="fa-{{ starred ? 'solid' : 'regular' }} fa-star text-sm"></i>
                </button>
            </div>

            {# Unread, as a dot, on its own line. The bold text says it too, but
               a dot is what you count down a column without reading anything. #}
            {% if unread %}
                <span class="w-2 h-2 rounded-full bg-success" aria-hidden="true"></span>
                <span class="sr-only">{{ 'thread_row.unread'|trans|default('Unread') }}</span>
            {% endif %}
        </div>

        {# Date + hover actions slot — desktop only #}
        <div data-row-date="inline"
             class="hidden @xl:flex flex-shrink-0 w-36 relative h-full items-center">

            <span class="absolute inset-0 flex items-center justify-end group-hover:invisible text-xs text-gray-400 dark:text-gray-600">
                                       {% if hasAttachment %}
                                           <span class="flex-shrink-0 mr-2 text-gray-400 dark:text-gray-600"
                                                 title="{{ 'thread_row.has_attachment'|trans }}">
                    <i class="fa-solid fa-paperclip text-[12px]" aria-hidden="true"></i>
                    <span class="sr-only">{{ 'thread_row.has_attachment'|trans }}</span>
                </span>
                                       {% endif %}
                {% if date %}
                    {% if date|date('Y-m-d') == 'now'|date('Y-m-d') %}
                        {{ date|date('g:i a') }}
                    {% elseif date|date('Y') == 'now'|date('Y') %}
                        {{ date|date('M j') }}
                    {% else %}
                        {{ date|date('M j Y') }}
                    {% endif %}
                {% endif %}
            </span>

            <div class="absolute inset-0 flex items-center justify-end invisible group-hover:visible pointer-events-auto gap-1">
                {% if false == draft %}
                    <button type="button" data-action="click->mail--message-row#archive"
                            data-mail--message-row-archive-url-param="{{ path('app_status_archive', {'type': type, 'id': rowId}) }}"
                            aria-label="{{ 'thread_row.actions.archive'|trans }}"
                            title="{{ 'thread_row.actions.archive'|trans }}"
                            class="z-10 p-1.5 cursor-pointer rounded-lg text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                        <i class="fa-solid fa-box-archive w-4 h-4" aria-hidden="true"></i>
                    </button>
                {% endif %}

                <button type="button" data-action="click->mail--message-row#trash"
                        data-mail--message-row-trash-url-param="{{ path('app_status_trash', {'type': type, 'id': rowId}) }}"
                        aria-label="{{ 'thread_row.actions.delete'|trans }}"
                        title="{{ 'thread_row.actions.delete'|trans }}"
                        class="z-10 p-1.5 cursor-pointer rounded-lg text-gray-400 hover:text-red-600 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                    <i class="fa-solid fa-trash w-4 h-4" aria-hidden="true"></i>
                </button>

                {% if false == draft %}
                    {# The button opens a menu rather than snoozing directly:
                       there is no defensible default wake time, and the one
                       this had (none at all) cleared the snooze instead of
                       setting it. #}
                    <div class="relative z-10" data-controller="ui--dropdown">
                        <button type="button"
                                data-action="click->ui--dropdown#toggle click->mail--message-row#stop"
                                aria-label="{{ 'thread_row.actions.snooze'|trans }}"
                                title="{{ 'thread_row.actions.snooze'|trans }}"
                                class="p-1.5 cursor-pointer rounded-lg text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                            <i class="fa-solid fa-clock w-4 h-4" aria-hidden="true"></i>
                        </button>

                        {% include '_partials/_snooze_menu.html.twig' with {
                            controller: 'mail--message-row',
                            method:     'snooze',
                            url:        path('app_status_snooze', {'type': type, 'id': rowId}),
                            snoozed:    thread is defined and thread.snoozed|default(false),
                        } only %}
                    </div>

                    <button type="button" data-action="click->mail--message-row#markRead"
                            data-mail--message-row-read-url-param="{{ path('app_status_mark_read', {'type': type, 'id': rowId}) }}"
                            data-mail--message-row-read-param="{{ true == unread ? 'true' : 'false' }}"
                            aria-label="{{ unread ? 'thread_row.actions.mark_read'|trans : 'thread_row.actions.mark_unread'|trans }}"
                            title="{{ unread ? 'thread_row.actions.mark_read'|trans : 'thread_row.actions.mark_unread'|trans }}"
                            class="z-10 p-1.5 cursor-pointer rounded-lg text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                        {% if unread %}
                            <i class="fa-solid fa-envelope w-4 h-4" aria-hidden="true"></i>
                        {% else %}
                            <i class="fa-solid fa-envelope-open w-4 h-4" aria-hidden="true"></i>
                        {% endif %}
                    </button>
                {% endif %}
            </div>
        </div>

    </div>
</li>
