{#
_modal_form.html.twig — the shell every form-bearing modal renders into.

Includable, or embeddable when a form needs prose or a copyable value beside its
fields. The blocks exist so those forms can add that content without
hand-drawing the body, footer and frame again — three of them had, which is how
the app ended up with four slightly different modal footers.
#}
{% set submit_label = submit_label ?? 'form.submit'|trans %}
{% set cancel_label = cancel_label ?? 'form.cancel'|trans %}
{% set danger       = danger ?? false %}
{# Merged rather than replaced, because form_start() takes `attr` whole: a
   caller that needs one more attribute — data-ui--modal-keep-open, for a form
   whose success is a step rather than a completion — would otherwise have to
   redraw the frame, the form tag and the footer to add it. #}
{% set form_attr    = form_attr ?? {} %}

<turbo-frame id="modal">
    <template data-ui--modal-frame-title>{{ title ?? '' }}</template>

    {{ form_start(form, {
        attr: {
            'data-turbo-frame': 'modal',
            class: 'flex-1 min-h-0 flex flex-col',
        }|merge(form_attr)
    }) }}

    {# ── Body ── #}
    <div class="flex-1 min-h-0 px-6 pb-6 space-y-7 overflow-y-auto">

        {# Global form errors #}
        {% if form.vars.errors|length %}
            <div
                role="alert"
                class="flex items-start gap-2.5 rounded-lg alert-danger px-3.5 py-3 text-sm text-danger"
            >
                <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0 text-danger" aria-hidden="true"></i>
                <div class="space-y-0.5">
                    {% for error in form.vars.errors %}
                        <p class="leading-snug">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {% block before_fields %}{% endblock %}

        {{ form_widget(form) }}

        {% block after_fields %}{% endblock %}

    </div>

    {# ── Footer ── #}
    <div class="flex items-center justify-end gap-2 px-6 pb-6 pt-3 shrink-0">
        <button
            type="button"
            data-action="click->ui--modal#close"
            class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg text-sm font-medium
               text-ink-soft
               bg-field
               border border-field
               hover:bg-hover
               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-1
               transition-colors duration-100"
        >{{ cancel_label }}</button>

        <button
            type="submit"
            class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg text-sm font-medium text-accent-ink
               focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1
               transition-colors duration-100
               {% if danger %}
                 bg-red-600 hover:bg-red-700 active:bg-red-800 focus-visible:ring-red-500
               {% else %}
                 bg-accent hover:bg-accent-strong active:bg-blue-800 focus-visible:ring-accent
               {% endif %}"
        >{{ submit_label }}</button>
    </div>

    {{ form_end(form) }}
</turbo-frame>
