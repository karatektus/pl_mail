{% import '_partials/_card_chrome.html.twig' as chrome %}
{#
admin/push/_frame.html.twig — Admin → Push.

Accepts:
  config — App\Entity\Push\FcmConfig (unsaved when nothing was ever configured)
  form   — App\Form\Admin\FcmConfigType, bound to it
  saved  — true immediately after a successful save

The status line above the form is the part worth keeping. "A key is on file"
and "FCM is live" are different states and an admin has to be able to tell them
apart at a glance — a key stored with the toggle off is a deliberate pause,
whereas a toggle on with no key is the state the form refuses to save. The chip
reads the entity's own isActive(), which is the same method the Session
capability publishes as `fcm`, so what this page claims and what a client is
told cannot drift.

The service-account key itself is never rendered. The field is write-only and
its placeholder says only whether one exists.

No auto-refresh wraps this frame — it is configuration, not telemetry, and a
poll would empty a field mid-paste.
#}
<turbo-frame id="admin-push" class="block space-y-3">

    <div class="{{ chrome.shell() }}">

        <div class="flex items-center gap-2.5 {{ chrome.band() }}">
            <i class="fa-solid fa-fire text-xs text-zinc-400" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-ink">{{ 'admin.push.fcm.heading'|trans }}</h2>

            {% if config.isActive %}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
                    {{ 'admin.push.status.live'|trans }}
                </span>
            {% elseif config.hasServiceAccount and config.hasClientConfig %}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-faint">
                    {{ 'admin.push.status.key_only'|trans }}
                </span>
            {% elseif config.hasServiceAccount or config.hasClientConfig %}
                {# Half set up is its own state and has to be named. A server
                   holding only the sending half can push to devices that can
                   never register; only the client half and it is the reverse.
                   Neither is visible from anywhere else. #}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-500">
                    {{ 'admin.push.status.incomplete'|trans }}
                </span>
            {% else %}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-faint">
                    {{ 'admin.push.status.unconfigured'|trans }}
                </span>
            {% endif %}
        </div>

        <div class="{{ chrome.body() }} space-y-4">

            {% if saved %}
                <div role="status" class="flex items-start gap-2.5 rounded-lg bg-emerald-500/10 px-3.5 py-3 text-sm text-emerald-500">
                    <i class="fa-solid fa-circle-check mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ 'admin.push.fcm.saved'|trans }}</p>
                </div>
            {% endif %}

            <p class="text-sm text-ink-soft leading-relaxed">{{ 'admin.push.fcm.intro'|trans }}</p>

            {% if config.projectId is not null %}
                {# The one thing a stored key can safely say about itself. An
                   admin with two Firebase projects needs to know which one is
                   in force, and the project id is in every URL the sender
                   builds — it is not a secret. #}
                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-xs">
                    <dt class="text-ink-faint">{{ 'admin.push.fcm.project'|trans }}</dt>
                    <dd class="font-mono text-ink-soft break-all">{{ config.projectId }}</dd>
                    {% if config.clientEmail is not null %}
                        <dt class="text-ink-faint">{{ 'admin.push.fcm.client_email'|trans }}</dt>
                        <dd class="font-mono text-ink-soft break-all">{{ config.clientEmail }}</dd>
                    {% endif %}
                    {% if config.hasClientConfig %}
                        <dt class="text-ink-faint">{{ 'admin.push.fcm.application_id'|trans }}</dt>
                        <dd class="font-mono text-ink-soft break-all">{{ config.applicationId }}</dd>
                        <dt class="text-ink-faint">{{ 'admin.push.fcm.sender_id'|trans }}</dt>
                        <dd class="font-mono text-ink-soft break-all">{{ config.senderId }}</dd>
                        {% if config.androidPackage %}
                            {# Which client of a multi-app file won. Shown
                               because "the debug variant was registered first"
                               is otherwise indistinguishable from the app being
                               broken. #}
                            <dt class="text-ink-faint">{{ 'admin.push.fcm.android_package'|trans }}</dt>
                            <dd class="font-mono text-ink-soft break-all">{{ config.androidPackage }}</dd>
                        {% endif %}
                    {% endif %}
                </dl>
            {% endif %}

            {{ form_start(form, { attr: { 'data-turbo-frame': 'admin-push' } }) }}
                <div class="space-y-4">
                    {{ form_widget(form) }}

                    <div class="flex justify-end">
                        <button type="submit"
                                class="inline-flex items-center gap-2 h-9 px-4 rounded-lg text-sm font-medium
                                       text-accent-ink bg-accent hover:bg-accent-strong transition-colors cursor-pointer">
                            <i class="fa-solid fa-floppy-disk text-xs" aria-hidden="true"></i>
                            {{ 'admin.push.fcm.save'|trans }}
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    {# px-4, the house inset: this note sits outside the card and has to
       begin where the card's own content begins, not at its own figure. #}
    <p class="px-4 text-xs text-ink-faint leading-relaxed">
        <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
        {{ 'admin.push.webpush_note'|trans }}
    </p>

</turbo-frame>
