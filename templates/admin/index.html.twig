{% extends '_layout/app.html.twig' %}

{% block title %}{{ 'admin.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    {% set navActive = 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium bg-raised text-ink' %}
    {% set navInactive = 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-ink-muted hover:bg-hover transition-colors' %}

    <div class="h-screen overflow-hidden app-bg"
         data-controller="ui--sidebar-drawer">

        {# Mobile backdrop #}
        <div data-ui--sidebar-drawer-target="backdrop" data-action="click->ui--sidebar-drawer#backdropClick"
             class="md:hidden fixed inset-0 z-30 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
             aria-hidden="true"></div>

        {# Mobile sidebar drawer #}
        <div data-ui--sidebar-drawer-target="drawer"
             class="md:hidden fixed inset-y-0 left-0 z-40 w-64 p-3 -translate-x-full transition-transform duration-200 ease-out">
            {% include '_partials/_sidebar.html.twig' with { _drawerMode: true } %}
        </div>

        <div class="shell-frame flex h-full flex-col p-gutter gap-gutter">

            {% include '_partials/_topbar.html.twig' %}

            <div class="flex flex-1 gap-gutter overflow-hidden">

                {# Sidebar — desktop #}
                <div class="hidden md:flex">
                    {% include '_partials/_sidebar.html.twig' %}
                </div>

                {# Main content pane — admin dashboard #}
                <div class="flex flex-1 overflow-hidden main-pane">
                    <div class="flex flex-col flex-1 overflow-hidden">

                        {# Pane header #}
                        <div class="flex items-center gap-3 px-6 h-14 border-b border-line shrink-0">
                            <i class="fa-solid fa-gauge-high text-zinc-400" aria-hidden="true"></i>
                            <h1 class="text-base font-semibold text-ink">{{ 'admin.title'|trans }}</h1>

                            {# In the header rather than in a panel, so it is on
                               screen whichever admin section is open — the
                               question it answers ("is this the build I think
                               it is?") is asked while looking at something
                               else. Absent entirely on a checkout that was
                               never built from a tag, because a chip reading
                               "development" beside every page is furniture. #}
                            {% if app_version.isKnown %}
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-raised px-2 py-0.5 font-mono text-[11px] text-ink-muted"
                                      title="{{ 'admin.version.hint'|trans }}">
                                    {{ app_version.label }}
                                    {% if app_version.commit %}
                                        <span class="text-ink-faint">{{ app_version.commit }}</span>
                                    {% endif %}
                                </span>
                            {% endif %}

                            {% if section not in ['logs', 'integrations', 'push', 'backup', 'reset'] %}
                                <span class="ml-auto text-xs text-ink-faint">{{ 'admin.refresh_hint'|trans }}</span>
                            {% endif %}
                        </div>

                        {# Scrollable body: section nav + content.
                           Two grid children only — nav and ONE content wrapper.

                           A container, so the bleed below is decided by how wide
                           this pane actually is. Viewport width is the wrong
                           question and not even monotonic in it: at 768px the
                           mail sidebar appears and the section nav takes 180px,
                           leaving less room here than a 390px phone has. #}
                        <div class="flex-1 overflow-y-auto @container">
                            <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 px-6 py-6">

                                {# Section nav #}
                                <nav class="flex md:flex-col gap-1 flex-wrap">
                                    <a href="{{ path('app_admin_dashboard', { section: 'system' }) }}"
                                       class="{{ section == 'system' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-heart-pulse w-4 {{ section == 'system' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.system'|trans }}
                                    </a>
                                    <a href="{{ path('app_admin_dashboard', { section: 'database' }) }}"
                                       class="{{ section == 'database' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-database w-4 {{ section == 'database' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.database'|trans }}
                                    </a>
                                    <a href="{{ path('app_admin_dashboard', { section: 'logs' }) }}"
                                       class="{{ section == 'logs' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-scroll w-4 {{ section == 'logs' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.logs'|trans }}
                                    </a>
                                    <a href="{{ path('app_admin_dashboard', { section: 'integrations' }) }}"
                                       class="{{ section == 'integrations' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-plug w-4 {{ section == 'integrations' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.integrations'|trans }}
                                    </a>
                                    {# After integrations, because it is the same
                                       kind of thing — a credential pasted out of
                                       somebody's console — and before users, which
                                       is where an admin goes for a different reason. #}
                                    <a href="{{ path('app_admin_dashboard', { section: 'push' }) }}"
                                       class="{{ section == 'push' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-bell w-4 {{ section == 'push' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.push'|trans }}
                                    </a>
                                    <a href="{{ path('app_admin_dashboard', { section: 'users' }) }}"
                                       class="{{ section == 'users' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-users w-4 {{ section == 'users' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.users'|trans }}
                                    </a>
                                    {# After users and before reset. It is the
                                       only entry that is about the install as a
                                       whole rather than a part of it, and it
                                       belongs beside the other irreversible
                                       thing rather than among the panels an
                                       admin opens to look at something. #}
                                    <a href="{{ path('app_admin_dashboard', { section: 'backup' }) }}"
                                       class="{{ section == 'backup' ? navActive : navInactive }}">
                                        <i class="fa-solid fa-box-archive w-4 {{ section == 'backup' ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.backup'|trans }}
                                    </a>
                                    {# Last, and the only one tinted: everything above reads or
                                       repairs, this one deletes. #}
                                    <a href="{{ path('app_admin_dashboard', { section: 'reset' }) }}"
                                       class="{{ section == 'reset' ? navActive : navInactive }} {{ section == 'reset' ? '' : 'hover:text-danger' }}">
                                        <i class="fa-solid fa-eraser w-4 {{ section == 'reset' ? 'text-danger' : '' }}" aria-hidden="true"></i>
                                        {{ 'admin.nav.reset'|trans }}
                                    </a>
                                </nav>

                                {# Single content wrapper — second (and last) grid child.
                                   Only the active section's frame is rendered, so only
                                   one loads/polls at a time.

                                   The negative margin cancels the wrapper's px-6 for
                                   this child only, so the section cards run to the
                                   pane's edges and their own px-5 is the single inset
                                   left. Nesting a card in a card cost 44px a side
                                   otherwise — a quarter of a 360px screen spent
                                   before a word of content. The nav keeps the
                                   padding — it is the other grid child and reads
                                   as chrome, not as a card. Restored above 42rem
                                   of pane, where the space is not scarce and a
                                   card flush to the panel edge only looks
                                   unfinished. #}
                                <div class="min-w-0 -mx-6 @2xl:mx-0">

                                    {% if section == 'database' %}

                                        <turbo-frame id="admin-db"
                                                     src="{{ path('app_admin_db') }}"
                                                     loading="lazy"
                                                     data-controller="mail--auto-refresh"
                                                     {# Panels inside write to the server; a refresh mid-write
                                                        would swap their pre-write markup back in. #}
                                                     data-action="admin--admin-panel:persisting->mail--auto-refresh#hold admin--admin-panel:persisted->mail--auto-refresh#release"
                                                     data-mail--auto-refresh-interval-value="20000">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% elseif section == 'integrations' %}

                                        {# No auto-refresh: this is configuration, not
                                           telemetry, and a poll would fight the modal. #}
                                        <turbo-frame id="admin-integrations"
                                                     src="{{ path('app_admin_integrations_list') }}"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% elseif section == 'push' %}

                                        {# No auto-refresh, same reasoning as
                                           integrations — and more so: the field
                                           in here takes a two-kilobyte paste,
                                           and a poll would empty it mid-word. #}
                                        <turbo-frame id="admin-push"
                                                     src="{{ path('app_admin_push_settings') }}"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                        {# A second frame rather than more of
                                           the first: this one is re-rendered
                                           every time a filter changes, and the
                                           form above is holding a paste. Below
                                           the configuration because that is the
                                           reading order — what is set up, then
                                           what it did. #}
                                        <turbo-frame id="admin-push-deliveries"
                                                     src="{{ path('app_admin_push_deliveries') }}"
                                                     class="block mt-3"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% elseif section == 'users' %}

                                        {# No auto-refresh, same reasoning as
                                           integrations: a poll would fight the
                                           modal an admin is typing into. #}
                                        <turbo-frame id="admin-users"
                                                     src="{{ path('app_admin_user_default_index') }}"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% elseif section == 'backup' %}

                                        {# No auto-refresh, and more emphatically
                                           than anywhere else: there are three
                                           password fields in this frame and a
                                           poll would empty whichever one is
                                           half-typed. The error travels on the
                                           query string for the reason the reset
                                           frame records — the frame is loaded by
                                           its own request and would not see a
                                           flash set for the page around it. #}
                                        <turbo-frame id="admin-backup"
                                                     src="{{ path('app_admin_config_backup_panel', app.request.query.get('error') ? { error: app.request.query.get('error') } : {}) }}"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% elseif section == 'reset' %}

                                        {# Emphatically no auto-refresh: one of the forms in
                                           here is a text field the operator has to type an
                                           instance name into, and a poll would empty it
                                           mid-word. The error state travels on the query
                                           string rather than through the flash bag, because
                                           the frame is loaded by its own request and would
                                           not see a flash set for the page around it. #}
                                        <turbo-frame id="admin-reset"
                                                     src="{{ path('app_admin_reset_panel', app.request.query.get('error') ? { error: app.request.query.get('error') } : {}) }}"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% elseif section == 'logs' %}

                                        <turbo-frame id="admin-logs"
                                                     src="{{ path('app_admin_logs') }}"
                                                     loading="lazy">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% else %}

                                        <turbo-frame id="admin-live"
                                                     src="{{ path('app_admin_live') }}"
                                                     loading="lazy"
                                                     data-controller="mail--auto-refresh"
                                                     {# Panels inside write to the server; a refresh mid-write
                                                        would swap their pre-write markup back in. The queue
                                                        browser holds it too — a refresh would drop the filter
                                                        and every page loaded under it. #}
                                                     data-action="admin--admin-panel:persisting->mail--auto-refresh#hold admin--admin-panel:persisted->mail--auto-refresh#release admin--queue-browser:holding->mail--auto-refresh#hold admin--queue-browser:released->mail--auto-refresh#release"
                                                     data-mail--auto-refresh-interval-value="10000">
                                            <div class="py-10 text-center text-sm text-ink-faint">
                                                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                            </div>
                                        </turbo-frame>

                                    {% endif %}

                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
