{#
The web container is on its way out.

A page rather than the usual redirect back to the panel: the redirect would be
requested while there was nothing listening to answer it, and the browser would
show its own connection error instead of anything plMail wrote. This is served
first and the process exits afterwards, so the last thing rendered is an
explanation rather than a dead socket.

The retry below is deliberately dumb — a plain reload on a timer. There is
nothing to poll: the server that would answer a health check is the one going
away.
#}
{% extends '_layout/app.html.twig' %}

{% block title %}{{ 'admin.restarting.page_title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center app-bg px-4 py-10">
        <div class="w-full max-w-md text-center">

            <div class="flex items-center justify-center gap-2 mb-6">
                <i class="fa-solid fa-envelope text-accent text-2xl" aria-hidden="true"></i>
                <span class="text-xl font-semibold text-ink">{{ 'app.name'|trans }}</span>
            </div>

            <div class="bg-surface rounded-pane shadow-sm border border-line p-8">
                {% if restartRequested %}
                    <i class="fa-solid fa-arrows-rotate text-2xl text-accent" aria-hidden="true"></i>
                    <h1 class="mt-4 text-base font-semibold text-ink">{{ 'admin.restarting.heading'|trans }}</h1>
                    <p class="mt-1.5 text-sm text-ink-muted">{{ 'admin.restarting.lead'|trans }}</p>
                {% else %}
                    <i class="fa-solid fa-triangle-exclamation text-2xl text-danger" aria-hidden="true"></i>
                    <h1 class="mt-4 text-base font-semibold text-ink">{{ 'admin.restarting.unavailable_heading'|trans }}</h1>
                    <p class="mt-1.5 text-sm text-ink-muted">{{ 'admin.restarting.unavailable_lead'|trans }}</p>
                    <code class="mt-3 block rounded bg-zinc-500/10 px-2.5 py-1.5 text-xs font-mono text-ink select-all">docker compose restart php</code>
                {% endif %}

                <a href="{{ path('app_admin_dashboard') }}"
                   class="mt-6 inline-block text-sm font-medium text-accent hover:underline">
                    {{ 'admin.restarting.back'|trans }}
                </a>
            </div>

        </div>
    </div>
{% endblock %}

{% block javascripts_body %}
    {% if restartRequested %}
        <script>
            // Long enough for FrankenPHP to drain, exit and be recreated by
            // compose's restart policy. Too early only costs one failed
            // navigation, which is why this is a reload and not a fetch.
            setTimeout(function () {
                window.location.href = {{ path('app_admin_dashboard')|json_encode|raw }};
            }, 6000);
        </script>
    {% endif %}
{% endblock %}
