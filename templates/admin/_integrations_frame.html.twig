{#
admin/_integrations_frame.html.twig — every integration provider and its state.

Lists all Provider cases, not just the configured ones, in two groups: the file
services, and below them the calendar services. A provider with no driver still
appears, greyed, with its setup tutorial readable — the list doubles as the
roadmap, and shipping a driver later needs no edit here.

Each row (admin/integrations/_provider_row.html.twig) is a <details> so the tutorial is inline rather than behind another
navigation step: an admin filling in a client secret wants the instructions on
the same screen as the field.
#}
{# Layout classes belong on the placeholder in admin/index.html.twig, not
   here: Turbo transplants this frame's CHILDREN into the frame already on
   the page and never copies its attributes, so a class written here reaches
   nothing. See tests/Infrastructure/Templating/TurboFrameClassesTest.php. #}
<turbo-frame id="admin-integrations">

    {# ── Mail sign-in ──
       Above the services, because it is the prerequisite: a Google or Microsoft
       integration can borrow this app registration, and mail itself does not
       work without it. Same row shape as a service, so the page reads as one
       list of app registrations rather than two unrelated things. #}
    <div id="admin-mail-providers" class="space-y-2">
        {# Bare text, so it carries the rows' own inset rather than borrowing
           one from the frame around it — which runs edge to edge on a narrow
           pane. px-4 is the house inset, from _partials/_card_chrome.html.twig,
           so this label, the rows below it and the paragraph under those all
           begin at the same x. They used to be px-5 against cards that were
           px-4, which is how one screen came to have the label, the card edge,
           the card content and the prose at four different positions. #}
        <h3 class="px-4 text-xs font-semibold uppercase tracking-wide text-ink-faint">
            {{ 'admin.integrations.mail.heading'|trans }}
        </h3>

        {% for mailProvider in mailProviders %}
            {% set mailConfig = mailConfigs[mailProvider.value] ?? null %}

            <div id="mail-provider-{{ mailProvider.value }}"
                 class="flex items-center gap-3 px-4 h-14 rounded-pane border border-line bg-pane-soft">
                <i class="fa-brands {{ mailProvider.value == 'google' ? 'fa-google' : 'fa-microsoft' }}
                          text-base w-5 text-center
                          {{ mailConfig is not null and mailConfig.isComplete ? 'text-accent' : 'text-ink-faint' }}"
                   aria-hidden="true"></i>

                <span class="text-sm font-semibold text-ink">
                    {{ ('admin.integrations.mail.' ~ mailProvider.value)|trans }}
                </span>

                {% if mailConfig is not null and mailConfig.isComplete %}
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
                        {{ 'admin.integrations.status.enabled'|trans }}
                    </span>
                {% else %}
                    {# "From environment" is a real state worth naming: the flow
                       may well be working off .env with nothing in the table. #}
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-muted">
                        {{ 'admin.integrations.mail.from_env'|trans }}
                    </span>
                {% endif %}

                <button type="button"
                        data-controller="ui--modal"
                        data-ui--modal-src-value="{{ path('app_admin_integrations_mail_edit', { provider: mailProvider.value }) }}"
                        data-ui--modal-title-value="{{ ('admin.integrations.mail.' ~ mailProvider.value)|trans }}"
                        data-action="click->ui--modal#open"
                        class="ml-auto inline-flex items-center gap-2 h-8 px-3.5 rounded-lg text-sm font-medium
                               text-ink-soft bg-field border border-field-border hover:bg-hover transition-colors">
                    <i class="fa-solid fa-sliders text-xs" aria-hidden="true"></i>
                    {{ 'admin.integrations.configure'|trans }}
                </button>
            </div>
        {% endfor %}
    </div>

    <p class="px-4 pt-2 text-sm text-ink-muted">
        {{ 'admin.integrations.intro'|trans }}
    </p>

    {% for provider in providers %}
        {% include 'admin/integrations/_provider_row.html.twig' with {
            provider: provider,
            config: configs[provider.value] ?? null,
            users: userCounts[provider.value] ?? 0,
            mailConfigs: mailConfigs,
            inheritable: inheritable,
            alwaysOffered: false,
        } only %}
    {% endfor %}

    {# ── Calendars ──
       CalDAV and calendar feeds, chosen by Provider::offersCalendars() less the
       file services above: Nextcloud offers calendars too, and its one config
       row is already edited there. The setup wizard writes these rows, so
       without this group a server address pinned at setup could not be
       changed afterwards (#212). #}
    {% if calendarProviders is not empty %}
        <div id="admin-calendar-providers" class="space-y-2 pt-4">
            <h3 class="px-4 text-xs font-semibold uppercase tracking-wide text-ink-faint">
                {{ 'admin.integrations.calendar.heading'|trans }}
            </h3>

            <p class="px-4 text-sm text-ink-muted">
                {{ 'admin.integrations.calendar.intro'|trans }}
            </p>

            {% for provider in calendarProviders %}
                {% include 'admin/integrations/_provider_row.html.twig' with {
                    provider: provider,
                    config: configs[provider.value] ?? null,
                    users: userCounts[provider.value] ?? 0,
                    mailConfigs: mailConfigs,
                    inheritable: inheritable,
                    alwaysOffered: true,
                } only %}
            {% endfor %}
        </div>
    {% endif %}

    {# ── Servers on your network ──
       The hosts plMail may reach although they resolve to a private address,
       each with its own plain-http permission (TrustedHost). Last, because it
       is the answer to an error a user meets on the services above — "must
       not point at a private network" — and that error sends the admin here.
       Inline rows rather than a modal per host: there is nothing to a host
       but its name and one checkbox. #}
    <div id="admin-trusted-hosts" class="space-y-2 pt-4">
        <h3 class="px-4 text-xs font-semibold uppercase tracking-wide text-ink-faint">
            {{ 'admin.integrations.trusted.heading'|trans }}
        </h3>

        <p class="px-4 text-sm text-ink-muted">
            {{ 'admin.integrations.trusted.intro'|trans }}
        </p>

        {% for trusted in trustedHosts %}
            <div id="trusted-host-{{ trusted.id }}"
                 class="flex flex-wrap items-center gap-3 px-4 min-h-14 py-2 rounded-pane border border-line bg-pane-soft">
                <i class="fa-solid fa-server text-base w-5 text-center text-accent" aria-hidden="true"></i>

                <span class="text-sm font-semibold text-ink break-all">{{ trusted.host }}</span>

                {% if trusted.allowHttp %}
                    <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-500">
                        {{ 'admin.integrations.trusted.http_allowed'|trans }}
                    </span>
                {% endif %}

                <span class="ml-auto flex items-center gap-2">
                    <form method="post"
                          action="{{ path('app_admin_integrations_trusted_host_http', { id: trusted.id }) }}"
                          data-turbo-frame="admin-integrations">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin-trusted-host-' ~ trusted.id) }}">
                        <input type="hidden" name="allowHttp" value="{{ trusted.allowHttp ? '0' : '1' }}">
                        <button type="submit"
                                class="inline-flex items-center h-8 px-3 rounded-lg text-xs font-medium
                                       text-ink-soft bg-field border border-field-border hover:bg-hover transition-colors cursor-pointer">
                            {{ (trusted.allowHttp ? 'admin.integrations.trusted.require_https' : 'admin.integrations.trusted.allow_http')|trans }}
                        </button>
                    </form>

                    <form method="post"
                          action="{{ path('app_admin_integrations_trusted_host_remove', { id: trusted.id }) }}"
                          data-turbo-frame="admin-integrations"
                          data-turbo-confirm="{{ 'admin.integrations.trusted.remove_confirm'|trans({ '%host%': trusted.host }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin-trusted-host-' ~ trusted.id) }}">
                        <button type="submit"
                                aria-label="{{ 'admin.integrations.trusted.remove'|trans({ '%host%': trusted.host }) }}"
                                class="inline-flex items-center px-2.5 h-8 rounded-lg text-xs font-medium btn-quiet hover:text-danger hover:bg-danger-soft transition-colors cursor-pointer">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                </span>
            </div>
        {% else %}
            <p class="px-4 text-sm text-ink-faint">{{ 'admin.integrations.trusted.empty'|trans }}</p>
        {% endfor %}

        <div class="px-4 pt-1">
            <button type="button"
                    data-controller="ui--modal"
                    data-ui--modal-src-value="{{ path('app_admin_integrations_trusted_host_new') }}"
                    data-ui--modal-title-value="{{ 'admin.integrations.trusted.add'|trans }}"
                    data-action="click->ui--modal#open"
                    class="inline-flex items-center gap-2 h-8 px-3.5 rounded-lg text-sm font-medium
                           text-ink-soft bg-field border border-field-border hover:bg-hover transition-colors">
                <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
                {{ 'admin.integrations.trusted.add'|trans }}
            </button>
        </div>
    </div>

</turbo-frame>
