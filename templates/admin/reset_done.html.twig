{#
Shown once, to nobody.

By the time this renders the user who asked for it has been deleted and signed
out, so it cannot extend the app shell's signed-in chrome and cannot be reached
again — there is no route that would serve it a second time. It is built on the
install screen's card for the same reason install.html.twig is: this and that
are now the only two pages this install has, and they are one step apart.

Everything the operator needs has to be on this page, because the next request
they make lands on /install with no memory of what happened here.
#}
{% extends '_layout/app.html.twig' %}

{% block title %}{{ 'admin.reset.done.page_title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center app-bg px-4 py-10">
        <div class="w-full max-w-lg">

            <div class="flex flex-col items-center mb-8">
                <div class="flex items-center gap-2 mb-2">
                    <i class="fa-solid fa-envelope text-accent text-2xl" aria-hidden="true"></i>
                    <span class="text-xl font-semibold text-ink">{{ 'app.name'|trans }}</span>
                </div>
                <p class="text-sm text-ink-muted">{{ 'admin.reset.done.tagline'|trans }}</p>
            </div>

            <div class="bg-surface rounded-pane shadow-sm border border-line p-8">

                <h1 class="text-base font-semibold text-ink">{{ 'admin.reset.done.heading'|trans }}</h1>
                <p class="mt-1.5 text-sm text-ink-muted">
                    {{ 'admin.reset.done.lead'|trans({ '%count%': tableCount }) }}
                </p>

                {% if rotatedSecrets %}
                    <div class="mt-6 rounded-lg alert-warning px-3.5 py-3">
                        <p class="text-sm font-medium text-warning">{{ 'admin.reset.done.secrets_heading'|trans }}</p>

                        {% if removedSecrets|length %}
                            <p class="mt-1.5 text-xs text-ink-soft font-mono break-all">
                                {{ removedSecrets|join(', ') }}, JWT
                            </p>
                        {% endif %}

                        <p class="mt-2 text-xs text-ink-soft leading-relaxed">{{ 'admin.reset.postgres_password'|trans }}</p>

                        <p class="mt-3 text-xs text-ink-soft leading-relaxed">{{ 'admin.reset.restart_required'|trans }}</p>
                        <code class="mt-1 block rounded bg-zinc-500/10 px-2.5 py-1.5 text-xs font-mono text-ink select-all">docker compose restart</code>

                        {# Honest either way. Claiming a restart that did not happen
                           would leave the operator believing the fleet is on the new
                           encryption key while half of it is not. #}
                        <p class="mt-3 text-xs leading-relaxed {{ restartRequested ? 'text-ink-soft' : 'text-danger' }}">
                            {{ (restartRequested ? 'admin.reset.done.restart_sent' : 'admin.reset.done.restart_failed')|trans }}
                        </p>

                        {% if not workersSignalled %}
                            <p class="mt-2 text-xs text-danger leading-relaxed">{{ 'admin.reset.done.workers_failed'|trans }}</p>
                        {% endif %}
                    </div>
                {% endif %}

                <a href="{{ path('app_install') }}"
                   class="mt-7 block w-full text-center bg-accent hover:bg-accent-strong text-accent-ink text-sm font-medium py-2 rounded-lg transition-colors">
                    {{ 'admin.reset.done.continue'|trans }}
                </a>
            </div>

            <p class="text-center text-xs text-ink-faint mt-6">
                {{ 'admin.reset.done.footnote'|trans }}
            </p>

        </div>
    </div>
{% endblock %}
