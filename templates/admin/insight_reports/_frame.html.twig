{% import '_partials/_card_chrome.html.twig' as chrome %}
{% import '_partials/_select.html.twig' as select %}
{#
admin/insight_reports/_frame.html.twig — Admin → Reported mail.

Accepts:
  reports      — list<App\Entity\Insight\InsightReport>, newest first
  pendingCount — how many of the whole table are unhandled, not how many of the list

Three cards, in the order the work happens: the pile first, because an admin
who opened this section came to read it, and the export under it, because that
is what you do once you have seen there is something worth writing a parser
for. The card that empties the done pile is last and tinted, the way the reset
section puts its irreversible half below its recoverable one.

Every row is a native <details>, exactly as the log browser's rows are. An
admin here is triaging — deciding which of forty mails is a shape worth an
extractor — and forty mail bodies rendered flat is a page nobody scrolls to the
bottom of. The summary carries everything that decision needs (when, who,
sender, subject, and the user's own words); the body is one click away.

No auto-refresh wraps this frame — see the note where it is embedded in
index.html.twig. The mutating forms post into this frame and get the re-rendered
list back, so nothing here navigates the page.
#}
{# Layout classes belong on the placeholder in admin/index.html.twig, not
   here: Turbo transplants this frame's CHILDREN into the frame already on
   the page and never copies its attributes, so a class written here reaches
   nothing. See tests/Infrastructure/Templating/TurboFrameClassesTest.php. #}
<turbo-frame id="admin-insight-reports">

    {# ── The pile ──────────────────────────────────────────────────────── #}
    <section class="@container {{ chrome.shell() }}">

        <div class="flex flex-wrap items-center gap-3 {{ chrome.band() }}">
            <i class="fa-solid fa-flag text-xs text-zinc-400" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-ink">{{ 'admin.insight_reports.heading'|trans }}</h2>
            <span class="text-xs text-ink-faint">{{ 'admin.insight_reports.pending'|trans({ '%count%': pendingCount }) }}</span>
        </div>

        {% if reports|length == 0 %}
            {# Calmly, and not as a table with no rows in it: nothing being
               reported is the ordinary state of a working install, not an
               empty result somebody should go looking for. #}
            <div class="{{ chrome.body() }}">
                <p class="text-sm text-ink-soft">{{ 'admin.insight_reports.empty'|trans }}</p>
                <p class="mt-1 text-xs text-ink-faint leading-relaxed">{{ 'admin.insight_reports.empty_hint'|trans }}</p>
            </div>
        {% else %}
            <div class="divide-y divide-line">
                {% for report in reports %}
                    {# The row is a <details> beside its buttons, not around
                       them: a <form> is flow content and may not live inside a
                       <summary>, and a button that did would toggle the fold on
                       its way to being pressed. #}
                    <div class="flex flex-wrap items-start gap-3 px-4 py-3">

                        <details class="min-w-0 flex-1 text-sm group">
                            <summary class="flex items-start gap-3 cursor-pointer list-none">
                                <i class="fa-solid fa-chevron-right mt-1 shrink-0 text-[9px] text-ink-faint w-3
                                          transition-transform group-open:rotate-90" aria-hidden="true"></i>

                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                        <span class="text-xs text-ink-faint font-mono">{{ report.createdAt|date('Y-m-d H:i') }}</span>

                                        {# Handled state on the row rather than
                                           only in a filter: the list is read top
                                           to bottom and "is this one still mine
                                           to do" has to be answerable without
                                           looking anywhere else. #}
                                        {% if report.handledAt is not null %}
                                            <span class="text-[10px] font-semibold uppercase tracking-wide rounded-md px-1.5 py-0.5 badge-neutral"
                                                  title="{{ 'admin.insight_reports.handled_at'|trans({ '%when%': report.handledAt|date('Y-m-d H:i') }) }}">
                                                {{ 'admin.insight_reports.handled'|trans }}
                                            </span>
                                        {% else %}
                                            <span class="text-[10px] font-semibold uppercase tracking-wide rounded-md px-1.5 py-0.5 badge-warning">
                                                {{ 'admin.insight_reports.pending_badge'|trans }}
                                            </span>
                                        {% endif %}

                                        <span class="min-w-0 truncate text-xs text-ink-muted">
                                            {{ 'admin.insight_reports.reported_by'|trans({
                                                '%who%': report.reportedBy ? report.reportedBy.email : 'admin.insight_reports.reporter_gone'|trans,
                                            }) }}
                                        </span>
                                    </div>

                                    <p class="mt-1 truncate text-sm text-ink">
                                        {{ report.subject|default('') ?: 'admin.insight_reports.no_subject'|trans }}
                                    </p>

                                    <p class="mt-0.5 truncate text-xs text-ink-muted">
                                        {% if report.fromName %}{{ report.fromName }} {% endif %}
                                        <span class="font-mono text-ink-faint">{{ report.fromAddress|default('') ?: 'admin.insight_reports.no_sender'|trans }}</span>
                                    </p>

                                    {# The user's own words, on the summary and
                                       not inside the fold. InsightReport calls
                                       it the single most valuable column in the
                                       export, and it is the single most valuable
                                       line here for the same reason: it names
                                       the fact a reader would otherwise guess
                                       at. #}
                                    {% if report.note %}
                                        <p class="mt-1.5 text-xs text-ink-soft leading-relaxed">
                                            <i class="fa-solid fa-quote-left mr-1 text-[9px] text-ink-faint" aria-hidden="true"></i>{{ report.note }}
                                        </p>
                                    {% endif %}
                                </div>
                            </summary>

                            <div class="mt-3 space-y-2 pl-6">
                                {% if report.receivedAt is not null %}
                                    <p class="text-xs text-ink-faint">
                                        {{ 'admin.insight_reports.received_at'|trans({ '%when%': report.receivedAt|date('Y-m-d H:i') }) }}
                                    </p>
                                {% endif %}

                                {# The body, and the only wall of text on the
                                   page — behind the fold, scrolling inside its
                                   own box, so a sixteen-kilobyte newsletter
                                   cannot push the next report off the screen. #}
                                {% if report.bodyText %}
                                    <pre class="max-h-72 overflow-auto rounded-lg bg-zinc-500/10 px-3 py-2 text-xs text-ink-soft whitespace-pre-wrap break-words">{{ report.bodyText }}</pre>
                                {% else %}
                                    <p class="text-xs text-ink-faint">{{ 'admin.insight_reports.no_body'|trans }}</p>
                                {% endif %}
                            </div>
                        </details>

                        <div class="flex shrink-0 items-center gap-1.5">
                            {% if report.handledAt is null %}
                                <form method="post"
                                      action="{{ path('app_admin_insight_reports_handled', { id: report.id }) }}"
                                      data-turbo-frame="admin-insight-reports">
                                    <input type="hidden" name="_token" value="{{ csrf_token('insight_report_handled_' ~ report.id) }}">
                                    <button type="submit"
                                            class="inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium btn-quiet transition-colors cursor-pointer">
                                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                                        {{ 'admin.insight_reports.mark_handled'|trans }}
                                    </button>
                                </form>
                            {% endif %}

                            <form method="post"
                                  action="{{ path('app_admin_insight_reports_delete', { id: report.id }) }}"
                                  data-turbo-frame="admin-insight-reports"
                                  data-turbo-confirm="{{ 'admin.insight_reports.delete_confirm'|trans }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('insight_report_delete_' ~ report.id) }}">
                                <button type="submit"
                                        aria-label="{{ 'admin.insight_reports.delete'|trans }}"
                                        class="inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium btn-quiet hover:text-danger hover:bg-danger-soft transition-colors cursor-pointer">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>

                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# ── Export ────────────────────────────────────────────────────────── #}
    <div class="{{ chrome.shell() }}">
        <div class="flex items-center gap-2.5 {{ chrome.band() }}">
            <i class="fa-solid fa-file-arrow-down text-xs text-zinc-400" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-ink">{{ 'admin.insight_reports.export.heading'|trans }}</h2>
        </div>

        <div class="{{ chrome.body() }} space-y-3">
            <p class="text-sm text-ink-soft leading-relaxed">{{ 'admin.insight_reports.export.intro'|trans }}</p>
            <p class="text-xs text-ink-faint leading-relaxed">
                <i class="fa-solid fa-triangle-exclamation mr-1 text-warning" aria-hidden="true"></i>
                {{ 'admin.insight_reports.export.warning'|trans }}
            </p>

            {#
                data-turbo="false", so the browser performs this submission
                itself. Turbo cannot render a download — it would swap the JSON
                into the frame and leave a blank panel. Every other form here
                posts into the frame as usual.
            #}
            <form method="post"
                  action="{{ path('app_admin_insight_reports_export') }}"
                  data-turbo="false"
                  class="flex flex-col gap-2 sm:flex-row sm:items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('insight_reports_export') }}">

                <div class="flex-1 min-w-0">
                    <label for="insight-reports-scope" class="block text-xs text-ink-muted">
                        {{ 'admin.insight_reports.export.scope'|trans }}
                    </label>
                    {# Unhandled first, and so the default the browser preselects:
                       that is the pile with work left in it. #}
                    <select id="insight-reports-scope" name="scope"
                            {{ select.enhance() }}
                            class="select-field mt-1 h-9 text-sm">
                        <option value="pending">{{ 'admin.insight_reports.export.scope_pending'|trans }}</option>
                        <option value="all">{{ 'admin.insight_reports.export.scope_all'|trans }}</option>
                    </select>
                </div>

                <button type="submit" id="insight-reports-export"
                        class="shrink-0 inline-flex items-center gap-2 h-9 px-4 rounded-lg text-sm font-medium
                               text-accent-ink bg-accent hover:bg-accent-strong transition-colors cursor-pointer">
                    <i class="fa-solid fa-file-arrow-down text-xs" aria-hidden="true"></i>
                    {{ 'admin.insight_reports.export.submit'|trans }}
                </button>
            </form>

            {# Said on the page and not only in the controller: an admin who
               expected the download to clear the pile would otherwise discover
               the opposite by exporting twice. #}
            <p class="text-xs text-ink-faint leading-relaxed">{{ 'admin.insight_reports.export.not_handled'|trans }}</p>
        </div>
    </div>

    {# ── Clearing what is done ───────────────────────────────────────────
       Absent entirely while nothing is handled, rather than present and
       disabled: a delete button that cannot delete anything is furniture, and
       this card is tinted precisely to say "something irreversible lives
       here". The count travels into the lead and the confirm, because a
       confirm that names no number asks the admin to take this panel's word
       for what is about to go — and what goes is the only surviving copy of
       mail somebody took the trouble to report. #}
    {% if handledCount > 0 %}
    {# Not chrome.shell()/chrome.band(): both of those pin `border-line`, and the
       tint is the whole point of this card. Two `border-*` colour utilities on
       one element are resolved by their order in the generated stylesheet, not
       by the order they are written here, so the danger colour cannot simply be
       appended to the macro — the figures are repeated instead, and it is only
       the COLOURS that differ. Same repetition as the reset panel's
       unrecoverable half, which is the other card that has to say this. #}
    <div class="rounded-pane border border-danger/40 bg-pane-soft overflow-hidden">
        <div class="flex items-center gap-2.5 px-4 py-3.5 border-b border-danger/40 alert-danger">
            <i class="fa-solid fa-broom text-xs text-danger" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-danger">{{ 'admin.insight_reports.clear_handled.heading'|trans }}</h2>
        </div>

        <div class="{{ chrome.body() }} flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-ink-soft leading-relaxed">{{ 'admin.insight_reports.clear_handled.lead'|trans({ '%count%': handledCount }) }}</p>

            <form method="post"
                  action="{{ path('app_admin_insight_reports_clear_handled') }}"
                  data-turbo-frame="admin-insight-reports"
                  data-turbo-confirm="{{ 'admin.insight_reports.clear_handled.confirm'|trans({ '%count%': handledCount }) }}"
                  class="shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token('insight_reports_clear_handled') }}">
                <button type="submit"
                        class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg text-xs font-medium
                               bg-danger-soft text-danger hover:bg-danger hover:text-white transition-colors cursor-pointer">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                    {{ 'admin.insight_reports.clear_handled.button'|trans }}
                </button>
            </form>
        </div>
    </div>
    {% endif %}

    {# What the SORTING has been getting wrong, beside what the insights have.
       Two different reports about two different features, and they live
       together because of where somebody looks for them.

       This started in Admin → AI, on the reasoning that a report should sit
       beside the thing it is evidence about — the prompt and the model are
       configured there. That lost to the plainer fact that this section is
       called "Reported mail": somebody who has just pressed a button labelled
       Report goes looking for what it did under the heading that matches, finds
       an empty list, and concludes the button is broken. Which is exactly what
       happened.

       The product is the TEXT, not the table. Whoever reads this is going to
       paste it somewhere — into a prompt, an issue, a message to whoever is
       changing a rule — so the copy button takes the whole block and the rows
       are there to be skimmed before deciding whether it is worth pasting. #}
    {% set reports = category_reports() %}
    {% if reports.count > 0 %}
        {# GROUPED BY THE PROBLEM, not listed by date. Twenty reports are rarely
           twenty problems — they are "this shop keeps landing in Primary" six
           times and one odd one — and the person reading this is deciding
           whether to change a rule, which is a decision about a group. The
           selection exists so they can take the group that is about their rule
           and leave the four that are not.

           Copying is ui--clipboard's, on the same wrapper: the selection
           controller only keeps the hidden block in step with the ticks, so the
           execCommand path that a plain-HTTP installation needs stays in one
           place rather than being written twice. #}
        <section class="{{ chrome.shell() }} mt-3"
                 data-controller="admin--report-selection ui--clipboard"
                 data-admin--report-selection-count-label-value="{{ 'admin.ai.reports.selected'|trans({'%count%': '%count%'}) }}"
                 data-admin--report-selection-filename-value="category-reports.txt"
                 data-ui--clipboard-confirm-text-value="{{ 'clipboard.copied'|trans }}"
                 data-ui--clipboard-failed-text-value="{{ 'clipboard.copy_failed'|trans }}">

            {# The selected lines, and the only thing either button acts on. #}
            <pre class="hidden"
                 data-admin--report-selection-target="sink"
                 data-ui--clipboard-target="source"></pre>

            <div class="flex items-start justify-between gap-3 {{ chrome.band() }}">
                <div class="min-w-0">
                    <h2 class="text-sm font-semibold text-ink">{{ 'admin.ai.reports.heading'|trans }}</h2>
                    <p class="text-xs text-ink-faint mt-0.5">
                        {{ 'admin.ai.reports.subheading'|trans({'%count%': reports.count}) }}
                    </p>
                </div>

                <div class="flex items-center gap-1.5 shrink-0">
                    <span class="text-[11px] text-ink-faint tabular-nums mr-1"
                          data-admin--report-selection-target="count"></span>

                    <button type="button"
                            data-action="click->ui--clipboard#copy"
                            data-admin--report-selection-target="action"
                            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-pane border border-line
                                   text-[11px] text-ink-muted hover:bg-hover cursor-pointer transition-colors
                                   disabled:opacity-40 disabled:cursor-not-allowed">
                        <i data-ui--clipboard-target="icon" class="fa-solid fa-copy text-[10px]" aria-hidden="true"></i>
                        <span data-ui--clipboard-target="label">{{ 'admin.ai.reports.copy'|trans }}</span>
                    </button>

                    <button type="button"
                            data-action="click->admin--report-selection#download"
                            data-admin--report-selection-target="action"
                            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-pane border border-line
                                   text-[11px] text-ink-muted hover:bg-hover cursor-pointer transition-colors
                                   disabled:opacity-40 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-download text-[10px]" aria-hidden="true"></i>
                        <span>{{ 'admin.ai.reports.download'|trans }}</span>
                    </button>

                    {# Clearing is how a list of grievances stops being a list of
                       the same grievance twenty times. These are somebody's
                       observations about their own mail and nothing regenerates
                       them, so it asks first. #}
                    <form method="post" action="{{ path('app_admin_ai_reports_clear') }}"
                          data-turbo-confirm="{{ 'admin.ai.reports.clear_confirm'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_ai_reports_clear') }}">
                        <button type="submit"
                                class="inline-flex items-center justify-center h-8 w-8 rounded-pane
                                       text-ink-faint hover:bg-hover cursor-pointer transition-colors">
                            <span class="sr-only">{{ 'admin.ai.reports.clear'|trans }}</span>
                            <i class="fa-solid fa-trash text-[10px]" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>

            <label class="flex items-center gap-2 px-4 py-2 border-b border-line cursor-pointer
                          text-[11px] text-ink-faint hover:bg-hover transition-colors">
                <input type="checkbox" checked
                       data-admin--report-selection-target="all"
                       data-action="change->admin--report-selection#toggleAll"
                       class="size-3.5 accent-accent cursor-pointer">
                {{ 'admin.ai.reports.select_all'|trans }}
            </label>

            <div class="max-h-96 overflow-y-auto">
                {% for group in reports.groups %}
                    <div class="border-b border-line last:border-b-0">
                        <label class="flex items-center gap-2 px-4 py-2 bg-hover/40 cursor-pointer
                                      hover:bg-hover transition-colors">
                            <input type="checkbox" checked
                                   data-group="{{ group.key }}"
                                   data-admin--report-selection-target="group"
                                   data-action="change->admin--report-selection#toggleGroup"
                                   class="size-3.5 accent-accent cursor-pointer">

                            <span class="text-[11px] font-medium text-ink">
                                {{ ('tabs.' ~ group.filed)|trans }}
                                <i class="fa-solid fa-arrow-right text-[9px] text-ink-faint mx-0.5" aria-hidden="true"></i>
                                {{ ('tabs.' ~ group.shouldBe)|trans }}
                            </span>

                            <span class="text-[10px] text-ink-faint tabular-nums">{{ group.count }}</span>
                        </label>

                        {% for row in group.rows %}
                            <label class="flex items-start gap-2 px-4 py-2 cursor-pointer
                                          hover:bg-hover transition-colors">
                                <input type="checkbox" checked
                                       data-group="{{ group.key }}"
                                       data-line="{{ row.line }}"
                                       data-admin--report-selection-target="row"
                                       data-action="change->admin--report-selection#toggleRow"
                                       class="size-3.5 mt-0.5 accent-accent cursor-pointer shrink-0">

                                <span class="min-w-0 flex-1">
                                    <span class="flex items-baseline gap-2 min-w-0">
                                        <span class="text-[10px] text-ink-faint tabular-nums shrink-0">{{ row.date }}</span>
                                        <span class="text-[11px] text-ink-muted truncate">{{ row.from }}</span>
                                    </span>

                                    <span class="block text-[11px] text-ink truncate mt-0.5">{{ row.subject }}</span>

                                    {# The line itself, on one row. It IS the
                                       product, so it is on screen to be skimmed
                                       before deciding whether the group is worth
                                       taking; the full text goes to the
                                       clipboard, not to this element. #}
                                    <span class="block font-mono text-[10px] text-ink-faint truncate mt-0.5"
                                          title="{{ row.line }}">{{ row.line }}</span>
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
</turbo-frame>
