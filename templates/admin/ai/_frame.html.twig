{% import '_partials/_card_chrome.html.twig' as chrome %}
{#
admin/ai/_frame.html.twig — Admin → AI.

Accepts:
  settings — App\Entity\Ai\AiSettings (unsaved when nothing was ever configured)
  form     — App\Form\Admin\AiSettingsType, bound to it
  saved    — true immediately after a successful save
  probes   — what the Test button found, one entry per model host that was
             asked: {role: 'writing'|'search', probe: App\Domain\DTO\Ai\AiProbe,
             wanted: the model names that host is expected to hold}. Absent or
             empty when nothing was tested
  prompts  — the seven editable system prompts; see admin/ai/_prompts.html.twig,
             which this includes and which reads them out of the same context

THE STATUS CHIP IS THE PART WORTH KEEPING. "Off", "configured but off" and
"running" are three states an administrator has to tell apart at a glance, and
they are the states people actually get into: a host typed in and never
switched on, or switched on with nothing behind it. The chip reads the entity's
own methods, so what this page claims and what the features do cannot drift.

The token is never rendered back. Its field is write-only and its placeholder
says only whether one exists.

No auto-refresh wraps this frame — it is configuration, not telemetry, and a
poll would empty a field mid-word.
#}
{# Layout classes belong on the placeholder in admin/index.html.twig, not
   here: Turbo transplants this frame's CHILDREN into the frame already on
   the page and never copies its attributes, so a class written here reaches
   nothing. See tests/Infrastructure/Templating/TurboFrameClassesTest.php. #}
<turbo-frame id="admin-ai">

    {# Collapsible, and CLOSED once there is nothing left to do here.
       Settings are a thing you finish. Once a host and a model are on file this
       card is a wall of filled-in fields standing between the administrator and
       the two cards below it, which are the ones worth looking at again — so it
       folds itself away and the chip in its header keeps saying what state it
       is in.

       It opens itself for the three cases where it still wants attention: a
       fresh install with nothing configured, the moment after a save (so the
       confirmation is not hidden behind a fold), and a form that came back with
       errors.

       Native <details>, like the settings pages: keyboard-operable and
       screen-reader-announced with nothing added, no JavaScript, and nothing for
       the Content Security Policy to refuse. #}
    <details class="{{ chrome.shell() }} group"
             {{ (not settings.isConfigured or saved or not form.vars.valid) ? 'open' : '' }}>

        <summary class="flex items-center gap-2.5 cursor-pointer list-none {{ chrome.band() }}">
            <i class="fa-solid fa-chevron-right w-3 text-xs text-ink-faint transition-transform
                      group-open:rotate-90" aria-hidden="true"></i>
            <i class="fa-solid fa-wand-magic-sparkles text-xs text-ink-faint" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-ink">{{ 'admin.ai.heading'|trans }}</h2>

            {% if settings.isEnabled and settings.isConfigured %}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
                    {{ 'admin.ai.status.on'|trans }}
                </span>
            {% elseif settings.isConfigured %}
                {# A host on file with the switch off is a deliberate pause, not
                   a half-finished setup, and saying "off" without saying that
                   would read as the configuration having been lost. #}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-muted">
                    {{ 'admin.ai.status.paused'|trans }}
                </span>
            {% elseif settings.isEnabled %}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-500">
                    {{ 'admin.ai.status.incomplete'|trans }}
                </span>
            {% else %}
                <span class="ml-auto text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-muted">
                    {{ 'admin.ai.status.off'|trans }}
                </span>
            {% endif %}
        </summary>

        {# px-4, matching chrome.band(). It was px-5, so the header's text and
           the body's text started four pixels apart down the whole card. #}
        <div class="{{ chrome.body() }} space-y-4">

            {% if saved %}
                <div role="status" class="flex items-start gap-2.5 rounded-lg bg-emerald-500/10 px-3.5 py-3 text-sm text-emerald-500">
                    <i class="fa-solid fa-circle-check mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ 'admin.ai.saved'|trans }}</p>
                </div>
            {% endif %}

            <p class="text-sm text-ink-soft leading-relaxed">{{ 'admin.ai.intro'|trans }}</p>

            {# ── What the test found ──────────────────────────────────────────
               Rendered only when something was tested. Three outcomes, because
               they send an administrator to three different places: nothing
               answered, something answered but is not holding the model that
               was named, or all is well. A single red cross for the first two
               would send them to the wrong one. #}
            {% for tested in probes|default([]) %}
                {% set probe = tested.probe %}
                {% set wanted = tested.wanted %}

                {# Named only when there are two. With one host, a heading
                   saying which host it was would be a heading about nothing. #}
                {% if probes|length > 1 %}
                    <p class="text-xs font-semibold text-ink-muted -mb-2">{{ ('admin.ai.probe.host.' ~ tested.role)|trans }}</p>
                {% endif %}

                {% if probe.reachable %}
                    {% set missing = [] %}
                    {% for name in wanted|default([]) %}
                        {% if name is not empty and not probe.hasModel(name) %}
                            {% set missing = missing|merge([name]) %}
                        {% endif %}
                    {% endfor %}

                    {% if missing is empty %}
                        <div role="status" class="flex items-start gap-2.5 rounded-lg bg-emerald-500/10 px-3.5 py-3 text-sm text-emerald-500">
                            <i class="fa-solid fa-plug-circle-check mt-0.5 shrink-0" aria-hidden="true"></i>
                            <p class="leading-snug">
                                {{ 'admin.ai.probe.ok'|trans({ '%count%': probe.models|length }) }}
                                {%- if probe.version %} <span class="opacity-70">({{ probe.version }})</span>{% endif %}
                            </p>
                        </div>
                    {% else %}
                        <div role="status" class="flex items-start gap-2.5 rounded-lg bg-amber-500/10 px-3.5 py-3 text-sm text-amber-500">
                            <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
                            <p class="leading-snug">
                                {{ 'admin.ai.probe.missing_model'|trans({ '%models%': missing|join(', ') }) }}
                            </p>
                        </div>
                    {% endif %}

                    {% if probe.models is not empty %}
                        <details class="text-xs">
                            <summary class="cursor-pointer text-ink-faint hover:text-ink-muted">
                                {{ 'admin.ai.probe.models'|trans({ '%count%': probe.models|length }) }}
                            </summary>
                            <ul class="mt-2 space-y-0.5 font-mono text-ink-soft">
                                {% for model in probe.models %}
                                    <li>{{ model.name }}</li>
                                {% endfor %}
                            </ul>
                        </details>
                    {% endif %}
                {% else %}
                    <div role="alert" class="flex items-start gap-2.5 rounded-lg alert-danger px-3.5 py-3 text-sm text-danger">
                        <i class="fa-solid fa-plug-circle-xmark mt-0.5 shrink-0" aria-hidden="true"></i>
                        <p class="leading-snug break-words">
                            {{ ('admin.ai.probe.' ~ probe.reason)|trans(probe.placeholders) }}
                        </p>
                    </div>
                {% endif %}
            {% endfor %}

            {{ form_start(form, { attr: { 'data-turbo-frame': 'admin-ai' } }) }}
                <div class="space-y-4">
                    {# Rendered row by row rather than with form_widget(form),
                       for one reason: the warm-up button has to sit with the
                       writing model and its keep-alive, and a single
                       form_widget emits all eleven rows in one go with nowhere
                       to put anything between them. The wrapper carries the
                       space-y-5 that modal_form_theme's form_widget_compound
                       adds for a root form, and form_rest() below still emits
                       the CSRF token — dropping it is how this kind of
                       hand-rendered form silently stops validating. #}
                    <div class="space-y-5" data-controller="admin--ai-connection">
                        {{ form_errors(form) }}

                        {{ form_row(form.isEnabled) }}
                        {{ form_row(form.provider) }}
                        {{ form_row(form.baseUrl) }}
                        {{ form_row(form.apiToken) }}

                        {# Folded away, and open only when it is in use or has
                           just been refused. Most installations never need it,
                           and two more boxes between the token and the model
                           are two more things to wonder about on a page that
                           already has plenty. #}
                        <details class="group/headers" {{ (settings.headers is not null or not form.headers.vars.valid) ? 'open' : '' }}>
                            <summary class="inline-flex items-center gap-2 cursor-pointer list-none text-[13px] font-medium text-ink-soft hover:text-ink">
                                <i class="fa-solid fa-chevron-right w-3 text-[10px] text-ink-faint transition-transform group-open/headers:rotate-90" aria-hidden="true"></i>
                                {{ 'admin.ai.headers.summary'|trans }}
                            </summary>
                            <div class="mt-4 space-y-5">
                                {{ form_row(form.headers) }}
                                {% if settings.headers is not null %}
                                    {{ form_row(form.clearHeaders) }}
                                {% else %}
                                    {# Rendered nowhere, on purpose: with nothing
                                       stored there is nothing to remove. Marked
                                       so form_rest() does not print it below. #}
                                    {% do form.clearHeaders.setRendered %}
                                {% endif %}
                            </div>
                        </details>

                        {{ form_row(form.chatModel) }}

                        {# ── What only Ollama can be asked ────────────────
                           How long the model is held, and loading it ahead of
                           time. The OpenAI-compatible dialect has no word for
                           either, so for that provider both are put away — by
                           the server for the saved choice, and by
                           admin--ai-connection when the select changes. See
                           that controller on why hidden and not disabled.

                           A plain wrapper, with no display class: `hidden`
                           loses to one. #}
                        {% set manages_memory = settings.provider.managesMemory %}
                        <div data-admin--ai-connection-target="ollamaOnly" {{ manages_memory ? '' : 'hidden' }}>
                        <div class="space-y-5">
                        {{ form_row(form.chatKeepAlive) }}

                        {# ── Warm up now ──────────────────────────────────
                           Here rather than beside Save, because it is about
                           the two fields above it and nothing else on the
                           page: it loads THAT model and holds it for THAT
                           long. Beside Save it would read as another way of
                           submitting the form, which it is not — it writes
                           nothing, and it acts on what is stored rather than
                           on what is on screen.

                           type="button", so a stray Enter in a text field
                           above cannot make it the form's default submit. #}
                        <div data-controller="admin--ai-warmup"
                             data-admin--ai-warmup-url-value="{{ path('app_admin_ai_warmup') }}"
                             data-admin--ai-warmup-csrf-value="{{ csrf_token('admin-ai-warmup') }}"
                             data-admin--ai-warmup-idle-label-value="{{ 'admin.ai.warmup.button'|trans }}"
                             data-admin--ai-warmup-busy-label-value="{{ 'admin.ai.warmup.loading'|trans }}"
                             data-admin--ai-warmup-failed-label-value="{{ 'admin.ai.warmup.failed'|trans }}"
                             class="flex flex-wrap items-center gap-x-3 gap-y-1.5">

                            <button type="button"
                                    data-admin--ai-warmup-target="button"
                                    data-action="admin--ai-warmup#warmUp"
                                    class="inline-flex items-center gap-2 h-8 px-3 rounded-lg text-[13px] font-medium
                                           btn-quiet transition-colors cursor-pointer
                                           disabled:opacity-50 disabled:cursor-not-allowed">
                                {# Each icon is WRAPPED, and the wrapper is what
                                   gets hidden. Font Awesome's own rule sets
                                   `display: var(--fa-display, inline-block)` on
                                   the <i>, which beats the `hidden` attribute's
                                   UA `display: none` — so hiding the <i>
                                   directly leaves both icons on screen at once,
                                   the same cascade trap as Tailwind's `.hidden`
                                   losing to `.inline-block`. A bare <span> has
                                   no display rule of its own and obeys. #}
                                <span data-admin--ai-warmup-target="icon">
                                    <i class="fa-solid fa-fire text-xs" aria-hidden="true"></i>
                                </span>
                                <span data-admin--ai-warmup-target="spinner" hidden>
                                    <i class="fa-solid fa-circle-notch fa-spin text-xs" aria-hidden="true"></i>
                                </span>
                                <span data-admin--ai-warmup-target="label">{{ 'admin.ai.warmup.button'|trans }}</span>
                            </button>

                            {# aria-live, because the answer arrives up to a
                               minute after the click and a screen reader user
                               who has moved on would otherwise never learn
                               what happened. Polite: it is a result, not an
                               interruption. #}
                            <p data-admin--ai-warmup-target="result"
                               role="status"
                               aria-live="polite"
                               hidden
                               class="text-[12px] leading-snug"></p>
                        </div>
                        </div>
                        </div>

                        {# The model, its query instruction and its threshold
                           are one decision written in three boxes: any two of
                           them from different models produce a search that is
                           confidently wrong rather than obviously broken. So
                           they sit together, under a row of presets that fills
                           all three at once. See EmbeddingPreset for the
                           measurements behind each. #}
                        {# ── Search on a host of its own ─────────────────────
                           One tick, and the same four fields the host above
                           has. Put away until it is ticked, because it is off
                           on nearly every installation and four more boxes
                           about a second host would make the first one look
                           unfinished. Set in from the tick box so they read as
                           belonging to it.

                           A plain outer wrapper again: the inner one has the
                           layout classes, and `hidden` would lose to them. #}
                        {{ form_row(form.embeddingOwnConnection) }}
                        <div data-admin--ai-connection-target="searchOwn" {{ settings.embeddingOwnConnection ? '' : 'hidden' }}>
                            <div class="flex flex-col gap-5 pl-4 border-l border-subtle">
                                {{ form_row(form.embeddingProvider) }}
                                {{ form_row(form.embeddingBaseUrl) }}
                                {{ form_row(form.embeddingApiToken) }}

                                <details class="group/search-headers" {{ (settings.embeddingHeaders is not null or not form.embeddingHeaders.vars.valid) ? 'open' : '' }}>
                                    <summary class="inline-flex items-center gap-2 cursor-pointer list-none text-[13px] font-medium text-ink-soft hover:text-ink">
                                        <i class="fa-solid fa-chevron-right w-3 text-[10px] text-ink-faint transition-transform group-open/search-headers:rotate-90" aria-hidden="true"></i>
                                        {{ 'admin.ai.headers.summary'|trans }}
                                    </summary>
                                    <div class="mt-4 space-y-5">
                                        {{ form_row(form.embeddingHeaders) }}
                                        {% if settings.embeddingHeaders is not null %}
                                            {{ form_row(form.clearEmbeddingHeaders) }}
                                        {% else %}
                                            {% do form.clearEmbeddingHeaders.setRendered %}
                                        {% endif %}
                                    </div>
                                </details>
                            </div>
                        </div>

                        <div data-controller="admin--embedding-preset"
                             class="flex flex-col gap-3">
                            {{ form_row(form.embeddingModel) }}

                            {# Autocomplete on the free-text field. A closed
                               dropdown would refuse a model that works; this
                               only offers. #}
                            <datalist id="embedding-model-presets">
                                {% for preset in embedding_presets() %}
                                    <option value="{{ preset.model }}"></option>
                                {% endfor %}
                            </datalist>

                            <div class="flex flex-col gap-1.5">
                                <p class="text-[12px] text-muted">{{ 'admin.ai.embedding_preset.heading'|trans }}</p>

                                {% for preset in embedding_presets() %}
                                    <button type="button"
                                            data-action="admin--embedding-preset#apply"
                                            data-model="{{ preset.model }}"
                                            data-instruction="{{ preset.instruction }}"
                                            data-similarity="{{ preset.similarity }}"
                                            class="text-left rounded-lg border border-subtle px-3 py-2 hover:bg-surface-hover transition-colors cursor-pointer">
                                        <span class="block text-sm font-medium">{{ preset.model }}</span>
                                        <span class="block text-[12px] leading-snug text-muted">{{ preset.summary|trans }}</span>
                                    </button>
                                {% endfor %}
                            </div>

                            {{ form_row(form.searchQueryInstruction) }}
                            {{ form_row(form.semanticMinSimilarity) }}
                        </div>

                        {# The search model's keep-alive follows the host
                           SEARCH runs on, which is the one above unless the
                           tick box says otherwise. #}
                        {% set search_manages_memory = (settings.embeddingOwnConnection ? settings.embeddingProvider : settings.provider).managesMemory %}
                        <div data-admin--ai-connection-target="searchOllamaOnly" {{ search_manages_memory ? '' : 'hidden' }}>
                            {{ form_row(form.embeddingKeepAlive) }}
                        </div>

                        {{ form_row(form.searchEnabled) }}
                        {{ form_row(form.categorisationEnabled) }}

                        {# The two that qualify the switch above, set in from
                           it so they read as belonging to it, and the measured
                           cost directly underneath: holding is a trade of a
                           short wait for mail that never moves tabs, and how
                           short is a property of this host that only a
                           measurement can state. #}
                        <div class="flex flex-col gap-4 pl-4 border-l border-subtle">
                            {{ form_row(form.holdUntilClassified) }}
                            {{ form_row(form.holdMaxSeconds) }}

                            <p class="text-[12px] leading-snug text-muted" data-testid="ai-hold-delay">
                                {% if hold.held > 0 %}
                                    {{ 'admin.ai.hold.measured'|trans({
                                        '%count%':   hold.held,
                                        '%median%':  hold.median|number_format(1),
                                        '%p95%':     hold.p95|number_format(1),
                                        '%timeout%': hold.timedOut,
                                    }) }}
                                {% else %}
                                    {{ 'admin.ai.hold.no_data'|trans }}
                                {% endif %}
                                {# _top: this is inside the settings frame, and
                                   the destination is another section of the page
                                   around it. #}
                                <a href="{{ path('app_admin_dashboard', { section: 'performance' }) }}"
                                   data-turbo-frame="_top"
                                   class="text-accent hover:underline">{{ 'admin.ai.hold.details'|trans }}</a>
                            </p>
                        </div>
                        {{ form_row(form.writingHelpEnabled) }}
                        {{ form_row(form.summaryEnabled) }}

                        {{ form_rest(form) }}
                    </div>

                    <div class="flex flex-wrap justify-end gap-2">
                        {# Same form, different action. `formaction` so the
                           address being tested is the one on screen rather than
                           the one in the database — which is the only moment
                           the answer is worth anything. #}
                        <button type="submit"
                                formaction="{{ path('app_admin_ai_test') }}"
                                class="inline-flex items-center gap-2 h-9 px-4 rounded-lg text-sm font-medium btn-quiet transition-colors cursor-pointer">
                            <i class="fa-solid fa-plug text-xs" aria-hidden="true"></i>
                            {{ 'admin.ai.test'|trans }}
                        </button>

                        <button type="submit"
                                class="inline-flex items-center gap-2 h-9 px-4 rounded-lg text-sm font-medium
                                       text-accent-ink bg-accent hover:bg-accent-strong transition-colors cursor-pointer">
                            <i class="fa-solid fa-floppy-disk text-xs" aria-hidden="true"></i>
                            {{ 'admin.ai.save'|trans }}
                        </button>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </details>

    {# ── The prompts, between the configuration and the telemetry ──────────
       Below the host and the switches because it is the next question in the
       same order somebody sets this up in — is it on, does it answer, and only
       then is it saying the right thing — and above the telemetry because the
       telemetry is what tells you a prompt change was worth making. #}
    {% include 'admin/ai/_prompts.html.twig' %}

    {# ── The search index backfill, under the configuration ────────────────
       The other card that used to sit here — the model host and its recorded
       calls — is on Admin → Performance now, with the other measurements. This
       one stays because it is not a measurement: it has Start and Pause on it.

       It is NOT rendered here. The first paint is a placeholder and the
       controller fetches immediately, which keeps the settings page off the
       critical path of a model host that may be switched off — probing one of
       those from inside this action would hold the whole admin page for as
       long as the timeout, before anybody had typed anything.

       The poll only runs while the master switch is on. Off is a valid
       configuration and there is nothing to watch; the one fetch on connect is
       what renders the card rather than a spinner that never stops. #}
    <div data-controller="admin--ai-status"
         data-admin--ai-status-url-value="{{ path('app_admin_ai_status') }}"
         data-admin--ai-status-part-value="backfill"
         data-admin--ai-status-start-url-value="{{ path('app_admin_ai_backfill', { action: 'start', part: 'backfill' }) }}"
         data-admin--ai-status-pause-url-value="{{ path('app_admin_ai_backfill', { action: 'pause', part: 'backfill' }) }}"
         data-admin--ai-status-resume-url-value="{{ path('app_admin_ai_backfill', { action: 'resume', part: 'backfill' }) }}"
         data-admin--ai-status-interval-value="5000"
         data-admin--ai-status-live-value="{{ settings.isEnabled and settings.isConfigured ? 'true' : 'false' }}">

        <div data-admin--ai-status-target="panel">
            <div class="py-8 text-center text-sm text-ink-faint">
                <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
            </div>
        </div>
    </div>

</turbo-frame>
