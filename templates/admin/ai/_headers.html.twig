<div data-controller="admin--ai-headers" data-ai-headers="{{ field.vars.name }}" class="space-y-3">
    <p class="text-sm font-semibold">{{ 'admin.ai.headers.title'|trans }}</p>
    {{ form_errors(field) }}
    {% set prototype %}{% include 'admin/ai/_header_row.html.twig' with {row: field.vars.prototype} only %}{% endset %}
    <div data-admin--ai-headers-target="rows" class="space-y-3" data-prototype="{{ prototype|e('html_attr') }}" data-index="{{ field|length }}">
        {% for row in field %}{% include 'admin/ai/_header_row.html.twig' with {row: row} only %}{% endfor %}
    </div>
    <button type="button" data-action="admin--ai-headers#add" class="text-sm font-semibold text-accent"><span aria-hidden="true">＋ </span>{{ 'admin.ai.headers.add'|trans }}</button>
    <details class="text-sm"><summary>{{ 'admin.ai.headers.details'|trans }}</summary>
        <div class="space-y-2 mt-2"><p>{{ 'admin.ai.headers.help'|trans }}</p><p>{{ 'admin.ai.headers.embedding_space_help'|trans }}</p></div>
    </details>
</div>
{% do field.setRendered %}
