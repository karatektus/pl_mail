    <li>{{ 'admin.integrations.tutorial.google.step_consent'|trans }}</li>
    <li>{{ 'admin.integrations.tutorial.google.step_credentials'|trans }}</li>
    <li>{{ 'admin.integrations.tutorial.google.step_redirect'|trans }}</li>
    <li>{{ 'admin.integrations.tutorial.google.step_paste'|trans }}</li>
</ol>

<p class="text-xs text-ink-faint">
    <i class="fa-solid fa-triangle-exclamation mr-1" aria-hidden="true"></i>
    {{ 'admin.integrations.tutorial.google_photos.scope_warning'|trans }}
</p>
