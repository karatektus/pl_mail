{#
admin/integrations/_form.html.twig — configure one integration provider.

A Symfony form through the shared modal shell; the fields themselves come from
IntegrationProviderConfigType and the styling from the modal form theme. Only
the redirect URI needs a block, because it is a value to copy rather than a
field to fill in.
#}
{% extends '_layout/app.html.twig' %}

{% block body %}
    {# `only` limits what the overridden blocks can see, so anything they use
       has to be handed over explicitly — provider is not inherited. #}
    {% embed '_partials/_modal_form.html.twig' with {
        form: form,
        title: provider.label,
        provider: provider,
    } only %}
        {% block before_fields %}
            {% if not provider.isImplemented %}
                <div role="status" class="flex items-start gap-2.5 rounded-lg bg-amber-500/10 px-3.5 py-3 text-sm text-amber-500">
                    <i class="fa-solid fa-hammer mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ 'admin.integrations.unimplemented_notice'|trans }}</p>
                </div>
            {% endif %}
        {% endblock %}

        {% block after_fields %}
            {% if provider.authKind.value == 'oauth2' %}
                {# The one value an admin copies out rather than types in, and the
                   one that cannot be changed later without breaking every
                   connection already authorised against it. #}
                <div class="flex flex-col gap-1.5">
                    <span class="block text-[13px] font-medium leading-none text-ink-soft">
                        {{ 'admin.integrations.field.redirect_uri'|trans }}
                    </span>
                    <div class="flex items-center gap-2"
                         data-controller="ui--clipboard"
                         data-ui--clipboard-confirm-text-value="{{ 'clipboard.copied'|trans }}"
                         data-ui--clipboard-failed-text-value="{{ 'clipboard.copy_failed'|trans }}">
                        <code data-ui--clipboard-target="source"
                              class="flex-1 min-w-0 truncate rounded-lg bg-sunken border border-line px-3 py-2 text-xs text-ink-muted">{{ url('app_integration_oauth_callback', { provider: provider.value }) }}</code>
                        <button type="button"
                                data-action="click->ui--clipboard#copy"
                                class="shrink-0 h-9 w-9 flex items-center justify-center rounded-lg text-ink-soft
                                       bg-field border border-field hover:bg-hover transition-colors"
                                aria-label="{{ 'admin.integrations.copy_redirect_uri'|trans }}">
                            <i class="fa-solid fa-copy text-xs" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p class="text-xs text-ink-faint">{{ 'admin.integrations.field.redirect_uri_help'|trans }}</p>
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
