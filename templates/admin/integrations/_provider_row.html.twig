{% import '_partials/_card_chrome.html.twig' as chrome %}
{#
admin/integrations/_provider_row.html.twig — one service in Admin → Integrations.

One row shape for both groups, the file services and the calendar services, so
the two cannot drift apart.

Variables:
  provider        Provider
  config          IntegrationProviderConfig|null
  users           int        connected users
  mailConfigs     array      MailProviderConfig by provider value
  inheritable     array      ProviderConfigWriter::INHERITABLE
  alwaysOffered   bool       a calendar service: every user is offered it, so
                             the chip says so instead of reading isEnabled,
                             which nothing on the calendar side consults
#}
{% set connectable = config is not null and config.isConnectable %}
{# Addressable by id: filtering rows by their visible text kept matching
   the wrong one — "Google Drive" is a substring of nothing here, but
   "Nextcloud" appears in its own tutorial body too. #}
<details id="integration-provider-{{ provider.value }}"
         class="group/int {{ chrome.shell() }}">

    {# h-14 rather than chrome.band(): this summary is a ROW in the list
       that starts with the mail registrations above, and matching their
       height is what keeps it reading as one list. Only the inset is
       shared with the band, which is the part that has to line up with
       the body below. #}
    <summary class="flex items-center gap-3 px-4 h-14 cursor-pointer list-none hover:bg-hover transition-colors select-none">
        <i class="fa-solid fa-chevron-right text-[9px] text-ink-faint w-3 shrink-0
                  transition-transform group-open/int:rotate-90" aria-hidden="true"></i>

        <i class="{{ provider.icon }} text-base w-5 text-center {{ connectable or alwaysOffered ? 'text-accent' : 'text-ink-faint' }}" aria-hidden="true"></i>

        <span class="text-sm font-semibold text-ink">{{ provider.label }}</span>

        {# Status chip. Three states, and they are not the same thing:
           "not available yet" is on us, "disabled" is the admin's
           choice, "needs credentials" is a half-finished setup. A
           calendar service has a fourth: it is offered to everyone, and
           "disabled" would be untrue whatever its row says. #}
        {% if not provider.isImplemented %}
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-muted">
                {{ 'admin.integrations.status.unimplemented'|trans }}
            </span>
        {% elseif alwaysOffered %}
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
                {{ 'admin.integrations.status.always_offered'|trans }}
            </span>
        {% elseif connectable %}
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-500">
                {{ 'admin.integrations.status.enabled'|trans }}
            </span>
        {% elseif config is not null and config.isEnabled %}
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-500">
                {{ 'admin.integrations.status.incomplete'|trans }}
            </span>
        {% else %}
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-raised text-ink-muted">
                {{ 'admin.integrations.status.disabled'|trans }}
            </span>
        {% endif %}

        <span class="ml-auto flex items-center gap-3 text-xs text-ink-faint">
            {% if users > 0 %}
                <span>{{ 'admin.integrations.connected_users'|trans({'%count%': users}) }}</span>
            {% endif %}
            <span class="hidden sm:inline">{{ ('settings.integrations.auth.' ~ provider.authKind.value)|trans }}</span>
        </span>
    </summary>

    <div class="border-t border-line {{ chrome.body() }} space-y-4">

        {# A calendar feed has nothing to configure: every feed is its own address.
           Its row shows an address and a Configure button only while one is stored,
           because that address quietly exempts its host from the private-network
           check, and the form is where it is cleared. #}
        {% set storedAddress = config is not null and config.baseUrl %}
        {% set configurable = provider.value != 'ics' or storedAddress %}

        {% if configurable %}
        {# Current setup, read-only. The secret is never rendered — only
           whether one is on file. #}
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-sm">
            <dt class="text-ink-faint">{{ 'admin.integrations.field.base_url'|trans }}</dt>
            <dd class="text-ink truncate">
                {% if config is not null and config.baseUrl %}
                    <code class="text-xs">{{ config.baseUrl }}</code>
                    <span class="text-xs text-ink-faint">— {{ (provider.value == 'ics' ? 'admin.integrations.base_url_exempt' : 'admin.integrations.base_url_pinned')|trans }}</span>
                {% elseif provider.needsBaseUrl %}
                    <span class="text-ink-faint">{{ 'admin.integrations.base_url_per_user'|trans }}</span>
                {% else %}
                    <span class="text-ink-faint">—</span>
                {% endif %}
            </dd>

            {% if provider.authKind.value == 'oauth2' %}
                <dt class="text-ink-faint">{{ 'admin.integrations.field.client_id'|trans }}</dt>
                <dd class="text-ink truncate">
                    {% if config is not null and config.clientId %}
                        <code class="text-xs">{{ config.clientId }}</code>
                    {% else %}
                        <span class="text-ink-faint">{{ 'admin.integrations.not_set'|trans }}</span>
                    {% endif %}
                </dd>

                <dt class="text-ink-faint">{{ 'admin.integrations.field.client_secret'|trans }}</dt>
                <dd>
                    {% if config is not null and config.hasClientSecret %}
                        <span class="text-emerald-500 text-xs">
                            <i class="fa-solid fa-check mr-1" aria-hidden="true"></i>{{ 'admin.integrations.secret_stored'|trans }}
                        </span>
                    {% else %}
                        <span class="text-ink-faint">{{ 'admin.integrations.not_set'|trans }}</span>
                    {% endif %}
                </dd>
            {% endif %}
        </dl>
        {% endif %}

        {% set mailSource = inheritable[provider.value] ?? null %}
        {% set sourceConfig = mailSource ? (mailConfigs[mailSource] ?? null) : null %}
        {% set inherits = sourceConfig is not null and sourceConfig.isComplete %}

        {# No row of buttons at all when it would be empty: an empty flex row still
           takes its place in space-y-4, and the feed's row has neither button. #}
        {% if configurable or inherits %}
        <div class="flex items-center gap-2 flex-wrap">
            {% if configurable %}
            <button type="button"
                    data-controller="ui--modal"
                    data-ui--modal-src-value="{{ path('app_admin_integrations_edit', { provider: provider.value }) }}"
                    data-ui--modal-title-value="{{ provider.label }}"
                    data-action="click->ui--modal#open"
                    class="inline-flex items-center gap-2 h-8 px-3.5 rounded-lg text-sm font-medium
                           text-ink-soft bg-field border border-field hover:bg-hover transition-colors">
                <i class="fa-solid fa-sliders text-xs" aria-hidden="true"></i>
                {{ 'admin.integrations.configure'|trans }}
            </button>
            {% endif %}

            {# ── Reuse the mail credentials ──
               Offered only when the counterpart is actually configured,
               because a button that explains why it cannot work is worse
               than no button. The copy happens server-side: the secret
               moves between rows and is never sent to the browser. #}
            {% if inherits %}
                <form method="post"
                      action="{{ path('app_admin_integrations_inherit', { provider: provider.value }) }}"
                      data-turbo-stream>
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('admin-integration-inherit-' ~ provider.value) }}">
                    <button type="submit"
                            class="inline-flex items-center gap-2 h-8 px-3.5 rounded-lg text-sm font-medium
                                   text-ink-soft bg-field border border-field hover:bg-hover transition-colors">
                        <i class="fa-solid fa-clone text-xs" aria-hidden="true"></i>
                        {{ 'admin.integrations.inherit'|trans({
                            '%name%': ('admin.integrations.mail.' ~ mailSource)|trans,
                        }) }}
                    </button>
                </form>
            {% endif %}
        </div>
        {% endif %}

        {% if inherits %}
            <p class="text-[11px] text-ink-faint">
                <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
                {{ 'admin.integrations.inherit_help'|trans }}
            </p>
        {% endif %}

        {# Setup tutorial. Written for every provider including the
           unimplemented ones, so the instructions are ready the day a
           driver lands. #}
        <div class="rounded-lg border border-line bg-sunken px-4 py-3">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-faint mb-2">
                {{ 'admin.integrations.tutorial_heading'|trans }}
            </h3>
            <div class="prose-integration text-sm text-ink-muted space-y-2">
                {% include 'admin/integrations/tutorial/_' ~ provider.slug ~ '.html.twig' ignore missing with { provider: provider } only %}
            </div>
        </div>

    </div>
</details>
