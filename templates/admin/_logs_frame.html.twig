{% import '_partials/_card_chrome.html.twig' as chrome %}
{# Opening this frame is what marks the log seen server-side, but the ring that
   clears lives on the user menu — outside this frame, and so never re-rendered
   by loading it. This announces the visit; the topbar listens. #}
{% import '_partials/_select.html.twig' as select %}
<turbo-frame id="admin-logs" data-controller="admin--log-seen">

    {# A container, so the rows below reflow on how wide this pane actually is
       rather than on the viewport. The two are not the same thing here and not
       even monotonic: at 768px the admin section nav appears and takes 180px,
       leaving this pane narrower (266px) than it is on a 390px phone (316px). #}
    <section class="@container {{ chrome.shell() }}">

        <div class="flex flex-wrap items-center gap-3 {{ chrome.band() }}">
            <i class="fa-solid fa-scroll text-xs text-zinc-400" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-ink">{{ 'admin.logs.heading'|trans }}</h2>
            <span class="text-xs text-ink-faint">{{ total }} {{ 'admin.logs.entries'|trans }}</span>

            {# Its own row in a narrow pane, where the two selects plus Refresh
               are wider than it and were being clipped by its overflow-hidden. #}
            <form method="get" action="{{ path('app_admin_logs') }}"
                  class="w-full @2xl:w-auto @2xl:ml-auto flex flex-wrap items-center gap-2" data-controller="ui--auto-submit">
                <select name="level"
                        {{ select.enhance() }}
                        class="select-field h-8 text-xs"
                        data-action="change->ui--auto-submit#submit">
                    {% for value, name in levels %}
                        <option value="{{ value }}" {{ minLevel == value ? 'selected' : '' }}>≥ {{ name }}</option>
                    {% endfor %}
                </select>
                <select name="channel"
                        {{ select.enhance() }}
                        class="select-field h-8 text-xs"
                        data-action="change->ui--auto-submit#submit">
                    <option value="">{{ 'admin.logs.all_channels'|trans }}</option>
                    {% for ch in channels %}
                        <option value="{{ ch }}" {{ channel == ch ? 'selected' : '' }}>{{ ch }}</option>
                    {% endfor %}
                </select>
                <button type="submit"
                        class="inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium btn-quiet transition-colors cursor-pointer">
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                    {{ 'admin.logs.refresh'|trans }}
                </button>
            </form>

            {# Deletes the current filter's entries, not the whole table. #}
            <form method="post" action="{{ path('app_admin_logs_clear') }}" data-turbo-frame="_top"
                  data-turbo-confirm="{{ 'admin.logs.clear_confirm'|trans({ '%count%': total }) }}" data-controller="ui--auto-submit">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_logs_clear') }}">
                <input type="hidden" name="level" value="{{ minLevel }}">
                <input type="hidden" name="channel" value="{{ channel }}">
                <button type="submit"
                        {{ total == 0 ? 'disabled' : '' }}
                        class="inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium btn-quiet hover:text-danger hover:bg-danger-soft transition-colors cursor-pointer disabled:opacity-40 disabled:pointer-events-none">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                    {{ 'admin.logs.clear'|trans }}
                </button>
            </form>
        </div>

        {# ── What is kept, as opposed to what is shown ────────────────────
           A second row, and deliberately not another control in the filter row
           above. The two look alike and mean opposite things: that row narrows
           what is DISPLAYED out of what was stored, this one decides what gets
           stored at all. Putting them side by side would invite an admin to
           change the wrong one and conclude the log is broken.

           Its own form, its own POST, and a full reload rather than a frame
           swap — the setting changes what the very next request writes, so the
           page that reports it has to be a fresh one. #}
        <div class="flex flex-wrap items-center gap-2 px-4 py-2.5 border-t border-line bg-sunken/40">
            <i class="fa-solid fa-database text-[10px] text-ink-faint" aria-hidden="true"></i>
            <span class="text-xs text-ink-muted">{{ 'admin.logs.capture.label'|trans }}</span>

            <form method="post" action="{{ path('app_admin_logs_level') }}" data-turbo-frame="_top"
                  class="flex items-center gap-2" data-controller="ui--auto-submit">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_logs_level') }}">
                <select name="capture"
                        {{ select.enhance() }}
                        class="select-field h-8 text-xs"
                        data-action="change->ui--auto-submit#submit">
                    {# The empty option is how an install gets back to following
                       its environment once a level has been chosen here — see
                       LogSettings on why that is not the same as storing the
                       environment's current value. #}
                    <option value="" {{ capture is null ? 'selected' : '' }}>
                        {{ 'admin.logs.capture.from_env'|trans({ '%level%': captureEnv }) }}
                    </option>
                    {% for value, name in levels %}
                        <option value="{{ name }}" {{ capture == name ? 'selected' : '' }}>≥ {{ name }}</option>
                    {% endfor %}
                </select>
            </form>

            <span class="text-xs text-ink-faint flex-1 min-w-0">
                {{ 'admin.logs.capture.hint'|trans }}
            </span>
        </div>

        {% if entries|length == 0 %}
            <p class="{{ chrome.body() }} text-sm text-ink-faint">{{ 'admin.logs.empty'|trans }}</p>
        {% else %}
            <div class="divide-y divide-line">
                {% for entry in entries %}
                    <details class="px-4 py-2.5 text-sm group">
                        {# Wraps until the pane can seat the message as well as
                           the metadata. Below that the four fixed-width labels
                           are wider than the row on their own, which left the
                           message — the only part anyone is reading — at
                           literally zero width, and clipped the rest. #}
                        <summary class="flex flex-wrap items-center gap-x-3 gap-y-1 @2xl:flex-nowrap cursor-pointer list-none">
                           <span class="shrink-0 w-16 text-center text-[10px] font-semibold uppercase tracking-wide rounded-md px-1.5 py-0.5
                            {{ entry.level >= 400 ? 'badge-danger' : (entry.level >= 300 ? 'badge-warning' : 'badge-neutral') }}">
                                {{ entry.levelName }}
                            </span>
                            <span class="shrink-0 text-xs text-ink-faint font-mono">{{ entry.createdAt|date('m-d H:i:s') }}</span>
                            <span class="shrink-0 text-xs text-ink-faint">{{ entry.source ?? '—' }}</span>
                            <span class="shrink-0 text-xs text-ink-muted font-mono">{{ entry.channel }}</span>
                            {# Last only on one line: while the row wraps the
                               chevron belongs to the metadata line, not to the
                               message line below it. #}
                            <i class="fa-solid fa-chevron-down text-[10px] text-ink-faint transition-transform group-open:rotate-180 ml-auto @2xl:ml-0 @2xl:order-last" aria-hidden="true"></i>
                            <span class="w-full min-w-0 truncate text-ink-soft @2xl:w-auto @2xl:flex-1 group-open:whitespace-normal group-open:break-words">{{ entry.message }}</span>
                        </summary>
                        {% if entry.context %}
                            {# Wrapped rather than scrolled in a narrow pane:
                               pretty printed JSON is several times a phone's
                               width, and a horizontal scroller nested in the
                               page's vertical one is close to unusable by
                               thumb. #}
                            <pre class="mt-2 p-3 rounded-lg bg-sunken border border-line text-xs text-ink-soft overflow-x-auto whitespace-pre-wrap break-words @2xl:whitespace-pre @2xl:break-normal">{{ entry.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                        {% endif %}

                        {# In the expanded region, not on the summary line: a
                           button there would compete with the disclosure for
                           the click. What lands on the clipboard is composed
                           rather than lifted from one element, because an entry
                           is only worth pasting into a bug report with its
                           when, how bad and where from attached — hence the
                           hidden source holding all of it. #}
                        <div class="mt-2 flex justify-end"
                             data-controller="ui--clipboard"
                             data-ui--clipboard-confirm-text-value="{{ 'admin.logs.copied'|trans }}"
                             data-ui--clipboard-failed-text-value="{{ 'admin.logs.copy_failed'|trans }}">
                            <span class="hidden" data-ui--clipboard-target="source">{{ entry.createdAt|date('Y-m-d H:i:s') }} {{ entry.levelName }} {{ entry.channel }}{% if entry.source %} ({{ entry.source }}){% endif %}

{{ entry.message }}{% if entry.context %}


{{ entry.context|json_encode(constant('JSON_PRETTY_PRINT')) }}{% endif %}</span>
                            <button type="button"
                                    data-action="click->ui--clipboard#copy"
                                    class="inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium btn-quiet transition-colors cursor-pointer">
                                <i class="fa-solid fa-copy text-[11px]" aria-hidden="true"></i>
                                <span data-ui--clipboard-target="label">{{ 'admin.logs.copy'|trans }}</span>
                            </button>
                        </div>
                    </details>
                {% endfor %}
            </div>

            {% if pages > 1 %}
                <div class="flex items-center justify-between px-4 py-3 border-t border-line text-xs text-ink-muted">
                    <span>{{ 'admin.logs.page'|trans }} {{ page }} / {{ pages }}</span>
                    <div class="flex items-center gap-2">
                        {% if page > 1 %}
                            <a href="{{ path('app_admin_logs', { level: minLevel, channel: channel, page: page - 1 }) }}"
                               class="px-2.5 h-7 inline-flex items-center rounded-lg btn-quiet transition-colors">
                                {{ 'admin.logs.newer'|trans }}
                            </a>
                        {% endif %}
                        {% if page < pages %}
                            <a href="{{ path('app_admin_logs', { level: minLevel, channel: channel, page: page + 1 }) }}"
                               class="px-2.5 h-7 inline-flex items-center rounded-lg btn-quiet transition-colors">
                                {{ 'admin.logs.older'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}

    </section>

    {# ── What broke in the browser ──────────────────────────────────────────
       Its own card, below the log and not inside it, because these are a
       different kind of thing. A server error is one event in one request; a
       broken line in a controller runs on every page load for every user, so a
       row here is a distinct FAULT with a count and a lifetime rather than an
       occurrence. Merged into the list above, one bug would be four hundred
       rows and the log nobody could read past.

       Most of what a browser reports is not ours — extensions inject scripts
       and those scripts throw — so what reaches this table has been filtered
       twice, in assets/client_errors.js and again in ClientErrorRecorder. An
       empty card is the ordinary state and says so. #}
    <section class="@container {{ chrome.shell() }} mt-3">

        <div class="flex flex-wrap items-center gap-3 {{ chrome.band() }}">
            <i class="fa-solid fa-bug text-xs text-zinc-400" aria-hidden="true"></i>
            <h2 class="text-sm font-semibold text-ink">{{ 'admin.client_errors.heading'|trans }}</h2>
            <span class="text-xs text-ink-faint">
                {{ 'admin.client_errors.count'|trans({'%count%': clientErrorsTotal}) }}
            </span>

            {% if clientErrorsTotal > 0 %}
                <form method="post" action="{{ path('app_admin_client_errors_clear') }}"
                      data-turbo-frame="_top" class="ml-auto"
                      data-turbo-confirm="{{ 'admin.client_errors.clear_confirm'|trans }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_client_errors_clear') }}">
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 h-8 px-3 rounded-pane border border-line
                                   text-[11px] text-ink-muted hover:bg-hover cursor-pointer transition-colors">
                        <i class="fa-solid fa-trash text-[10px]" aria-hidden="true"></i>
                        {{ 'admin.client_errors.clear'|trans }}
                    </button>
                </form>
            {% endif %}
        </div>

        {% if clientErrors is empty %}
            <div class="{{ chrome.body() }}">
                <p class="text-sm text-ink-soft">{{ 'admin.client_errors.empty'|trans }}</p>
                <p class="mt-1 text-xs text-ink-faint leading-relaxed">{{ 'admin.client_errors.empty_hint'|trans }}</p>
            </div>
        {% else %}
            <div class="divide-y divide-line">
                {% for error in clientErrors %}
                    <details class="group">
                        <summary class="flex items-start gap-3 px-4 py-3 cursor-pointer list-none hover:bg-hover/50 transition-colors">
                            <i class="fa-solid fa-chevron-right mt-1 shrink-0 text-[9px] text-ink-faint w-3
                                      transition-transform group-open:rotate-90" aria-hidden="true"></i>

                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                    <span class="text-[10px] font-semibold uppercase tracking-wide rounded-md px-1.5 py-0.5
                                                 {{ error.kind == 'csp' ? 'badge-warning' : 'badge-danger' }}">
                                        {{ ('admin.client_errors.kind.' ~ error.kind)|trans }}
                                    </span>

                                    {# The count is the whole reason these are grouped: one
                                       fault seen twice is a curiosity, the same one seen
                                       four hundred times is what to fix first. #}
                                    <span class="text-[11px] text-ink-muted tabular-nums">
                                        {{ 'admin.client_errors.occurrences'|trans({'%count%': error.occurrences}) }}
                                    </span>

                                    <span class="text-xs text-ink-faint font-mono">{{ error.lastSeenAt|date('Y-m-d H:i') }}</span>
                                </div>

                                <p class="mt-1 text-sm text-ink break-words">{{ error.message }}</p>

                                {% if error.origin %}
                                    <p class="mt-0.5 truncate font-mono text-[11px] text-ink-muted">{{ error.origin }}</p>
                                {% endif %}
                            </div>
                        </summary>

                        <div class="px-4 pb-3 pl-11 space-y-2">
                            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
                                <dt class="text-ink-faint">{{ 'admin.client_errors.first_seen'|trans }}</dt>
                                <dd class="text-ink-soft font-mono">{{ error.firstSeenAt|date('Y-m-d H:i') }}</dd>

                                {% if error.url %}
                                    <dt class="text-ink-faint">{{ 'admin.client_errors.page'|trans }}</dt>
                                    <dd class="text-ink-soft font-mono break-all min-w-0">{{ error.url }}</dd>
                                {% endif %}

                                {% if error.userAgent %}
                                    <dt class="text-ink-faint">{{ 'admin.client_errors.browser'|trans }}</dt>
                                    <dd class="text-ink-soft break-all min-w-0">{{ error.userAgent }}</dd>
                                {% endif %}
                            </dl>

                            {% if error.stack %}
                                <pre class="max-h-72 overflow-auto rounded-lg bg-zinc-500/10 px-3 py-2 text-[11px]
                                            font-mono text-ink-soft whitespace-pre-wrap break-all">{{ error.stack }}</pre>
                            {% endif %}
                        </div>
                    </details>
                {% endfor %}
            </div>
        {% endif %}
    </section>

</turbo-frame>
