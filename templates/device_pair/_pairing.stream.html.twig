{# Replaces the placeholder inside the app-passwords panel with the live code.
   A Turbo stream rather than JSON so this matches every other settings action,
   and so the QR arrives already rendered — the browser never holds the pairing
   code in JavaScript it might log or leak. #}
<turbo-stream action="replace" target="settings-device-pairing">
    <template>
        <div id="settings-device-pairing" class="px-4 py-4 border-b border-line bg-accent-soft/30">
            <p class="text-xs font-semibold text-ink mb-1">
                <i class="fa-solid fa-mobile-screen text-[11px] mr-1" aria-hidden="true"></i>
                {{ 'settings.device_pairing.scan_title'|trans }}
            </p>
            <p class="text-[11px] text-ink-muted mb-3">
                {{ 'settings.device_pairing.scan_hint'|trans }}
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-4">
                {# The SVG is a data URI, so the code never becomes a URL that
                   could land in an access log or a referrer header. #}
                <img src="{{ qr }}" alt="{{ 'settings.device_pairing.qr_alt'|trans }}"
                     class="shrink-0 rounded-lg bg-white p-2" width="220" height="220">

                <div class="min-w-0 flex-1 text-center sm:text-left">
                    <p class="text-[11px] text-ink-muted mb-2">
                        {{ 'settings.device_pairing.expires'|trans({ '%time%': expiresAt|date('H:i') }) }}
                    </p>

                    {# On a phone browser there is no second screen to scan
                       with, so the same code is offered as a link the app
                       opens directly. #}
                    <a href="{{ uri }}"
                       class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg text-xs font-medium
                              bg-accent hover:bg-accent-strong text-white transition-colors">
                        <i class="fa-solid fa-arrow-up-right-from-square text-[11px]" aria-hidden="true"></i>
                        {{ 'settings.device_pairing.open_in_app'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </template>
</turbo-stream>
