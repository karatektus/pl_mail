{% if stays|default(false) %}
<turbo-stream action="replace" target="thread_{{ message is defined ? message.thread.id : thread.id }}"><template>{% include '_partials/_thread_row.html.twig' with {thread: message is defined ? message.thread : thread, unified: unified|default(false)} %}</template></turbo-stream>
{% else %}
<turbo-stream action="remove" target="thread_{{ message is defined ? message.id : thread.id }}">
</turbo-stream>
{% endif %}

{# Archive is a button whose result is a row that is no longer there, which is
   also what a slip of the pointer looks like. The toast says which of the two
   it was and offers the way back. #}
{% if undoToken|default(null) is not null %}
    {% include 'thread/status/_undo_toast.stream.html.twig' with {
        message:   'toast.archived'|trans,
        undoToken: undoToken,
    } only %}
{% endif %}
