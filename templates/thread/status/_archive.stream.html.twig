{# The row that stays: the email's own in the email list (#615), else its
   conversation's — an email archived from an open conversation redraws the
   conversation's row. #}
{% set rowItem = message is defined ? (app.user.conversationView ? message.thread : message) : thread %}
{% if stays|default(false) %}
<turbo-stream action="replace" target="thread_{{ rowItem.id }}"><template>{% include '_partials/_thread_row.html.twig' with {thread: rowItem, unified: unified|default(false)} %}</template></turbo-stream>
{% else %}
<turbo-stream action="remove" target="thread_{{ message is defined ? message.id : thread.id }}">
</turbo-stream>
{% endif %}

{# Archive is a button whose result is a row that is no longer there, which is
   also what a slip of the pointer looks like. The toast says which of the two
   it was and offers the way back. #}
{% if undoToken|default(null) is not null %}
    {% include 'thread/status/_undo_toast.stream.html.twig' with {
        message:   'toast.archived'|trans,
        undoToken: undoToken,
    } only %}
{% endif %}
