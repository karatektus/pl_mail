{#
Reply to a password change: say what happened, and redraw the card.

The toast is the whole report on success — the card comes back with three empty
fields and nothing else to show for it, and a form that simply blanks itself is
indistinguishable from one that lost the submission. On a refusal the card
carries the field errors as well, and the toast says only that nothing was
written; which of the four refusals it was is printed under the field it
belongs to.
#}
<turbo-stream action="append" target="toast-region">
    <template>
        {% include '_partials/_toast.html.twig' with { message: toastMessage|trans, type: toastType } only %}
    </template>
</turbo-stream>

<turbo-stream action="replace" target="settings-password">
    <template>
        <div id="settings-password">
            {% include 'settings/_password.html.twig' with { passwordForm: passwordForm } only %}
        </div>
    </template>
</turbo-stream>
