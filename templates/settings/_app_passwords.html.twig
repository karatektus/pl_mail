{# Where to get the app, right above the button that pairs it: this is the
   moment somebody wants a phone connected, and nothing else in plMail says
   where the app is. Outside #settings-device-pairing, because the pairing
   stream replaces that element and the links should stay while the QR shows.

   The badge is Google's own artwork, served from this instance rather than
   from play.google.com, so opening Settings makes no request to Google. Its
   path is a translation because Google draws one badge per language; the
   catalogues without one point at the English badge. The GitHub link stays
   beside it: the same app is free there, and the Play price is a way to
   support the project, not a gate. #}
<div class="px-4 py-3.5 border-b border-line flex flex-col sm:flex-row sm:items-center gap-3">
    <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold text-ink mb-1">
            <i class="fa-brands fa-android text-[11px] mr-1" aria-hidden="true"></i>
            {{ 'settings.native_apps.android_title'|trans }}
        </p>
        <p class="text-[11px] text-ink-muted">{{ 'settings.native_apps.android_hint'|trans }}</p>
    </div>
    <div class="shrink-0 flex flex-col items-start sm:items-center gap-1">
        <a href="https://play.google.com/store/apps/details?id=de.pluetzner.plmail"
           target="_blank" rel="noopener noreferrer" data-testid="native-apps-play">
            <img src="{{ asset('settings.native_apps.play_badge'|trans) }}"
                 alt="{{ 'settings.native_apps.play_alt'|trans }}"
                 width="155" height="60" class="block h-[60px] w-auto -my-2">
        </a>
        <a href="https://github.com/karatektus/pl_mail_android/releases/latest"
           target="_blank" rel="noopener noreferrer"
           class="text-[11px] text-ink-faint hover:text-ink underline underline-offset-2">
            {{ 'settings.native_apps.github'|trans }}
        </a>
    </div>
</div>

{# Pairing sits above the list because it is the way in that works: the
   alternative is copying 71 characters of hex onto a phone keyboard. The QR
   carries a two-minute single-use code, never the password itself — see
   App\Service\User\DevicePairingService. #}
<div id="settings-device-pairing" class="px-4 py-3.5 border-b border-line">
    {# settings--device-keys seals the keyring for the new device first, when
       this browser has it open; see assets/crypto/pairing.js. #}
    <form method="post" action="{{ path('app_device_pair_issue') }}" data-turbo-stream
          data-controller="settings--device-keys"
          data-action="submit->settings--device-keys#submit"
          data-settings--device-keys-keyring-value="{{ {
              stateUrl:    path('app_keyring_state'),
              unlockUrl:   path('app_keyring_unlock_current'),
              preloginUrl: path('app_login_prelogin'),
              csrf:        csrf_token('keyring'),
              userId:      app.user.id,
              email:       app.user.email,
          }|json_encode }}">
        <input type="hidden" name="_token" value="{{ csrf_token('device-pair') }}">
        <input type="hidden" name="keys" value="" data-settings--device-keys-target="keys">
        <button type="submit"
                class="inline-flex items-center gap-2 px-3 h-9 rounded-lg text-xs font-medium
                       bg-raised hover:bg-hover text-ink border border-line transition-colors cursor-pointer">
            <i class="fa-solid fa-qrcode text-[11px]" aria-hidden="true"></i>
            {{ 'settings.device_pairing.pair_device'|trans }}
        </button>
    </form>
</div>

{# newSecret is set only on the response that just minted it — see ApiTokenController. #}
{% if newSecret is defined and newSecret is not null %}
    <div class="px-4 py-3.5 border-b border-line bg-accent-soft/40">
        <p class="text-xs font-semibold text-ink mb-1">
            <i class="fa-solid fa-key text-[11px] mr-1" aria-hidden="true"></i>
            {{ 'settings.app_passwords.copy_now'|trans }}
        </p>
        <p class="text-[11px] text-ink-muted mb-2">{{ 'settings.app_passwords.copy_now_hint'|trans }}</p>

        <div data-controller="ui--clipboard"
             data-ui--clipboard-confirm-text-value="{{ 'clipboard.copied'|trans }}"
             data-ui--clipboard-failed-text-value="{{ 'clipboard.copy_failed'|trans }}"
             class="flex items-center gap-2">
            <code data-ui--clipboard-target="source"
                  class="flex-1 min-w-0 break-all rounded-lg bg-zinc-500/10 px-3 py-2 text-xs font-mono text-ink select-all">{{ newSecret }}</code>
            <button type="button"
                    data-action="click->ui--clipboard#copy"
                    class="shrink-0 inline-flex items-center gap-1.5 px-3 h-9 rounded-lg text-xs font-medium
                           bg-accent hover:bg-accent-strong text-accent-ink transition-colors cursor-pointer">
                <i class="fa-solid fa-copy text-[11px]" aria-hidden="true"></i>
                <span data-ui--clipboard-target="label">{{ 'settings.app_passwords.copy'|trans }}</span>
            </button>
        </div>
    </div>
{% endif %}

{% if apiTokens is empty %}
    <p class="px-4 py-8 text-center text-sm text-ink-faint italic">
        {{ 'settings.app_passwords.empty'|trans }}
    </p>
{% else %}
    <ul class="divide-y divide-line">
        {% for token in apiTokens %}
            <li class="flex items-center gap-3 px-4 py-3">
                <i class="fa-solid fa-key text-ink-faint text-xs shrink-0" aria-hidden="true"></i>

                <div class="flex-1 min-w-0">
                    <span class="block truncate text-sm text-ink">{{ token.name }}</span>
                    <span class="block text-[11px] text-ink-faint font-mono">{{ token.masked }}</span>
                </div>

                <span class="shrink-0 text-[11px] text-ink-faint hidden sm:block">
                    {% if token.lastUsedAt %}
                        {{ 'settings.app_passwords.last_used'|trans({ '%date%': token.lastUsedAt|date('Y-m-d H:i') }) }}
                    {% else %}
                        {{ 'settings.app_passwords.never_used'|trans }}
                    {% endif %}
                </span>

                <form method="post" action="{{ path('app_api_token_revoke', { id: token.id }) }}"
                      data-turbo-stream class="shrink-0"
                      data-turbo-confirm="{{ 'settings.app_passwords.revoke_confirm'|trans({ '%name%': token.name }) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('app-password-revoke' ~ token.id) }}">
                    <button type="submit"
                            class="text-[11px] text-ink-faint hover:text-red-400 transition-colors cursor-pointer">
                        {{ 'settings.app_passwords.revoke'|trans }}
                    </button>
                </form>
            </li>
        {% endfor %}
    </ul>
{% endif %}

{#
The name field renders through ApiTokenType rather than by hand: this endpoint
mints a working credential, and a Symfony form is what carries the CSRF token.
The label is suppressed — the placeholder and the button already say what the
single field is, and a label would push this inline row onto two lines.
#}
<div class="px-4 py-3.5 border-t border-line">
    {{ form_start(apiTokenForm, {
        action: path('app_api_token_create'),
        attr: { 'data-turbo-stream': true, class: 'flex items-end gap-2' }
    }) }}
        <div class="flex-1 min-w-0">
            {{ form_widget(apiTokenForm.name) }}
        </div>
        <button type="submit"
                class="shrink-0 inline-flex items-center gap-2 px-3 h-9 rounded-lg text-sm font-medium
                       bg-accent hover:bg-accent-strong text-accent-ink transition-colors cursor-pointer">
            <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
            {{ 'settings.app_passwords.generate'|trans }}
        </button>
    {{ form_end(apiTokenForm) }}
</div>
