{# The folders modal: which of an IMAP account's folders plMail fetches.

   Same shell as account/_edit_modal.html.twig. The list is a tree and is
   drawn as one: no rules between the rows, which the Labels pane's list has
   and this one began with — a hairline under every row cut each of the tree's
   verticals into dashes and made the two sets of lines fight. What separates
   one row from the next here is the row under the pointer lighting up. There is no form around it — each row carries its own, and a
   form inside a form is not HTML — and no footer: every switch has done its
   work the moment it is pressed, and the modal's own header closes it, as it
   does for the calendar's read-only dialogs.

   Above the list, New folder (#221), and after a folder action the sentence
   saying what it did (`notice`) or why it did not (`error`). #}
{% extends '_layout/app.html.twig' %}

{% block body %}
    <turbo-frame id="modal">
        <template data-ui--modal-frame-title>{{ 'settings.accounts.folders.title'|trans({ '%account%': account.displayAddress }) }}</template>

        <div class="flex-1 min-h-0 overflow-y-auto pb-2">
            <div class="flex items-start gap-3 px-6 pb-3">
                <p class="flex-1 text-xs text-ink-faint">{{ 'settings.accounts.folders.intro'|trans }}</p>

                {# A folder is made here, in the account's own tree, and nowhere
                   else (#221): making a label never makes a folder. #}
                <a href="{{ path('settings_account_folder_new', { id: account.id }) }}"
                   data-turbo-frame="modal"
                   data-folder-new
                   class="shrink-0 inline-flex items-center gap-1.5 px-2.5 h-7 rounded-lg text-xs font-medium bg-accent hover:bg-accent-strong text-accent-ink transition-colors">
                    <i class="fa-solid fa-folder-plus text-[10px]" aria-hidden="true"></i>
                    {{ 'settings.accounts.folders.new.button'|trans }}
                </a>
            </div>

            {% if error|default(null) is not null %}
                <div role="alert" data-folder-error class="mx-6 mb-3 flex items-start gap-2.5 rounded-lg alert-danger px-3.5 py-2 text-sm text-danger">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ error }}</p>
                </div>
            {% endif %}

            {% if notice|default(null) is not null %}
                <p role="status" data-folder-notice class="mx-6 mb-3 rounded-lg bg-success/10 px-3.5 py-2 text-sm text-success">
                    <i class="fa-solid fa-check mr-1" aria-hidden="true"></i>{{ notice }}
                </p>
            {% endif %}

            {% if rows is empty %}
                <p class="px-4 py-8 text-center text-sm text-ink-faint italic">
                    {{ 'settings.accounts.folders.empty'|trans }}
                </p>
            {% else %}
                {# The dialog is opened at its `narrow` width (see the button in
                   settings/_accounts.html.twig): a row is a name and a switch,
                   and at the usual width the switch sat a hand's breadth from
                   the name it belongs to — far enough to press the one on the
                   line above. #}
                <ul class="py-1">
                    {# Striped: with no rules between the rows, every second one
                       is tinted so the eye can follow a name across to its
                       switch — starting with the first, so the list opens on a
                       band that sets it off from the explanation above it. A tint sits behind the tree's lines where a rule
                       cut through them. #}
                    {% for row in rows %}
                        <li class="odd:bg-raised">
                            {{ include('settings/accounts/_folder_row.html.twig', { account: account, row: row }) }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </turbo-frame>
{% endblock %}
