{# Where a new folder goes: "Top level", or inside any folder the server listed
   (#221). New folder and "Make it a folder" both draw it, preselected with the
   account's last choice (NewFolderPlace).

   Variables:
     rows        list<FolderTreeRow>  the account's tree
     selectedId  int|null             the preselected folder, null for the top level
     id          string               the select's id
     label       string               what the select is called, already translated
     help        string|null          a line under it, already translated #}
<div class="space-y-1.5">
    <label for="{{ id }}" class="block text-xs font-medium text-ink-soft">{{ label }}</label>
    <select id="{{ id }}" name="parent" class="select-field w-full h-9 text-sm" data-folder-place>
        <option value="" {{ selectedId is null ? 'selected' : '' }}>{{ 'settings.accounts.folders.new.top_level'|trans }}</option>
        {% for row in rows %}
            {% set m = row.mailbox %}
            {# Indented with non-breaking spaces, the one way an <option> can
               show a tree. #}
            <option value="{{ m.id }}" {{ selectedId == m.id ? 'selected' : '' }}>
                {%- if row.depth > 0 %}{% for i in 1..row.depth %}&nbsp;&nbsp;&nbsp;{% endfor %}{% endif -%}
                {{ m.label and m.specialUse ? m.label|label_name : m.name }}
            </option>
        {% endfor %}
    </select>
    {% if help|default(null) is not null %}
        <p class="text-xs text-ink-muted">{{ help }}</p>
    {% endif %}
</div>
