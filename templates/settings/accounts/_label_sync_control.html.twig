{# Compact label-sync control for a single account row in the accounts list.

   Include with just the account:

       {{ include('settings/accounts/_label_sync_control.html.twig', {account: account}) }}

   Renders nothing for providers that cannot mirror label structure (IMAP), so
   no conditional is needed at the call site.

   NOTE: `class="contents"` on the turbo-frame is load-bearing — same reason as
   _push_control.html.twig: <turbo-frame> is display:block and would otherwise
   break out of the row's flex layout. #}

<turbo-frame id="account-label-sync-{{ account.id }}" class="contents">
    {% if account.supportsLabelSync %}
        {% set enabled = account.labelSyncEnabled %}

        {% set tooltip = enabled
            ? 'settings.accounts.label_sync.on_hint'|trans
            : 'settings.accounts.label_sync.off_hint'|trans %}

        <form method="post"
              action="{{ path('settings_account_label_sync_toggle', {id: account.id}) }}"
              class="contents">
            <input type="hidden" name="_token" value="{{ csrf_token('account_label_sync_' ~ account.id) }}">

            <button type="submit"
                    title="{{ tooltip }}"
                    aria-label="{{ 'settings.accounts.label_sync.title'|trans }}"
                    aria-pressed="{{ enabled ? 'true' : 'false' }}"
                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-sm transition-colors
                           focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500
                           {% if enabled %}
                               text-emerald-600 hover:bg-emerald-100/60 dark:text-emerald-400 dark:hover:bg-emerald-950/40
                           {% else %}
                               text-zinc-400 hover:bg-zinc-100/60 dark:text-zinc-500 dark:hover:bg-zinc-800/60
                           {% endif %}">
                <i class="fa-solid fa-tags"></i>
            </button>
        </form>
    {% endif %}
</turbo-frame>
