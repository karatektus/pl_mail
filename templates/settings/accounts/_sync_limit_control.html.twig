{# Compact sync-limit control for a single account row in the accounts list.

   Include with just the account:

       {{ include('settings/accounts/_sync_limit_control.html.twig', {account: account}) }}

   Renders nothing for providers that cannot cap a sync (Microsoft), so no
   conditional is needed at the call site.

   NOTE: `class="contents"` on the turbo-frame is load-bearing — same reason as
   _push_control.html.twig: <turbo-frame> is display:block and would otherwise
   break out of the row's flex layout. #}

<turbo-frame id="account-sync-limit-{{ account.id }}" class="contents">
    {% if account.supportsSyncLimit %}
        {% set limit = account.syncLimit %}

        {% set tooltip = limit == 0
            ? 'settings.accounts.sync_limit.off_hint'|trans
            : 'settings.accounts.sync_limit.on_hint'|trans({'%limit%': limit|number_format}) %}

        <form method="post"
              action="{{ path('settings_account_sync_limit', {id: account.id}) }}"
              class="contents">
            <input type="hidden" name="_token" value="{{ csrf_token('account_sync_limit_' ~ account.id) }}">

            <select name="limit"
                    title="{{ tooltip }}"
                    aria-label="{{ 'settings.accounts.sync_limit.title'|trans }}"
                    onchange="this.form.requestSubmit();"
                    class="select-field h-8 shrink-0 text-xs
                           {{ limit == 0 ? 'text-ink-faint' : 'text-ink-soft' }}">
                {% for choice in constant('App\\Entity\\Mail\\Account::SYNC_LIMIT_CHOICES') %}
                    <option value="{{ choice }}" {{ limit == choice ? 'selected' : '' }}>
                        {{ choice == 0
                            ? 'settings.accounts.sync_limit.all'|trans
                            : 'settings.accounts.sync_limit.newest'|trans({'%limit%': choice|number_format}) }}
                    </option>
                {% endfor %}
            </select>
        </form>
    {% endif %}
</turbo-frame>
