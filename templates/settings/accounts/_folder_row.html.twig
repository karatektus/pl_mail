{# One folder's sync switch, a row of the folders modal.

   Include with the account and the mailbox:

       {{ include('settings/accounts/_folder_row.html.twig', {account: account, mailbox: mailbox}) }}

   The toggle answers with this same partial, so the frame replaces itself and
   nothing else on the page moves.

   The name is the folder's label name, as the sidebar and the Labels list
   print it, so a system folder reads "Drafts" or "Entwürfe" here exactly as it
   does there; the stored name is only the fallback for a folder with no label.

   The inbox gets the control but disabled and with no form behind it: it is
   always synced, and a switch that is simply absent would leave the row
   looking unfinished next to its siblings. #}

{% set isInbox = mailbox.specialUse is same as enum('App\\Domain\\Enum\\Mail\\MailboxSpecialUse').INBOX %}
{% set folderName = mailbox.label ? mailbox.label|label_name : mailbox.name %}
{% set enabled = mailbox.isSyncEnabled %}
{% set switchLabel = isInbox
    ? 'settings.accounts.folders.always_synced'|trans
    : (enabled
        ? 'settings.accounts.folders.stop_sync'|trans({ '%folder%': folderName })
        : 'settings.accounts.folders.start_sync'|trans({ '%folder%': folderName })) %}

<turbo-frame id="account-folder-sync-{{ mailbox.id }}" class="flex items-center gap-3 px-4 py-1.5">
    <i class="fa-solid fa-folder w-3.5 text-xs text-ink-faint shrink-0" aria-hidden="true"></i>

    <span class="flex-1 min-w-0 truncate text-sm {{ enabled ? 'text-ink' : 'text-ink-faint' }}">
        {{ folderName }}
    </span>

    {% if isInbox %}
        <button type="button" disabled
                class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint disabled:cursor-not-allowed disabled:opacity-40"
                aria-label="{{ switchLabel }}" title="{{ switchLabel }}">
            <i class="fa-solid fa-toggle-on text-base" aria-hidden="true"></i>
        </button>
    {% else %}
        {# data-ui--modal-keep-open: the modal closes on every successful submit,
           which is right for a form and wrong for a switch — this one answers
           with the row, and the list is meant to stay open for the next. #}
        <form method="post" action="{{ path('settings_account_folder_sync_toggle', { id: account.id, mailbox: mailbox.id }) }}" class="contents" data-ui--modal-keep-open>
            <input type="hidden" name="_token" value="{{ csrf_token('account_folder_sync_' ~ mailbox.id) }}">
            <button type="submit"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                    aria-label="{{ switchLabel }}" title="{{ switchLabel }}">
                <i class="fa-solid {{ enabled ? 'fa-toggle-on text-success' : 'fa-toggle-off' }} text-base" aria-hidden="true"></i>
            </button>
        </form>
    {% endif %}
</turbo-frame>
