{% extends '_layout/app.html.twig' %}

{% block title %}{{ 'settings.title'|trans }} — {{ 'app.name'|trans }}{% endblock %}
{# No override any more. This one existed to drop mail--mail-pane, and named
   `mercure` — an identifier that stopped existing when the controllers were
   grouped into directories, so settings pages have had no live updates since.
   The default is core--mercure alone, which is what this page wanted. #}
{% block body %}
    <div class="h-screen overflow-hidden app-bg"
         data-controller="ui--sidebar-drawer">

        {# Mobile backdrop #}
        <div data-ui--sidebar-drawer-target="backdrop" data-action="click->ui--sidebar-drawer#backdropClick"
             class="md:hidden fixed inset-0 z-30 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
             aria-hidden="true"></div>

        {# Mobile sidebar drawer #}
        <div data-ui--sidebar-drawer-target="drawer"
             class="md:hidden fixed inset-y-0 left-0 z-40 w-64 p-3 -translate-x-full transition-transform duration-200 ease-out">
            {% include '_partials/_sidebar.html.twig' with { _drawerMode: true } %}
        </div>

        <div class="shell-frame flex h-full flex-col p-gutter gap-gutter">

            {% include '_partials/_topbar.html.twig' %}

            <div class="flex flex-1 gap-gutter overflow-hidden">

                {# Sidebar — desktop #}
                <div class="hidden md:flex">
                    {% include '_partials/_sidebar.html.twig' %}
                </div>

                {# Main content pane — settings #}
                <div class="flex flex-1 overflow-hidden main-pane">
                    <div class="flex flex-col flex-1 overflow-hidden">

                        {# Pane header #}
                        <div class="flex items-center gap-3 px-6 h-14 border-b border-line shrink-0">
                            <i class="fa-solid fa-gear text-zinc-400" aria-hidden="true"></i>
                            <h1 class="text-base font-semibold text-ink">{{ 'settings.title'|trans }}</h1>
                        </div>

                        {# Scrollable body: section nav + content.
                           IMPORTANT: this grid must have exactly TWO children —
                           the nav and ONE content wrapper. A third child wraps
                           into the 180px nav column on the next grid row. #}
                        <div class="flex-1 overflow-y-auto @container">
                            <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-6 px-6 py-6">

                                {# Grouped by what the setting is about, not by when it was
                                   added — thirteen equal-weight links in one column is a list
                                   nobody reads, they scan it for a word they already have in
                                   mind. Four groups, in the order someone new meets them:
                                   themselves, their mail, their calendar, and finally what
                                   else can reach the account. Security closes the list rather
                                   than sitting third: it is the section people arrive at
                                   deliberately, and it has the two neighbours it belongs with
                                   — app passwords and integrations are the other two ways in.

                                   Sharing stays next to Calendars rather than moving to that
                                   last group: a shared link and a booking page are calendar
                                   features first, and somebody looking for "who can see my
                                   calendar" starts at the calendar.

                                   A loop rather than thirteen hand-written anchors, because
                                   the previous copy-paste had already drifted — two sections
                                   shared one icon and one of them highlighted it a different
                                   colour when active. #}
                                {% set navGroups = [
                                    { label: 'settings.nav.group.personal', items: [
                                        { section: 'profile',       icon: 'fa-solid fa-user' },
                                        { section: 'general',       icon: 'fa-solid fa-sliders' },
                                        { section: 'appearance',    icon: 'fa-solid fa-palette' },
                                    ] },
                                    { label: 'settings.nav.group.mail', items: [
                                        { section: 'accounts',      icon: 'fa-solid fa-at',    label: 'settings.nav.accounts' },
                                        { section: 'aliases',       icon: 'fa-solid fa-user-tag' },
                                        { section: 'labels',        icon: 'fa-solid fa-tag' },
                                        { section: 'filters',       icon: 'fa-solid fa-filter' },
                                        { section: 'notifications', icon: 'fa-solid fa-bell' },
                                    ] },
                                    { label: 'settings.nav.group.calendar', items: [
                                        { section: 'calendars',     icon: 'fa-regular fa-calendar' },
                                        { section: 'sharing',       icon: 'fa-solid fa-share-nodes' },
                                    ] },
                                    { label: 'settings.nav.group.access', items: [
                                        { section: 'integrations',  icon: 'fa-solid fa-plug' },
                                        { section: 'app-passwords', icon: 'fa-solid fa-key',   label: 'settings.nav.app_passwords' },
                                        { section: 'security',      icon: 'fa-solid fa-shield-halved' },
                                    ] },
                                ] %}

                                {# Not a <nav> per group: it is one navigation with four
                                   labelled parts, and four landmarks would be read out as
                                   four separate menus. The headings are presentational —
                                   aria-hidden, with the same word given to the list it
                                   labels — so a screen reader hears "Mail, list, 5 items"
                                   once instead of the word twice. #}
                                <nav class="flex md:flex-col gap-1 flex-wrap md:gap-0">
                                    {% set navActive   = 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium bg-raised text-ink' %}
                                    {% set navInactive = 'flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-ink-muted hover:bg-hover transition-colors' %}

                                    {% for group in navGroups %}
                                        {# Wraps into a row on mobile, where the nav is a
                                           horizontal strip and a heading per group would cost
                                           more width than the links it introduces. #}
                                        <div class="hidden md:block px-3 text-[11px] font-semibold uppercase tracking-wide text-ink-faint {{ loop.first ? 'pb-1.5' : 'pt-4 pb-1.5' }}"
                                             aria-hidden="true">
                                            {{ group.label|trans }}
                                        </div>

                                        <ul class="contents md:block md:space-y-1" aria-label="{{ group.label|trans }}">
                                            {% for item in group.items %}
                                                <li class="contents md:block">
                                                    <a href="{{ path('app_settings_index', { section: item.section }) }}"
                                                       class="{{ section == item.section ? navActive : navInactive }}"
                                                       {{ section == item.section ? 'aria-current="page"' : '' }}>
                                                        <i class="{{ item.icon }} w-4 {{ section == item.section ? 'text-zinc-400' : '' }}" aria-hidden="true"></i>
                                                        {{ (item.label|default('settings.nav.' ~ item.section))|trans }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endfor %}
                                </nav>

                                {# Single content wrapper — second (and last) grid child.

                                   The negative margin cancels the wrapper's px-6 for this
                                   child only, so the section cards run to the pane's edges
                                   and their own px-4/px-5 is the single inset left. Nesting
                                   a card inside a padded page cost 40px a side otherwise,
                                   which on a 360px screen is spent before any content. The
                                   nav keeps its padding: it is the other grid child and
                                   reads as chrome rather than as a card. Restored above
                                   42rem of pane, where the space is not scarce and a card
                                   flush to the edge only looks unfinished.

                                   Container query rather than a breakpoint, for the reason
                                   the admin page documents: this pane is not as wide as the
                                   window, and at md the mail sidebar appears and takes from
                                   it, so pane width and viewport width do not move
                                   together. #}
                                <div class="min-w-0 -mx-6 @2xl:mx-0">
                                    {% if section == 'appearance' %}
                                        {% include 'settings/_appearance.html.twig' %}
                                    {% elseif section == 'profile' %}
                                        {% include 'settings/_profile.html.twig' %}
                                    {% elseif section == 'security' %}
                                        {% include 'settings/_security.html.twig' %}
                                    {% elseif section == 'general' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.language.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.language.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                {% include 'settings/_language.html.twig' with {
                                                    locales: locales,
                                                    activeLocale: activeLocale,
                                                } %}
                                            </div>

                                            <div class="mb-4 mt-8 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.timezone.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.timezone.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                {% include 'settings/_timezone.html.twig' with {
                                                    timezoneGroups: timezoneGroups,
                                                    activeTimezone: activeTimezone,
                                                    defaultTimezone: defaultTimezone,
                                                    currentTime: currentTime,
                                                } %}
                                            </div>

                                            {# Under the zone rather than beside the language: the two
                                               together answer "what time is it, and how is it
                                               written", and somebody fixing one has usually come to
                                               fix the other. #}
                                            <div class="mb-4 mt-8 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.clock.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.clock.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                {% include 'settings/_clock.html.twig' with {
                                                    clockOptions: clockOptions,
                                                    activeClock: activeClock,
                                                    defaultClock: defaultClock,
                                                } %}
                                            </div>
                                        </section>
                                    {% elseif section == 'aliases' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.aliases.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.aliases.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                <div id="settings-alias-list">
                                                    {% include 'settings/_aliases.html.twig' with {
                                                        manageableAccounts: manageableAccounts,
                                                        aliasForms: aliasForms,
                                                    } %}
                                                </div>

                                            </div>
                                        </section>

                                        {# Per-alias compose defaults, under the alias list
                                           because every control in it is captioned by an
                                           address from the list above. #}
                                        <section class="mt-8">
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.compose_defaults.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.compose_defaults.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                <div id="settings-compose-defaults">
                                                    {% include 'settings/_compose_defaults.html.twig' with {
                                                        manageableAccounts: manageableAccounts,
                                                    } %}
                                                </div>
                                            </div>
                                        </section>
                                    {% elseif section == 'filters' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.filters.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.filters.subheading'|trans }}</p>
                                            </div>

                                            {# A frame, so a run in progress can re-read itself without
                                               a full navigation. Its src is the same partial the stream
                                               replaces, so both paths render one template. #}
                                            <turbo-frame id="settings-filter-frame"
                                                         src="{{ path('app_settings_filters_list') }}"
                                                         class="block rounded-pane border border-line overflow-hidden">
                                                <div id="settings-filter-list">
                                                    {% include 'settings/_filters.html.twig' with { rules: rules, labels: labels } %}
                                                </div>
                                            </turbo-frame>

                                            {# The editor opens below the list rather than replacing it, so the
                                               rule being edited stays visible next to its siblings. #}
                                            <div class="mt-4">
                                                {% include 'settings/filters/_editor_empty.html.twig' %}
                                            </div>
                                        </section>

                                    {% elseif section == 'notifications' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.notifications.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.notifications.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                {% include 'settings/_notifications.html.twig' with {
                                                    vapidPublicKey: vapidPublicKey,
                                                } %}

                                                {# In the same pane as the
                                                   toggle, because they are one
                                                   subject: the toggle registers
                                                   this browser, and the list
                                                   below is what registering has
                                                   produced across every device. #}
                                                {# Wrapped in an id because removing
                                                   a device replaces the whole list
                                                   over Turbo — see
                                                   push_device/_mutation.stream.html.twig. #}
                                                <div id="settings-push-device-list">
                                                    {% include 'settings/_push_devices.html.twig' with {
                                                        devices: pushDevices,
                                                        lastDeliveries: lastDeliveries,
                                                    } %}
                                                </div>
                                            </div>
                                        </section>

                                    {% elseif section == 'app-passwords' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.app_passwords.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.app_passwords.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                <div id="settings-app-password-list">
                                                    {% include 'settings/_app_passwords.html.twig' with {
                                                        apiTokens: apiTokens,
                                                        apiTokenForm: apiTokenForm,
                                                    } %}
                                                </div>
                                            </div>

                                            <div class="mt-4 rounded-pane border border-line px-4 py-3.5">
                                                <h3 class="text-xs font-semibold text-ink mb-1">{{ 'settings.app_passwords.setup_heading'|trans }}</h3>
                                                <p class="text-[11px] text-ink-muted leading-relaxed">
                                                    {{ 'settings.app_passwords.setup_hint'|trans }}
                                                </p>
                                                <code class="mt-2 block break-all rounded-lg bg-zinc-500/10 px-3 py-2 text-[11px] font-mono text-ink select-all">{{ app.request.schemeAndHttpHost }}/jmap/session</code>
                                            </div>
                                        </section>

                                    {% elseif section == 'integrations' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.integrations.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.integrations.subheading'|trans }}</p>
                                            </div>

                                            {# Loaded through its own frame rather than rendered inline:
                                               every mutation replaces the frame, and the connect form
                                               posts a Turbo Stream that needs a stable target. #}
                                            <turbo-frame id="settings-integrations-frame"
                                                         src="{{ path('app_settings_integrations_list') }}"
                                                         loading="lazy"
                                                         class="block space-y-6">
                                                <div class="py-10 text-center text-sm text-ink-faint">
                                                    <i class="fa-solid fa-circle-notch fa-spin mr-2" aria-hidden="true"></i>{{ 'admin.loading'|trans }}
                                                </div>
                                            </turbo-frame>
                                        </section>

                                    {% elseif section == 'labels' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.labels.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.labels.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                <div id="settings-label-list">
                                                    {% include 'settings/_labels.html.twig' with { labels: labels } %}
                                                </div>
                                            </div>
                                        </section>

                                    {% elseif section == 'sharing' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.sharing.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.sharing.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                {# The stream's target, re-emitted inside its own
                                                   replacement for the reason the calendar list
                                                   below states. Both halves of the section live
                                                   inside it, so creating a booking page redraws
                                                   the links too and neither can go stale behind
                                                   the other. #}
                                                <div id="settings-sharing-list">
                                                    {% include 'settings/sharing/_lists.html.twig' with {
                                                        shareLinks: shareLinks|default([]),
                                                        bookingPages: bookingPages|default([]),
                                                        mintedLinkUrl: null,
                                                        mintedBookingUrl: null,
                                                    } only %}
                                                </div>
                                            </div>
                                        </section>

                                    {% elseif section == 'calendars' %}
                                        <section>
                                            <div class="mb-4 px-4 @2xl:px-0">
                                                <h2 class="text-sm font-semibold text-ink">{{ 'settings.calendars.heading'|trans }}</h2>
                                                <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.calendars.subheading'|trans }}</p>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                {# The id is the stream's target, so it wraps the
                                                   partial here and is re-emitted inside the
                                                   replacement — a replace that dropped it would
                                                   work once and then never again. #}
                                                <div id="settings-calendar-list">
                                                    {% include 'settings/_calendars.html.twig' with {
                                                        calendars: calendars,
                                                        calendarAccounts: calendarAccounts|default([]),
                                                        calendarConnections: calendarConnections|default([]),
                                                    } only %}
                                                </div>
                                            </div>
                                        </section>

                                    {% else %}
                                        <section>
                                            <div class="flex items-center justify-between mb-4">
                                                <div>
                                                    <h2 class="text-sm font-semibold text-ink">{{ 'settings.accounts.heading'|trans }}</h2>
                                                    <p class="text-xs text-ink-faint mt-0.5">{{ 'settings.accounts.subheading'|trans }}</p>
                                                </div>
                                                <button
                                                    type="button"
                                                    data-controller="ui--modal"
                                                    data-action="click->ui--modal#open"
                                                    data-ui--modal-title-value="{{ 'sidebar.accounts.add'|trans }}"
                                                    data-ui--modal-src-value="{{ path('app_account_new') }}"
                                                    class="inline-flex items-center gap-2 px-3 h-9 rounded-lg text-sm font-medium
                                                           bg-accent hover:bg-accent-strong text-accent-ink transition-colors cursor-pointer"
                                                >
                                                    <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>
                                                    {{ 'sidebar.accounts.add'|trans }}
                                                </button>
                                            </div>

                                            <div class="rounded-pane border border-line overflow-hidden">
                                                <div id="settings-account-list">
                                                    {% include 'settings/_accounts.html.twig' with { manageableAccounts: manageableAccounts } %}
                                                </div>
                                            </div>
                                        </section>

                                    {% endif %}
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
