{#
Connect or edit one integration, inside the modal.

Only reached for app-password providers — OAuth ones redirect to the service, so
there is nothing to fill in. Fields come from IntegrationConnectType, which
decides which of them exist from the provider and from what the admin settled.

The blocks carry what is not a field: the last failure, the permissions a key
needs, and the note that saving probes the connection.
#}
{% extends '_layout/app.html.twig' %}

{% set isNew = integration is null or integration.id is null %}

{% block body %}
    {% embed '_partials/_modal_form.html.twig' with {
        form: form,
        title: isNew ? provider.label : integration.name,
        submit_label: isNew ? 'settings.integrations.connect'|trans : 'form.submit'|trans,
        integration: integration,
        provider: provider,
        config: config,
        isNew: isNew,
    } only %}
        {% block before_fields %}
            {% if not isNew and not integration.isHealthy %}
                <div role="alert" class="flex items-start gap-2.5 rounded-lg alert-danger px-3.5 py-3 text-sm text-danger">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ integration.lastError }}</p>
                </div>
            {% endif %}
        {% endblock %}

        {% block after_fields %}
            {# An admin-pinned address is stated rather than offered as a field:
               the form omits it and the controller ignores a submitted value. #}
            {% if config is not null and config.baseUrl and provider.needsBaseUrl %}
                <p class="text-xs text-ink-faint">
                    <i class="fa-solid fa-lock mr-1" aria-hidden="true"></i>
                    {{ 'settings.integrations.field.base_url_fixed'|trans({ '%url%': config.baseUrl }) }}
                </p>
            {% endif %}

            {# Listed here rather than only in the admin tutorial, because the
               person minting the key is the one reading this form. A key short of
               one of these fails at the operation that needs it — uploads working
               while previews 404 — which is far harder to diagnose than being
               told up front. #}
            {% set permissionKey = 'settings.integrations.field.permissions.' ~ provider.value %}
            {% if permissionKey|trans != permissionKey %}
                <div class="rounded-lg border border-line bg-sunken px-3.5 py-3 space-y-1.5">
                    <p class="text-xs font-semibold text-ink">
                        <i class="fa-solid fa-key mr-1 text-[10px]" aria-hidden="true"></i>
                        {{ 'settings.integrations.field.permissions_heading'|trans }}
                    </p>
                    <ul class="space-y-1">
                        {% for permission in permissionKey|trans|split('|') %}
                            <li class="flex items-start gap-2 text-xs text-ink-muted">
                                <code class="shrink-0 text-[11px] text-ink">{{ permission|split(' — ')|first }}</code>
                                {% if permission|split(' — ')|length > 1 %}
                                    <span class="text-ink-faint">{{ permission|split(' — ')|last }}</span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="text-[11px] text-ink-faint pt-0.5">
                        {{ 'settings.integrations.field.permissions_note'|trans }}
                    </p>
                </div>
            {% endif %}

            <p class="text-xs text-ink-faint">
                <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
                {{ 'settings.integrations.save_tests'|trans }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}
