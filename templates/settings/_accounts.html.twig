{% if manageableAccounts is empty %}
    <p class="px-4 py-8 text-center text-sm text-ink-faint italic">
        {{ 'settings.accounts.empty'|trans }}
    </p>
{% else %}
    {# Says what dragging does, before it is dragged. This list used to reassign
       the primary account as a side effect of being tidied, and nothing on
       screen mentioned it; the honest fix is that it no longer does, but the
       list should still say which of the two it is. #}
    <p class="px-4 pt-3 pb-1 text-xs text-ink-faint">{{ 'settings.accounts.order_hint'|trans }}</p>

    {# sortablejs by way of our own controller, not @stimulus-components/sortable:
       that wrapper builds its own request body with nowhere to put a CSRF
       token, which is exactly why this endpoint went without one. The rules
       list had already moved off it for the same reason. #}
    <ul class="divide-y divide-line"
        data-controller="settings--account-order"
        data-settings--account-order-url-value="{{ path('app_account_reorder') }}"
        data-settings--account-order-csrf-value="{{ csrf_token('account_reorder') }}"
        data-settings--account-order-target="list">
        {# Accounts on their way out (#672), by id. Removing runs on a worker,
           and until it finishes the row stays — greyed out, with how far it has
           got and nothing to press: every control on it would act on an
           account that is being emptied. settings--account-removal re-reads
           the list while one is there, so the row goes when the job does, or
           comes back as an ordinary row if the job fails.

           Passed in by AccountController when it renders this after a change,
           read before the list for the reason AccountController::accountLists()
           gives; asked here only on an ordinary page load. #}
        {% set removals = removals ?? account_removals() %}
        {% for account in manageableAccounts %}
            {% set isPassword = account.authType == 'password' %}
            {% set removal = removals[account.id] ?? null %}
            {% if removal %}
            <li class="flex items-center gap-3 px-4 py-3.5 opacity-70" data-account-id="{{ account.id }}"
                data-account-removing aria-busy="true"
                data-controller="settings--account-removal"
                data-settings--account-removal-url-value="{{ path('app_account_lists') }}">
                <span class="w-8 h-8 flex items-center justify-center shrink-0 text-ink-faint">
                    <i class="fa-solid fa-arrows-rotate fa-spin text-xs" aria-hidden="true"></i>
                </span>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium text-ink">{{ account.displayAddress }}</p>
                    <p class="truncate text-xs text-ink-faint">
                        {% if removal.total > 0 %}
                            {{ 'settings.accounts.removing_progress'|trans({ '%done%': removal.processed|number_format, '%total%': removal.total|number_format }) }}
                        {% else %}
                            {{ 'settings.accounts.removing'|trans }}
                        {% endif %}
                    </p>
                    {% if removal.total > 0 %}
                        <div class="mt-1.5 h-1 rounded-full bg-line overflow-hidden">
                            <div class="h-full bg-accent transition-all duration-300" style="width: {{ removal.percent() }}%"></div>
                        </div>
                    {% endif %}
                </div>
            </li>
            {% else %}
            <li class="flex items-center gap-3 px-4 py-3.5" data-account-id="{{ account.id }}">

                {# Buttons as well as a handle: a drag is unreachable from a
                   keyboard and fiddly on a phone, and the rules list beside
                   this one already worked that way. #}
                <div class="flex flex-col items-center shrink-0">
                    <button type="button" data-action="settings--account-order#move" data-direction="up"
                            class="w-5 h-4 flex items-center justify-center rounded text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            {{ loop.first ? 'disabled' : '' }}
                            aria-label="{{ 'settings.accounts.move_up'|trans({ '%account%': account.displayAddress }) }}">
                        <i class="fa-solid fa-chevron-up text-[9px]" aria-hidden="true"></i>
                    </button>

                    <span class="account-drag-handle w-5 h-4 flex items-center justify-center text-ink-faint hover:text-ink-muted cursor-grab active:cursor-grabbing touch-none"
                          title="{{ 'settings.accounts.reorder'|trans }}" aria-hidden="true">
                        <i class="fa-solid fa-grip-vertical text-[10px]"></i>
                    </span>

                    <button type="button" data-action="settings--account-order#move" data-direction="down"
                            class="w-5 h-4 flex items-center justify-center rounded text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            {{ loop.last ? 'disabled' : '' }}
                            aria-label="{{ 'settings.accounts.move_down'|trans({ '%account%': account.displayAddress }) }}">
                        <i class="fa-solid fa-chevron-down text-[9px]" aria-hidden="true"></i>
                    </button>
                </div>

                {# On while any of the services is (#575): an account kept
                   for its calendar alone, or to send through a relay, is
                   working, not switched off. #}
                {% set anyOn = account.services is not empty %}
                <span class="w-2.5 h-2.5 rounded-full shrink-0 {{ anyOn ? 'bg-green-400' : 'bg-ink-faint' }}"
                      title="{{ anyOn ? 'settings.accounts.status.active'|trans : 'settings.accounts.status.disabled'|trans }}"></span>

                <div class="min-w-0 flex-1">
                    <p class="flex items-center gap-2 min-w-0">
                        <span class="truncate text-sm font-medium text-ink">{{ account.displayAddress }}</span>
                        {# Read the flag, not the position. This badge used to
                           be `loop.first`, which made it a statement about
                           whatever order the list happened to arrive in — and
                           `isPrimary` was then itself derived from position, so
                           the badge moved when the list was dragged and took
                           the user's From address with it.

                           The flag is now chosen rather than derived, and the
                           badge reports it. It is also a title, because "which
                           account sends my mail" is not something a coloured
                           pill on its own answers. #}
                        {% if account.isPrimary %}
                            <span class="shrink-0 inline-flex items-center rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-medium text-accent"
                                  title="{{ 'settings.accounts.primary_explained'|trans }}">
                                {{ 'settings.accounts.primary'|trans }}
                            </span>
                        {% endif %}
                    </p>
                    {# The server it sends through when it has no incoming one —
                       an SMTP relay added to send only (#628). #}
                    <p class="truncate text-xs text-ink-faint">{{ account.username }} · {{ account.imapHost ?: account.smtpHost }}</p>
                    {# Said only when something is off, so the common case — an
                       account used for everything — reads as it always did. #}
                    {% if account.services|length < account_services()|filter(service => account.offers(service))|length %}
                        <p class="truncate text-xs text-ink-faint" data-account-services>
                            {% if account.services is empty %}
                                {{ 'settings.accounts.services.none'|trans }}
                            {% else %}
                                {{ 'settings.accounts.services.used_for'|trans({ '%services%': account.services|map(s => s.labelKey|trans)|join(', ') }) }}
                            {% endif %}
                        </p>
                    {% endif %}
                </div>

                {# A password account says how its mail is read, not how it
                   signs in: this badge used to say IMAP for every one of
                   them, POP3 and JMAP included (#528). Same words as the
                   form's protocol choice, so the two never disagree. #}
                <span class="hidden sm:inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium
                             {{ isPassword ? 'bg-zinc-500/10 text-ink-muted' : 'bg-accent-soft text-accent' }}"
                      data-account-type>
                    {{ isPassword ? ('account.form.protocol.' ~ account.incomingProtocol.value)|trans : 'settings.accounts.type.oauth'|trans({ '%provider%': account.oauthProvider|capitalize }) }}
                </span>

                <div class="flex items-center gap-1 shrink-0">
                    {# The explicit way to choose the sending account, which is
                       the half that was missing: the only way to change it used
                       to be to drag a row to the top, which is not something a
                       person tidying a list is asking for and which the list
                       never said it would do.

                       Only offered on an account that could actually send —
                       an account with its sending switched off as the default
                       From would be a From nothing can go out of. #}
                    {% if not account.isPrimary and account.sendEnabled %}
                        <form method="post" action="{{ path('app_account_primary', { id: account.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('account-primary' ~ account.id) }}">
                            <button
                                type="submit"
                                class="h-8 px-2 flex items-center gap-1.5 rounded-lg text-[11px] font-medium text-ink-faint hover:text-accent hover:bg-hover transition-colors cursor-pointer"
                                title="{{ 'settings.accounts.make_primary_explained'|trans({ '%account%': account.displayAddress }) }}"
                            >
                                <i class="fa-regular fa-star text-[10px]" aria-hidden="true"></i>
                                <span class="hidden sm:inline">{{ 'settings.accounts.make_primary'|trans }}</span>
                                <span class="sr-only sm:hidden">{{ 'settings.accounts.make_primary_explained'|trans({ '%account%': account.displayAddress }) }}</span>
                            </button>
                        </form>
                    {% endif %}

                    {# The colour this account wears on its sidebar dot and on
                       every message row. Offered on every account, OAuth ones
                       included, which is why it is not a field in the edit
                       modal: edit() is closed to them.

                       The current entry is marked by a ring and a tick, not by
                       its hue alone. #}
                    {% set dot = account_dot(account) %}
                    {% set custom = account.customColor %}
                    {% set customValue = custom ?? '#0072b2' %}
                    {% set heading = 'text-[11px] font-semibold uppercase tracking-wide text-ink-muted' %}
                    {# The colour menu (#638): the palette, a colour of the
                       user's own beside it, and Save.

                       Choosing no longer posts by itself. A colour is picked by
                       looking at it, so the menu previews it first — on the
                       button, the sidebar dot and the contrast rows — and Save
                       commits it; Cancel, Escape or a click elsewhere puts the
                       old one back. One radio group, name="colour", so the
                       palette entries and the custom swatch are one choice: the
                       custom radio's value IS the hex code, kept in step with
                       the colour well and the hex field, and the route already
                       tells an index from a hex value.

                       place=above: the menu goes into the top layer over its
                       button. Pinned with bottom-full inside the card it fitted
                       while it was two rows of swatches; this is taller than a
                       card holding one account, whose overflow-hidden cut its
                       top off. #}
                    <div class="relative"
                         data-controller="ui--dropdown settings--account-colour"
                         data-ui--dropdown-place-value="above"
                         data-action="ui--dropdown:closed->settings--account-colour#restore"
                         data-settings--account-colour-account-value="{{ account.id }}">
                        <button
                            type="button"
                            data-action="click->ui--dropdown#toggle"
                            aria-haspopup="true"
                            class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ 'settings.accounts.colour.change'|trans({ '%account%': account.displayAddress }) }}"
                            title="{{ 'settings.accounts.colour.change'|trans({ '%account%': account.displayAddress }) }}"
                        >
                            <span data-account-dot="{{ account.id }}" class="w-3 h-3 rounded-full {{ dot.class }}" style="{{ dot.style }}" aria-hidden="true"></span>
                        </button>

                        <form method="post" action="{{ path('app_account_colour', { id: account.id }) }}"
                              data-ui--dropdown-target="menu" hidden data-enter="rise"
                              data-settings--account-colour-target="form"
                              data-action="submit->settings--account-colour#commit reset->settings--account-colour#reverted"
                              role="group"
                              aria-label="{{ 'settings.accounts.colour.change'|trans({ '%account%': account.displayAddress }) }}"
                              class="absolute bottom-full mb-1 right-0 z-30 popover w-[300px] p-3 flex flex-col gap-3 text-left">
                            <input type="hidden" name="_token" value="{{ csrf_token('account-colour' ~ account.id) }}">

                            <fieldset class="flex flex-col gap-2.5">
                                <legend class="{{ heading }} mb-2.5">{{ 'settings.accounts.colour.presets'|trans }}</legend>
                                <div class="grid grid-cols-5 gap-2 justify-items-center">
                                    {% for index in 0..(constant('App\\Twig\\SenderAvatarExtension::ACCOUNT_COLOURS') - 1) %}
                                        {% set swatchName = ('settings.accounts.colour.swatch.' ~ index)|trans %}
                                        <label class="relative cursor-pointer" title="{{ swatchName }}">
                                            <input type="radio" name="colour" value="{{ index }}" class="peer sr-only"
                                                   data-action="settings--account-colour#choose"
                                                   aria-label="{{ swatchName }}"
                                                   {{ custom is null and index == account.colorIndex ? 'checked' : '' }}>
                                            <span data-swatch
                                                  class="w-7 h-7 rounded-full flex items-center justify-center transition-[transform,box-shadow] hover:scale-110 {{ index|account_color }}
                                                         peer-checked:ring-2 peer-checked:ring-ink peer-checked:ring-offset-2 peer-checked:ring-offset-surface
                                                         peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-surface
                                                         [&>i]:invisible peer-checked:[&>i]:visible">
                                                <i class="fa-solid fa-check text-[11px] text-white dark:text-black" aria-hidden="true"></i>
                                            </span>
                                        </label>
                                    {% endfor %}

                                    {# The ninth swatch: a colour wheel until the
                                       account has a colour of its own, then
                                       that colour. #}
                                    <label class="relative cursor-pointer" title="{{ 'settings.accounts.colour.custom'|trans }}">
                                        <input type="radio" name="colour" value="{{ customValue }}" class="peer sr-only"
                                               data-settings--account-colour-target="customRadio"
                                               data-action="settings--account-colour#choose"
                                               aria-label="{{ 'settings.accounts.colour.custom'|trans }}"
                                               {{ custom is null ? '' : 'checked' }}>
                                        <span data-swatch data-settings--account-colour-target="customSwatch"
                                              class="w-7 h-7 rounded-full flex items-center justify-center transition-[transform,box-shadow] hover:scale-110
                                                     peer-checked:ring-2 peer-checked:ring-ink peer-checked:ring-offset-2 peer-checked:ring-offset-surface
                                                     peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-surface"
                                              style="background: {{ custom ?? 'conic-gradient(#ef4444, #eab308, #22c55e, #06b6d4, #3b82f6, #a855f7, #ef4444)' }}">
                                            <i data-settings--account-colour-target="customIcon"
                                               class="fa-solid {{ custom is null ? 'fa-plus text-white' : 'fa-check' }} text-[11px]"
                                               aria-hidden="true"></i>
                                        </span>
                                    </label>
                                </div>
                            </fieldset>

                            {# data-place-reserve: the menu is placed as if this were open, so
                               opening it does not move the menu (place_above.js). #}
                            <div data-settings--account-colour-target="panel" data-place-reserve {{ custom is null ? 'hidden' : '' }}
                                 class="border-t border-line pt-3 flex flex-col gap-2.5">
                                <div class="{{ heading }}">{{ 'settings.accounts.colour.custom_heading'|trans }}</div>
                                <div class="flex items-center gap-2">
                                    <label class="relative w-9 h-9 shrink-0 cursor-pointer">
                                        <span data-settings--account-colour-target="wellFace"
                                              class="absolute inset-0 rounded-lg ring-1 ring-inset ring-black/10 dark:ring-white/15"
                                              style="background-color: {{ customValue }}"></span>
                                        <input type="color" value="{{ customValue }}"
                                               data-settings--account-colour-target="well"
                                               data-action="input->settings--account-colour#pickWell"
                                               aria-label="{{ 'settings.accounts.colour.custom_pick'|trans }}"
                                               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                                    </label>
                                    <input type="text" value="{{ customValue }}"
                                           maxlength="7" spellcheck="false" autocomplete="off"
                                           data-settings--account-colour-target="hex"
                                           data-action="input->settings--account-colour#typeHex change->settings--account-colour#complete"
                                           aria-label="{{ 'settings.accounts.colour.custom_hex'|trans }}"
                                           aria-describedby="account-colour-format-{{ account.id }}"
                                           class="flex-1 min-w-0 h-9 px-2.5 rounded-lg text-[13px] font-mono bg-field border border-field-border text-ink
                                                  aria-invalid:border-danger">
                                </div>
                                <p id="account-colour-format-{{ account.id }}" data-settings--account-colour-target="invalid" hidden
                                   class="text-xs text-danger">{{ 'settings.accounts.colour.custom_format'|trans }}</p>

                                {# Against the theme in use and against the plain
                                   light and dark ones, because a custom colour is
                                   one value on every theme, where a preset has a
                                   shade for each. The current row is dropped when
                                   the theme's background is one of the other two,
                                   so no row says the same thing twice. #}
                                <div class="flex flex-col gap-1.5">
                                    {% for mode in ['current', 'light', 'dark'] %}
                                        <div data-settings--account-colour-target="row" data-mode="{{ mode }}" class="flex items-center gap-2 text-xs">
                                            <span data-chip class="w-11 h-[22px] shrink-0 rounded-md flex items-center justify-center ring-1 ring-inset ring-black/10 dark:ring-white/15">
                                                <span data-chip-dot class="w-2 h-2 rounded-full"></span>
                                            </span>
                                            <span class="w-14 text-ink-muted">{{ ('settings.accounts.colour.contrast_' ~ mode)|trans }}</span>
                                            <span data-ratio class="w-12 font-mono tabular-nums text-ink"></span>
                                            <span data-ok hidden class="flex items-center gap-1 text-success">
                                                <i class="fa-solid fa-check text-[10px]" aria-hidden="true"></i>{{ 'settings.accounts.colour.contrast_ok'|trans }}
                                            </span>
                                            <span data-low hidden class="flex items-center gap-1 text-warning">
                                                <i class="fa-solid fa-triangle-exclamation text-[10px]" aria-hidden="true"></i>{{ 'settings.accounts.colour.contrast_low'|trans }}
                                            </span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="flex justify-end gap-2 border-t border-line pt-2.5">
                                <button type="reset" data-action="ui--dropdown#close"
                                        class="h-8 px-3 rounded-lg text-[13px] text-ink-soft hover:bg-hover transition-colors cursor-pointer">
                                    {{ 'form.cancel'|trans }}
                                </button>
                                <button type="submit" data-settings--account-colour-target="save"
                                        class="h-8 px-3.5 rounded-lg text-[13px] font-medium bg-accent hover:bg-accent-strong text-accent-ink transition-colors cursor-pointer disabled:opacity-40 disabled:pointer-events-none">
                                    {{ 'form.submit'|trans }}
                                </button>
                            </div>
                        </form>
                    </div>

                    {# How often the scheduled poll syncs this account (#202).
                       Built like the colour menu above and for its reason: every
                       account has one, OAuth ones included, and edit() is
                       closed to those. One submit button per choice; the
                       current one carries aria-pressed and the tick. Opens
                       upward, as the colour menu does. #}
                    {% set intervalLabel = 'settings.accounts.sync_interval.change'|trans({ '%account%': account.displayAddress, '%minutes%': account.syncIntervalMinutes }) %}
                    <div class="relative" data-controller="ui--dropdown">
                        <button
                            type="button"
                            data-action="click->ui--dropdown#toggle"
                            aria-haspopup="true"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ intervalLabel }}" title="{{ intervalLabel }}"
                        >
                            <i class="fa-regular fa-clock text-xs" aria-hidden="true"></i>
                        </button>

                        {# A row of chips under one heading, not a list: the
                           menu opens upward inside the card, and five rows were
                           taller than a card holding a single account. #}
                        <form method="post" action="{{ path('app_account_sync_interval', { id: account.id }) }}"
                              data-ui--dropdown-target="menu" hidden data-enter="rise"
                              role="group" aria-label="{{ intervalLabel }}"
                              class="absolute bottom-full mb-1 right-0 z-30 popover p-2"
                              data-sync-interval-menu>
                            <input type="hidden" name="_token" value="{{ csrf_token('account-sync-interval' ~ account.id) }}">
                            <p class="px-1 pb-1.5 text-xs text-ink-faint whitespace-nowrap">{{ 'settings.accounts.sync_interval.heading'|trans }}</p>
                            <div class="flex gap-1">
                                {% for minutes in constant('App\\Entity\\Mail\\Account::SYNC_INTERVALS') %}
                                    {% set chosen = minutes == account.syncIntervalMinutes %}
                                    {% set choiceLabel = 'settings.accounts.sync_interval.every'|trans({ '%minutes%': minutes }) %}
                                    <button
                                        type="submit" name="minutes" value="{{ minutes }}"
                                        aria-pressed="{{ chosen ? 'true' : 'false' }}"
                                        aria-label="{{ choiceLabel }}" title="{{ choiceLabel }}"
                                        class="min-w-9 h-8 px-2 rounded-md text-sm tabular-nums cursor-pointer transition-colors {{ chosen ? 'bg-accent text-accent-ink' : 'text-ink hover:bg-hover' }}"
                                    >{{ minutes }}</button>
                                {% endfor %}
                            </div>
                        </form>
                    </div>

                    {% if isPassword %}
                        <button
                            type="button"
                            data-controller="ui--modal"
                            data-action="click->ui--modal#open"
                            data-ui--modal-title-value="{{ 'settings.accounts.edit'|trans }}"
                            data-ui--modal-src-value="{{ path('app_account_edit', { id: account.id }) }}"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ 'settings.accounts.edit'|trans }}" title="{{ 'settings.accounts.edit'|trans }}"
                        >
                            <i class="fa-solid fa-pen text-xs" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    {# Which folders to fetch. Only an account that syncs over
                       IMAP has folder rows to choose between; the others get
                       no button, which is the condition
                       AccountFoldersController refuses the rest on. #}
                    {% if account.plainImap %}
                        <button
                            type="button"
                            data-controller="ui--modal"
                            data-action="click->ui--modal#open"
                            data-ui--modal-title-value="{{ 'settings.accounts.folders.title'|trans({ '%account%': account.displayAddress }) }}"
                            data-ui--modal-src-value="{{ path('settings_account_folders', { id: account.id }) }}"
                            data-ui--modal-size-value="narrow"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ 'settings.accounts.folders.button'|trans }}" title="{{ 'settings.accounts.folders.button'|trans }}"
                        >
                            <i class="fa-solid fa-folder-open text-xs" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    {# Reconnect, always offered on an OAuth account and not
                       only when something is already known to be broken.

                       This is the affordance that was missing. An IMAP account
                       has Edit beside it; an OAuth one had nothing at all, so a
                       user who wanted to grant a permission they had declined —
                       or simply re-authorise — had no way to ask for it. The
                       reconnect existed, and lived exclusively on a health card
                       that only appears once plMail has already detected the
                       fault, which is precisely too late.

                       Same target as that card's button: the provider's consent
                       screen, with the account remembered so the callback
                       relinks rather than creating a second one. Google is sent
                       prompt=consent, so the screen is shown in full and a
                       previously declined tick box can be ticked. #}
                    {% if not isPassword and account.oauthProvider %}
                        <a href="{{ path('app_oauth_connect', { provider: account.oauthProvider, reconnect: account.id }) }}"
                           data-turbo="false"
                           class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-ink hover:bg-hover transition-colors"
                           aria-label="{{ 'settings.accounts.reconnect'|trans }}"
                           title="{{ 'settings.accounts.reconnect_explained'|trans({ '%account%': account.displayAddress }) }}">
                            <i class="fa-solid fa-rotate text-xs" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    {% if account.microsoft or account.gmail %}
                        {{ include('settings/accounts/_push_control.html.twig', {account: account, failed: false}) }}
                    {% endif %}
                    {% if account.microsoft %}
                        {{ include('settings/accounts/_categories_control.html.twig', {account: account}) }}
                    {% endif %}
                    {% if account.gmail %}
                        {{ include('settings/accounts/_gmail_move_control.html.twig', {account: account}) }}
                    {% endif %}
                    {# Mail, calendar and contacts, each switched on its own
                       (#575), in a modal like Folders. This replaced a single
                       on/off toggle that only ever stopped the mail, whatever
                       it looked like it did. A menu on the row was the first
                       version, and the card's overflow-hidden cut it off above
                       a single account. #}
                    {% set servicesLabel = 'settings.accounts.services.change'|trans({ '%account%': account.displayAddress }) %}
                    <button
                        type="button"
                        data-controller="ui--modal"
                        data-action="click->ui--modal#open"
                        data-ui--modal-title-value="{{ servicesLabel }}"
                        data-ui--modal-src-value="{{ path('app_account_services', { id: account.id }) }}"
                        data-ui--modal-size-value="narrow"
                        class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                        aria-label="{{ servicesLabel }}" title="{{ servicesLabel }}"
                    >
                        <i class="fa-solid {{ anyOn ? 'fa-toggle-on text-success' : 'fa-toggle-off' }} text-base" aria-hidden="true"></i>
                    </button>

                    <form method="post" action="{{ path('app_account_delete', { id: account.id }) }}"
                          data-turbo-confirm="{{ 'settings.accounts.delete_confirm'|trans({ '%account%': account.displayAddress }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ account.id) }}">
                        <button
                            type="submit"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-ink-faint hover:text-danger hover:bg-danger-soft transition-colors cursor-pointer"
                            aria-label="{{ 'settings.accounts.delete'|trans }}" title="{{ 'settings.accounts.delete'|trans }}"
                        >
                            <i class="fa-solid fa-trash text-xs" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </li>
            {% endif %}
        {% endfor %}
    </ul>
{% endif %}
