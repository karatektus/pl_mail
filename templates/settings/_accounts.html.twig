{% if manageableAccounts is empty %}
    <p class="px-4 py-8 text-center text-sm text-ink-faint italic">
        {{ 'settings.accounts.empty'|trans }}
    </p>
{% else %}
    {# Says what dragging does, before it is dragged. This list used to reassign
       the primary account as a side effect of being tidied, and nothing on
       screen mentioned it; the honest fix is that it no longer does, but the
       list should still say which of the two it is. #}
    <p class="px-4 pt-3 pb-1 text-xs text-ink-faint">{{ 'settings.accounts.order_hint'|trans }}</p>

    {# sortablejs by way of our own controller, not @stimulus-components/sortable:
       that wrapper builds its own request body with nowhere to put a CSRF
       token, which is exactly why this endpoint went without one. The rules
       list had already moved off it for the same reason. #}
    <ul class="divide-y divide-line"
        data-controller="settings--account-order"
        data-settings--account-order-url-value="{{ path('app_account_reorder') }}"
        data-settings--account-order-csrf-value="{{ csrf_token('account_reorder') }}"
        data-settings--account-order-target="list">
        {% for account in manageableAccounts %}
            {% set isPassword = account.authType == 'password' %}
            <li class="flex items-center gap-3 px-4 py-3.5" data-account-id="{{ account.id }}">

                {# Buttons as well as a handle: a drag is unreachable from a
                   keyboard and fiddly on a phone, and the rules list beside
                   this one already worked that way. #}
                <div class="flex flex-col items-center shrink-0">
                    <button type="button" data-action="settings--account-order#move" data-direction="up"
                            class="w-5 h-4 flex items-center justify-center rounded text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            {{ loop.first ? 'disabled' : '' }}
                            aria-label="{{ 'settings.accounts.move_up'|trans({ '%account%': account.displayAddress }) }}">
                        <i class="fa-solid fa-chevron-up text-[9px]" aria-hidden="true"></i>
                    </button>

                    <span class="account-drag-handle w-5 h-4 flex items-center justify-center text-ink-faint hover:text-ink-muted cursor-grab active:cursor-grabbing touch-none"
                          title="{{ 'settings.accounts.reorder'|trans }}" aria-hidden="true">
                        <i class="fa-solid fa-grip-vertical text-[10px]"></i>
                    </span>

                    <button type="button" data-action="settings--account-order#move" data-direction="down"
                            class="w-5 h-4 flex items-center justify-center rounded text-ink-faint hover:text-ink hover:bg-hover transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                            {{ loop.last ? 'disabled' : '' }}
                            aria-label="{{ 'settings.accounts.move_down'|trans({ '%account%': account.displayAddress }) }}">
                        <i class="fa-solid fa-chevron-down text-[9px]" aria-hidden="true"></i>
                    </button>
                </div>

                <span class="w-2.5 h-2.5 rounded-full shrink-0 {{ account.isActive ? 'bg-green-400' : 'bg-ink-faint' }}"
                      title="{{ account.isActive ? 'settings.accounts.status.active'|trans : 'settings.accounts.status.disabled'|trans }}"></span>

                <div class="min-w-0 flex-1">
                    <p class="flex items-center gap-2 min-w-0">
                        <span class="truncate text-sm font-medium text-ink">{{ account.displayAddress }}</span>
                        {# Read the flag, not the position. This badge used to
                           be `loop.first`, which made it a statement about
                           whatever order the list happened to arrive in — and
                           `isPrimary` was then itself derived from position, so
                           the badge moved when the list was dragged and took
                           the user's From address with it.

                           The flag is now chosen rather than derived, and the
                           badge reports it. It is also a title, because "which
                           account sends my mail" is not something a coloured
                           pill on its own answers. #}
                        {% if account.isPrimary %}
                            <span class="shrink-0 inline-flex items-center rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-medium text-accent"
                                  title="{{ 'settings.accounts.primary_explained'|trans }}">
                                {{ 'settings.accounts.primary'|trans }}
                            </span>
                        {% endif %}
                    </p>
                    <p class="truncate text-xs text-ink-faint">{{ account.username }} · {{ account.imapHost }}</p>
                </div>

                <span class="hidden sm:inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium
                             {{ isPassword ? 'bg-zinc-500/10 text-ink-muted' : 'bg-accent-soft text-accent' }}">
                    {{ isPassword ? 'settings.accounts.type.imap'|trans : 'settings.accounts.type.oauth'|trans({ '%provider%': account.oauthProvider|capitalize }) }}
                </span>

                <div class="flex items-center gap-1 shrink-0">
                    {# The explicit way to choose the sending account, which is
                       the half that was missing: the only way to change it used
                       to be to drag a row to the top, which is not something a
                       person tidying a list is asking for and which the list
                       never said it would do.

                       Only offered on an account that could actually send —
                       a disabled account as the default From would be a From
                       nothing can go out of. #}
                    {% if not account.isPrimary and account.isActive %}
                        <form method="post" action="{{ path('app_account_primary', { id: account.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('account-primary' ~ account.id) }}">
                            <button
                                type="submit"
                                class="h-8 px-2 flex items-center gap-1.5 rounded-lg text-[11px] font-medium text-ink-faint hover:text-accent hover:bg-hover transition-colors cursor-pointer"
                                title="{{ 'settings.accounts.make_primary_explained'|trans({ '%account%': account.displayAddress }) }}"
                            >
                                <i class="fa-regular fa-star text-[10px]" aria-hidden="true"></i>
                                <span class="hidden sm:inline">{{ 'settings.accounts.make_primary'|trans }}</span>
                                <span class="sr-only sm:hidden">{{ 'settings.accounts.make_primary_explained'|trans({ '%account%': account.displayAddress }) }}</span>
                            </button>
                        </form>
                    {% endif %}

                    {% if isPassword %}
                        <button
                            type="button"
                            data-controller="ui--modal"
                            data-action="click->ui--modal#open"
                            data-ui--modal-title-value="{{ 'settings.accounts.edit'|trans }}"
                            data-ui--modal-src-value="{{ path('app_account_edit', { id: account.id }) }}"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ 'settings.accounts.edit'|trans }}" title="{{ 'settings.accounts.edit'|trans }}"
                        >
                            <i class="fa-solid fa-pen text-xs" aria-hidden="true"></i>
                        </button>
                    {% endif %}
                    {# Reconnect, always offered on an OAuth account and not
                       only when something is already known to be broken.

                       This is the affordance that was missing. An IMAP account
                       has Edit beside it; an OAuth one had nothing at all, so a
                       user who wanted to grant a permission they had declined —
                       or simply re-authorise — had no way to ask for it. The
                       reconnect existed, and lived exclusively on a health card
                       that only appears once plMail has already detected the
                       fault, which is precisely too late.

                       Same target as that card's button: the provider's consent
                       screen, with the account remembered so the callback
                       relinks rather than creating a second one. Google is sent
                       prompt=consent, so the screen is shown in full and a
                       previously declined tick box can be ticked. #}
                    {% if not isPassword and account.oauthProvider %}
                        <a href="{{ path('app_oauth_connect', { provider: account.oauthProvider, reconnect: account.id }) }}"
                           data-turbo="false"
                           class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-ink hover:bg-hover transition-colors"
                           aria-label="{{ 'settings.accounts.reconnect'|trans }}"
                           title="{{ 'settings.accounts.reconnect_explained'|trans({ '%account%': account.displayAddress }) }}">
                            <i class="fa-solid fa-rotate text-xs" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    {% if account.microsoft or account.gmail %}
                        {{ include('settings/accounts/_push_control.html.twig', {account: account, failed: false}) }}
                    {% endif %}
                    <form method="post" action="{{ path('app_account_toggle', { id: account.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ account.id) }}">
                        <button
                            type="submit"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ account.isActive ? 'settings.accounts.disable'|trans : 'settings.accounts.enable'|trans }}"
                            title="{{ account.isActive ? 'settings.accounts.disable'|trans : 'settings.accounts.enable'|trans }}"
                        >
                            <i class="fa-solid {{ account.isActive ? 'fa-toggle-on text-green-500' : 'fa-toggle-off' }} text-base" aria-hidden="true"></i>
                        </button>
                    </form>

                    <form method="post" action="{{ path('app_account_delete', { id: account.id }) }}"
                          data-turbo-confirm="{{ 'settings.accounts.delete_confirm'|trans({ '%account%': account.displayAddress }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ account.id) }}">
                        <button
                            type="submit"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-danger hover:bg-red-500/10 transition-colors cursor-pointer"
                            aria-label="{{ 'settings.accounts.delete'|trans }}" title="{{ 'settings.accounts.delete'|trans }}"
                        >
                            <i class="fa-solid fa-trash text-xs" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}
