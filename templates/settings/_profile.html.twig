{#
Settings → Profile. The same form the setup wizard shows, with its own action so
it posts here rather than to the wizard, and the same picture picker — the
wizard runs once, and a feature reachable only from it is one most people never
find.
#}
{# `padded`: this body is a bare form, not a list that pads its own rows, so it
   is one of the few cards that takes the chrome's body inset. Until now it was
   not a card at all — a bare heading and a form, which on a narrow pane sat
   flush against the pane border like security's heading did. #}
{% embed 'settings/_card.html.twig' with {
    heading:    'settings.profile.heading'|trans,
    subheading: 'settings.profile.subheading'|trans,
    padded:     true,
} %}
    {% block body %}
    <div class="max-w-md">
        {{ form_start(profileForm) }}
            {{ form_widget(profileForm) }}

            {% include '_partials/_avatar_picker.html.twig' with {
                sources:   avatarSources,
                picking:   avatarPicking,
                entries:   avatarEntries,
                pickUrls:  avatarPickUrls,
                closeUrl:  avatarCloseUrl,
                fileField: avatarPicking is null ? '' : profileForm.avatarFileId.vars.full_name,
                current:   app.user.avatar ? path('app_settings_profile_avatar', { filename: app.user.avatar }) : null,
            } only %}

            <button
                type="submit"
                id="profile-save"
                class="mt-6 inline-flex items-center justify-center h-9 px-4 rounded-lg text-sm font-medium text-accent-ink
                       bg-accent hover:bg-accent-strong active:bg-blue-800
                       focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-1
                       transition-colors duration-100"
            >{{ 'settings.profile.save'|trans }}</button>
        {{ form_end(profileForm) }}
    </div>
    {% endblock %}
{% endembed %}
