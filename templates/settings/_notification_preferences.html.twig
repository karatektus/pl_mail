{#
settings/_notification_preferences.html.twig
─────────────────────────────────────────────────────────────────────────────
What mail is worth a notification, for the whole user and not one device
(#369): a box for each inbox tab (or the Inbox, for somebody without tabs) and
one for each label, Primary alone ticked until somebody chooses; and whether a
browser drops a notification for mail read in the meantime. The boxes are
applied where the push is sent and by the phone apps; the second choice by the
service worker, which reads it back when a push arrives.

A plain form that submits on change and redirects, like the Disposal card.

Accepts:
  skipRead   bool
  chosen     list<string>   the scopes that are on (NotifyScope keys)
  switches   {inbox: list<{scope, tab: ?InboxTab}>, labels: list<Label>}
#}
{% set segText = 'flex h-full items-center justify-center px-3 py-1.5 text-center text-[11px] leading-tight text-ink-muted
                  peer-checked:bg-accent peer-checked:text-accent-ink
                  peer-focus-visible:ring-2 peer-focus-visible:ring-inset peer-focus-visible:ring-accent
                  transition-colors cursor-pointer' %}

<form method="post" action="{{ path('app_settings_notifications_update') }}"
      class="border-t border-line" data-controller="ui--auto-submit">
    <input type="hidden" name="_token" value="{{ csrf_token('settings-notifications') }}">

    <fieldset class="px-4 py-3">
        <legend class="sr-only">{{ 'settings.notifications.notify_for'|trans }}</legend>
        <input type="hidden" name="scopesSent" value="1">

        <span class="block text-xs font-medium text-ink-muted">{{ 'settings.notifications.notify_for'|trans }}</span>
        <span class="block text-[11px] text-ink-faint mt-0.5">{{ 'settings.notifications.notify_for_hint'|trans }}</span>

        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5">
            {% for switch in switches.inbox %}
                {% set scope = switch.scope %}
                {% set name = switch.tab is null
                    ? 'settings.notifications.inbox'|trans
                    : (switch.tab.isCustom ? switch.tab.name : ('tabs.' ~ switch.tab.value)|trans) %}
                <label class="inline-flex items-center gap-2 text-sm text-ink cursor-pointer">
                    <input type="checkbox" name="scopes[]" value="{{ scope }}"
                           class="rounded border-line accent-accent"
                           data-action="change->ui--auto-submit#submit"
                           {{ scope in chosen ? 'checked' : '' }}>
                    {{ name }}
                </label>
            {% endfor %}
        </div>

        {% if switches.labels is not empty %}
            <span class="block mt-3 text-xs font-medium text-ink-muted">{{ 'settings.notifications.labels'|trans }}</span>

            <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1.5">
                {% for label in switches.labels %}
                    {% set scope = 'label:' ~ label.id %}
                    {% set name = label.fullName %}
                    <label class="inline-flex items-center gap-2 text-sm text-ink cursor-pointer">
                        <input type="checkbox" name="scopes[]" value="{{ scope }}"
                               class="rounded border-line accent-accent"
                               data-action="change->ui--auto-submit#submit"
                               {{ scope in chosen ? 'checked' : '' }}>
                        {{ name }}
                    </label>
                {% endfor %}
            </div>
        {% endif %}
    </fieldset>

    <div class="px-4 py-3 border-t border-line flex items-start justify-between gap-3">
        <span class="min-w-0">
            <span class="block text-xs font-medium text-ink-muted">{{ 'settings.notifications.skip_read'|trans }}</span>
            <span class="block text-[11px] text-ink-faint mt-0.5">{{ 'settings.notifications.skip_read_hint'|trans }}</span>
        </span>

        <div class="grid grid-flow-col auto-cols-fr shrink-0 rounded-pane border border-line overflow-hidden"
             role="radiogroup" aria-label="{{ 'settings.notifications.skip_read'|trans }}">
            {% for on in [true, false] %}
                <label>
                    <input type="radio" name="skipRead" class="peer sr-only"
                           value="{{ on ? '1' : '0' }}"
                           data-action="change->ui--auto-submit#submit"
                           {{ skipRead == on ? 'checked' : '' }}>
                    <span class="{{ segText }}">
                        {{ (on ? 'settings.notifications.on' : 'settings.notifications.off')|trans }}
                    </span>
                </label>
            {% endfor %}
        </div>
    </div>
</form>
