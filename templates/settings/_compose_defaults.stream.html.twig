<turbo-stream action="append" target="toast-region">
    <template>
        {% include '_partials/_toast.html.twig' with { message: toastMessage|trans, type: 'success' } %}
    </template>
</turbo-stream>

{# The whole panel, not the one select that changed — see
   ComposeDefaultsController::streamResponse() for why. #}
<turbo-stream action="replace" target="settings-compose-defaults">
    <template>
        <div id="settings-compose-defaults">
            {% include 'settings/_compose_defaults.html.twig' with { manageableAccounts: manageableAccounts } %}
        </div>
    </template>
</turbo-stream>
