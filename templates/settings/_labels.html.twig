{#
settings/_labels.html.twig
─────────────────────────────────────────────────────────────────────────────
Label management: create, rename, re-parent, recolour, delete, show/hide.

One flat list, not one section per account: labels are user-scoped, so
"Receipts" is a single row regardless of how many accounts it is materialized
on. Which accounts those are lives on LabelBinding and is deliberately not
surfaced here.

System labels (Inbox, Sent, …) map onto provider built-ins that cannot be
renamed or deleted, so they get the visibility toggle only — the same rule
LabelController::assertOwnedUserLabel() enforces server-side.

Variables:
  labels  Label[]  tree-ordered (system block first, then the custom tree)
#}
<div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-line bg-sunken">
    <p class="text-xs text-ink-faint">{{ 'settings.labels.count'|trans({ '%count%': labels|length }) }}</p>

    <button
        data-controller="ui--modal"
        data-action="click->ui--modal#open"
        data-ui--modal-title-value="{{ 'sidebar.labels.add'|trans }}"
        data-ui--modal-src-value="{{ path('app_label_new') }}"
        class="inline-flex items-center gap-1.5 px-2.5 h-8 rounded-lg text-xs font-medium bg-accent hover:bg-accent-strong text-white transition-colors cursor-pointer"
    >
        <i class="fa-solid fa-plus text-[10px]" aria-hidden="true"></i>
        {{ 'sidebar.labels.add'|trans }}
    </button>
</div>

{% if labels is empty %}
    <p class="px-4 py-8 text-center text-sm text-ink-faint italic">
        {{ 'settings.labels.empty'|trans }}
    </p>
{% else %}
    <ul class="py-2 divide-y divide-line">
        {% for label in labels %}
            <li class="group/label flex items-center gap-3 pr-4 py-1.5"
                style="padding-left: {{ 16 + label.depth * 14 }}px">

                {% if label.isSystem %}
                    <i class="fa-solid fa-inbox w-3.5 text-xs text-ink-faint shrink-0" aria-hidden="true"></i>
                {% else %}
                    <span class="w-2.5 h-2.5 rounded-full shrink-0
                        {{ {
                            'gray':   'bg-ink-faint',
                            'red':    'bg-red-500',
                            'orange': 'bg-orange-500',
                            'amber':  'bg-amber-500',
                            'green':  'bg-green-500',
                            'teal':   'bg-teal-500',
                            'blue':   'bg-accent',
                            'violet': 'bg-violet-500',
                            'pink':   'bg-pink-500',
                        }[label.color ?? 'gray'] ?? 'bg-ink-faint' }}"
                        aria-hidden="true"></span>
                {% endif %}

                <span class="flex-1 min-w-0 flex items-center gap-2">
                    <span class="truncate text-sm {{ label.isVisible ? 'text-ink' : 'text-ink-faint' }}">
                        {{ label.name }}
                    </span>
                    {% if label.isSystem %}
                        <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-zinc-500/10 text-ink-muted">
                            {{ 'settings.labels.system'|trans }}
                        </span>
                    {% endif %}
                </span>

                <div class="flex items-center gap-0.5 shrink-0">
                    {% if not label.isSystem %}
                        {# Kept reachable without hover: these rows are the only
                           place a label can be renamed or removed. #}
                        <button
                            data-controller="ui--modal"
                            data-action="click->ui--modal#open"
                            data-ui--modal-title-value="{{ 'label.form.edit_title'|trans }}"
                            data-ui--modal-src-value="{{ path('app_label_edit', { id: label.id }) }}"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ 'settings.labels.edit'|trans({ '%name%': label.name }) }}"
                            title="{{ 'label.form.edit_title'|trans }}"
                        >
                            <i class="fa-solid fa-pen text-xs" aria-hidden="true"></i>
                        </button>

                        <form method="post" action="{{ path('app_label_delete', { id: label.id }) }}"
                              data-turbo-confirm="{{ label.children|length > 0
                                  ? 'label.delete_confirm_children'|trans({ '%name%': label.name, '%count%': label.children|length })
                                  : 'label.delete_confirm'|trans({ '%name%': label.name }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('label-delete' ~ label.id) }}">
                            <button
                                type="submit"
                                class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-danger hover:bg-danger-soft transition-colors cursor-pointer"
                                aria-label="{{ 'settings.labels.delete'|trans({ '%name%': label.name }) }}"
                                title="{{ 'label.form.delete'|trans }}"
                            >
                                <i class="fa-solid fa-trash text-xs" aria-hidden="true"></i>
                            </button>
                        </form>
                    {% endif %}

                    <form method="post" action="{{ path('app_label_toggle_visibility', { id: label.id }) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('label-visibility' ~ label.id) }}">
                        <button
                            type="submit"
                            class="w-8 h-8 flex items-center justify-center rounded-lg text-zinc-400 hover:text-ink hover:bg-hover transition-colors cursor-pointer"
                            aria-label="{{ label.isVisible ? 'settings.labels.hide'|trans : 'settings.labels.show'|trans }}"
                            title="{{ label.isVisible ? 'settings.labels.hide'|trans : 'settings.labels.show'|trans }}"
                        >
                            <i class="fa-solid {{ label.isVisible ? 'fa-eye text-accent' : 'fa-eye-slash' }} text-sm" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}
