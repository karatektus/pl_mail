{#
integration/_picker.html.twig — browse a service and pick files, in the modal.

Folder navigation, search and paging are plain links and a GET form inside the
modal frame, so they work without JavaScript. Two things are scripted on top:
the selection, which posts once at the end, and paging, which appends the next
page in place rather than navigating — a photo grid that reset to the top and
lost its ticks on every page would be unusable.

Per file the user chooses copy or link. Copy is blocked only when the size is
*known* to exceed the cap; services that report no size at all (Immich, Google
Photos) are given the benefit of the doubt, because the attach endpoint checks
the real size once it has the bytes. Link is unavailable on services that cannot
share a single file (Immich), so a photo genuinely over the cap there cannot be
attached and says so.

Layout: everything above the results is fixed, and only the results scroll. The
scroll container carries no vertical padding on purpose — padding on a scroll
container does not clip its content, so scrolled images stayed visible in the
gap under the shortcuts row.
#}
{% extends '_layout/app.html.twig' %}

{# A photo library gets a grid of previews; a file store gets a list of names.
   A listing of people gets a third shape: portraits with the name always shown,
   which the driver signals by the entries' kind rather than by the folder id. #}
{% set isGrid = canThumb and integration.provider.isMediaLibrary %}
{% set isPeople = listing is not null and listing.people is not empty %}

{% block body %}
    <turbo-frame id="modal">
        <template data-modal-frame-title>{{ integration.name }}</template>

        {# data-modal-keep-open: the search form re-renders this frame, and the
           modal otherwise treats any successful submit as "done" and closes. #}
        <div data-controller="integration-picker"
             data-modal-keep-open
             data-integration-picker-url-value="{{ path('app_integration_attach', { id: integration.id }) }}"
             data-integration-picker-draft-value="{{ draftId }}"
             data-integration-picker-token-value="{{ csrf_token('integration-picker') }}"
             class="flex flex-col min-h-0">

            {% if error is not null %}
                <div role="alert" class="m-5 flex items-start gap-2.5 rounded-lg alert-danger px-3.5 py-3 text-sm text-danger">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ error }}</p>
                </div>
            {% else %}

                {# ── Search ── #}
                {% if canSearch %}
                    <form method="get" action="{{ path('app_integration_browse', { id: integration.id }) }}"
                          class="flex items-center gap-2 px-5 py-3 shrink-0">
                        <input type="hidden" name="draft" value="{{ draftId }}">
                        <div class="relative flex-1 min-w-0">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-[11px] text-ink-faint" aria-hidden="true"></i>
                            <input type="search" name="q" value="{{ query }}"
                                   placeholder="{{ ('integration.picker.search_placeholder.' ~ integration.provider.value)|trans }}"
                                   class="w-full h-9 pl-8 pr-3 rounded-lg text-sm bg-field border border-field text-ink
                                          focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                        </div>
                        <button type="submit"
                                class="shrink-0 inline-flex items-center h-9 px-3 rounded-lg text-sm font-medium
                                       text-ink-soft bg-field border border-field hover:bg-hover transition-colors">
                            {{ 'integration.picker.search'|trans }}
                        </button>
                    </form>
                {% endif %}

                {# ── Trail and shortcuts ──
                   One row, so the results start immediately below a single
                   opaque boundary. Shortcuts are whatever the driver offered —
                   Immich surfacing its albums from the timeline — so no
                   per-provider branch lives here. #}
                <div class="flex items-center gap-2 flex-wrap px-5 pb-3 border-b border-line shrink-0">
                    <nav class="flex items-center gap-1 flex-wrap text-xs text-ink-muted">
                        {% for crumb in listing.breadcrumb %}
                            {% if not loop.last %}
                                <a href="{{ path('app_integration_browse', { id: integration.id, folder: crumb.id, draft: draftId }) }}"
                                   class="hover:text-ink transition-colors">{{ crumb.name }}</a>
                                <i class="fa-solid fa-chevron-right text-[8px] text-ink-faint" aria-hidden="true"></i>
                            {% else %}
                                <span class="text-ink font-medium">{{ crumb.name }}</span>
                            {% endif %}
                        {% endfor %}
                    </nav>

                    {% for shortcut in listing.shortcuts %}
                        <a href="{{ path('app_integration_browse', { id: integration.id, folder: shortcut.id, draft: draftId }) }}"
                           class="{{ loop.first ? 'ml-auto' : '' }} inline-flex items-center h-7 px-2.5 rounded-lg
                                  text-xs font-medium text-ink-soft bg-field border border-field
                                  hover:bg-hover transition-colors">
                            {{ shortcut.name }}
                        </a>
                    {% endfor %}
                </div>

                {# ── Results and scrubber, side by side ──
                   The bar is a sibling of the scroll container, not inside it, so
                   it stays put while the photos move. #}
                {# The height bound lives on the row, not the scroller: the
                   scrubber is the other child, and bounding only the scroller let
                   the bar grow the row and push through the footer. #}
                <div class="flex min-h-0 max-h-[55vh]">
                {# No py-* on the scroller: padding on a scroll container is not
                   clipped, so content would scroll into it and show above the
                   boundary. #}
                <div class="flex-1 min-w-0 min-h-0 px-5 overflow-y-auto overscroll-contain"
                     data-integration-picker-target="scroller">
                    <div class="py-3">
                        {% if listing.entries is empty %}
                            <p class="py-8 text-center text-sm text-ink-faint italic">
                                {{ query ? 'integration.picker.no_results'|trans({ '%query%': query })
                                         : 'integration.picker.empty'|trans }}
                            </p>
                        {% elseif isPeople %}

                            {# People are places, not attachments, so this grid
                               navigates rather than selects. #}
                            <div class="grid gap-2 grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))]"
                                 data-integration-picker-target="results">
                                {% for entry in listing.people %}
                                    {% include 'integration/_person.html.twig' with {
                                        integration: integration,
                                        entry: entry,
                                        draftId: draftId,
                                    } only %}
                                {% endfor %}
                            </div>

                        {% elseif isGrid %}

                            {% if listing.folders is not empty %}
                                <ul class="mb-3 divide-y divide-line">
                                    {% for entry in listing.folders %}
                                        <li>
                                            <a href="{{ path('app_integration_browse', { id: integration.id, folder: entry.id, draft: draftId }) }}"
                                               class="flex items-center gap-3 py-2.5 hover:bg-hover -mx-2 px-2 rounded-lg transition-colors">
                                                <i class="fa-solid fa-images text-amber-500 w-5 text-center shrink-0" aria-hidden="true"></i>
                                                <span class="flex-1 min-w-0 truncate text-sm text-ink">{{ entry.name }}</span>
                                                <i class="fa-solid fa-chevron-right text-[9px] text-ink-faint" aria-hidden="true"></i>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                            {# ── Photo grid ──
                               No filenames: nobody recognises a photo by reading
                               IMG_4821.jpg. The whole tile is the control, and
                               the date appears on hover, on keyboard focus, and
                               while selected — hover alone would hide it
                               permanently on a touch screen.

                               Copy is the only mode here. A media library with
                               share links would need a second affordance; none
                               has one. #}
                            <div class="grid gap-2 grid-cols-[repeat(auto-fill,minmax(6rem,1fr))]"
                                 data-integration-picker-target="results">
                                {% for entry in listing.files %}
                                    {% include 'integration/_tile.html.twig' with {
                                        integration: integration,
                                        entry: entry,
                                        maxBytes: maxBytes,
                                    } only %}
                                {% endfor %}
                            </div>

                        {% else %}
                            <ul class="divide-y divide-line" data-integration-picker-target="results">
                                {% for entry in listing.entries %}
                                    {% include 'integration/_row.html.twig' with {
                                        integration: integration,
                                        entry: entry,
                                        draftId: draftId,
                                        maxBytes: maxBytes,
                                        canLink: canLink,
                                        canThumb: canThumb,
                                    } only %}
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {# ── Paging ──
                           Scripted into an append by the controller, which also
                           auto-triggers it as the sentinel scrolls into view.
                           Left as a real link so it still works, by navigating,
                           if that script never runs. #}
                        {% if listing.nextCursor %}
                            <div class="pt-3 text-center" data-integration-picker-target="sentinel">
                                <a href="{{ path('app_integration_browse', {
                                       id: integration.id,
                                       folder: folderId,
                                       draft: draftId,
                                       q: query,
                                       cursor: listing.nextCursor,
                                   }) }}"
                                   data-action="integration-picker#loadMore"
                                   class="inline-flex items-center gap-2 h-8 px-3.5 rounded-lg text-sm font-medium
                                          text-ink-soft bg-field border border-field hover:bg-hover transition-colors">
                                    {{ 'integration.picker.more'|trans }}
                                    <i class="fa-solid fa-chevron-down text-[9px]" aria-hidden="true"></i>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {% include 'integration/_scrubber.html.twig' with {
                    integration: integration,
                    buckets: buckets,
                    draftId: draftId,
                } only %}
                </div>

            {% endif %}

            {# ── Footer ── #}
            <div class="flex items-center gap-2 px-5 py-3.5 border-t border-line bg-sunken rounded-b-xl shrink-0">
                <span class="text-[11px] text-ink-faint" data-integration-picker-target="status"></span>

                <div class="flex-1"></div>

                <button type="button" data-action="click->modal#close"
                        class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg text-sm font-medium
                               text-ink-soft bg-field border border-field hover:bg-hover transition-colors">
                    {{ 'form.cancel'|trans }}
                </button>
                <button type="button"
                        data-action="click->integration-picker#attach"
                        data-integration-picker-target="submit"
                        class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg text-sm font-medium text-white
                               bg-accent hover:bg-accent-strong transition-colors disabled:opacity-50">
                    {{ 'integration.picker.attach'|trans }}
                </button>
            </div>

        </div>
    </turbo-frame>
{% endblock %}
