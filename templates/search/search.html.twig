{% extends '_layout/_mailbox.html.twig' %}

{#
    The query goes through a translated pattern rather than being concatenated
    ahead of the word "Search": the order of the two is a property of the
    language, not of the page.
#}
{% block title %}
    {%- if q %}{{ 'search.title_query'|trans({ '%query%': q }) }}{% else %}{{ 'search.title'|trans }}{% endif %} — {{ 'app.name'|trans -}}
{% endblock %}

{% block inbox_tabs %}
    <div class="px-4 py-2.5 border-b border-line flex items-center gap-3">
        <h2 class="text-sm font-semibold text-ink-soft flex-1 min-w-0 truncate">
            {% if q %}
                {{ 'search.heading.results'|trans }} <span class="text-accent">{{ q }}</span>
            {% else %}
                {{ 'search.title'|trans }}
            {% endif %}
        </h2>
        {% if total > 0 %}
            <span class="text-xs text-ink-faint flex-shrink-0">
                {{ total == 1 ? ('search.results.count_one'|trans) : ('search.results.count'|trans({'%count%': total})) }}
            </span>
        {% endif %}
    </div>

    {# Active filter pills — shown when structured operators were parsed #}
    {% if parsed is not null and not parsed.isEmpty %}
        <div class="flex flex-wrap gap-1.5 px-4 py-2 border-b border-line">
            {% if parsed.from %}
                {{ _self.pill('search.pill.from'|trans, parsed.from, q) }}
            {% endif %}
            {% if parsed.to %}
                {{ _self.pill('search.pill.to'|trans, parsed.to, q) }}
            {% endif %}
            {% if parsed.cc %}
                {{ _self.pill('search.pill.cc'|trans, parsed.cc, q) }}
            {% endif %}
            {% if parsed.subject %}
                {{ _self.pill('search.pill.subject'|trans, parsed.subject, q) }}
            {% endif %}
            {% if parsed.label %}
                {{ _self.pill('search.pill.label'|trans, parsed.label, q) }}
            {% endif %}
            {% if parsed.hasAttachment %}
                {{ _self.pill('search.pill.has'|trans, 'search.pill.attachment'|trans, q) }}
            {% endif %}
            {% if parsed.isUnread %}
                {{ _self.pill('search.pill.is'|trans, 'search.pill.unread'|trans, q) }}
            {% endif %}
            {% if parsed.isRead %}
                {{ _self.pill('search.pill.is'|trans, 'search.pill.read'|trans, q) }}
            {% endif %}
            {% if parsed.isStarred %}
                {{ _self.pill('search.pill.is'|trans, 'search.pill.starred'|trans, q) }}
            {% endif %}
            {% if parsed.mailboxRole %}
                {{ _self.pill('search.pill.in'|trans, parsed.mailboxRole, q) }}
            {% endif %}
            {% if parsed.after %}
                {{ _self.pill('search.pill.after'|trans, parsed.after|date('Y-m-d'), q) }}
            {% endif %}
            {% if parsed.before %}
                {{ _self.pill('search.pill.before'|trans, parsed.before|date('Y-m-d'), q) }}
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{# Filter pill macro #}
{% macro pill(label, value, q) %}
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium
                 bg-accent-soft text-accent border border-accent/20">
        <span class="text-accent">{{ label }}:</span>{{ value }}
    </span>
{% endmacro %}

{% block message_list %}
    {% if q == '' %}
        {# Empty state — no query yet #}
        <li class="flex flex-col items-center justify-center py-16 text-center px-4">
            <div class="w-12 h-12 rounded-full bg-sunken flex items-center justify-center mb-4">
                <i class="fa-solid fa-magnifying-glass text-ink-faint text-lg" aria-hidden="true"></i>
            </div>
            <p class="text-sm font-medium text-ink-muted">{{ 'search.empty.title'|trans }}</p>
            <p class="text-xs text-ink-faint mt-1 max-w-xs">
                {{ 'search.empty.try'|trans }} <code class="bg-sunken px-1 rounded">from:alice</code>,
                <code class="bg-sunken px-1 rounded">has:attachment</code>,
                <code class="bg-sunken px-1 rounded">is:unread</code> {{ 'search.empty.or_keyword'|trans }}
            </p>
        </li>
    {% elseif threads is empty %}
        {# No results #}
        <li class="flex flex-col items-center justify-center py-16 text-center px-4">
            <div class="w-12 h-12 rounded-full bg-sunken flex items-center justify-center mb-4">
                <i class="fa-solid fa-magnifying-glass text-ink-faint text-lg" aria-hidden="true"></i>
            </div>
            <p class="text-sm font-medium text-ink-muted">{{ 'search.no_results.title'|trans({'%query%': q}) }}</p>
            <p class="text-xs text-ink-faint mt-1">{{ 'search.no_results.hint'|trans }}</p>
        </li>
    {% else %}
        {% for thread in threads %}
            {% include '_partials/_thread_row.html.twig' with { thread: thread } %}
        {% endfor %}
    {% endif %}
{% endblock %}
