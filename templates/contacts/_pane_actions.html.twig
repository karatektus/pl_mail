{#
contacts/_pane_actions.html.twig — the end of a contacts page's header in the
pane: the pane menu (#755), as every pane in a workspace has it. See
_partials/_pane_controls.html.twig.

Included, so it reads `inPane` from contacts/_layout.html.twig. Rendered on the
full page as well, which is the same pane at full width
(contacts/_page_shell.html.twig).
#}
{% if inPane %}
    <span class="contents" data-contacts-pane-actions>
        {% include '_partials/_pane_controls.html.twig' only %}
    </span>
{% endif %}
