{#
contacts/_page_shell.html.twig — a contacts page at full size: the mailbox with
the Contacts pane at full width (#755). Chosen by contacts/_layout.html.twig for
anything that is not a navigation inside the pane.

`fullPane` is the whole difference from a workspace with the pane at full width
(see tasks/index.html.twig, the same shape). The mail side is the thread page's:
no list behind it, said to be empty, so leaving full width here is a visit to
the mail rather than an uncovered blank list.
#}
{% extends '_layout/_mailbox.html.twig' %}
{% set fullPane = 'contacts' %}
{% block message_list %}{% endblock %}
{% block inbox_tabs %}{% endblock %}
{% block list_rendered %}0{% endblock %}
{# The page's own content, in the frame the pane would have fetched it into —
   _pane_layout's, plus `advance`: while the pane has the row, a navigation
   inside it is a navigation of the page, and the address says so. The flashes
   go to the toast region the full layout already has. #}
{% block contacts_pane_body %}
    <turbo-frame id="contacts-pane-frame" data-turbo-action="advance" class="flex flex-col min-h-0 flex-1">
        <div data-contacts-page class="@container relative flex flex-col flex-1 min-h-0 min-w-0 overflow-hidden">
            {{ block('contacts_content') }}
        </div>
    </turbo-frame>
{% endblock %}
