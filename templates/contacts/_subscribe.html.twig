{#
contacts/_subscribe.html.twig — which of a connection's address books to mirror.

calendar/_subscribe.html.twig's shape: a hand-written form posting only the
ticked remote ids, the server re-reading everything else, and the reason in
place of the list when discovery failed.

Variables:
  offers       list<{remote: RemoteAddressBook, local: AddressBook|null}>
  integration  Integration
  error        string|null
#}
{% extends '_layout/app.html.twig' %}

{% block body %}
<turbo-frame id="modal">
    <template data-ui--modal-frame-title>{{ 'settings.contacts.subscribe.title'|trans }}</template>

    <form method="post"
          action="{{ path('app_settings_contacts_subscribe', { id: integration.id }) }}"
          data-turbo-frame="modal"
          class="flex-1 min-h-0 flex flex-col">
        <input type="hidden" name="_token" value="{{ csrf_token('contacts-subscribe' ~ integration.id) }}">

        <div class="flex-1 min-h-0 px-6 pb-6 space-y-5 overflow-y-auto">
            <p class="text-xs text-ink-muted leading-relaxed">
                {{ 'settings.contacts.subscribe.intro'|trans({ '%name%': integration.name }) }}
            </p>

            {% if error is not null %}
                <div role="alert" class="flex items-start gap-2.5 rounded-lg alert-danger px-3.5 py-3 text-sm text-danger">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0" aria-hidden="true"></i>
                    <p class="leading-snug">{{ error }}</p>
                </div>

            {% elseif offers is empty %}
                <p class="py-6 text-center text-sm text-ink-faint italic">
                    {{ 'settings.contacts.subscribe.empty'|trans({ '%name%': integration.name }) }}
                </p>

            {% else %}
                <ul class="divide-y divide-line">
                    {% for offer in offers %}
                        {% set field = 'remote-book-' ~ loop.index %}

                        <li class="flex items-start gap-3 py-2.5">
                            <input type="checkbox"
                                   id="{{ field }}"
                                   name="remoteIds[]"
                                   value="{{ offer.remote.remoteId }}"
                                   {% if offer.local is not null %}checked{% endif %}
                                   class="mt-0.5 size-4 shrink-0 rounded border-field accent-accent focus:ring-accent cursor-pointer">

                            <label for="{{ field }}" class="flex-1 min-w-0 flex flex-col gap-0.5 cursor-pointer">
                                <span class="flex items-center gap-2 flex-wrap">
                                    <span class="truncate text-sm text-ink">{{ offer.remote.name }}</span>

                                    {% if offer.remote.isReadOnly %}
                                        <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-medium bg-zinc-500/10 text-ink-muted">
                                            <i class="fa-solid fa-lock mr-1 text-[8px]" aria-hidden="true"></i>
                                            {{ 'settings.contacts.read_only'|trans }}
                                        </span>
                                    {% endif %}
                                </span>

                                {% if offer.local is not null %}
                                    <span class="text-[11px] text-ink-faint leading-snug">
                                        {{ 'settings.contacts.subscribe.mirrored'|trans }}
                                    </span>
                                {% endif %}
                            </label>
                        </li>
                    {% endfor %}
                </ul>

                <p class="text-[11px] text-ink-faint leading-snug">
                    <i class="fa-solid fa-circle-info mr-1" aria-hidden="true"></i>
                    {{ 'settings.contacts.subscribe.unsubscribe_note'|trans }}
                </p>
            {% endif %}
        </div>

        <div class="flex items-center justify-end gap-2 px-6 pb-6 pt-3 shrink-0">
            <button type="button"
                    data-action="click->ui--modal#close"
                    class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg text-sm font-medium
                           text-ink-soft bg-field border border-field hover:bg-hover
                           focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-1
                           transition-colors duration-100">{{ 'form.cancel'|trans }}</button>

            {% if error is null %}
                <button type="submit"
                        class="inline-flex items-center justify-center h-8 px-3.5 rounded-lg text-sm font-medium text-accent-ink
                               bg-accent hover:bg-accent-strong active:bg-blue-800
                               focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-1
                               transition-colors duration-100">{{ 'settings.contacts.subscribe.save'|trans }}</button>
            {% endif %}
        </div>
    </form>
</turbo-frame>
{% endblock %}
