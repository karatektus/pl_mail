{#
contacts/form.html.twig — new + edit.

Dynamic email/phone/address rows are server-rendered — from the contact, or
from the submitted draft after a failed save, whose rows carry `primary` only
when it was ticked; the "add" buttons are
handled by contacts--form (a tiny Stimulus controller — inline handlers are
refused by the CSP). Removed rows simply never submit, and update() treats
the submitted set as replace-all.

Variables: contact (Contact|null), isNew, postUrl, tokenId, draft (optional,
the failed create's submitted values), books (new only: the writable synced
address books a contact can be saved to, besides plMail's own).
#}
{% extends 'contacts/_layout.html.twig' %}
{% import 'contacts/_macros.html.twig' as cm %}

{% block title %}{{ (isNew ? 'contacts.new' : 'contacts.edit')|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% set d = draft|default(null) %}
{% set draftEmails = d ? (d.emails|default([])) : (contact ? contact.emails : []) %}
{% set draftPhones = d ? (d.phones|default([])) : (contact ? contact.phones : []) %}
{% set draftAddresses = d ? (d.addresses|default([])) : (contact ? contact.addresses : []) %}
{% set tagsValue = d ? (d.tags|default('')) : (contact ? contact.tags|join(', ') : '') %}
{# The labelled lists. A failed create's draft is not re-shown for these: it
   only fails for a missing name, and the rows are quick to add again. #}
{% set lists = {
    dates:        contact ? contact.dates : [],
    relations:    contact ? contact.relations : [],
    urls:         contact ? contact.urls : [],
    ims:          contact ? contact.ims : [],
    customFields: contact ? contact.customFields : [],
} %}
{% set labels = {
    dates:     ['anniversary', 'other'],
    relations: ['spouse', 'partner', 'child', 'parent', 'mother', 'father', 'sibling', 'brother', 'sister', 'friend', 'relative', 'manager', 'assistant', 'other'],
    urls:      ['home', 'work', 'blog', 'profile', 'other'],
    ims:       ['home', 'work', 'other'],
} %}
{% set imServices = ['sip', 'xmpp', 'skype', 'teams', 'matrix', 'aim', 'msn', 'yahoo', 'icq', 'qq', 'googleTalk', 'other'] %}
{% set selectCls = 'h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink shrink-0' %}

{% block contacts_content %}
<form method="post" action="{{ postUrl }}" data-controller="contacts--form" class="flex flex-col h-full min-h-0">
    <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">

    <div class="flex items-center gap-2 px-4 @2xl:px-6 h-14 border-b border-line shrink-0">
        <a href="{{ contact ? path('app_contacts_show', { id: contact.id }) : path('app_contacts_list') }}" class="{{ iconBtn }}" title="{{ 'contacts.cancel'|trans }}">
            <i class="fa-solid fa-arrow-left text-sm" aria-hidden="true"></i>
        </a>
        <h1 class="text-base font-semibold text-ink flex-1 min-w-0 truncate">
            {{ (isNew ? 'contacts.new' : 'contacts.edit')|trans }}
        </h1>
        <button type="submit" class="{{ btnPrimary }}">
            <i class="fa-solid fa-check text-xs" aria-hidden="true"></i>{{ 'contacts.save'|trans }}
        </button>
        {% include 'contacts/_pane_actions.html.twig' %}
    </div>

    <div class="flex-1 overflow-y-auto p-4 @2xl:p-6">
        <div class="max-w-2xl mx-auto flex flex-col gap-5">

            {% if isNew and books|default([]) is not empty %}
                <section class="{{ cardCls }}">
                    <label class="{{ labelCls }}" for="f-addressBook">{{ 'contacts.save_to'|trans }}</label>
                    <select id="f-addressBook" name="addressBook" class="{{ fieldCls }}">
                        <option value="">{{ 'contacts.book_local'|trans }}</option>
                        {% for book in books %}
                            <option value="{{ book.id }}" {{ (d.addressBook|default('')) == (book.id ~ '') ? 'selected' }}>{{ book.name }} — {{ book.holderName }}</option>
                        {% endfor %}
                    </select>
                    <p class="mt-1.5 text-xs text-ink-faint">{{ 'contacts.save_to_hint'|trans }}</p>
                </section>
            {% elseif contact and contact.addressBook %}
                <p class="text-xs text-ink-muted flex items-center gap-1.5">
                    <i class="fa-solid fa-cloud text-ink-faint" aria-hidden="true"></i>
                    {{ 'contacts.synced_with'|trans({'%book%': contact.addressBook.name, '%server%': contact.addressBook.holderName}) }}
                </p>
            {% endif %}

            <section class="{{ cardCls }}">
                <h2 class="text-sm font-semibold text-ink mb-3">{{ 'contacts.section_name'|trans }}</h2>
                <div class="grid gap-3 @lg:grid-cols-2">
                    <div class="@lg:col-span-2">
                        <label class="{{ labelCls }}" for="f-displayName">{{ 'contacts.display_name'|trans }}</label>
                        <input id="f-displayName" name="displayName" required maxlength="255" value="{{ cm.field('displayName', d, contact) }}" class="{{ fieldCls }}" autocomplete="off">
                    </div>
                    {% for key in ['namePrefix', 'givenName', 'middleName', 'familyName', 'nameSuffix', 'nickname'] %}
                        <div>
                            <label class="{{ labelCls }}" for="f-{{ key }}">{{ ('contacts.field.' ~ key)|trans }}</label>
                            <input id="f-{{ key }}" name="{{ key }}" maxlength="255" value="{{ cm.field(key, d, contact) }}" class="{{ fieldCls }}" autocomplete="off">
                        </div>
                    {% endfor %}
                </div>
                {% set hasPhonetic = contact and (contact.phoneticGivenName or contact.phoneticMiddleName or contact.phoneticFamilyName) %}
                <details class="mt-3 group" {{ hasPhonetic ? 'open' }}>
                    <summary class="text-xs font-medium text-ink-muted cursor-pointer select-none">{{ 'contacts.phonetic'|trans }}</summary>
                    <div class="grid gap-3 @lg:grid-cols-3 mt-3">
                        {% for key in ['phoneticGivenName', 'phoneticMiddleName', 'phoneticFamilyName'] %}
                            <div>
                                <label class="{{ labelCls }}" for="f-{{ key }}">{{ ('contacts.field.' ~ key)|trans }}</label>
                                <input id="f-{{ key }}" name="{{ key }}" maxlength="255" value="{{ cm.field(key, d, contact) }}" class="{{ fieldCls }}" autocomplete="off">
                            </div>
                        {% endfor %}
                    </div>
                </details>
            </section>

            <section class="{{ cardCls }}">
                <h2 class="text-sm font-semibold text-ink mb-3">{{ 'contacts.section_work'|trans }}</h2>
                <div class="grid gap-3 @lg:grid-cols-2">
                    {% for key in ['company', 'phoneticCompany', 'department', 'jobTitle', 'officeLocation'] %}
                        <div class="{{ 'officeLocation' == key ? '@lg:col-span-2' }}">
                            <label class="{{ labelCls }}" for="f-{{ key }}">{{ ('contacts.field.' ~ key)|trans }}</label>
                            <input id="f-{{ key }}" name="{{ key }}" maxlength="255" value="{{ cm.field(key, d, contact) }}" class="{{ fieldCls }}" autocomplete="off">
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="{{ cardCls }}">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-ink">{{ 'contacts.section_emails'|trans }}</h2>
                    <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addEmail">
                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ 'contacts.add_email'|trans }}
                    </button>
                </div>
                <div class="flex flex-col gap-2" data-contacts--form-target="emailRows" data-next-index="{{ draftEmails|length }}">
                    {% for email in draftEmails %}
                        {% set _val = email.value is defined ? email.value : email.email %}
                        {% set _prim = email.primary is defined ? email.primary : (email.isPrimary is defined ? email.isPrimary : false) %}
                        <div class="flex items-center gap-2" data-row>
                            <input name="emails[{{ loop.index0 }}][value]" value="{{ _val }}" type="email" maxlength="320"
                                   placeholder="{{ 'contacts.email_placeholder'|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
                            <select name="emails[{{ loop.index0 }}][label]" class="h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink shrink-0" aria-label="{{ 'contacts.label'|trans }}">
                                {% for l in ['home', 'work', 'other'] %}
                                    <option value="{{ l }}" {{ email.label == l ? 'selected' }}>{{ ('contacts.label_' ~ l)|trans }}</option>
                                {% endfor %}
                            </select>
                            <label class="flex items-center gap-1.5 text-xs text-ink-muted shrink-0 cursor-pointer" title="{{ 'contacts.primary'|trans }}">
                                <input type="checkbox" name="emails[{{ loop.index0 }}][primary]" value="1" {{ _prim ? 'checked' }} class="accent-[var(--color-accent)]">
                                {{ 'contacts.primary_short'|trans }}
                            </label>
                            <button type="button" class="{{ iconBtn }}" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
                                <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                            </button>
                        </div>
                    {% endfor %}
                </div>
                <template data-contacts--form-target="emailTemplate">
                    <div class="flex items-center gap-2" data-row>
                        <input name="emails[__INDEX__][value]" type="email" maxlength="320"
                               placeholder="{{ 'contacts.email_placeholder'|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
                        <select name="emails[__INDEX__][label]" class="h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink shrink-0" aria-label="{{ 'contacts.label'|trans }}">
                            {% for l in ['home', 'work', 'other'] %}
                                <option value="{{ l }}">{{ ('contacts.label_' ~ l)|trans }}</option>
                            {% endfor %}
                        </select>
                        <label class="flex items-center gap-1.5 text-xs text-ink-muted shrink-0 cursor-pointer" title="{{ 'contacts.primary'|trans }}">
                            <input type="checkbox" name="emails[__INDEX__][primary]" value="1" class="accent-[var(--color-accent)]">
                            {{ 'contacts.primary_short'|trans }}
                        </label>
                        <button type="button" class="{{ iconBtn }}" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
                            <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                        </button>
                    </div>
                </template>
            </section>

            <section class="{{ cardCls }}">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-ink">{{ 'contacts.section_phones'|trans }}</h2>
                    <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addPhone">
                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ 'contacts.add_phone'|trans }}
                    </button>
                </div>
                <div class="flex flex-col gap-2" data-contacts--form-target="phoneRows" data-next-index="{{ draftPhones|length }}">
                    {% for phone in draftPhones %}
                        {% set _val = phone.value is defined ? phone.value : phone.phone %}
                        {% set _prim = phone.primary is defined ? phone.primary : (phone.isPrimary is defined ? phone.isPrimary : false) %}
                        <div class="flex items-center gap-2" data-row>
                            <input name="phones[{{ loop.index0 }}][value]" value="{{ _val }}" type="tel" maxlength="64"
                                   placeholder="{{ 'contacts.phone_placeholder'|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
                            <select name="phones[{{ loop.index0 }}][label]" class="h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink shrink-0" aria-label="{{ 'contacts.label'|trans }}">
                                {% for l in ['mobile', 'home', 'work', 'other'] %}
                                    <option value="{{ l }}" {{ phone.label == l ? 'selected' }}>{{ ('contacts.label_' ~ l)|trans }}</option>
                                {% endfor %}
                            </select>
                            <label class="flex items-center gap-1.5 text-xs text-ink-muted shrink-0 cursor-pointer" title="{{ 'contacts.primary'|trans }}">
                                <input type="checkbox" name="phones[{{ loop.index0 }}][primary]" value="1" {{ _prim ? 'checked' }} class="accent-[var(--color-accent)]">
                                {{ 'contacts.primary_short'|trans }}
                            </label>
                            <button type="button" class="{{ iconBtn }}" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
                                <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                            </button>
                        </div>
                    {% endfor %}
                </div>
                <template data-contacts--form-target="phoneTemplate">
                    <div class="flex items-center gap-2" data-row>
                        <input name="phones[__INDEX__][value]" type="tel" maxlength="64"
                               placeholder="{{ 'contacts.phone_placeholder'|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
                        <select name="phones[__INDEX__][label]" class="h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink shrink-0" aria-label="{{ 'contacts.label'|trans }}">
                            {% for l in ['mobile', 'home', 'work', 'other'] %}
                                <option value="{{ l }}">{{ ('contacts.label_' ~ l)|trans }}</option>
                            {% endfor %}
                        </select>
                        <label class="flex items-center gap-1.5 text-xs text-ink-muted shrink-0 cursor-pointer" title="{{ 'contacts.primary'|trans }}">
                            <input type="checkbox" name="phones[__INDEX__][primary]" value="1" class="accent-[var(--color-accent)]">
                            {{ 'contacts.primary_short'|trans }}
                        </label>
                        <button type="button" class="{{ iconBtn }}" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
                            <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                        </button>
                    </div>
                </template>
            </section>

            <section class="{{ cardCls }}">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-ink">{{ 'contacts.section_addresses'|trans }}</h2>
                    <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addAddress">
                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ 'contacts.add_address'|trans }}
                    </button>
                </div>
                <div class="flex flex-col gap-3" data-contacts--form-target="addressRows" data-next-index="{{ draftAddresses|length }}">
                    {% for addr in draftAddresses %}
                        <div class="rounded-lg border border-line p-3 flex flex-col gap-2" data-row>
                            <div class="flex items-center gap-2">
                                <select name="addresses[{{ loop.index0 }}][label]" class="h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink" aria-label="{{ 'contacts.label'|trans }}">
                                    {% for l in ['home', 'work', 'other'] %}
                                        <option value="{{ l }}" {{ addr.label == l ? 'selected' }}>{{ ('contacts.label_' ~ l)|trans }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button" class="{{ iconBtn }} ml-auto" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
                                    <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                                </button>
                            </div>
                            <input name="addresses[{{ loop.index0 }}][street]" value="{{ addr.street|default('') }}" placeholder="{{ 'contacts.street'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                            <div class="grid grid-cols-2 gap-2">
                                <input name="addresses[{{ loop.index0 }}][city]" value="{{ addr.city|default('') }}" placeholder="{{ 'contacts.city'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                                <input name="addresses[{{ loop.index0 }}][region]" value="{{ addr.region|default('') }}" placeholder="{{ 'contacts.region'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                                <input name="addresses[{{ loop.index0 }}][postcode]" value="{{ addr.postcode|default('') }}" placeholder="{{ 'contacts.postcode'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                                <input name="addresses[{{ loop.index0 }}][country]" value="{{ addr.country|default('') }}" placeholder="{{ 'contacts.country'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <template data-contacts--form-target="addressTemplate">
                    <div class="rounded-lg border border-line p-3 flex flex-col gap-2" data-row>
                        <div class="flex items-center gap-2">
                            <select name="addresses[__INDEX__][label]" class="h-9 rounded-lg border border-field bg-field px-2 text-sm text-ink" aria-label="{{ 'contacts.label'|trans }}">
                                {% for l in ['home', 'work', 'other'] %}
                                    <option value="{{ l }}">{{ ('contacts.label_' ~ l)|trans }}</option>
                                {% endfor %}
                            </select>
                            <button type="button" class="{{ iconBtn }} ml-auto" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
                                <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
                            </button>
                        </div>
                        <input name="addresses[__INDEX__][street]" placeholder="{{ 'contacts.street'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                        <div class="grid grid-cols-2 gap-2">
                            <input name="addresses[__INDEX__][city]" placeholder="{{ 'contacts.city'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                            <input name="addresses[__INDEX__][region]" placeholder="{{ 'contacts.region'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                            <input name="addresses[__INDEX__][postcode]" placeholder="{{ 'contacts.postcode'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                            <input name="addresses[__INDEX__][country]" placeholder="{{ 'contacts.country'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                        </div>
                    </div>
                </template>
            </section>

            <section class="{{ cardCls }}">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-ink">{{ 'contacts.section_dates'|trans }}</h2>
                    <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addRow" data-contacts--form-list-param="dates">
                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ 'contacts.add_date'|trans }}
                    </button>
                </div>
                <div class="flex flex-col gap-2">
                    <div class="flex flex-wrap items-center gap-2" data-birthday>
                        <span class="w-28 text-sm text-ink-muted shrink-0">{{ 'contacts.field.birthday'|trans }}</span>
                        {{ cm.dateInputs('birthday', contact ? contact.birthday : null, fieldCls) }}
                    </div>
                    <div class="flex flex-col gap-2" data-list-rows="dates" data-next-index="{{ lists.dates|length }}">
                        {% for row in lists.dates %}
                            <div class="flex flex-wrap items-center gap-2" data-row>
                                {{ cm.labelSelect('dates[' ~ loop.index0 ~ '][label]', labels.dates, row.label, selectCls ~ ' w-28') }}
                                {{ cm.dateInputs('dates[' ~ loop.index0 ~ ']', row.date, fieldCls) }}
                                {{ _self.removeButton(iconBtn) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <template data-list-template="dates">
                    <div class="flex flex-wrap items-center gap-2" data-row>
                        {{ cm.labelSelect('dates[__INDEX__][label]', labels.dates, 'anniversary', selectCls ~ ' w-28') }}
                        {{ cm.dateInputs('dates[__INDEX__]', null, fieldCls) }}
                        {{ _self.removeButton(iconBtn) }}
                    </div>
                </template>
            </section>

            {{ _self.pairList('relations', 'name', 'contacts.section_relations', 'contacts.add_relation', 'contacts.relation_placeholder', 'text', lists.relations, labels.relations, cardCls, btnGhost, fieldCls, selectCls, iconBtn) }}
            {{ _self.pairList('urls', 'url', 'contacts.section_urls', 'contacts.add_url', 'contacts.url_placeholder', 'url', lists.urls, labels.urls, cardCls, btnGhost, fieldCls, selectCls, iconBtn) }}

            <section class="{{ cardCls }}">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-ink">{{ 'contacts.section_ims'|trans }}</h2>
                    <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addRow" data-contacts--form-list-param="ims">
                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ 'contacts.add_im'|trans }}
                    </button>
                </div>
                <div class="flex flex-col gap-2" data-list-rows="ims" data-next-index="{{ lists.ims|length }}">
                    {% for row in lists.ims %}
                        {{ _self.imRow(loop.index0, row, imServices, labels.ims, fieldCls, selectCls, iconBtn) }}
                    {% endfor %}
                </div>
                <template data-list-template="ims">
                    {{ _self.imRow('__INDEX__', {service: 'sip', handle: '', label: 'other'}, imServices, labels.ims, fieldCls, selectCls, iconBtn) }}
                </template>
            </section>

            <section class="{{ cardCls }}">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-ink">{{ 'contacts.section_custom'|trans }}</h2>
                    <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addRow" data-contacts--form-list-param="customFields">
                        <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ 'contacts.add_custom'|trans }}
                    </button>
                </div>
                <div class="flex flex-col gap-2" data-list-rows="customFields" data-next-index="{{ lists.customFields|length }}">
                    {% for row in lists.customFields %}
                        {{ _self.customRow(loop.index0, row, fieldCls, iconBtn) }}
                    {% endfor %}
                </div>
                <template data-list-template="customFields">
                    {{ _self.customRow('__INDEX__', {label: '', value: ''}, fieldCls, iconBtn) }}
                </template>
            </section>

            <section class="{{ cardCls }}">
                <h2 class="text-sm font-semibold text-ink mb-3">{{ 'contacts.section_notes'|trans }}</h2>
                <div class="flex flex-col gap-3">
                    <div>
                        <label class="{{ labelCls }}" for="f-notes">{{ 'contacts.notes'|trans }}</label>
                        <textarea id="f-notes" name="notes" rows="4" class="{{ fieldCls }} h-auto py-2">{{ cm.field('notes', d, contact) }}</textarea>
                    </div>
                    <div>
                        <label class="{{ labelCls }}" for="f-tags">{{ 'contacts.tags'|trans }}</label>
                        <input id="f-tags" name="tags" value="{{ tagsValue }}" placeholder="{{ 'contacts.tags_placeholder'|trans }}" class="{{ fieldCls }}" autocomplete="off">
                    </div>
                </div>
            </section>

        </div>
    </div>
</form>

{% if not isNew %}
    <div class="flex items-center gap-2 px-4 @2xl:px-6 h-14 border-t border-line shrink-0">
        <form method="post" action="{{ path('app_contacts_photo', { id: contact.id }) }}" enctype="multipart/form-data"
              data-controller="contacts--form" class="flex items-center gap-2 min-w-0">
            <input type="hidden" name="_token" value="{{ csrf_token('contacts_photo_' ~ contact.id) }}">
            {{ cm.avatar(contact, 'w-9 h-9 text-sm') }}
            <label class="{{ btnGhost }} cursor-pointer">
                <i class="fa-solid fa-camera text-xs" aria-hidden="true"></i>{{ 'contacts.photo_upload'|trans }}
                <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="sr-only"
                       data-action="change->contacts--form#submitForm">
            </label>
            <span class="text-xs text-ink-faint hidden @lg:inline">{{ 'contacts.photo_hint'|trans }}</span>
        </form>
        {% if contact.photoPath %}
            <form method="post" action="{{ path('app_contacts_photo_remove', { id: contact.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('contacts_photo_' ~ contact.id) }}">
                <button type="submit" class="{{ iconBtn }}" title="{{ 'contacts.photo_remove'|trans }}" aria-label="{{ 'contacts.photo_remove'|trans }}">
                    <i class="fa-solid fa-trash-can text-xs" aria-hidden="true"></i>
                </button>
            </form>
        {% endif %}
        <form method="post" action="{{ path('app_contacts_delete', { id: contact.id }) }}"
              data-turbo-confirm="{{ 'contacts.delete_confirm'|trans({'%name%': contact.displayName}) }}" class="ml-auto">
            <input type="hidden" name="_token" value="{{ csrf_token('contacts_delete_' ~ contact.id) }}">
            <button type="submit" class="{{ btnDanger }}">
                <i class="fa-solid fa-trash text-xs" aria-hidden="true"></i>{{ 'contacts.delete'|trans }}
            </button>
        </form>
    </div>
{% endif %}
{% endblock %}

{% macro removeButton(iconBtn) %}
    <button type="button" class="{{ iconBtn }}" data-action="click->contacts--form#removeRow" title="{{ 'contacts.remove'|trans }}" aria-label="{{ 'contacts.remove'|trans }}">
        <i class="fa-solid fa-xmark text-xs" aria-hidden="true"></i>
    </button>
{% endmacro %}

{# A card of label + value rows: relations (name) and websites (url). #}
{% macro pairList(list, key, title, addLabel, placeholder, type, rows, labels, cardCls, btnGhost, fieldCls, selectCls, iconBtn) %}
    {% import 'contacts/_macros.html.twig' as cm %}
    <section class="{{ cardCls }}">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-ink">{{ title|trans }}</h2>
            <button type="button" class="{{ btnGhost }}" data-action="click->contacts--form#addRow" data-contacts--form-list-param="{{ list }}">
                <i class="fa-solid fa-plus text-xs" aria-hidden="true"></i>{{ addLabel|trans }}
            </button>
        </div>
        <div class="flex flex-col gap-2" data-list-rows="{{ list }}" data-next-index="{{ rows|length }}">
            {% for row in rows %}
                <div class="flex items-center gap-2" data-row>
                    {{ cm.labelSelect(list ~ '[' ~ loop.index0 ~ '][label]', labels, row.label, selectCls ~ ' w-32') }}
                    <input name="{{ list }}[{{ loop.index0 }}][{{ key }}]" value="{{ attribute(row, key) }}" type="{{ type }}" maxlength="1024"
                           placeholder="{{ placeholder|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
                    {{ _self.removeButton(iconBtn) }}
                </div>
            {% endfor %}
        </div>
        <template data-list-template="{{ list }}">
            <div class="flex items-center gap-2" data-row>
                {{ cm.labelSelect(list ~ '[__INDEX__][label]', labels, labels|first, selectCls ~ ' w-32') }}
                <input name="{{ list }}[__INDEX__][{{ key }}]" type="{{ type }}" maxlength="1024"
                       placeholder="{{ placeholder|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
                {{ _self.removeButton(iconBtn) }}
            </div>
        </template>
    </section>
{% endmacro %}

{% macro imRow(index, row, services, labels, fieldCls, selectCls, iconBtn) %}
    {% import 'contacts/_macros.html.twig' as cm %}
    <div class="flex flex-wrap items-center gap-2" data-row>
        <select name="ims[{{ index }}][service]" class="{{ selectCls }} w-32" aria-label="{{ 'contacts.im_service_label'|trans }}">
            {% if row.service not in services %}
                <option value="{{ row.service }}" selected>{{ row.service }}</option>
            {% endif %}
            {% for service in services %}
                <option value="{{ service }}" {{ row.service == service ? 'selected' }}>{{ ('contacts.im_service.' ~ service)|trans }}</option>
            {% endfor %}
        </select>
        <input name="ims[{{ index }}][handle]" value="{{ row.handle }}" maxlength="1024"
               placeholder="{{ 'contacts.im_placeholder'|trans }}" class="{{ fieldCls }} flex-1 min-w-40" autocomplete="off">
        {{ cm.labelSelect('ims[' ~ index ~ '][label]', labels, row.label, selectCls ~ ' w-28') }}
        {{ _self.removeButton(iconBtn) }}
    </div>
{% endmacro %}

{% macro customRow(index, row, fieldCls, iconBtn) %}
    <div class="flex items-center gap-2" data-row>
        <input name="customFields[{{ index }}][label]" value="{{ row.label }}" maxlength="1024"
               placeholder="{{ 'contacts.custom_label_placeholder'|trans }}" aria-label="{{ 'contacts.label'|trans }}" class="{{ fieldCls }} w-40 shrink-0" autocomplete="off">
        <input name="customFields[{{ index }}][value]" value="{{ row.value }}" maxlength="1024"
               placeholder="{{ 'contacts.custom_value_placeholder'|trans }}" class="{{ fieldCls }} flex-1 min-w-0" autocomplete="off">
        {{ _self.removeButton(iconBtn) }}
    </div>
{% endmacro %}
