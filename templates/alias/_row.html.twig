{% set isPrimary  = alias.status.value == 'primary' %}
{% set isInactive = alias.status.value == 'inactive' %}
{% set isSystem   = alias.source.value == 'system' %}

<li class="flex items-start gap-3 py-1">
    <span class="mt-1.5 w-2 h-2 rounded-full shrink-0 {{ isInactive ? 'bg-ink-faint' : 'bg-green-400' }}"
          aria-hidden="true"></span>

    <div class="flex-1 min-w-0">
        <span class="block truncate text-sm {{ isInactive ? 'text-ink-faint line-through' : 'text-ink' }}">
            {{ alias.address }}
            {% if isSystem %}
                <span class="ml-1 text-[11px] text-ink-faint">({{ 'settings.aliases.system'|trans }})</span>
            {% endif %}
        </span>

        {# The name this address sends under. Empty means the account's own,
           which is why that is the placeholder: it is what the recipient sees
           until something is typed here. Not offered on a disabled address —
           it sends nothing, so it has no name to send under. #}
        {% if not isInactive %}
            <form method="post" action="{{ path('app_alias_name', { id: account.id, aliasId: alias.id }) }}"
                  data-turbo-stream class="mt-0.5 flex items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('alias-name' ~ alias.id) }}">
                <input type="text" name="name" value="{{ alias.displayName }}" maxlength="255"
                       autocomplete="off" data-1p-ignore data-lpignore="true"
                       placeholder="{{ account.name ?: 'settings.aliases.name_placeholder'|trans }}"
                       aria-label="{{ 'settings.aliases.name_for'|trans({'%alias%': alias.address}) }}"
                       class="min-w-0 flex-1 max-w-xs h-7 rounded-md border border-line bg-surface px-2 text-xs text-ink
                              placeholder:text-ink-faint focus:border-accent focus:outline-none">
                <button type="submit" class="shrink-0 text-[11px] text-ink-faint hover:text-accent transition-colors cursor-pointer">
                    {{ 'settings.aliases.name_save'|trans }}
                </button>
            </form>
        {% endif %}
    </div>

    {% if isPrimary %}
        <span class="shrink-0 inline-flex items-center rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-medium text-accent">
            {{ 'settings.aliases.primary'|trans }}
        </span>
    {% else %}
        <form method="post" action="{{ path('app_alias_primary', { id: account.id, aliasId: alias.id }) }}"
              data-turbo-stream class="shrink-0">
            <input type="hidden" name="_token" value="{{ csrf_token('alias-primary' ~ alias.id) }}">
            <button type="submit" class="text-[11px] text-ink-faint hover:text-accent transition-colors cursor-pointer">
                {{ 'settings.aliases.make_primary'|trans }}
            </button>
        </form>

        <form method="post" action="{{ path('app_alias_status', { id: account.id, aliasId: alias.id }) }}"
              data-turbo-stream class="shrink-0">
            <input type="hidden" name="_token" value="{{ csrf_token('alias-status' ~ alias.id) }}">
            <input type="hidden" name="status" value="{{ isInactive ? 'active' : 'inactive' }}">
            <button type="submit" class="text-[11px] text-ink-faint hover:text-ink-muted transition-colors cursor-pointer">
                {{ isInactive ? 'settings.aliases.enable'|trans : 'settings.aliases.disable'|trans }}
            </button>
        </form>

        {% if alias.source.value == 'manual' %}
            <form method="post" action="{{ path('app_alias_delete', { id: account.id, aliasId: alias.id }) }}"
                  data-turbo-stream class="shrink-0">
                <input type="hidden" name="_token" value="{{ csrf_token('alias-delete' ~ alias.id) }}">
                <button type="submit" class="text-[11px] text-ink-faint hover:text-red-500 transition-colors cursor-pointer"
                        aria-label="{{ 'settings.aliases.delete'|trans }}">
                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                </button>
            </form>
        {% endif %}
    {% endif %}
</li>
