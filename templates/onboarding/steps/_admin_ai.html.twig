<p class="text-sm text-ink-soft">{{ 'onboarding.step.admin-ai.intro'|trans }}</p>
<div data-controller="admin--ai-provider" data-action="change->admin--ai-provider#update" class="space-y-5">
    {{ form_row(form.isEnabled) }}
    <h3>{{ 'admin.ai.generation.heading'|trans }}</h3>
    {{ form_row(form.chatProvider) }}
    <div data-ai-panel="generationOpenai" class="space-y-5">
        {{ form_row(form.openAiBaseUrl) }}{{ form_row(form.openAiModel) }}{{ form_row(form.openAiApiToken) }}
    </div>
    <div data-ai-panel="generationOllama" class="space-y-5">
        {{ form_row(form.baseUrl) }}{{ form_row(form.apiToken) }}{{ form_row(form.chatModel) }}{{ form_row(form.chatKeepAlive) }}
    </div>
    {{ form_row(form.searchEnabled) }}
    <div data-ai-panel="embeddings" class="space-y-5">
        <h3>{{ 'admin.ai.embedding.heading'|trans }}</h3><p>{{ 'admin.ai.embedding.explanation'|trans }}</p>
        {{ form_row(form.embeddingSharedConnection) }}
        <div data-ai-panel="independent" class="space-y-5">{{ form_row(form.embeddingProvider) }}{{ form_row(form.embeddingBaseUrl) }}{{ form_row(form.embeddingApiToken) }}</div>
        {{ form_row(form.embeddingModel) }}{{ form_row(form.embeddingRevision) }}{{ form_row(form.searchQueryInstruction) }}{{ form_row(form.semanticMinSimilarity) }}
        <div data-ai-panel="embeddingOllama">{{ form_row(form.embeddingKeepAlive) }}</div>
    </div>
    {{ form_rest(form) }}
</div>
