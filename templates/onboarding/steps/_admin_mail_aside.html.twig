{#
The step-by-step for the selected provider, plus the redirect URI it has to be
given. Longer than the admin panel's version on purpose: this is where someone
sets plMail up for the first time, and "create an OAuth app" is not a single
action if you have never opened the console before.

The redirect URI is the same copyable block the admin form uses — pasting it
wrong is the most common reason sign-in never works.
#}
{% set key = 'onboarding.aside.admin_mail.' ~ provider.value %}

<p class="font-medium text-ink-soft">{{ (key ~ '.heading')|trans }}</p>

<ol class="mt-3 space-y-2 list-decimal list-outside pl-4 marker:text-ink-faint">
    {% for i in 1..6 %}
        {% set line = (key ~ '.step' ~ i)|trans %}
        {% if line != key ~ '.step' ~ i %}
            <li class="pl-1 leading-relaxed">{{ line }}</li>
        {% endif %}
    {% endfor %}
</ol>

<div class="mt-4 pt-4 border-t border-line">
    <span class="block text-[13px] font-medium leading-none text-ink-soft">
        {{ 'admin.integrations.field.redirect_uri'|trans }}
    </span>
    <div class="mt-1.5 flex items-center gap-2"
         data-controller="ui--clipboard"
         data-ui--clipboard-confirm-text-value="{{ 'clipboard.copied'|trans }}"
         data-ui--clipboard-failed-text-value="{{ 'clipboard.copy_failed'|trans }}">
        <code data-ui--clipboard-target="source"
              class="flex-1 min-w-0 truncate rounded-lg bg-surface border border-line px-3 py-2 text-xs text-ink-muted">{{ url('app_oauth_callback', { provider: provider.value }) }}</code>
        <button type="button"
                data-action="click->ui--clipboard#copy"
                class="shrink-0 h-9 w-9 flex items-center justify-center rounded-lg text-ink-soft
                       bg-field border border-field hover:bg-hover transition-colors"
                aria-label="{{ 'admin.integrations.copy_redirect_uri'|trans }}">
            <i class="fa-solid fa-copy text-xs" aria-hidden="true"></i>
        </button>
    </div>
    <p class="mt-1.5 text-xs text-ink-faint">{{ 'admin.integrations.field.redirect_uri_help'|trans }}</p>
</div>
