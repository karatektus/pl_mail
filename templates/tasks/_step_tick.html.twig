{#
tasks/_step_tick.html.twig — the tick of a saved step, in its row or in the dialog.

Drawn from aria-checked alone, because tasks--step-tick sets that the moment it is
pressed, before the server has heard. The step's title follows it as a peer, so it
goes right after this. Named after the step and nothing else: "checked" is said by
the role, and the name does not have to change with it.

Accepts: step Task · readOnly bool · offset string, classes to line it up (default mt-0.5, beside text)
#}
<button type="button"
        role="checkbox"
        aria-checked="{{ step.status.isOpen ? 'false' : 'true' }}"
        aria-label="{{ step.title }}"
        data-task-step-tick="{{ step.id }}"
        data-controller="tasks--step-tick"
        data-action="tasks--step-tick#tick"
        data-tasks--step-tick-id-value="{{ step.id }}"
        data-tasks--step-tick-url-value="{{ path('app_tasks_step_tick', { id: step.id }) }}"
        data-tasks--step-tick-token-value="{{ csrf_token('tasks_toggle') }}"
        {% if readOnly %}disabled{% endif %}
        class="peer group/tick flex items-center justify-center size-4 {{ offset ?? 'mt-0.5' }} shrink-0 rounded-full border border-ink-faint transition-colors
               aria-checked:border-accent aria-checked:bg-accent aria-checked:text-accent-ink
               {{ readOnly ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer hover:border-accent' }}">
    <i class="fa-solid fa-check text-[0.5rem] invisible group-aria-checked/tick:visible" aria-hidden="true"></i>
</button>
