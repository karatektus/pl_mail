{#
mail/_reply_zone.html.twig
─────────────────────────────────────────────────────────────────────────────
Bottom of the conversation: the Reply / Reply all / Forward buttons and the
turbo-frame the inline compose card loads into.

Replaced wholesale by a Turbo Stream after an inline send, which is why the
outer #reply_zone_{id} element is part of this template.

Variables:
  thread   MessageThread
  sending  null | { messageId, undoUrl, delay }  — post-send countdown state.
           **Nothing passes this any more.** A send no longer replaces the
           composer with a countdown bar here; the composer stays open and its
           Send pill is the cancel (see compose/_sending.stream.html.twig).
           The block is left in place, unreached, while that is reviewed.

The action buttons hide themselves while a compose card is open; see the
[data-reply-zone] rule in assets/styles/app.css.
#}
{% set sending = sending|default(null) %}
{# The conversation-newest message, passed from the thread view. Falls back to
   the association's last, which is right whenever a reply zone is re-rendered
   just after sending (the sent message is genuinely newest then) but wrong on
   a fresh thread open, which is why the ordered value is threaded through. #}
{% set last    = latest|default(thread.messages|last) %}
{% set frame   = 'compose_inline' %}
{% set params  = { frame: frame, thread: thread.id } %}

<div id="reply_zone_{{ thread.id }}" class="mt-6" data-reply-zone>

    {% if last is not null %}
        {% set hasMultipleParticipants = ((last.toAddresses ?? [])|length + (last.ccAddresses ?? [])|length) > 1 %}

        {# Prefetch off on all three, and this is the row the report was about.
           Turbo Drive prefetches a link on hover, and hovering Reply is what
           you do on the way to clicking it — so every pass of the pointer
           rebuilt the entire compose window server-side: the form, the
           identity's signature, and the sanitised quote of the whole original.
           Nothing is written by that GET, so it was waste rather than damage,
           and it was waste on the two controls at the bottom of every mail.

           Same attribute, same reason, as the thread rows and the folder rows
           — see _thread_row.html.twig, where a prefetched response ALSO had to
           be declined for a second reason. #}
        <div data-reply-actions class="flex items-center gap-2 {{ sending ? 'hidden' : '' }}">
            <a
                href="{{ path('app_compose_reply', params|merge({ id: last.id })) }}"
                data-turbo-frame="{{ frame }}"
                data-controller="compose--frame-target"
                data-turbo-prefetch="false"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium
                       text-ink-soft bg-sunken border border-line hover:bg-hover transition-colors"
            >
                <i class="fa-solid fa-reply text-xs" aria-hidden="true"></i>
                {{ 'compose.reply'|trans }}
            </a>

            {% if hasMultipleParticipants %}
                <a
                    href="{{ path('app_compose_reply_all', params|merge({ id: last.id })) }}"
                    data-turbo-frame="{{ frame }}"
                    data-controller="compose--frame-target"
                data-turbo-prefetch="false"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium
                           text-ink-soft bg-sunken border border-line hover:bg-hover transition-colors"
                >
                    <i class="fa-solid fa-reply-all text-xs" aria-hidden="true"></i>
                    {{ 'compose.reply_all'|trans }}
                </a>
            {% endif %}

            <a
                href="{{ path('app_compose_forward', params|merge({ id: last.id })) }}"
                data-turbo-frame="{{ frame }}"
                data-controller="compose--frame-target"
                data-turbo-prefetch="false"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium
                       text-ink-soft bg-sunken border border-line hover:bg-hover transition-colors"
            >
                <i class="fa-solid fa-share text-xs" aria-hidden="true"></i>
                {{ 'compose.forward'|trans }}
            </a>
        </div>
    {% endif %}

    {% if sending %}
        <div data-controller="compose--inline-send"
             data-compose--inline-send-url-value="{{ sending.undoUrl }}"
             data-compose--inline-send-delay-value="{{ sending.delay }}">
            <button
                type="button"
                data-action="click->compose--inline-send#cancel"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium
                       text-accent bg-accent-soft border border-accent/30
                       hover:bg-accent hover:text-accent-ink transition-colors cursor-pointer"
            >
                <i class="fa-solid fa-paper-plane text-xs" aria-hidden="true"></i>
                <span>{{ 'compose.sending'|trans }}</span>
                <span class="tabular-nums" data-compose--inline-send-target="countdown">{{ (sending.delay / 1000)|round }}</span><span>s</span>
                <span class="opacity-70">— {{ 'compose.click_to_cancel'|trans }}</span>
            </button>
        </div>
    {% endif %}

    <turbo-frame id="{{ frame }}"></turbo-frame>
</div>
