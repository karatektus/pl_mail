{# mail/snoozed.html.twig #}
{% extends "_layout/_mailbox.html.twig" %}

{% block list_scope %}snoozed{% endblock %}

{% block title %}{{ "sidebar.nav.snoozed"|trans }} — {{ "app.name"|trans }}{% endblock %}

{% block message_list %}
    {% if threads is empty %}
        <li class="px-4 py-8 text-center text-sm text-ink-faint">
            {{ "snoozed.empty"|trans }}
        </li>
    {% else %}
        {% for thread in threads %}
            {# snooze_scope: the one thing this list is about is WHEN each
               conversation comes back, and the row showed the time it arrived
               instead — so every row said something true and useless, and there
               was no way to tell a mail returning in an hour from one returning
               in a fortnight. #}
            {% include "_partials/_thread_row.html.twig" with {
                thread:        thread,
                snooze_scope:  true,
            } %}
        {% endfor %}
    {% endif %}
{% endblock %}
