{#
mail/print.html.twig
─────────────────────────────────────────────────────────────────────────────
Standalone printable view of a single message (opened in a new tab, fires the
print dialog on load). Only the sanitized body is rendered as markup.

NOT iframed, unlike the reading pane — this page IS the message, and a print
dialog aimed at a page whose content is in a frame paginates the frame's
scrollbox rather than the mail. The two things the frame was buying are bought
here another way: the CSP below refuses to execute anything (the print trigger
carries the one nonce), and there is no application DOM on this page for mail
CSS to collide with.

Remote images follow the SAME rule as the reading pane — blocked unless the
sender is on the reader's allowlist. Printing is a read, and a tracking pixel
does not care which stylesheet fired it.
#}
{% set render = message_render(message) %}<!DOCTYPE html>
<html lang="{{ app.request.locale|replace({'_': '-'}) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Security-Policy" content="{{ render.csp }}">
    {% include '_partials/_favicon.html.twig' %}
    <title>{{ message.subject ?: ('thread.no_subject'|trans) }}</title>
    <style>
        body {
            margin: 0;
            padding: 32px;
            font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #fff;
            color: #202124;
        }
        h1 { font-size: 18px; font-weight: 600; margin: 0 0 12px; }
        .meta { border-bottom: 1px solid #e0e0e0; padding-bottom: 12px; margin-bottom: 20px; }
        .meta p { margin: 2px 0; }
        .meta .muted { color: #5f6368; font-size: 12px; }
        .body { word-break: break-word; }
        .body img { max-width: 100%; height: auto; }
        .attachments { margin-top: 24px; border-top: 1px solid #e0e0e0; padding-top: 12px; font-size: 12px; color: #5f6368; }
        .warning { border: 1px solid #b91c1c; color: #b91c1c; border-radius: 6px; padding: 8px 12px; margin-bottom: 16px; font-size: 12px; }
        @media print {
            body { padding: 0; }
            @page { margin: 1.5cm; }
        }
    </style>
</head>
<body>

<h1>{{ message.subject ?: ('thread.no_subject'|trans) }}</h1>

<div class="meta">
    <p><strong>{{ message.fromName ?: message.fromAddress }}</strong>
        {% if message.fromName %}<span class="muted">&lt;{{ message.fromAddress }}&gt;</span>{% endif %}
    </p>
    <p class="muted">
        {{ 'message.details.to_label'|trans }}:
        {%- for entry in message.toAddresses ?? [] %} {{ entry.address }}{{ not loop.last ? ',' : '' }}{% else %} —{% endfor %}
    </p>
    <p class="muted">
        {% set printedAt = message.receivedAt ?? message.sentAt %}
        {{ printedAt ? printedAt|intl_date('EEEdMMMy') ~ ', ' ~ printedAt|date(clock.time) : '' }}
    </p>
</div>

{% if render.inSpam or render.mismatch is not null %}
    <div class="warning">
        {% if render.inSpam %}{{ 'message.security.spam.title'|trans }} — {{ 'message.security.spam.body'|trans }}{% endif %}
        {% if render.mismatch is not null %}
            {{ render.mismatch.kind.translationKey|trans({
                '%claimed%': render.mismatch.claimed,
                '%actual%':  render.mismatch.actual,
            }) }}
        {% endif %}
    </div>
{% endif %}

<div class="body">
    {% if render.content.html is not empty %}
        {{ render.content.html|raw }}
    {% else %}
        <pre style="white-space: pre-wrap; font: inherit;">{{ render.text }}</pre>
    {% endif %}
</div>

{% if render.content.blocked > 0 %}
    <p class="attachments">{{ 'message.images.blocked'|trans({'%count%': render.content.blocked}) }}</p>
{% endif %}

{% if message.hasAttachments %}
    <div class="attachments">
        {{ 'message.attachments'|trans }}:
        {% for part in message.messageParts %}{% if not part.isInline %}{{ part.filename ?: 'attachment' }}{{ not loop.last ? ', ' : '' }}{% endif %}{% endfor %}
    </div>
{% endif %}

<script nonce="{{ render.nonce }}">window.addEventListener('load', () => window.print());</script>

</body>
</html>
