{#
mail/_thread_message.html.twig
─────────────────────────────────────────────────────────────────────────────
One message inside the conversation view. Extracted so a Turbo Stream can
append or remove exactly one message (see compose/_inline_send.stream.html.twig).

Variables:
  message   Message
  expanded  bool   — render open (newest message / unread) or collapsed
  draft     bool   — override; a just-sent message still carries the DRAFT
                     flag for a moment, but belongs in the thread as a message
#}
{% set expanded = expanded|default(false) %}
{% set isDraft  = draft is defined ? draft : message.isDraft %}

{# A draft has no body worth reading — clicking it opens the editor in the
   reply zone, which then hides this row for as long as it is open. #}
{% if isDraft %}
    {# The row is its own turbo-frame, so the editor opens right here rather
       than at the foot of the thread. compose--compose#close navigates it back. #}
    {% set threaded = message.thread is not null %}
    {% set draftFrame = threaded ? 'compose_draft_' ~ message.id : 'compose_dock' %}
    {% set composeParams = threaded
        ? { frame: draftFrame, thread: message.thread.id }
        : {} %}
    {# No |striptags: bodyText is already plain text, so a second strip deletes
       literal angle brackets the user wrote rather than any real markup. See the
       longer note in _partials/_thread_row.html.twig. #}
    {% set snippet = message.bodyText ? message.bodyText|trim : '' %}

    <div id="thread_message_{{ message.id }}" class="border-b border-line last:border-b-0 py-4 first:pt-0">
        <turbo-frame id="{{ draftFrame }}">
            <a
                href="{{ path('app_compose_edit', composeParams|merge({ id: message.id })) }}"
                data-turbo-frame="{{ draftFrame }}"
                data-controller="compose--frame-target"
                class="flex items-center gap-3 cursor-pointer group"
            >
                <div class="w-9 h-9 rounded-full bg-sunken border border-line flex-shrink-0 flex items-center justify-center text-ink-faint text-sm">
                    <i class="fa-regular fa-pen-to-square text-xs" aria-hidden="true"></i>
                </div>

                <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-2">
                        <span class="text-sm font-medium text-danger">{{ 'message.draft'|trans }}</span>
                        {# Same badge as the Drafts list, for the same reason:
                           this row is what a scheduled reply looks like once
                           the composer has closed over it, and "Draft" alone
                           says the opposite of what is true. #}
                        {% if message.sentAt is null and message.submissionSendAt is not null %}
                            <span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full
                                         text-[11px] font-medium bg-info/10 text-info whitespace-nowrap"
                                  data-scheduled-badge>
                                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                {{ 'thread_row.scheduled'|trans({
                                    '%when%': 'compose.schedule.when'|trans({
                                        '%date%': message.submissionSendAt|intl_date('dMMM', clock.timezone),
                                        '%time%': message.submissionSendAt|date(clock.time, clock.timezone),
                                    }),
                                }) }}
                            </span>
                        {% endif %}
                        <span class="text-xs text-ink-muted truncate">
                            {{ snippet ?: (message.subject ?: ('compose.empty_draft'|trans)) }}
                        </span>
                    </div>
                </div>

                <span class="text-xs text-ink-faint whitespace-nowrap group-hover:text-ink-soft transition-colors">
                    {{ 'compose.continue_editing'|trans }}
                </span>
            </a>
        </turbo-frame>
    </div>
{% else %}

<div
    id="thread_message_{{ message.id }}"
    class="border-b border-line last:border-b-0 py-4 first:pt-0"
    data-controller="mail--thread-message"
    data-mail--thread-message-expanded-value="{{ expanded ? 'true' : 'false' }}"
>
    {# ── Header row ─────────────────────────────────────────────────────── #}
    {# Sticky within the conversation scroller (H-14). Long mail used to carry
       the sender, the date and every action off the top of the pane, so the
       answer to "who is this from" was a scroll away from the sentence that
       raised the question. Each message's header parks at the top and is
       pushed out by the next one's, which is what a reader expects from a
       list of things they are moving through.

       bg-surface, not transparent: `.mail-sheet` re-points --rgb-surface at the
       sheet, so this is the sheet's own colour and the body scrolls *under* it
       rather than through it. z-10 keeps it over the frame. #}
    <div class="flex items-start gap-3 sticky top-0 z-10 bg-surface pt-2 -mt-2 pb-2">
        {# Same tone the thread list derives for this sender — one person, one
           colour, wherever they appear. The gradient this replaces was a
           hardcoded one-off that predated SenderAvatarExtension: every sender
           wore the same blue, and "<hello@…>" wore a bracket. #}
        <div class="w-9 h-9 rounded-full flex-shrink-0 flex items-center justify-center text-sm font-semibold select-none
                    {{ (message.fromAddress ?: message.fromName)|avatar_tone }}">
            {{ message.fromName|avatar_initial(message.fromAddress) }}
        </div>

        <div
            class="flex-1 min-w-0 cursor-pointer"
            data-action="click->mail--thread-message#toggle"
        >
            <div class="flex items-baseline gap-2 flex-wrap">
                <span class="text-sm font-semibold text-ink truncate">
                    {{ message.fromName ?: message.fromAddress }}
                </span>
                {% if message.fromName %}
                    <span class="text-xs text-ink-faint truncate">&lt;{{ message.fromAddress }}&gt;</span>
                {% endif %}

                {# The labels on THIS message, not on the thread. A rule that
                   files one reply, or a label applied to a single message,
                   was visible in the list row and nowhere in the thread it
                   opened — so the thread showed a label the message in front
                   of you did not have, and hid the one it did. Same chips as
                   the list, so a label looks like itself everywhere. #}
                {% include '_partials/_thread_labels.html.twig' with { item: message } only %}
            </div>

            {# The details popover must not toggle the message, so it stops
               the click itself (see message_details#toggle). #}
            <div data-mail--thread-message-target="recipients" class="{{ expanded ? '' : 'hidden' }}">
                {% include 'mail/_message_details.html.twig' with { message: message } only %}
            </div>

            {# Snippet — collapsed #}
            <div
                data-mail--thread-message-target="snippet"
                class="text-xs text-ink-muted truncate py-0.5 {{ expanded ? 'hidden' : '' }}"
            >
                {{ message.bodyText|slice(0, 200) }}…
            </div>
        </div>

        <div class="flex items-center gap-1 flex-shrink-0">
            <span class="text-xs text-ink-faint whitespace-nowrap">
                {# Date through the locale, time through the user's 12/24-hour
                   setting: the two answer different questions and only one of
                   them is a property of the language. Sent mail has no
                   receivedAt — it was never received — so it shows its sentAt
                   and stops being the one message in a thread with no date. #}
                {% set shownAt = message.receivedAt ?? message.sentAt %}
                {{ shownAt ? shownAt|intl_date('dMMM') ~ ', ' ~ shownAt|date(clock.time) : '' }}
            </span>

            {% include 'mail/_message_actions.html.twig' with { message: message } only %}

            <button
                type="button"
                data-action="click->mail--thread-message#toggle:stop"
                data-mail--thread-message-target="toggleBtn"
                aria-label="{{ 'message.actions.expand'|trans }}"
                class="flex items-center justify-center w-8 h-8 rounded-full text-ink-muted hover:text-ink hover:bg-hover transition-colors"
            >
                <i
                    data-mail--thread-message-target="chevron"
                    class="fa-solid fa-chevron-down text-xs transition-transform duration-150 {{ expanded ? 'rotate-180' : '' }}"
                    aria-hidden="true"
                ></i>
            </button>
        </div>
    </div>

    {# ── Body — full pane width ─────────────────────────────────────────── #}
    <div data-mail--thread-message-target="body" class="{{ expanded ? '' : 'hidden' }} mt-4">
        {# Attachments, directly under the header (H-13).
           They used to render after the full HTML body, which on a long mail
           put them some 750px below the fold — an attachment nobody scrolled
           to is an attachment nobody was sent. The chips themselves are
           untouched; this is the same partial, moved. #}
        {% if message.hasAttachments %}
            <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="text-xs font-medium text-ink-faint">{{ 'message.attachments'|trans }}</span>
                {% for part in message.messageParts %}
                    {% if not part.isInline %}
                        {% include 'mail/_attachment_chip.html.twig' with { part: part } %}
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

        {# An invitation, above the mail that carried it. The lookup is one
           query per CONVERSATION, not per message — InviteReader loads the
           whole thread's links the first time any message in it asks. #}
        {% set invite = message_invite(message) %}
        {% if invite is not null %}
            {% include 'calendar/_invite_card.html.twig' with { invite: invite } only %}
        {% endif %}

        {# A date read out of the prose, offered and not added. Batched per
           conversation the same way, and the two cards never both appear: a
           message carrying a real invitation is refused by EventProposer
           before it is ever read, because the invitation is the better
           answer to the same question. #}
        {% set proposal = message_event_proposal(message) %}
        {% if proposal is not null %}
            {% include 'calendar/_proposal_card.html.twig' with { proposal: proposal } only %}
        {% endif %}

        {# The body, its warnings and its images bar — all decided in one place.
           See mail/_message_body.html.twig for why it is framed. #}
        {% include 'mail/_message_body.html.twig' with { message: message } only %}

        {# The receipt prompt, and "Read at …" on our own sent mail. Below the
           body and outside the frame, for the same reason the images bar is:
           a button the message could draw is a button the message could forge,
           and this one sends mail on the reader's behalf. #}
        {% include 'mail/_read_receipt.html.twig' with { message: message } only %}
    </div>
</div>
{% endif %}
