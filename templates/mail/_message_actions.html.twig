{#
mail/_message_actions.html.twig
─────────────────────────────────────────────────────────────────────────────
Per-message overflow menu (top right of a message header), Gmail-style.

Variables:
  message  Message
#}
{% set toCount = (message.toAddresses ?? [])|length + (message.ccAddresses ?? [])|length %}
{% set starred = message.starredAt is not null %}

{# Replies open inline at the bottom of the conversation; the dock is only
   used when this message somehow isn't threaded. #}
{% set composeFrame  = message.thread is not null ? 'compose_inline' : 'compose_dock' %}
{% set composeParams = message.thread is not null
    ? { frame: 'compose_inline', thread: message.thread.id }
    : {} %}

<div
    class="relative"
    data-controller="mail--message-actions"
    data-mail--message-actions-entity-id-value="{{ message.id }}"
    data-mail--message-actions-entity-type-value="message"
    data-mail--message-actions-starred-value="{{ starred ? 'true' : 'false' }}"
>
    <button
        type="button"
        data-action="click->mail--message-actions#toggle"
        aria-label="{{ 'message.actions.more'|trans }}"
        class="flex items-center justify-center w-8 h-8 rounded-full
               text-ink-muted hover:text-ink hover:bg-hover
               transition-colors duration-100 cursor-pointer"
    >
        <i class="fa-solid fa-ellipsis-vertical text-sm" aria-hidden="true"></i>
    </button>

    {# The same entrance every menu in the app gets. This one has its own
       controller rather than ui--dropdown, so it says so itself; it is `hidden`
       until opened, which is what keeps a first-paint element from animating
       until the moment it is actually shown. #}
    <div
        data-mail--message-actions-target="panel"
        data-enter="slide-down"
        class="hidden absolute right-0 top-full mt-1 z-30 w-56
               rounded-pane bg-pane-soft backdrop-blur-sm
               border border-line shadow-pop py-1 text-sm"
    >
        <a href="{{ path('app_compose_reply', composeParams|merge({ id: message.id })) }}"
           data-turbo-frame="{{ composeFrame }}"
           data-controller="compose--frame-target"
           data-turbo-prefetch="false"
           data-action="click->mail--message-actions#dismiss"
           class="flex items-center gap-2 px-4 py-2 text-ink-soft hover:bg-hover transition-colors">
            <i class="fa-solid fa-reply w-4 text-ink-faint" aria-hidden="true"></i>
            {{ 'compose.reply'|trans }}
        </a>

        {% if toCount > 1 %}
            <a href="{{ path('app_compose_reply_all', composeParams|merge({ id: message.id })) }}"
               data-turbo-frame="{{ composeFrame }}"
               data-controller="compose--frame-target"
           data-turbo-prefetch="false"
           data-action="click->mail--message-actions#dismiss"
               class="flex items-center gap-2 px-4 py-2 text-ink-soft hover:bg-hover transition-colors">
                <i class="fa-solid fa-reply-all w-4 text-ink-faint" aria-hidden="true"></i>
                {{ 'compose.reply_all'|trans }}
            </a>
        {% endif %}

        <a href="{{ path('app_compose_forward', composeParams|merge({ id: message.id })) }}"
           data-turbo-frame="{{ composeFrame }}"
           data-controller="compose--frame-target"
           data-turbo-prefetch="false"
           data-action="click->mail--message-actions#dismiss"
           class="flex items-center gap-2 px-4 py-2 text-ink-soft hover:bg-hover transition-colors">
            <i class="fa-solid fa-share w-4 text-ink-faint" aria-hidden="true"></i>
            {{ 'compose.forward'|trans }}
        </a>

        <div class="border-t border-line my-1"></div>

        <button type="button"
                data-action="click->mail--message-actions#star"
                class="w-full flex items-center gap-2 px-4 py-2 text-left text-ink-soft hover:bg-hover transition-colors cursor-pointer">
            <i data-mail--message-actions-target="starIcon"
               class="{{ starred ? 'fa-solid text-amber-400' : 'fa-regular text-ink-faint' }} fa-star w-4"
               aria-hidden="true"></i>
            <span data-mail--message-actions-target="starLabel"
                  data-star="{{ 'message.actions.star'|trans }}"
                  data-unstar="{{ 'message.actions.unstar'|trans }}">{{ starred ? ('message.actions.unstar'|trans) : ('message.actions.star'|trans) }}</span>
        </button>

        <button type="button"
                data-action="click->mail--message-actions#markUnread"
                class="w-full flex items-center gap-2 px-4 py-2 text-left text-ink-soft hover:bg-hover transition-colors cursor-pointer">
            <i class="fa-regular fa-envelope w-4 text-ink-faint" aria-hidden="true"></i>
            {{ 'message.actions.mark_unread'|trans }}
        </button>

        {# Not in spam or the trash: archiving out of the bin means nothing, and
           deleting something already deleted is a no-op the list used to
           report as a change. See App\Twig\MailPlacementExtension. #}
        {% if mail_placement(message) == 'normal' %}
            <button type="button"
                    data-action="click->mail--message-actions#archive"
                    class="w-full flex items-center gap-2 px-4 py-2 text-left text-ink-soft hover:bg-hover transition-colors cursor-pointer">
                <i class="fa-solid fa-box-archive w-4 text-ink-faint" aria-hidden="true"></i>
                {{ 'message.actions.archive'|trans }}
            </button>

            <button type="button"
                    data-action="click->mail--message-actions#trash"
                    class="w-full flex items-center gap-2 px-4 py-2 text-left text-danger hover:bg-hover transition-colors cursor-pointer">
                <i class="fa-solid fa-trash w-4" aria-hidden="true"></i>
                {{ 'message.actions.delete'|trans }}
            </button>
        {% endif %}

        <div class="border-t border-line my-1"></div>

        <a href="{{ path('app_mail_message_original', { id: message.id }) }}"
           target="_blank" rel="noopener"
           data-action="click->mail--message-actions#dismiss"
           class="flex items-center gap-2 px-4 py-2 text-ink-soft hover:bg-hover transition-colors">
            <i class="fa-solid fa-code w-4 text-ink-faint" aria-hidden="true"></i>
            {{ 'message.actions.show_original'|trans }}
        </a>

        <a href="{{ path('app_mail_message_print', { id: message.id }) }}"
           target="_blank" rel="noopener"
           data-action="click->mail--message-actions#dismiss"
           class="flex items-center gap-2 px-4 py-2 text-ink-soft hover:bg-hover transition-colors">
            <i class="fa-solid fa-print w-4 text-ink-faint" aria-hidden="true"></i>
            {{ 'message.actions.print'|trans }}
        </a>

        {# In this group and not with Archive or Delete: it does nothing to the
           mail. It is a statement ABOUT the mail — the same kind of thing as
           "Show original" — and the only entry here that sends anything
           anywhere, which is why the dialog behind it opens with what it sends
           rather than with a field to fill in.

           Both actions on the click, in this order: the dialog is a body-level
           frame and the menu is not part of it, so a menu left open would sit
           over the backdrop for as long as the dialog does. #}
        <button type="button"
                data-controller="ui--modal"
                data-action="click->ui--modal#open click->mail--message-actions#dismiss"
                data-ui--modal-src-value="{{ path('app_insight_report_dialog', { id: message.id }) }}"
                data-ui--modal-title-value="{{ 'insights.report.heading'|trans }}"
                class="w-full flex items-center gap-2 px-4 py-2 text-left text-ink-soft hover:bg-hover transition-colors cursor-pointer">
            <i class="fa-regular fa-lightbulb w-4 text-ink-faint" aria-hidden="true"></i>
            {{ 'message.actions.report_insight'|trans }}
        </button>
    </div>
</div>
