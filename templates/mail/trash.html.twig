{% extends '_layout/_mailbox.html.twig' %}

{% block list_scope %}trash{% endblock %}

{% block title %}
    {# A total here, not an unread count — see SidebarCounts::TOTAL_ROLES — so
       the tab agrees with the badge and with the list's own "1–50 of 193". #}
    {% set _count = sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Trash) %}
    {{ _count > 0 ? '('~_count~')' }} {{ 'sidebar.nav.trash'|trans }} — {{ 'app.name'|trans }}
{% endblock %}

{% block title_count_key %}role:trash{% endblock %}

{% block inbox_tabs %}
    <div class="px-4 py-2.5 border-b border-line">
        <h2 class="text-sm font-semibold text-ink-soft">{{ 'trash.heading'|trans }}</h2>
    </div>
{% endblock %}

{% block message_list %}
    {% if threads is empty %}
        <li class="px-4 py-8 text-center text-sm text-ink-faint">
            {{ 'trash.empty'|trans }}
        </li>
    {% else %}
        {% for thread in threads %}
            {% include '_partials/_thread_row.html.twig' with { thread: thread } %}
        {% endfor %}
    {% endif %}
{% endblock %}
