{#
mail/label.html.twig — thread list for a custom label.
#}
{% extends '_layout/_mailbox.html.twig' %}

{# A label view names itself by its id, because the label is the view — see
   App\Service\Mail\ListViewResolver, which checks the label belongs to the
   person asking before it resolves anything. #}
{% block list_scope %}label{% endblock %}
{% block list_scope_value %}{{ label.id }}{% endblock %}

{% block title %}
    {% set _unread = sidebarCounts.forLabel(label) %}
    {{ _unread > 0 ? '('~_unread~')' }} {{ label.fullName }} — {{ 'app.name'|trans }}
{% endblock %}

{% block title_count_key %}label:{{ label.id }}{% endblock %}

{% block inbox_tabs %}
    <div class="px-4 py-2.5 border-b border-line flex items-center gap-2">
        <h2 class="text-sm font-semibold text-ink-soft">{{ label.fullName }}</h2>
        {# Narrowed to one account. Said out loud, and with a way back out:
           the same label under a different account looks identical otherwise,
           and an empty one is then indistinguishable from an empty label. #}
        {% if account is defined and account %}
            <span class="text-xs text-ink-faint">{{ account.displayAddress }}</span>
            <a href="{{ path('app_mail_label', { id: label.id }) }}"
               class="text-xs text-accent hover:underline">
                {{ 'label.all_accounts'|trans }}
            </a>
        {% endif %}
    </div>
{% endblock %}

{% block message_list %}
    {% if threads is empty %}
        <li class="px-4 py-8 text-center text-sm text-ink-faint">
            {{ 'label.empty'|trans }}
        </li>
    {% else %}
        {% for thread in threads %}
            {% include '_partials/_thread_row.html.twig' with { thread: thread } %}
        {% endfor %}
    {% endif %}
{% endblock %}
