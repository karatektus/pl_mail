{#
mail/label.html.twig — thread list for a custom label.
#}
{% extends '_layout/_mailbox.html.twig' %}

{# A label view names itself by its id, because the label is the view — see
   App\Service\Mail\ListViewResolver, which checks the label belongs to the
   person asking before it resolves anything. #}
{% block list_scope %}label{% endblock %}
{% block list_scope_value %}{{ label.id }}{% endblock %}

{% block title %}
    {% set _unread = sidebarCounts.forLabel(label) %}
    {{ _unread > 0 ? '('~_unread~')' }} {{ label.fullName }} — {{ 'app.name'|trans }}
{% endblock %}

{% block title_count_key %}label:{{ label.id }}{% endblock %}

{% block inbox_tabs %}
    {# The label is a filter on the mail, so it reads as one (#783): a chip
       with an ×, which takes it off — back to the Inbox — without reaching for
       the sidebar, which a workspace may not even have. Narrowed to one
       account, that account is a second chip, whose × keeps the label and
       drops the account; the same label under another account looks identical
       otherwise, and an empty one would read as an empty label. #}
    {% import '_partials/_sidebar.html.twig' as sidebarMacros %}
    <div class="px-4 py-2 border-b border-line flex flex-wrap items-center gap-1.5" role="group" aria-label="{{ 'label.filters'|trans }}">
        <span class="filter-chip">
            {{ sidebarMacros.label_dot(label.color) }}
            <span class="truncate">{{ label.fullName }}</span>
            <a href="{{ path('app_mail_inbox') }}"
               class="filter-chip-remove"
               title="{{ 'label.remove_filter'|trans({ '%name%': label.fullName }) }}"
               aria-label="{{ 'label.remove_filter'|trans({ '%name%': label.fullName }) }}">
                <i class="fa-solid fa-xmark text-[10px]" aria-hidden="true"></i>
            </a>
        </span>
        {% if account is defined and account %}
            <span class="filter-chip">
                <i class="fa-solid fa-at text-[10px] text-ink-faint" aria-hidden="true"></i>
                <span class="truncate">{{ account.displayAddress }}</span>
                <a href="{{ path('app_mail_label', { id: label.id }) }}"
                   class="filter-chip-remove"
                   title="{{ 'label.all_accounts'|trans }}"
                   aria-label="{{ 'label.all_accounts'|trans }}">
                    <i class="fa-solid fa-xmark text-[10px]" aria-hidden="true"></i>
                </a>
            </span>
        {% endif %}
    </div>
{% endblock %}

{% block message_list %}
    {% if threads is empty %}
        <li class="px-4 py-8 text-center text-sm text-ink-faint">
            {{ 'label.empty'|trans }}
        </li>
    {% else %}
        {% for thread in threads %}
            {% include '_partials/_thread_row.html.twig' with { thread: thread } %}
        {% endfor %}
    {% endif %}
{% endblock %}
