{#
mail/_thread_content.html.twig
─────────────────────────────────────────────────────────────────────────────
The conversation view. Rendered both as a full page (mail/thread.html.twig)
and injected as a bare fragment by mail_pane_controller — so it must stay
self-contained: no {% extends %}, no block dependencies.
#}
{% from '_partials/_list_toolbar.html.twig' import tbtn %}
{% import 'mail/_thread_summary.html.twig' as thread_summary %}

{% set threadLabelIds = [] %}
{% for label in thread.labels %}
    {% set threadLabelIds = threadLabelIds|merge([label.id]) %}
{% endfor %}

{# The whole pane is a white sheet while a conversation is open (see the
   mail-sheet utility in assets/styles/app.css). #}
<div class="mail-sheet flex flex-col flex-1 min-h-0">

{# ── Toolbar ─────────────────────────────────────────────────────────────── #}
<div class="flex items-center gap-1 px-3 py-2 border-b border-line flex-shrink-0">
    <button
        type="button"
        data-action="click->mail--mail-pane#close"
        aria-label="{{ 'message.back'|trans }}"
        class="flex items-center justify-center w-8 h-8 rounded-full text-ink-muted hover:text-ink hover:bg-hover transition-colors"
    >
        <i class="fa-solid fa-arrow-left text-sm" aria-hidden="true"></i>
    </button>

    <div
        class="flex items-center gap-1"
        data-controller="mail--message-actions"
        data-mail--message-actions-entity-id-value="{{ thread.id }}"
        data-mail--message-actions-entity-type-value="thread"
    >
        {# Archive and Delete are hidden where they would do nothing.
           Trashing something already in the trash adds a label it already
           carries — a no-op that nonetheless took the row off the list, so the
           mail appeared to be deleted twice and was still there both times. And
           archiving out of the bin is not a thing anyone means. See
           App\Twig\MailPlacementExtension. #}
        {% set placement = mail_placement(thread) %}

        {% if placement == 'normal' %}
            {{ tbtn('click->mail--message-actions#archive', 'fa-solid fa-box-archive', 'toolbar.actions.archive'|trans) }}
            {{ tbtn('click->mail--message-actions#trash', 'fa-solid fa-trash', 'toolbar.actions.delete'|trans) }}
        {% endif %}

        {{ tbtn('click->mail--message-actions#markUnread', 'fa-regular fa-envelope', 'toolbar.actions.mark_unread'|trans) }}
    </div>

    {% include '_partials/_label_menu.html.twig' with {
        labels:       sidebarCounts.flattenedUserLabels(),
        targetType:   'thread',
        targetId:     thread.id,
        activeLabels: threadLabelIds,
    } only %}

    <span class="ml-2 text-sm text-ink-faint truncate min-w-0">
        {{ thread.subject ?: ('thread.no_subject'|trans) }}
    </span>
</div>

{# ── Conversation ────────────────────────────────────────────────────────── #}
<div class="flex-1 overflow-y-auto"
     data-controller="mail--thread-read"
     data-mail--thread-read-mark-url-value="{{ path('app_status_mark_read', {'type': 'thread', 'id': thread.id}) }}"
     data-mail--thread-read-id-value="{{ thread.id }}"
     data-mail--thread-read-delay-value="0"
     {# Whether this conversation still counted towards a badge when the page
        was rendered, so the controller knows whether reading it moved a
        number. Re-opening mail you have already read must not fire a counts
        request per click. #}
     data-mail--thread-read-was-unread-value="{{ thread.unreadCount > 0 ? 'true' : 'false' }}"
>
    {# The summary controller lives HERE rather than on its own card, because
       its card is the one part of the feature that does not exist yet on a
       conversation nobody has summarised — and a controller cannot listen for
       the click that creates it from inside it. This wrapper is the nearest
       element that holds both the control (in the subject row) and the card
       (below the insight strip), and it is present on every open. See
       _thread_summary, which stamps the attributes and owns the vocabulary. #}
    <div class="w-full px-4 md:px-6 py-5"{{ thread_summary.root(thread) }}>

        <div class="flex items-baseline gap-3 mb-6">
            <h1 class="text-xl font-semibold text-ink min-w-0 break-words">
                {{ thread.subject ?: ('thread.no_subject'|trans) }}
            </h1>
            {% if thread.messageCount > 1 %}
                <span class="text-sm text-ink-faint flex-shrink-0">{{ thread.messageCount }}</span>
            {% endif %}

            {# The offer to summarise, at the right-hand end of the subject and
               on its baseline. It is here and not in a card because there is no
               card until somebody accepts the offer: an empty box headed
               "Summary" claims a summary exists. #}
            {{ thread_summary.trigger(thread, summary|default(null)) }}
        </div>

        {# What plMail read out of this conversation, before the conversation. #}
        {% include 'mail/_insight_strip.html.twig' with { insights: insights|default([]) } only %}

        {# And what a model made of it, if anybody has asked. On a conversation
           that has never been summarised this renders no card at all — only the
           inert template the control fills in on the first click. Nothing is
           spent here either way; see _thread_summary. #}
        {{ thread_summary.card(thread, summary|default(null)) }}

        {# `messages` is the controller's conversation-ordered list; the raw
           association is the fallback for any include that has not been given
           it (its receivedAt-only order is why the list is passed at all). #}
        {% set messages = messages|default(thread.messages) %}
        {# The messages are the one thing in this pane that ARRIVES, so they
           are what animates, and the toolbar and subject above deliberately do
           not: chrome that flinched every time a conversation opened would be
           movement that says nothing, on the surface a reader opens forty times
           a day. Each message rises in on its own — see _thread_message — and
           the stagger turns "a conversation opened" into a conversation being
           laid out. It costs nothing on the common single-message thread, and
           motion.css caps it at eight so a long one still finishes at once. #}
        <div id="thread_messages_{{ thread.id }}" data-enter-stagger>
            {% for message in messages %}
                {% include 'mail/_thread_message.html.twig' with {
                    message:  message,
                    expanded: loop.last or message.seenAt is null,
                } only %}
            {% endfor %}
        </div>

        {% include 'mail/_reply_zone.html.twig' with { thread: thread, latest: latest|default(null) } only %}

    </div>
</div>

</div>{# /mail-sheet #}
