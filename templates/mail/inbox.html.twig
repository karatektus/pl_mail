{# mail/inbox.html.twig #}
{% extends '_layout/_mailbox.html.twig' %}

{% block list_scope %}inbox{% endblock %}
{# The tab IS the view: selecting everything while looking at Notifications
   must not reach into Primary, which is not on screen. #}
{% block list_scope_value %}{{ tab.value ?? '' }}{% endblock %}

{% block title %}
    {% set _unread = sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Inbox) %}
    {{ _unread > 0 ? '('~_unread~')' }} {{ 'sidebar.nav.inbox'|trans }} — {{ 'app.name'|trans }}
{% endblock %}

{# Keeps the tab in step with the sidebar after a sync — see app.html.twig. #}
{% block title_count_key %}role:inbox{% endblock %}

{% block inbox_tabs %}
    {# Imported inside the block rather than at the top of the file: this
       template only ever renders through a block, and a macro imported at
       template scope is not reliably in scope inside one. #}
    {% import '_partials/_new_dot.html.twig' as newMarkers %}

    {# The Gmail category glyphs, one combined path per category — heroicons,
       the set the rest of the app's inline icons draw from. A map here rather
       than a partial per icon: the five are used nowhere else, and the tab
       loop is the only reader. Two weights of each: the OUTLINE for resting
       tabs and the SOLID for the one you are on — the filled shape is the
       "you are here", the same statement the underline makes, said where the
       eye lands first. #}
    {% set tabIcons = {
        primary:    'M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z',
        social:     'M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z',
        promotions: 'M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z M6 6h.008v.008H6V6Z',
        updates:    'M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z',
        forums:     'M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155',
    } %}

    {% set tabIconsSolid = {
        primary:    'M6.912 3a3 3 0 0 0-2.868 2.118l-2.411 7.838a3 3 0 0 0-.133.882V18a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3v-4.162c0-.299-.045-.596-.133-.882l-2.412-7.838A3 3 0 0 0 17.088 3H6.912Zm13.823 9.75-2.213-7.191A1.5 1.5 0 0 0 17.088 4.5H6.912a1.5 1.5 0 0 0-1.434 1.059L3.265 12.75H6.11a3 3 0 0 1 2.684 1.658l.256.513a1.5 1.5 0 0 0 1.342.829h3.218a1.5 1.5 0 0 0 1.342-.83l.256-.512a3 3 0 0 1 2.684-1.658h2.844Z',
        social:     'M8.25 6.75a3.75 3.75 0 1 1 7.5 0 3.75 3.75 0 0 1-7.5 0ZM15.75 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM2.25 9.75a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.31 15.117A6.745 6.745 0 0 1 12 12a6.745 6.745 0 0 1 6.709 7.498.75.75 0 0 1-.372.568A12.696 12.696 0 0 1 12 21.75c-2.305 0-4.47-.612-6.337-1.684a.75.75 0 0 1-.372-.568 6.787 6.787 0 0 1 1.019-4.38Z M5.082 14.254a8.287 8.287 0 0 0-1.308 5.135 9.687 9.687 0 0 1-1.764-.44l-.115-.04a.563.563 0 0 1-.373-.487l-.01-.121a3.75 3.75 0 0 1 3.57-4.047ZM20.226 19.389a8.287 8.287 0 0 0-1.308-5.135 3.75 3.75 0 0 1 3.57 4.047l-.01.121a.563.563 0 0 1-.373.486l-.115.04c-.567.2-1.156.349-1.764.441Z',
        promotions: 'M5.25 2.25a3 3 0 0 0-3 3v4.318a3 3 0 0 0 .879 2.121l9.58 9.581c.92.92 2.39 1.186 3.548.428a18.849 18.849 0 0 0 5.441-5.44c.758-1.16.492-2.629-.428-3.548l-9.58-9.581a3 3 0 0 0-2.122-.879H5.25ZM6.375 7.5a1.125 1.125 0 1 0 0-2.25 1.125 1.125 0 0 0 0 2.25Z',
        updates:    'M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z',
        forums:     'M4.913 2.658c2.075-.27 4.19-.408 6.337-.408 2.147 0 4.262.139 6.337.408 1.922.25 3.291 1.861 3.405 3.727a4.403 4.403 0 0 0-1.032-.211 51.175 51.175 0 0 0-8.42 0c-2.358.196-4.04 2.19-4.04 4.434v4.286a4.47 4.47 0 0 0 2.433 3.984L7.28 21.53A.75.75 0 0 1 6 21v-4.03a48.527 48.527 0 0 1-1.087-.128C2.905 16.58 1.5 14.833 1.5 12.862V6.638c0-1.97 1.405-3.718 3.413-3.979Z M15.75 7.5c-1.376 0-2.739.057-4.086.169C10.124 7.797 9 9.103 9 10.609v4.285c0 1.507 1.128 2.814 2.67 2.94 1.243.102 2.5.157 3.768.165l2.782 2.781a.75.75 0 0 0 1.28-.53v-2.39l.33-.026c1.542-.125 2.67-1.433 2.67-2.94v-4.286c0-1.505-1.125-2.811-2.664-2.94A49.392 49.392 0 0 0 15.75 7.5Z',
    } %}

    {# Gmail's category colours for the "N new" pills — identity colour, not
       theme colour, which is why these are the fixed -600s under white text
       (the label palette's idiom, one step darker for contrast at pill size)
       rather than the accent token. The colour says WHICH door the mail came
       in through before the label is read. #}
    {% set tabTones = {
        primary:    'bg-red-600 text-white',
        social:     'bg-blue-600 text-white',
        promotions: 'bg-green-600 text-white',
        updates:    'bg-amber-600 text-white',
        forums:     'bg-violet-600 text-white',
    } %}

    {# The same five identity colours as ink rather than as fill, for the icon
       tint that says "there is unread mail behind this tab".

       The case that asked for it is the unread filter, where the strip is
       otherwise mute: every row on screen is unread, so boldness distinguishes
       nothing, and the sidebar's Inbox badge is a single total with no way to
       say which tab its mail is in — a tab could sit there looking exactly like
       a full one and open on "No messages in this tab". It is drawn on the
       ordinary inbox too, by decision: "which tabs have anything waiting" is
       worth answering before you have filtered for it, and answering it in only
       one view would make the strip mean different things in two places.

       It coexists with the "N new" pill rather than competing: the pill is a
       number about ARRIVALS, the tint is a colour about UNREAD, and they are
       distinguishable because only one of them is a number. That is the same
       vocabulary split the rows use — a "New" pill against an unread dot.

       The -600/-400 pair is the app's established way of holding one identity
       colour readable in both themes (see the health and notification
       partials): -600 has the contrast against a light sheet, -400 against a
       dark one. No counter — presence is the whole statement, and the number is
       already downstairs in the list header. #}
    {% set tabIconTones = {
        primary:    'text-red-600 dark:text-red-400',
        social:     'text-blue-600 dark:text-blue-400',
        promotions: 'text-green-600 dark:text-green-400',
        updates:    'text-amber-600 dark:text-amber-400',
        forums:     'text-violet-600 dark:text-violet-400',
    } %}

    {# A lone Primary tab is a heading pretending to be a choice — when no
       other category has mail, the whole row stays home. #}
    {# What a tab link carries with it.
       Everything the current URL narrows the list by, minus the two that must
       not survive: `tab` because this is what each link is setting, and `page`
       because page four of Primary is not page four of Social.

       Rebuilt from the request rather than naming `unread`, and for the reason
       the toolbar's own "Show all" link is — see _list_toolbar.html.twig, which
       does the mirror image of this. Without it a tab dropped the filter it was
       being clicked inside: opening the inbox from the sidebar's unread badge
       and then reaching for Social answered with ALL of Social, silently, and
       the only way back into unread was the badge again. Naming `unread` here
       would fix today's filter and quietly lose the next one. #}
    {% set tabQuery = app.request.query.all|filter((v, k) => k not in ['tab', 'page']) %}

    {# The strip exists when more than one category holds mail, unchanged.

       A LIMITATION WORTH STATING, because it is a decision and not an
       oversight: on an inbox where everything is Primary there is no strip, so
       there is nowhere to drop a conversation and that inbox can never acquire
       a second category by dragging. The ghost tabs below fix this for every
       other inbox and cannot fix it for that one.

       Rendering the strip there anyway, hidden until a drag, was built and
       taken out again. It works, and it makes the list jump: the strip appears
       the instant a row is picked up and pushes every row down by its height,
       under a pointer that is still over them. A gesture whose first effect is
       to move the thing you just grabbed is worse than a gesture you cannot
       start. The honest answer is a preference — "always show the category
       tabs", which is how Gmail solves the same problem — and that is a
       different change.

       Nothing about the multi-category case shifts: the ghosts join a row of
       tabs that is already on screen, so they only widen it. #}
    {% set _dropTabs = drop_tabs|default([]) %}

    {% if tabs|length > 1 %}
    <div class="border-b border-line px-1">
        <nav class="flex text-sm">
            {% for tabCase in tabs %}
                {% set isActive = tabCase === tab %}
                {% set tabName = ('tabs.' ~ tabCase.value)|trans %}
                {% set newCount = newMail.forCategory(tabCase) %}

                {# Rendered on every tab except the one being looked at. The tint answers "where
                   is the mail I cannot see"; the active tab is the one place on
                   the strip that question is already answered, out loud, by the
                   list underneath it. Colouring it there says nothing and costs
                   something: the active tab is accent-coloured throughout —
                   label, underline, filled glyph — and an identity colour
                   dropped into the middle of that reads as a fault rather than
                   as a signal, which is exactly how it was reported.

                   The attributes ride along on the same terms as every other
                   patched marker: emitted whatever the number is so the sidebar
                   controller can find them after a sync, since an element that
                   was never rendered cannot be re-coloured. Withholding them on
                   the active tab is therefore also what stops a sync from
                   tinting the one tab the server deliberately left alone. The
                   tone travels in an attribute because the patcher has no way to
                   know which of the five a given tab wears. #}
                {% set tintable  = false === isActive %}
                {% set unreadHere = tintable ? (tab_unread[tabCase.value]|default(0)) : 0 %}
                {% set iconTone  = tabIconTones[tabCase.value]|default('') %}
                {% set senderNames = newCount > 0 ? newMail.sendersForCategory(tabCase)|join(', ') : '' %}

                {# min-h rather than padding for the vertical size: the tab is
                   one line without a sender hint and two with one, and a
                   fixed floor is what keeps the whole strip from changing
                   height when a hint arrives over a sync. items-center /
                   justify-center are the other half of that deal — a hintless
                   tab centres its label beside the icon instead of sitting on
                   an invisible second line. #}
                {# Somewhere a conversation can be dropped, on every tab but the
                   one being looked at. That one is where the row already is, so
                   accepting it would remove the row from the list and put it
                   back on the next refresh, which reads as a glitch rather than
                   as "nothing to do". #}
                <a
                    href="{{ path('app_mail_inbox', tabQuery|merge({tab: tabCase.value})) }}"
                    data-turbo-frame="inbox-list-frame"
                    {% if false == isActive %}data-dnd-category="{{ tabCase.value }}"{% endif %}
                    class="flex items-center gap-2.5 px-5 py-1.5 min-h-14 font-medium border-b-2 -mb-px transition-colors min-w-0 {{ isActive ? 'text-accent border-accent' : 'text-ink-muted hover:text-gray-700 border-transparent hover:border-gray-300' }}"
                >
                    {% if isActive %}
                        <svg class="w-5 h-5 shrink-0{{ unreadHere > 0 ? ' ' ~ iconTone : '' }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                             {% if tintable %}data-tab-icon data-count-key="category:{{ tabCase.value }}" data-tone-class="{{ iconTone }}"{% endif %}>
                            <path fill-rule="evenodd" clip-rule="evenodd" d="{{ tabIconsSolid[tabCase.value] }}"/>
                        </svg>
                    {% else %}
                        <svg class="w-5 h-5 shrink-0{{ unreadHere > 0 ? ' ' ~ iconTone : '' }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
                             {% if tintable %}data-tab-icon data-count-key="category:{{ tabCase.value }}" data-tone-class="{{ iconTone }}"{% endif %}>
                            <path stroke-linecap="round" stroke-linejoin="round" d="{{ tabIcons[tabCase.value] }}"/>
                        </svg>
                    {% endif %}

                    <span class="flex flex-col justify-center min-w-0">
                        <span class="flex items-center whitespace-nowrap">
                            {{ tabName }}

                            {# "3 new", the Gmail way — and the ONLY number on
                               a tab. There used to be an unread count beside
                               it, and the pair was two demands in one glance;
                               unread already has the sidebar's Inbox badge
                               and the bold rows themselves, so the tab keeps
                               the one thing only it can say: what arrived
                               here that you have never seen. The macro's
                               header comment holds the pill's own argument,
                               and why the sidebar's copy of this marker stays
                               a wordless dot.

                               Rendered whatever the number is and hidden at
                               zero — the established idiom for everything the
                               sidebar controller patches after a sync. It
                               carries the data-count-key the counts endpoint
                               emits, and the patcher rewrites text as well as
                               visibility. #}
                            <span class="ml-1.5 inline-flex align-middle">{{ newMarkers.new_pill(newCount, 'new:category:' ~ tabCase.value, tabName, tabTones[tabCase.value] ?? null) }}</span>
                        </span>

                        {# Who the new mail is from — Gmail's second line.
                           Hidden when there is nothing to say rather than
                           left as reserved blank space, so a hintless tab
                           centres its one line; the tab's min-height is what
                           keeps the strip steady when this appears. The
                           patcher writes the text and flips the class from
                           the same payload value. #}
                        <span class="text-[11px] leading-4 font-normal {{ isActive ? 'text-accent opacity-70' : 'text-ink-faint' }} truncate max-w-44{{ senderNames != '' ? '' : ' hidden' }}"
                              data-tab-senders
                              data-count-key="senders:category:{{ tabCase.value }}"
                        >{{ senderNames }}</span>
                    </span>
                </a>
            {% endfor %}

            {# The categories nothing is in yet.

               Not shown, until a drag starts. The strip's rule is that a tab
               exists while it holds mail — a door to an empty room is worse
               than no door, and Gmail itself has quietly retired Forums — and
               that rule is right for reading. It is wrong for FILING, and in a
               way that cannot fix itself: the only categories a conversation
               could be moved into were the ones it might already be in, so an
               empty Forums stayed empty forever.

               So they are rendered and hidden, and app.css reveals them while
               html carries data-dnd-active. Rendered rather than fetched
               because a target that arrives a request after the drag has begun
               is a target the pointer has already travelled past.

               Deliberately plainer than a real tab: no icon, no counts, no
               senders line, and a dashed edge. It is not a place you can go —
               clicking it would open a list with nothing in it — which is why
               it is a <span> rather than a link. It is a slot to put something
               in, and it should look like one. #}
            {% for tabCase in _dropTabs %}
                <span
                    data-dnd-category="{{ tabCase.value }}"
                    data-dnd-ghost
                    class="flex items-center px-5 py-1.5 min-h-14 text-sm font-medium
                           text-ink-faint border-b-2 border-dashed border-transparent
                           whitespace-nowrap transition-colors"
                >{{ ('tabs.' ~ tabCase.value)|trans }}</span>
            {% endfor %}
        </nav>
    </div>
    {% endif %}
{% endblock %}

{% block message_list %}
    {% if threads is empty %}
        <li class="px-4 py-8 text-center text-sm text-ink-faint">
            {{ 'inbox.empty'|trans }}
        </li>
    {% else %}
        {% for thread in threads %}
            {% include '_partials/_thread_row.html.twig' with {
                thread: thread,
            } %}
        {% endfor %}
    {% endif %}
{% endblock %}
