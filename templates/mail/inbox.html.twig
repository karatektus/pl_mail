{# mail/inbox.html.twig #}
{% extends '_layout/_mailbox.html.twig' %}

{% block list_scope %}inbox{% endblock %}

{% block title %}
    {% set _unread = sidebarCounts.forRoleBadge(enum('App\\Domain\\Enum\\Mail\\LabelRole').Inbox) %}
    {{ _unread > 0 ? '('~_unread~')' }} {{ 'sidebar.nav.inbox'|trans }} — {{ 'app.name'|trans }}
{% endblock %}

{# Keeps the tab in step with the sidebar after a sync — see app.html.twig. #}
{% block title_count_key %}role:inbox{% endblock %}

{% block inbox_tabs %}
    {# Imported inside the block rather than at the top of the file: this
       template only ever renders through a block, and a macro imported at
       template scope is not reliably in scope inside one. #}
    {% import '_partials/_new_dot.html.twig' as newMarkers %}

    {# A lone Primary tab is a heading pretending to be a choice — when no
       other category has mail, the whole row stays home. #}
    {% if tabs|length > 1 %}
    <div class="border-b border-line px-1">
        <nav class="flex text-sm">
            {% for tabCase in tabs %}
                {% set isActive = tabCase === tab %}
                {% set unreadCount = tabCounts[tabCase.value]|default(0) %}
                {% set newCount = newMail.forCategory(tabCase) %}

                <a
                    href="{{ path('app_mail_inbox', {tab: tabCase.value}) }}"
                    data-turbo-frame="inbox-list-frame"
                    class="px-4 py-3 font-medium border-b-2 -mb-px transition-colors {{ isActive ? 'text-accent border-accent' : 'text-ink-muted hover:text-gray-700 border-transparent hover:border-gray-300' }}"
                >
                    {{ ('tabs.' ~ tabCase.value)|trans }}

                    {# "Something arrived in here", not "how much". A count
                       already lives one element along and means unread; a
                       second number would be two demands on the same tab and
                       no way to tell them apart at a glance. So the new marker
                       is deliberately quiet and deliberately quantity-free.

                       Rendered whatever the number is and hidden at zero,
                       which is the established idiom for everything the
                       sidebar controller patches after a sync — see the
                       unread_badge macro. It carries the same data-count-key
                       the counts endpoint emits. #}
                    {# inline-flex on the wrapper, because the dot itself is a
                       flex box (see the macro) and would otherwise start its
                       own line inside this tab. #}
                    <span class="ml-1.5 inline-flex align-middle">{{ newMarkers.new_dot(newCount, 'new:category:' ~ tabCase.value, ('tabs.' ~ tabCase.value)|trans) }}</span>

                    {% if unreadCount > 0 %}
                        <span class="ml-1 text-xs {{ isActive ? 'text-accent opacity-70' : 'text-gray-400' }}">{{ unreadCount }}</span>
                    {% endif %}
                </a>
            {% endfor %}
        </nav>
    </div>
    {% endif %}
{% endblock %}

{% block message_list %}
    {% if threads is empty %}
        <li class="px-4 py-8 text-center text-sm text-ink-faint">
            {{ 'inbox.empty'|trans }}
        </li>
    {% else %}
        {% for thread in threads %}
            {% include '_partials/_thread_row.html.twig' with {
                thread: thread,
            } %}
        {% endfor %}
    {% endif %}
{% endblock %}
