{# templates/compose/_attachments.html.twig #}

{#
The attachment strip of a compose window. Rendered with the window and again
on its own after every upload/removal — compose_controller swaps it into the
"attachments" target — so it must stay a standalone fragment.

`live` says whether this render is an UPDATE — the answer to an upload or a
removal, swapped in by compose_controller — or the copy that ships inside a
window that is itself arriving. Only the first animates. The window carries its
own entrance, and a staggered strip playing inside it is two animations for one
arrival; the three controller renders take the default and get the chips one
after another, which is the case that needed marking. An attachment that
appears with no sign it arrived is an attachment people upload twice.

Variables: message, live (default true)
#}
{% set parts = message.messageParts|filter(part => not part.isInline) %}
{# `?? true`, not `|default(true)`: the default filter fires on any empty
   value, so `false|default(true)` is true and `live: false` — which the compose
   window passes to say "these chips are already here, do not animate them in" —
   was ignored. #}
{% set live  = live ?? true %}

{# The Image size row (#502). Every image of the draft that a browser can make
   smaller, attached or in the body: compose_controller scales them all to the
   size picked here. Rendered whenever the draft could hold such an image and
   shown by compose_controller (_refreshImageSize) while it does — the body
   can gain or lose a picture without this fragment being rendered again, and
   a sealed draft's pictures live in the body as data: URIs the server never
   sees. The `hidden` here is the server's first guess, so the row does not
   blink in on a window that opens with images. #}
{% set scalable = constant('App\\Service\\Mail\\DraftAttachmentService::SCALABLE') %}
{% set images = message.messageParts|filter(part => part.contentType in scalable and part.senderKeyFingerprint is null) %}
{% set imageSize = message.imageSize %}
{% set picked = imageSize ? imageSize.value : 'original' %}
{% set presetQuality = constant('App\\Domain\\Enum\\Mail\\ImageSize::PRESET_QUALITY') %}
{% set custom = 'custom' == picked %}
{# What the size now in force means in numbers: compose_controller scales a
   picture added later to these, and opens the Adjust panel on them. Original
   is 0 and 100, which the panel shows as "own size" at full quality. #}
{% set currentEdge = custom ? message.imageEdge : (imageSize ? imageSize.edge : 0) %}
{% set currentQuality = custom ? message.imageQuality : (imageSize ? presetQuality : 100) %}
{% set panelId = 'image-size-panel-' ~ message.id %}
<div data-compose--compose-target="imageSize"
     data-image-parts="{{ images|map(part => {
         id: part.id,
         inline: part.isInline ? true : false,
         sealed: part.sealed,
         scaled: part.originalStoragePath is not null,
         size: part.size ?: 0,
         original: part.originalSize ?? (part.size ?: 0),
         dims: draft_image_dimensions(part),
         type: part.contentType,
         name: part.filename ?: 'image',
     })|json_encode|e('html_attr') }}"
     data-size="{{ picked }}"
     data-edge="{{ currentEdge }}"
     data-quality="{{ currentQuality }}"
     {% if images|length == 0 %}hidden{% endif %}
     data-controller="ui--dropdown"
     data-action="ui--dropdown:opened->compose--compose#openImageSizePanel ui--dropdown:closed->compose--compose#imageSizePanelClosed"
     class="relative mx-4 mb-2 pt-2 border-t border-line group-data-[collapsed]/attachments:hidden">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span id="image-size-label-{{ message.id }}" class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-soft">
            <i class="fa-regular fa-image w-4 text-center" aria-hidden="true"></i>
            {{- 'compose.image_size.label'|trans -}}
        </span>
        {# The settings pages' segmented control (settings/_images.html.twig), as
           buttons rather than radio inputs: this sits inside the compose form,
           and a radio there would ride along in every autosave and set the size
           before a single picture had been scaled to it. #}
        <div role="radiogroup" aria-labelledby="image-size-label-{{ message.id }}"
             class="grid grid-flow-col auto-cols-fr rounded-pane border border-line overflow-hidden">
            {% for case in [null]|merge(enum('App\\Domain\\Enum\\Mail\\ImageSize').presets()) %}
                {% set size = case ? case.value : 'original' %}
                {% set edge = case ? case.edge : 0 %}
                <button type="button" role="radio"
                        aria-checked="{{ size == picked ? 'true' : 'false' }}"
                        data-action="click->compose--compose#pickImageSize"
                        data-compose--compose-size-param="{{ size }}"
                        data-compose--compose-edge-param="{{ edge }}"
                        data-compose--compose-quality-param="{{ case ? presetQuality : 100 }}"
                        {% if edge > 0 %}title="{{ 'compose.image_size.edge'|trans({ '%px%': edge }) }}"{% endif %}
                        class="flex items-center justify-center px-3 py-1.5 text-center text-[11px] leading-tight text-ink-muted
                               aria-[checked=false]:hover:bg-hover aria-checked:bg-accent aria-checked:text-accent-ink
                               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent
                               disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer">
                    {{- ('compose.image_size.' ~ size)|trans -}}
                </button>
            {% endfor %}
            {# Custom is only a segment while it is the choice: there is no
               "custom" to pick before the panel has made one. Clicking it opens
               the panel on its numbers. #}
            {% if custom %}
                <button type="button" role="radio" aria-checked="true"
                        data-action="click->ui--dropdown#toggle"
                        data-compose--compose-size-param="custom"
                        aria-controls="{{ panelId }}"
                        class="flex items-center justify-center px-3 py-1.5 text-center text-[11px] leading-tight whitespace-nowrap
                               bg-accent text-accent-ink
                               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent
                               disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer">
                    {{- 'compose.image_size.custom_segment'|trans -}}
                </button>
            {% endif %}
        </div>
        <button type="button"
                data-action="click->ui--dropdown#toggle"
                data-image-size-adjust
                aria-expanded="false"
                aria-controls="{{ panelId }}"
                aria-label="{{ 'compose.image_size.adjust'|trans }}"
                title="{{ 'compose.image_size.adjust'|trans }}"
                class="w-8 h-8 flex items-center justify-center rounded-lg border border-line text-ink-muted
                       hover:bg-hover hover:text-ink aria-expanded:bg-accent-soft aria-expanded:text-accent aria-expanded:border-accent
                       focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                       disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
            <i class="fa-solid fa-sliders text-xs" aria-hidden="true"></i>
        </button>
        {# Custom's numbers beside the segment rather than in it: the
           segments share one width, and "Custom · 1600 px, 70 %" does not
           fit a compose window docked at its narrowest. #}
        {% if custom %}
            <span data-image-size-custom class="text-xs text-ink-muted whitespace-nowrap">
                {{- (0 == message.imageEdge
                    ? 'compose.image_size.custom_own'|trans({ '%quality%': message.imageQuality })
                    : 'compose.image_size.custom'|trans({ '%px%': message.imageEdge, '%quality%': message.imageQuality })) -}}
            </span>
        {% endif %}
        <span data-image-size-total class="ml-auto text-xs text-ink-faint"></span>
    </div>

    {# The Adjust panel: longest side and quality, set apart. A popover like
       the compose window's other menus (ui--dropdown: an outside click or
       Escape closes it), so the attachments do not move. While open it is
       lifted into the browser's top layer and placed beside the Adjust
       button (compose_controller#_liftImageSizePanel): it may be larger than
       the compose window, which would otherwise clip it. The classes here
       are its placement in a browser without the popover API.

       Its inputs have no name, so the compose form's autosave leaves them out,
       and `:stop` keeps their input events from reaching the form's autosave
       listener at all: dragging a slider is not an edit to the mail. #}
    <div id="{{ panelId }}" data-image-size-panel hidden
         data-ui--dropdown-target="menu"
         data-enter="rise"
         role="dialog" aria-label="{{ 'compose.image_size.panel'|trans }}"
         data-action="input->compose--compose#previewImageSize:stop change->compose--compose#previewImageSize:stop"
         class="absolute bottom-full right-0 mb-2 z-30 popover w-[22rem] max-w-[calc(100vw-1rem)]
                max-h-[70vh] overflow-y-auto p-3 flex flex-col gap-2.5">
        <div class="flex flex-col gap-1">
            <div class="flex items-baseline justify-between">
                <label for="image-size-edge-{{ message.id }}" class="text-xs font-medium text-ink-soft">{{ 'compose.image_size.longest_side'|trans }}</label>
                <span data-image-size-edge-label class="text-xs font-semibold text-ink"></span>
            </div>
            <input id="image-size-edge-{{ message.id }}" type="range" data-image-size-edge
                   min="{{ constant('App\\Domain\\Enum\\Mail\\ImageSize::MIN_EDGE') }}"
                   max="{{ constant('App\\Domain\\Enum\\Mail\\ImageSize::MAX_EDGE') }}"
                   step="32" class="w-full accent-accent">
            <div class="flex justify-between text-[11px] text-ink-faint">
                <span>{{ 'compose.image_size.edge_px'|trans({ '%px%': constant('App\\Domain\\Enum\\Mail\\ImageSize::MIN_EDGE') }) }}</span>
                <span>{{ 'compose.image_size.edge_px'|trans({ '%px%': constant('App\\Domain\\Enum\\Mail\\ImageSize::MAX_EDGE') }) }}</span>
            </div>
            <label class="flex items-center gap-2 text-xs text-ink-soft">
                <input type="checkbox" data-image-size-keep class="accent-accent">
                {{ 'compose.image_size.keep_pixels'|trans }}
            </label>
        </div>

        <div class="flex flex-col gap-1">
            <div class="flex items-baseline justify-between">
                <label for="image-size-quality-{{ message.id }}" class="text-xs font-medium text-ink-soft">{{ 'compose.image_size.quality'|trans }}</label>
                <span data-image-size-quality-label class="text-xs font-semibold text-ink"></span>
            </div>
            <input id="image-size-quality-{{ message.id }}" type="range" data-image-size-quality
                   min="{{ constant('App\\Domain\\Enum\\Mail\\ImageSize::MIN_QUALITY') }}"
                   max="{{ constant('App\\Domain\\Enum\\Mail\\ImageSize::MAX_QUALITY') }}"
                   step="5" class="w-full accent-accent">
            <div class="flex justify-between text-[11px] text-ink-faint">
                <span>{{ 'compose.image_size.smaller'|trans }}</span>
                <span>{{ 'compose.image_size.sharper'|trans }}</span>
            </div>
            <span data-image-size-hint class="text-[11px] text-ink-muted"></span>
        </div>

        <div class="flex flex-col gap-1 px-3 py-2 rounded-lg bg-sunken">
            <span data-image-size-estimate class="text-xs font-semibold text-ink"></span>
            <div class="h-1.5 rounded-full bg-line overflow-hidden">
                <div data-image-size-bar class="h-full bg-accent" style="width: 100%"></div>
            </div>
            <span class="text-[11px] text-ink-faint">{{ 'compose.image_size.estimate_note'|trans }}</span>
        </div>

        <div class="flex items-center justify-between gap-2">
            <button type="button" data-action="click->compose--compose#resetImageSizePanel"
                    class="h-8 px-2.5 rounded-lg text-xs font-medium text-ink-soft hover:bg-hover transition-colors">
                {{- 'compose.image_size.reset'|trans -}}
            </button>
            <button type="button" data-action="click->compose--compose#applyImageSizePanel"
                    class="h-8 px-3 rounded-lg text-xs font-medium bg-accent text-accent-ink hover:bg-accent-strong transition-colors">
                {{- 'compose.image_size.apply'|trans -}}
            </button>
        </div>
    </div>
</div>

{# The whole strip on one line, shown in its place while somebody writes
   (compose--compose#collapseAttachments, on the editor's focus): how many
   files, the message's size — before → after once images are smaller — and
   the image size in force. A click brings the strip back. Without it, five
   photos and the Image size row left a docked window three lines to write in. #}
{% set listed = parts|length %}
{% if listed > 0 or images|length > 0 %}
    <button type="button"
            data-attachments-summary
            data-action="click->compose--compose#expandAttachments"
            aria-expanded="false"
            class="hidden group-data-[collapsed]/attachments:flex items-center gap-2 mx-4 mb-2 px-3 h-8 w-[calc(100%-2rem)]
                   rounded-lg border border-line bg-sunken text-xs text-ink-soft text-left
                   hover:bg-hover transition-colors cursor-pointer
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
        <i class="fa-solid fa-paperclip text-[10px] text-ink-faint" aria-hidden="true"></i>
        <span class="truncate min-w-0">
            {{- listed > 0
                ? 'compose.attachments_summary.files'|trans({ '%count%': listed })
                : 'compose.attachments_summary.images_in_text'|trans -}}
        </span>
        <span data-attachments-summary-size class="shrink-0 text-ink-faint"></span>
        {% if images|length > 0 and picked != 'original' %}
            <span class="shrink-0 text-ink-faint" aria-hidden="true">·</span>
            <span class="truncate min-w-0 text-ink-muted">
                {{- custom
                    ? 'compose.image_size.custom_segment'|trans ~ ' ' ~ (0 == message.imageEdge
                        ? 'compose.image_size.custom_own'|trans({ '%quality%': message.imageQuality })
                        : 'compose.image_size.custom'|trans({ '%px%': message.imageEdge, '%quality%': message.imageQuality }))
                    : ('compose.image_size.' ~ picked)|trans -}}
            </span>
        {% endif %}
        <span class="ml-auto shrink-0 inline-flex items-center gap-1 text-ink-muted">
            {{- 'compose.attachments_summary.show'|trans -}}
            <i class="fa-solid fa-chevron-up text-[10px]" aria-hidden="true"></i>
        </span>
    </button>
{% endif %}

{% if parts|length > 0 %}
    {# Stagger, so three files dropped at once read as a list arriving rather
       than as a slab appearing. motion.css caps the delay at eight, which is
       well past the point where a compose window has other problems. #}
    {# Capped at about four rows of chips and scrolling inside itself past
       that: a strip with a dozen files used to take the whole window, leaving
       no text to click into and running out under the toolbar. #}
    <div data-attachments-chips
         class="flex flex-wrap gap-2 px-4 pb-2 max-h-[9.5rem] overflow-y-auto overscroll-contain
                group-data-[collapsed]/attachments:hidden" {% if live %}data-enter-stagger{% endif %}>
        {% for part in parts %}
            {% set kb = (part.size ?: 0) / 1024 %}
            {# data-compose-part*: what compose--encryption needs to put the
               file into a message it builds in the browser. #}
            <span {% if live %}data-enter="rise"{% endif %}
                  data-compose-part="{{ part.id }}"
                  data-part-name="{{ part.filename ?: 'attachment' }}"
                  data-part-type="{{ part.contentType ?: 'application/octet-stream' }}"
                  data-part-sealed="{{ part.sealed ? '1' : '0' }}"
                  data-part-size="{{ part.size ?: 0 }}"
                  class="inline-flex items-center gap-2 pl-2.5 pr-1.5 py-1 rounded-lg text-xs
                         bg-sunken border border-line text-ink-soft">
                {% if part.sealed %}
                    {# Encrypted in the browser to the person's own key: the
                       file on the server is ciphertext, so there is nothing a
                       link could usefully download. See MessagePart::$sealed. #}
                    <i class="fa-solid fa-lock text-[10px] text-success" aria-hidden="true"
                       title="{{ 'compose.crypto.sealed_attachment'|trans }}"></i>
                    <span class="truncate max-w-[11rem]" data-testid="sealed-attachment">
                        {{- part.filename ?: 'attachment' -}}
                    </span>
                {% else %}
                <i class="fa-solid fa-paperclip text-[10px] text-ink-faint" aria-hidden="true"></i>
                {% if attachment_preview_kind(part) %}
                    {# A picture, a video or a PDF opens the reading pane's
                       viewer rather than downloading: in a draft the question
                       is "is this the right file, and how does it look at the
                       size I picked" (#502), not "save it again". The viewer
                       has its own download button for the rest. #}
                    <button type="button"
                            data-controller="ui--modal"
                            data-action="click->ui--modal#open"
                            data-ui--modal-size-value="full"
                            data-ui--modal-src-value="{{ path('app_mail_attachment_preview', { id: part.id }) }}"
                            data-ui--modal-title-value="{{ part.filename ?: 'attachment.preview.untitled'|trans }}"
                            data-testid="compose-attachment-preview"
                            class="truncate max-w-[11rem] text-left hover:text-accent transition-colors cursor-pointer
                                   rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                        {{- part.filename ?: 'attachment' -}}
                    </button>
                {% else %}
                    {# `download` for the same reason as in mail/_attachment_chip:
                       without it Turbo intercepts the click and throws the file
                       away, and the link does nothing at all. #}
                    <a href="{{ path('app_mail_attachment', { id: part.id }) }}?download=1"
                       download="{{ part.filename ?: 'attachment' }}"
                       class="truncate max-w-[11rem] hover:text-accent transition-colors">
                        {{- part.filename ?: 'attachment' -}}
                    </a>
                {% endif %}
                {% endif %}
                <span class="text-ink-faint shrink-0">
                    {{- kb >= 1024 ? (kb / 1024)|number_format(1) ~ ' MB' : kb|number_format(0) ~ ' KB' -}}
                </span>
                <button type="button"
                        data-action="click->compose--compose#removeAttachment"
                        data-part-id="{{ part.id }}"
                        title="{{ 'compose.attachment_remove'|trans }}"
                        class="w-5 h-5 flex items-center justify-center rounded
                               text-ink-faint hover:text-danger hover:bg-hover transition-colors">
                    <i class="fa-solid fa-xmark text-[10px]"></i>
                </button>
            </span>
        {% endfor %}
        {# Fold the strip to its one-line summary by hand, the same as
           clicking into the text does. #}
        <button type="button"
                data-action="click->compose--compose#collapseAttachments"
                aria-label="{{ 'compose.attachments_summary.hide_label'|trans }}"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs text-ink-muted
                       hover:bg-hover hover:text-ink transition-colors
                       focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            {{- 'compose.attachments_summary.hide'|trans -}}
            <i class="fa-solid fa-chevron-down text-[10px]" aria-hidden="true"></i>
        </button>
    </div>
{% endif %}
