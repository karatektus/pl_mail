{# templates/compose/_attachments.html.twig #}

{#
The attachment strip of a compose window. Rendered with the window and again
on its own after every upload/removal — compose_controller swaps it into the
"attachments" target — so it must stay a standalone fragment.

`live` says whether this render is an UPDATE — the answer to an upload or a
removal, swapped in by compose_controller — or the copy that ships inside a
window that is itself arriving. Only the first animates. The window carries its
own entrance, and a staggered strip playing inside it is two animations for one
arrival; the three controller renders take the default and get the chips one
after another, which is the case that needed marking. An attachment that
appears with no sign it arrived is an attachment people upload twice.

Variables: message, live (default true)
#}
{% set parts = message.messageParts|filter(part => not part.isInline) %}
{# `?? true`, not `|default(true)`: the default filter fires on any empty
   value, so `false|default(true)` is true and `live: false` — which the compose
   window passes to say "these chips are already here, do not animate them in" —
   was ignored. #}
{% set live  = live ?? true %}

{# The Image size row (#502). Every image of the draft that a browser can make
   smaller, attached or in the body: compose_controller scales them all to the
   size picked here. Rendered whenever the draft could hold such an image and
   shown by compose_controller (_refreshImageSize) while it does — the body
   can gain or lose a picture without this fragment being rendered again, and
   a sealed draft's pictures live in the body as data: URIs the server never
   sees. The `hidden` here is the server's first guess, so the row does not
   blink in on a window that opens with images. #}
{% set scalable = constant('App\\Service\\Mail\\DraftAttachmentService::SCALABLE') %}
{% set images = message.messageParts|filter(part => part.contentType in scalable and part.senderKeyFingerprint is null) %}
{% set picked = message.imageSize ? message.imageSize.value : 'original' %}
<div data-compose--compose-target="imageSize"
     data-image-parts="{{ images|map(part => { id: part.id, inline: part.isInline ? true : false, sealed: part.sealed, scaled: part.originalStoragePath is not null, size: part.size ?: 0, type: part.contentType, name: part.filename ?: 'image' })|json_encode|e('html_attr') }}"
     data-size="{{ picked }}"
     {% if images|length == 0 %}hidden{% endif %}
     class="mx-4 mb-2 pt-2 border-t border-line flex flex-wrap items-center gap-x-3 gap-y-2">
    <span id="image-size-label-{{ message.id }}" class="inline-flex items-center gap-1.5 text-xs font-medium text-ink-soft">
        <i class="fa-regular fa-image w-4 text-center" aria-hidden="true"></i>
        {{- 'compose.image_size.label'|trans -}}
    </span>
    {# The settings pages' segmented control (settings/_images.html.twig), as
       buttons rather than radio inputs: this sits inside the compose form,
       and a radio there would ride along in every autosave and set the size
       before a single picture had been scaled to it. #}
    <div role="radiogroup" aria-labelledby="image-size-label-{{ message.id }}"
         class="grid grid-flow-col auto-cols-fr rounded-pane border border-line overflow-hidden">
        {% for case in [null]|merge(enum('App\\Domain\\Enum\\Mail\\ImageSize').cases()) %}
            {% set size = case ? case.value : 'original' %}
            {% set edge = case ? case.edge : 0 %}
            <button type="button" role="radio"
                    aria-checked="{{ size == picked ? 'true' : 'false' }}"
                    data-action="click->compose--compose#pickImageSize"
                    data-compose--compose-size-param="{{ size }}"
                    data-compose--compose-edge-param="{{ edge }}"
                    {% if edge > 0 %}title="{{ 'compose.image_size.edge'|trans({ '%px%': edge }) }}"{% endif %}
                    class="flex items-center justify-center px-3 py-1.5 text-center text-[11px] leading-tight text-ink-muted
                           aria-[checked=false]:hover:bg-hover aria-checked:bg-accent aria-checked:text-accent-ink
                           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent
                           disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer">
                {{- ('compose.image_size.' ~ size)|trans -}}
            </button>
        {% endfor %}
    </div>
    <span data-image-size-total class="ml-auto text-xs text-ink-faint"></span>
</div>

{% if parts|length > 0 %}
    {# Stagger, so three files dropped at once read as a list arriving rather
       than as a slab appearing. motion.css caps the delay at eight, which is
       well past the point where a compose window has other problems. #}
    <div class="flex flex-wrap gap-2 px-4 pb-2" {% if live %}data-enter-stagger{% endif %}>
        {% for part in parts %}
            {% set kb = (part.size ?: 0) / 1024 %}
            {# data-compose-part*: what compose--encryption needs to put the
               file into a message it builds in the browser. #}
            <span {% if live %}data-enter="rise"{% endif %}
                  data-compose-part="{{ part.id }}"
                  data-part-name="{{ part.filename ?: 'attachment' }}"
                  data-part-type="{{ part.contentType ?: 'application/octet-stream' }}"
                  data-part-sealed="{{ part.sealed ? '1' : '0' }}"
                  data-part-size="{{ part.size ?: 0 }}"
                  class="inline-flex items-center gap-2 pl-2.5 pr-1.5 py-1 rounded-lg text-xs
                         bg-sunken border border-line text-ink-soft">
                {% if part.sealed %}
                    {# Encrypted in the browser to the person's own key: the
                       file on the server is ciphertext, so there is nothing a
                       link could usefully download. See MessagePart::$sealed. #}
                    <i class="fa-solid fa-lock text-[10px] text-success" aria-hidden="true"
                       title="{{ 'compose.crypto.sealed_attachment'|trans }}"></i>
                    <span class="truncate max-w-[11rem]" data-testid="sealed-attachment">
                        {{- part.filename ?: 'attachment' -}}
                    </span>
                {% else %}
                <i class="fa-solid fa-paperclip text-[10px] text-ink-faint" aria-hidden="true"></i>
                {% if attachment_preview_kind(part) %}
                    {# A picture, a video or a PDF opens the reading pane's
                       viewer rather than downloading: in a draft the question
                       is "is this the right file, and how does it look at the
                       size I picked" (#502), not "save it again". The viewer
                       has its own download button for the rest. #}
                    <button type="button"
                            data-controller="ui--modal"
                            data-action="click->ui--modal#open"
                            data-ui--modal-size-value="full"
                            data-ui--modal-src-value="{{ path('app_mail_attachment_preview', { id: part.id }) }}"
                            data-ui--modal-title-value="{{ part.filename ?: 'attachment.preview.untitled'|trans }}"
                            data-testid="compose-attachment-preview"
                            class="truncate max-w-[11rem] text-left hover:text-accent transition-colors cursor-pointer
                                   rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                        {{- part.filename ?: 'attachment' -}}
                    </button>
                {% else %}
                    {# `download` for the same reason as in mail/_attachment_chip:
                       without it Turbo intercepts the click and throws the file
                       away, and the link does nothing at all. #}
                    <a href="{{ path('app_mail_attachment', { id: part.id }) }}?download=1"
                       download="{{ part.filename ?: 'attachment' }}"
                       class="truncate max-w-[11rem] hover:text-accent transition-colors">
                        {{- part.filename ?: 'attachment' -}}
                    </a>
                {% endif %}
                {% endif %}
                <span class="text-ink-faint shrink-0">
                    {{- kb >= 1024 ? (kb / 1024)|number_format(1) ~ ' MB' : kb|number_format(0) ~ ' KB' -}}
                </span>
                <button type="button"
                        data-action="click->compose--compose#removeAttachment"
                        data-part-id="{{ part.id }}"
                        title="{{ 'compose.attachment_remove'|trans }}"
                        class="w-5 h-5 flex items-center justify-center rounded
                               text-ink-faint hover:text-danger hover:bg-hover transition-colors">
                    <i class="fa-solid fa-xmark text-[10px]"></i>
                </button>
            </span>
        {% endfor %}
    </div>
{% endif %}
