{# templates/compose/_window.html.twig #}
{% form_theme form '_layout/form/compose_theme.html.twig' %}
{% import '_partials/_select.html.twig' as select %}

{#
Renders in two places:
  • the floating dock (default) — turbo-frame "compose_dock"
  • inline at the bottom of a thread — frame "compose_inline", `inline` true

Everything below the header is shared verbatim. The frame id and the form
name travel back to the server on every POST via the `frame`/`thread` query
params baked into draftUrl/sendUrl, which is what keeps the named inline form
("compose_inline_*" ids) from colliding with the dock's.

Variables: form, message, ctx (inline, frame, thread, urlParams)
#}
{% set ctx    = ctx|default({}) %}
{% set inline = ctx.inline|default(false) %}
{% set frame  = ctx.frame|default('compose_dock') %}
{% set thread = ctx.thread|default(null) %}
{# Query params the server needs back on every POST: which frame rendered us,
   which conversation we're in, and which message we're answering. #}
{% set params = ctx.urlParams|default({}) %}

{# Window-chrome button. Larger below md so it clears the 44px touch target. #}
{% set hc = "w-9 h-9 md:w-7 md:h-7 flex items-center justify-center rounded-lg
             text-ink-muted hover:text-ink hover:bg-hover transition-colors shrink-0" %}
{# Formatting-toolbar button: shrink-0 so it keeps its width inside the
   horizontal scroller the toolbar becomes below md. #}
{% set tb = "shrink-0 px-1.5 py-0.5 rounded text-sm transition-colors text-ink-muted hover:bg-hover" %}

<turbo-frame id="{{ frame }}">
    <div data-controller="compose--compose compose--compose-toolbar"
         {# Every word the controller puts on screen, translated here rather
            than spelled in JavaScript — same arrangement as ui--select's
            i18n value. A string baked into the controller is a string that
            stays English in a German window. #}
         data-compose--compose-i18n-value="{{ {
             saving:           'compose.status.saving'|trans,
             saved:            'compose.status.saved'|trans,
             saveFailed:       'compose.status.save_failed'|trans,
             uploading:        'compose.status.uploading'|trans,
             sending:          'compose.sending'|trans,
             newMessage:       'compose.new_message'|trans,
             attachFailed:     'compose.attach_failed'|trans,
             attachRemoveFailed: 'compose.attach_remove_failed'|trans,
             pendingOne:       'compose.status.pending_one'|trans,
             pendingMany:      'compose.status.pending_many'|trans({ '%count%': '%d' }),
             quoteShow:        'compose.quote.show'|trans,
             quoteHide:        'compose.quote.hide'|trans,
             invalidAddress:   'compose.invalid_address'|trans({ '%address%': '%s' }),
             recipientRequired: 'compose.recipient_required'|trans,
             confirmNoSubject: 'compose.confirm.no_subject'|trans,
             confirmNoBody:    'compose.confirm.no_body'|trans,
             tooLarge:         'compose.attach_too_large'|trans({ '%name%': '%s', '%limit%': '%d' }),
             imageFailed:      'compose.image_insert_failed'|trans,
             noSignature:      'compose.signature_none'|trans,
             confirmPlainText: 'compose.confirm.plain_text'|trans,
         }|json_encode|e('html_attr') }}"
         {# Every From option's signature, keyed by the same "accountId|address"
            token the hidden account <select> carries. Handed over in one go so
            that switching From is a DOM swap and not a fetch: the From menu is
            a keystroke-level interaction and a network round trip inside it is
            a spinner where a signature should be. See signature_map(). #}
         data-compose--compose-signatures-value="{{ signature_map()|json_encode|e('html_attr') }}"
         data-compose--compose-inline-value="{{ inline ? 'true' : 'false' }}"
         data-compose--compose-min-chars-value="{{ min_chars|default(5) }}"
         data-compose--compose-max-attachment-bytes-value="{{ constant('App\\Controller\\Mail\\ComposeController::MAX_ATTACHMENT_BYTES') }}"
         {% if thread is not null %}data-compose--compose-thread-value="{{ thread }}"{% endif %}
        {% if null == message.id %}
            data-compose--compose-draft-url-value="{{ path('app_compose_form_new', params) }}"
            data-compose--compose-send-url-value="{{ path('app_compose_mail_send', params) }}"
        {% else %}
            data-compose--compose-draft-url-value="{{ path('app_compose_form_edit', params|merge({'id': message.id})) }}"
            data-compose--compose-send-url-value="{{ path('app_compose_mail_send_draft', params|merge({'id': message.id})) }}"
        {% endif %}
         class="compose-window flex flex-col
       {% if inline %}
       w-full rounded-pane border border-line bg-surface shadow-sm mt-3
       {% else %}
       max-h-[90vh] w-[520px] rounded-pane shadow-float
       pane-flat border border-line mb-4
       {% endif %}
       {# Below md *both* variants are the whole screen, Gmail-app style —
          replying from a phone gets the same window as composing, not a card
          wedged into the thread. Fixed to the viewport, square, opaque, no
          dock offset. The height starts at 100dvh and the controller then
          takes it over from visualViewport, so the virtual keyboard shrinks
          the window instead of covering its bottom row. The safe-area padding
          sits here rather than on body: a fixed element is outside body's
          box. #}
       max-md:fixed max-md:inset-x-0 max-md:top-0 max-md:z-50
       max-md:w-full max-md:h-[100dvh] max-md:max-h-none
       max-md:m-0 max-md:rounded-none max-md:border-0 max-md:shadow-none
       max-md:bg-surface
       max-md:pt-[env(safe-area-inset-top)] max-md:pb-[env(safe-area-inset-bottom)]">
        {{ form_start(form, { attr: { novalidate: 'novalidate', class: 'flex flex-col flex-1 min-h-0' } }) }}

        {# ── Header ───────────────────────────────────────────────── #}
        <div class="flex items-center justify-between gap-1 px-2 py-2 md:px-4 md:py-2.5
                    {{ inline ? 'border-b border-line' : 'border-b border-line md:border-b-0 bg-surface md:bg-sunken md:rounded-t-pane' }}
                    select-none shrink-0"
             {% if not inline %}data-action="dblclick->compose--compose#toggleMinimize"{% endif %}>
            {# Fullscreen has no window chrome to close from, so the back arrow
               is the way out — same gesture as the Gmail app, and the same for
               a reply, which is fullscreen below md too. #}
            <button type="button" title="{{ 'compose.save_and_close'|trans }}"
                    aria-label="{{ 'compose.save_and_close'|trans }}"
                    data-action="compose--compose#saveDraft compose--compose#close"
                    class="md:hidden {{ hc }}">
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </button>

            {% if inline %}
                {# Replying rarely means retargeting: the address and subject
                   rows stay folded behind this summary. #}
                {% set recipients = [] %}
                {% for entry in message.toAddresses ?? [] %}
                    {% set recipients = recipients|merge([entry.name|default('') ?: entry.address]) %}
                {% endfor %}

                <button type="button"
                        data-action="click->compose--compose#toggleFields"
                        class="flex items-center gap-2 min-w-0 flex-1 md:flex-none text-sm text-ink-soft
                               hover:text-ink transition-colors cursor-pointer">
                    <span class="text-xs text-ink-faint shrink-0">{{ 'message.details.to_label'|trans }}</span>
                    <span class="truncate max-w-[420px]">
                        {{- recipients is empty ? ('compose.no_recipients'|trans) : recipients|join(', ') -}}
                    </span>
                    <i data-compose--compose-target="fieldsChevron"
                       class="fa-solid fa-chevron-down text-[10px] text-ink-faint shrink-0 transition-transform duration-150"></i>
                </button>
                <span class="hidden" data-compose--compose-target="title"></span>
            {% else %}
                <span class="text-sm font-semibold text-ink truncate min-w-0 flex-1 md:flex-none md:max-w-[260px] cursor-pointer"
                      data-compose--compose-target="title"
                      data-action="click->compose--compose#toggleMinimize">{{ 'compose.new_message'|trans }}</span>
            {% endif %}
            <div class="flex items-center gap-1 shrink-0">
                <span data-compose--compose-target="saveStatus"
                      class="text-xs text-ink-muted mr-2 transition-colors truncate max-w-[40vw] md:max-w-none"></span>

                {# Send is the one action that must never be scrolled away, so
                   below md it lives up here rather than in the bottom bar,
                   which is a horizontal scroller. #}
                <button type="submit" title="{{ 'compose.send'|trans }}"
                        aria-label="{{ 'compose.send'|trans }}"
                        data-compose--compose-target="sendBtn"
                        class="md:hidden {{ hc }} text-accent hover:text-accent">
                    <i class="fa-solid fa-paper-plane text-sm" aria-hidden="true"></i>
                </button>

                {% if inline %}
                    {# Popping out lands in the dock, which below md is the
                       same fullscreen window we are already in. #}
                    <button type="button" title="{{ 'compose.pop_out'|trans }}"
                            aria-label="{{ 'compose.pop_out'|trans }}"
                            data-action="click->compose--compose#popOut"
                            class="hidden md:flex {{ hc }}">
                        <i class="fa-solid fa-up-right-from-square text-xs" aria-hidden="true"></i>
                    </button>
                {% else %}
                    {# Minimize and expand are dock concepts: below md the
                       window already is the screen. #}
                    <button type="button" title="{{ 'compose.minimize'|trans }}"
                            aria-label="{{ 'compose.minimize'|trans }}"
                            data-action="click->compose--compose#toggleMinimize"
                            class="hidden md:flex {{ hc }}">
                        <i data-compose--compose-target="minimizeIcon" class="fa-solid fa-minus text-xs" aria-hidden="true"></i>
                    </button>
                    <button type="button" title="{{ 'compose.expand'|trans }}"
                            aria-label="{{ 'compose.expand'|trans }}"
                            data-action="click->compose--compose#toggleExpand"
                            class="hidden md:flex {{ hc }}">
                        <i data-compose--compose-target="expandIcon"
                           class="fa-solid fa-up-right-and-down-left-from-center text-[10px]" aria-hidden="true"></i>
                    </button>
                {% endif %}

                {# Below md the back arrow at the left is the way out instead. #}
                <button type="button" title="{{ 'compose.save_and_close'|trans }}"
                        data-action="compose--compose#saveDraft compose--compose#close"
                        class="hidden md:flex {{ hc }}">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>
        </div>

        {# ── Collapsible body ─────────────────────────────────────── #}
        <div data-compose--compose-target="collapsible"
             class="flex flex-col flex-1 min-h-0">

            {# ── Hidden account select (submitted with form) ─────────
               Deliberately not a Tom Select. It is never shown: the "From"
               line is a custom menu built from these options, and this is only
               the value the form posts. A widget here would be one the user
               cannot see and the screen reader would announce twice. #}
            <select id="{{ form.account.vars.id }}"
                    name="{{ form.account.vars.full_name }}"
                    data-compose--compose-target="accountSelect"
                    class="sr-only">
                {% for choice in form.account.vars.choices %}
                    <option value="{{ choice.value }}"
                            {% if form.account.vars.value == choice.value %}selected{% endif %}>
                        {{ choice.label }}
                    </option>
                {% endfor %}
            </select>

            {# ── Body ─────────────────────────────────────────────── #}
            <input type="hidden"
                   id="{{ form.bodyHtml.vars.id }}"
                   name="{{ form.bodyHtml.vars.full_name }}"
                   data-compose--compose-toolbar-target="hiddenInput"
                   value="{{ form.bodyHtml.vars.value|e('html_attr') ?: '' }}">

            {# Addresses, subject and the editor scroll as one region rather
               than the editor scrolling under fixed field rows. On a phone
               with the keyboard up there is no room for both, and Gmail
               scrolls the headers away the same way. #}
            <div data-compose--compose-target="scroller"
                 class="flex-1 min-h-0 overflow-y-auto flex flex-col">

            {# ── Addresses + subject (folded away inline) ──────────── #}
            <div data-compose--compose-target="fields" class="shrink-0 {{ inline ? 'hidden' : '' }}">

            {# ── From ─────────────────────────────────────────────── #}
            <div class="relative shrink-0">
                <div class="flex items-center gap-3 px-4 pt-3 pb-1"
                     data-compose--compose-target="fromRow">
                    <span id="{{ form.vars.id }}_from_label"
                          class="text-xs font-medium text-ink-faint w-10 shrink-0 text-right">{{ 'compose.from'|trans }}</span>
                    <button type="button"
                            data-action="click->compose--compose#toggleFromDropdown"
                            data-compose--compose-target="fromBtn"
                            aria-haspopup="listbox"
                            aria-labelledby="{{ form.vars.id }}_from_label {{ form.vars.id }}_from_value"
                            class="flex-1 flex items-center justify-between gap-2 text-sm
                                   text-ink-soft text-left">
                        <span data-compose--compose-target="fromLabel" id="{{ form.vars.id }}_from_value" class="truncate">
                            {% for choice in form.account.vars.choices %}
                                {% if form.account.vars.value == choice.value %}{{ choice.label }}{% endif %}
                            {% endfor %}
                        </span>
                        <i class="fa-solid fa-chevron-down text-[10px] text-ink-faint shrink-0 transition-transform duration-150"
                           data-compose--compose-target="fromChevron"></i>
                    </button>
                </div>

                <div data-compose--compose-target="fromDropdown"
                     class="hidden absolute left-4 right-4 top-full z-20 rounded-pane overflow-hidden
                            bg-pane-soft
                            backdrop-blur-sm
                            border border-line
                            shadow-pop">
                    {% for choice in form.account.vars.choices %}
                        <button type="button"
                                data-action="click->compose--compose#selectAccount"
                                data-value="{{ choice.value }}"
                                data-label="{{ choice.label }}"
                                class="w-full text-left px-4 py-2.5 text-sm
                                       text-ink-soft
                                       hover:bg-accent-soft
                                       hover:text-accent
                                       transition-colors
                                       {% if form.account.vars.value == choice.value %}
                                           bg-accent-soft text-accent
                                       {% endif %}">
                            {{ choice.label }}
                        </button>
                    {% endfor %}
                </div>
            </div>

            {# ── To ───────────────────────────────────────────────── #}
            {# A real <label for>, not a <span>: it is what gives the recipient
               combobox an accessible name. Tom Select hides the <select> and
               builds its own text input, and copies the name across only when
               there is a label bound to the select's id — so the label is
               load-bearing rather than decoration. The controller mirrors it
               onto the generated input as well, for the same reason a belt
               goes with braces. #}
            <div data-compose--compose-target="toField"
                 class="flex items-center gap-3 px-4 py-1.5 shrink-0 min-h-[36px]">
                <label for="{{ form.toAddresses.vars.id }}"
                       id="{{ form.toAddresses.vars.id }}_label"
                       class="text-xs font-medium text-ink-faint w-10 shrink-0 text-right">{{ 'compose.to'|trans }}</label>
                <div class="flex-1 min-w-0">
                    {{ form_widget(form.toAddresses) }}
                </div>
                <div class="flex gap-2 shrink-0">
                    <button type="button"
                            data-compose--compose-target="ccBtn"
                            data-action="click->compose--compose#showCc"
                            {# title, not aria-label: the button already has an
                               accessible name — the word "Cc" on its face — and
                               an aria-label would replace it rather than add to
                               it, leaving the visible label and the spoken one
                               saying different things (WCAG 2.5.3). #}
                            title="{{ 'compose.add_cc'|trans }}"
                            class="text-xs text-ink-faint hover:text-accent transition-colors">
                        {{ 'compose.cc'|trans }}
                    </button>
                    <button type="button"
                            data-compose--compose-target="bccBtn"
                            data-action="click->compose--compose#showBcc"
                            title="{{ 'compose.add_bcc'|trans }}"
                            class="text-xs text-ink-faint hover:text-accent transition-colors">
                        {{ 'compose.bcc'|trans }}
                    </button>
                </div>
            </div>

            {# Why a send was refused. Rendered from the form rather than from a
               toast so it sits with the field it is about, and so a refusal
               that came from the server reads the same as one the window
               caught itself. #}
            <div data-compose--compose-target="errors"
                 class="px-4 {{ form.toAddresses.vars.errors|length > 0 ? 'py-1' : 'hidden' }}"
                 role="alert" aria-live="polite">
                <p class="text-xs text-danger">
                    {%- for error in form.toAddresses.vars.errors %}{{ error.message }}{% endfor -%}
                </p>
            </div>

            {# ── Cc ───────────────────────────────────────────────── #}
            <div data-compose--compose-target="ccField"
                 class="flex hidden items-center gap-3 px-4 py-1.5 shrink-0 min-h-[36px]">
                <label for="{{ form.ccAddresses.vars.id }}"
                       id="{{ form.ccAddresses.vars.id }}_label"
                       class="text-xs font-medium text-ink-faint w-10 shrink-0 text-right">{{ 'compose.cc'|trans }}</label>
                <div class="flex-1 min-w-0">
                    {{ form_widget(form.ccAddresses) }}
                </div>
            </div>

            {# ── Bcc ──────────────────────────────────────────────── #}
            <div data-compose--compose-target="bccField"
                 class="flex hidden items-center gap-3 px-4 py-1.5 shrink-0 min-h-[36px]">
                <label for="{{ form.bccAddresses.vars.id }}"
                       id="{{ form.bccAddresses.vars.id }}_label"
                       class="text-xs font-medium text-ink-faint w-10 shrink-0 text-right">{{ 'compose.bcc'|trans }}</label>
                <div class="flex-1 min-w-0">
                    {{ form_widget(form.bccAddresses) }}
                </div>
            </div>

            {# ── Divider ──────────────────────────────────────────── #}
            <div class="mx-4 border-t border-line mt-1 shrink-0"></div>

            {# ── Subject ──────────────────────────────────────────── #}
            <div class="flex items-center gap-3 px-4 py-2 shrink-0">
                <label for="{{ form.subject.vars.id }}"
                       class="text-xs font-medium text-ink-faint w-10 shrink-0 text-right">{{ 'compose.subject_label'|trans }}</label>
                <input type="text"
                       id="{{ form.subject.vars.id }}"
                       name="{{ form.subject.vars.full_name }}"
                       data-compose--compose-target="subject"
                       value="{{ form.subject.vars.value ?: '' }}"
                       placeholder="{{ 'compose.subject_placeholder'|trans }}"
                       class="flex-1 bg-transparent outline-none text-sm
                              text-ink
                              placeholder:text-ink-faint"/>
            </div>
            <div class="mx-4 border-t border-line shrink-0"></div>

            </div>

            <div class="flex-1 min-h-[180px] px-4 py-3">
                {# ── The plain-text surface ─────────────────────────────
                   A draft is in plain-text mode when it has text and no HTML
                   — which is not a flag anywhere, it is simply what such a
                   message IS, so the mode survives a reload with no column to
                   store it in. MessageSendService::buildEmail() branches on
                   exactly the same pair, so what the window shows and what
                   goes on the wire cannot disagree.

                   `disabled` in rich mode so the field is not submitted at
                   all: mapped, an absent bodyText binds null and
                   DraftPersister derives the text part from the HTML as it
                   always has. Submitted, it IS the message. #}
                {% set plainText = (form.bodyHtml.vars.value|default('')|trim is empty)
                                   and (form.bodyText.vars.value|default('')|trim is not empty) %}

                <textarea id="{{ form.bodyText.vars.id }}"
                          name="{{ form.bodyText.vars.full_name }}"
                          data-compose--compose-target="plainBody"
                          aria-label="{{ 'compose.body_placeholder'|trans }}"
                          placeholder="{{ 'compose.body_placeholder'|trans }}"
                          {% if not plainText %}disabled hidden{% endif %}
                          class="w-full min-h-[170px] bg-transparent outline-none resize-none
                                 text-sm leading-relaxed font-mono
                                 text-ink placeholder:text-ink-faint
                                 {{ plainText ? '' : 'hidden' }}">{{ form.bodyText.vars.value }}</textarea>

                <div id="{{ form.bodyHtml.vars.id }}_editor"
                     data-compose--compose-toolbar-target="editor"
                     data-compose--compose-target="body"
                     contenteditable="true"
                     role="textbox"
                     aria-multiline="true"
                     aria-label="{{ 'compose.body_placeholder'|trans }}"
                     data-placeholder="{{ 'compose.body_placeholder'|trans }}"
                     class="w-full min-h-[170px] bg-transparent outline-none
                            text-sm leading-relaxed
                            text-ink {{ plainText ? 'hidden' : '' }}
                            empty:before:content-[attr(data-placeholder)]
                            empty:before:text-ink-faint
                            empty:before:pointer-events-none">{{ form.bodyHtml.vars.value|raw ?: '' }}</div>
            </div>

            </div>{# end scroller #}

            {# ── Attachments ──────────────────────────────────────── #}
            <div data-compose--compose-target="attachments" class="shrink-0">
                {{ include('compose/_attachments.html.twig', { message: message }) }}
            </div>

            {# ── Toolbar ──────────────────────────────────────────── #}
            <div class="px-2 md:px-3 pb-2 md:pb-3 pt-1 shrink-0">

                {# One line that scrolls sideways below md — wrapping it would
                   eat three rows of a phone screen. The controller hides it
                   there until "Aa" asks for it. #}
                <div data-compose--compose-target="formatBar"
                     class="flex items-center gap-0.5 mb-2 flex-nowrap md:flex-wrap
                            overflow-x-auto md:overflow-visible compose-scroll-x
                            bg-sunken
                            rounded-full px-2 py-1">

                    {# Bare rather than framed: this is a strip of icon buttons,
                       and two boxed fields in the middle of it would read as a
                       different toolbar. Only the popup changes — which is the
                       point, since the format bar scrolls horizontally on
                       phones and a native popup was the one thing in it the
                       theme never reached.

                       The option labels used to be the lookup keys, which is
                       why they were English in a German UI. The values carry
                       the key now and the labels are free to be translated. #}
                    <select data-compose--compose-toolbar-target="fontFamily"
                            data-action="change->compose--compose-toolbar#changeFontFamily"
                            aria-label="{{ 'compose.font_family.label'|trans }}"
                            {{ select.enhance(bare = true) }}
                            class="shrink-0 bg-transparent border-none outline-none text-xs cursor-pointer px-1 py-0.5 rounded
                                   text-ink-muted
                                   hover:bg-hover transition-colors">
                        <option value="sans">{{ 'compose.font_family.sans'|trans }}</option>
                        <option value="serif">{{ 'compose.font_family.serif'|trans }}</option>
                        <option value="monospace">{{ 'compose.font_family.monospace'|trans }}</option>
                    </select>

                    <div class="w-px h-4 bg-line mx-1 shrink-0"></div>

                    <select data-compose--compose-toolbar-target="fontSize"
                            data-action="change->compose--compose-toolbar#changeFontSize"
                            aria-label="{{ 'compose.font_size.label'|trans }}"
                            {{ select.enhance(bare = true) }}
                            class="shrink-0 bg-transparent border-none outline-none text-xs cursor-pointer px-1 py-0.5 rounded
                                   text-ink-muted
                                   hover:bg-hover transition-colors">
                        <option value="small">{{ 'compose.font_size.small'|trans }}</option>
                        <option value="normal" selected>{{ 'compose.font_size.normal'|trans }}</option>
                        <option value="large">{{ 'compose.font_size.large'|trans }}</option>
                        <option value="huge">{{ 'compose.font_size.huge'|trans }}</option>
                    </select>

                    <div class="w-px h-4 bg-line mx-1 shrink-0"></div>

                    <button type="button" data-compose--compose-toolbar-action data-compose--compose-toolbar-target="boldBtn"
                            data-action="click->compose--compose-toolbar#bold"
                            title="{{ 'compose.bold'|trans }}" aria-label="{{ 'compose.bold'|trans }}"
                            class="{{ tb }} font-bold text-ink-soft">B</button>
                    <button type="button" data-compose--compose-toolbar-action data-compose--compose-toolbar-target="italicBtn"
                            data-action="click->compose--compose-toolbar#italic"
                            title="{{ 'compose.italic'|trans }}" aria-label="{{ 'compose.italic'|trans }}"
                            class="{{ tb }} italic text-ink-soft">I</button>
                    <button type="button" data-compose--compose-toolbar-action data-compose--compose-toolbar-target="underlineBtn"
                            data-action="click->compose--compose-toolbar#underline"
                            title="{{ 'compose.underline'|trans }}" aria-label="{{ 'compose.underline'|trans }}"
                            class="{{ tb }} underline text-ink-soft">U</button>

                    {# The colour input covers the whole control instead of
                       being a 0×0 box parked beside it. Sized to nothing, with
                       pointer-events off and tabindex="-1", it was reachable by
                       neither pointer nor keyboard and never entered the
                       accessibility tree at all — the "A" was a picture of a
                       button. Stretched over the label it keeps exactly the
                       same look, and is now the real, focusable control it
                       always appeared to be. #}
                    <label class="shrink-0 px-1.5 py-0.5 rounded text-sm flex flex-col items-center leading-none gap-0.5
                                  transition-colors text-ink-soft
                                  hover:bg-hover cursor-pointer relative
                                  focus-within:ring-2 focus-within:ring-accent">
                        <span class="font-semibold" aria-hidden="true">A</span>
                        <span data-compose--compose-toolbar-target="colorSwatch"
                              class="block w-3.5 h-[3px] bg-accent rounded-sm" aria-hidden="true"></span>
                        <input type="color" data-action="input->compose--compose-toolbar#changeColor"
                               title="{{ 'compose.text_color'|trans }}"
                               aria-label="{{ 'compose.text_color'|trans }}"
                               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
                    </label>

                    <div class="w-px h-4 bg-line mx-1 shrink-0"></div>

                    {% set toolbarButtons = [
                        { action: 'alignLeft',      icon: 'fa-align-left',   label: 'compose.align.left'      },
                        { action: 'alignCenter',    icon: 'fa-align-center', label: 'compose.align.center'    },
                        { action: 'alignRight',     icon: 'fa-align-right',  label: 'compose.align.right'     },
                        { divider: true },
                        { action: 'orderedList',    icon: 'fa-list-ol',      label: 'compose.list.ordered'    },
                        { action: 'unorderedList',  icon: 'fa-list-ul',      label: 'compose.list.unordered'  },
                        { action: 'outdent',        icon: 'fa-outdent',      label: 'compose.outdent'         },
                        { action: 'indent',         icon: 'fa-indent',       label: 'compose.indent'          },
                        { divider: true },
                        { action: 'undo',           icon: 'fa-rotate-left',  label: 'compose.undo'            },
                        { action: 'redo',           icon: 'fa-rotate-right', label: 'compose.redo'            },
                    ] %}

                    {% for item in toolbarButtons %}
                        {% if item.divider|default(false) %}
                            <div class="w-px h-4 bg-line mx-1 shrink-0"></div>
                        {% else %}
                            <button type="button" data-compose--compose-toolbar-action
                                    data-action="click->compose--compose-toolbar#{{ item.action }}"
                                    class="{{ tb }}"
                                    title="{{ item.label|trans }}"
                                    aria-label="{{ item.label|trans }}">
                                <i class="fa-solid {{ item.icon }}" aria-hidden="true"></i></button>
                        {% endif %}
                    {% endfor %}
                </div>

                {# Action bar #}
                <div class="flex items-center gap-1">
                    {# ── The Send pill, and behind its chevron, send later ──

                       Desktop only — below md the header carries Send, which
                       is always on screen. Which is also why the send-options
                       menu needs no mobile treatment: there is no chevron on a
                       phone for it to open off the edge of.

                       The positioning box is OUTSIDE the pill because the pill
                       is `overflow-hidden` (that is what rounds the two
                       buttons into one shape) and a menu absolutely positioned
                       inside it would be clipped to a 30px strip. Same shape as
                       the integration picker below: relative wrapper,
                       ui--dropdown, a `menu` target that starts hidden,
                       `bottom-full` so it opens upwards out of a window that
                       already sits at the bottom of the screen.

                       Every item is a real submit button pointed at the
                       schedule route with `formaction`, so choosing a time goes
                       through the same submit path as Send — the same guards in
                       compose--compose#_handleSubmit, the same CSRF token, the
                       same form body. See compose--schedule. #}
                    {% set scheduleUrl = null == message.id
                        ? path('app_compose_mail_schedule', params)
                        : path('app_compose_mail_schedule_draft', params|merge({'id': message.id})) %}
                    {# The hold already in place, if any. sentAt guards it: on a
                       sent message submissionSendAt is a record of when it was
                       due, not a schedule anyone can still call off. #}
                    {% set scheduledAt = (message.id and message.sentAt is null)
                        ? message.submissionSendAt : null %}

                    <div class="relative hidden md:block mr-2 shrink-0"
                         data-controller="ui--dropdown compose--schedule"
                         data-action="ui--dropdown:opened->compose--schedule#refresh"
                         {# The zone every other timestamp in this app is drawn
                            in — the user's setting, not the browser's guess.
                            The menu computes "tomorrow morning" against it and
                            posts a wall clock; ScheduledSendResolver turns that
                            into an instant with the tz database in hand. #}
                         data-compose--schedule-timezone-value="{{ clock.timezone }}"
                         data-compose--schedule-max-days-value="{{ constant('App\\Service\\Mail\\ScheduledSendResolver::MAX_SECONDS') // 86400 }}"
                         data-compose--schedule-i18n-value="{{ {
                             scheduleUnreadable: 'compose.schedule.error.unreadable'|trans,
                             schedulePast:       'compose.schedule.error.past'|trans,
                             scheduleTooFar:     'compose.schedule.error.too_far'|trans({
                                 '%days%': constant('App\\Service\\Mail\\ScheduledSendResolver::MAX_SECONDS') // 86400,
                             }),
                         }|json_encode|e('html_attr') }}">

                        <div class="flex items-center rounded-full overflow-hidden bg-accent">
                            <button type="submit"
                                    data-compose--compose-target="sendBtn"
                                    class="text-white text-sm font-semibold px-4 py-1.5 hover:bg-white/10 transition-colors">
                                {{ 'compose.send'|trans }}
                            </button>
                            <button type="button"
                                    data-action="click->ui--dropdown#toggle"
                                    title="{{ 'compose.send_options'|trans }}"
                                    aria-label="{{ 'compose.send_options'|trans }}"
                                    class="text-white border-l border-white/30 px-2.5 py-1.5 hover:bg-white/10 transition-colors text-xs">
                                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>

                        {# `right-0` on desktop: the pill sits at the left of a
                           520px window, and a menu anchored to its right edge
                           opens back across the window rather than off it.

                           Flipped to `left-0` below md, exactly as the
                           integration picker flips its own. The pill is hidden
                           at that width today, so this costs nothing now — but
                           right-anchored at 393px the menu's left edge lands at
                           -140, and the day the pill is ever shown on a phone
                           the failure would be a menu half off the screen with
                           no obvious cause. compose-scheduled-send.spec.ts
                           measures it either way. #}
                        <div data-ui--dropdown-target="menu" hidden
                             class="absolute bottom-full mb-1 right-0 max-md:left-0 max-md:right-auto
                                    z-20 w-64 max-w-[calc(100vw-2rem)] popover py-1">

                            {% if scheduledAt is not null %}
                                {# A draft that is already on a hold. The menu is
                                   where the schedule was set, so it is where it
                                   can be called off — and unlike the toast, this
                                   is still here tomorrow. #}
                                <div class="px-3 py-2 border-b border-line">
                                    <p class="text-[10px] font-semibold uppercase tracking-wide text-ink-faint">
                                        {{ 'compose.schedule.scheduled_for'|trans }}
                                    </p>
                                    <p class="text-sm text-ink mt-0.5">
                                        {{ 'compose.schedule.when'|trans({
                                            '%date%': scheduledAt|intl_date('dMMM', clock.timezone),
                                            '%time%': scheduledAt|date(clock.time, clock.timezone),
                                        }) }}
                                    </p>
                                    <button type="button"
                                            data-cancel-url="{{ path('app_compose_mail_undo', params|merge({'id': message.id})) }}"
                                            data-action="click->compose--schedule#cancel click->ui--dropdown#close"
                                            class="mt-1 text-xs text-danger hover:underline cursor-pointer">
                                        {{ 'compose.schedule.cancel'|trans }}
                                    </button>
                                </div>
                            {% endif %}

                            <p class="px-3 py-1 text-[10px] font-semibold uppercase tracking-wide text-ink-faint">
                                {{ 'compose.schedule.heading'|trans }}
                            </p>

                            {# Hidden until the controller has a time to put on
                               it: a preset showing its label and no hour is a
                               button whose effect you cannot read.

                               `style="display:none"` as well as the attribute,
                               and not belt and braces — `[hidden]` lives in the
                               UA stylesheet, so ANY author rule that sets
                               display wins over it, and `flex` below is exactly
                               such a rule. The attribute stays for the
                               semantics an assistive technology reads; the
                               inline style is what actually keeps it off the
                               screen. Kept in step by compose--schedule. #}
                            {% for key in ['tomorrow_morning', 'tomorrow_afternoon', 'monday_morning'] %}
                                <button type="submit" hidden style="display:none" formnovalidate
                                        formaction="{{ scheduleUrl }}"
                                        data-compose--schedule-target="option"
                                        data-schedule-key="{{ key }}"
                                        data-action="click->compose--schedule#choose"
                                        class="w-full flex items-center justify-between gap-3 px-3 py-2 text-sm text-ink-muted
                                               hover:bg-hover hover:text-ink transition-colors text-left">
                                    <span>{{ ('compose.schedule.' ~ key)|trans }}</span>
                                    <span data-schedule-when class="text-xs text-ink-faint tabular-nums"></span>
                                </button>
                            {% endfor %}

                            <div class="my-1 border-t border-line"></div>

                            <button type="button"
                                    data-compose--schedule-target="toggle"
                                    data-action="click->compose--schedule#showCustom"
                                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-ink-muted
                                           hover:bg-hover hover:text-ink transition-colors text-left">
                                <i class="fa-regular fa-calendar w-4 text-center" aria-hidden="true"></i>
                                <span>{{ 'compose.schedule.custom'|trans }}</span>
                            </button>

                            {# Native input, no picker library — the same choice
                               the calendar event editor makes. #}
                            <div data-compose--schedule-target="custom" hidden class="px-3 py-2 space-y-2">
                                <input type="datetime-local"
                                       data-compose--schedule-target="input"
                                       aria-label="{{ 'compose.schedule.custom'|trans }}"
                                       class="w-full rounded-lg border border-line bg-surface px-2 py-1.5 text-sm text-ink">
                                {# Named, because a bare time is ambiguous the
                                   moment the machine and the setting disagree —
                                   which is exactly when it matters. #}
                                <p class="text-[11px] text-ink-faint">
                                    {{ 'compose.schedule.timezone_hint'|trans({ '%zone%': clock.timezone }) }}
                                </p>
                                <p data-compose--schedule-target="error" hidden
                                   class="text-xs text-danger"></p>
                                <button type="submit" formnovalidate
                                        formaction="{{ scheduleUrl }}"
                                        data-action="click->compose--schedule#confirm"
                                        class="w-full rounded-full bg-accent text-white text-sm font-semibold
                                               px-3 py-1.5 hover:bg-white/10 transition-colors">
                                    {{ 'compose.schedule.confirm'|trans }}
                                </button>
                            </div>

                            {# The only field of the lot that is submitted. The
                               datetime-local above is deliberately unnamed —
                               the value that counts is the one a preset or the
                               confirm button writes here. #}
                            <input type="hidden" name="schedule_at" value=""
                                   data-compose--schedule-target="field">
                        </div>
                    </div>

                    {% set ic = "shrink-0 w-9 h-9 md:w-8 md:h-8 flex items-center justify-center rounded-full transition-colors text-ink-muted hover:text-ink hover:bg-hover" %}
                    {# Scrolls sideways rather than wrapping or clipping, so
                       every icon stays reachable on a phone. #}
                    <div class="flex-1 min-w-0 flex items-center gap-1 overflow-x-auto md:overflow-visible compose-scroll-x">
                    <button type="button"
                            data-action="click->compose--compose#toggleFormatBar"
                            data-compose--compose-target="formatToggle"
                            {# "Aa" on its face is the accessible name; the
                               title enlarges on it without replacing it. #}
                            title="{{ 'compose.formatting'|trans }}"
                            class="{{ ic }} text-sm font-bold tracking-tighter">Aa</button>
                    <button type="button"
                            data-action="click->compose--compose#openFilePicker"
                            title="{{ 'compose.attach'|trans }}"
                            aria-label="{{ 'compose.attach'|trans }}"
                            class="{{ ic }}"><i class="fa-solid fa-paperclip" aria-hidden="true"></i></button>
                    {# No name: never submitted with the form, only read by the
                       controller and POSTed to the attachment endpoint. #}
                    <input type="file" multiple class="hidden"
                           data-compose--compose-target="fileInput"
                           data-action="change->compose--compose#uploadFiles">
                    <button type="button" data-compose--compose-toolbar-action
                            data-action="click->compose--compose-toolbar#insertLink"
                            title="{{ 'compose.insert_link'|trans }}"
                            aria-label="{{ 'compose.insert_link'|trans }}"
                            class="{{ ic }}"><i class="fa-solid fa-link" aria-hidden="true"></i></button>

                    {# ── Emoji ─────────────────────────────────────────
                       Same dropdown shape as the integration picker below,
                       so Escape and outside-click come free. The panel opens
                       upwards and is pinned to the left edge of the window on
                       a phone: the button itself lives in a strip that scrolls
                       sideways, and a menu anchored to it would open off the
                       screen. #}
                    <div class="relative"
                         data-controller="ui--dropdown compose--emoji-picker"
                         data-action="ui--dropdown:opened->compose--emoji-picker#build"
                         data-compose--emoji-picker-locale-value="{{ app.request.locale|split('_')|first }}"
                         data-compose--emoji-picker-data-source-value="{{ asset('emoji/' ~ (app.request.locale starts with 'de' ? 'de' : 'en') ~ '/data.json') }}"
                         data-compose--emoji-picker-i18n-value="{{ {
                             categoriesLabel:         'compose.emoji.categories'|trans,
                             emojiUnsupportedMessage: 'compose.emoji.unsupported'|trans,
                             favoritesLabel:          'compose.emoji.favorites'|trans,
                             loadingMessage:          'compose.emoji.loading'|trans,
                             networkErrorMessage:     'compose.emoji.network_error'|trans,
                             regionLabel:             'compose.emoji.region'|trans,
                             searchDescription:       'compose.emoji.search_description'|trans,
                             searchLabel:             'compose.emoji.search'|trans,
                             searchResultsLabel:      'compose.emoji.search_results'|trans,
                             skinToneDescription:     'compose.emoji.skin_tone_description'|trans,
                             skinToneLabel:           'compose.emoji.skin_tone'|trans,
                             skinTonesLabel:          'compose.emoji.skin_tones'|trans,
                             skinTones: [
                                 'compose.emoji.tone_default'|trans,
                                 'compose.emoji.tone_light'|trans,
                                 'compose.emoji.tone_medium_light'|trans,
                                 'compose.emoji.tone_medium'|trans,
                                 'compose.emoji.tone_medium_dark'|trans,
                                 'compose.emoji.tone_dark'|trans,
                             ],
                             categories: {
                                 'custom':          'compose.emoji.custom'|trans,
                                 'smileys-emotion': 'compose.emoji.smileys_emotion'|trans,
                                 'people-body':     'compose.emoji.people_body'|trans,
                                 'animals-nature':  'compose.emoji.animals_nature'|trans,
                                 'food-drink':      'compose.emoji.food_drink'|trans,
                                 'travel-places':   'compose.emoji.travel_places'|trans,
                                 'activities':      'compose.emoji.activities'|trans,
                                 'objects':         'compose.emoji.objects'|trans,
                                 'symbols':         'compose.emoji.symbols'|trans,
                                 'flags':           'compose.emoji.flags'|trans,
                             },
                         }|json_encode|e('html_attr') }}">
                        <button type="button" data-compose--compose-toolbar-action
                                data-action="click->ui--dropdown#toggle"
                                title="{{ 'compose.insert_emoji'|trans }}"
                                aria-label="{{ 'compose.insert_emoji'|trans }}"
                                class="{{ ic }}"><i class="fa-regular fa-face-smile" aria-hidden="true"></i></button>
                        <div data-ui--dropdown-target="menu" hidden
                             data-compose--emoji-picker-target="panel"
                             class="emoji-panel fixed left-2 right-2 bottom-20
                                    md:absolute md:inset-auto md:bottom-full md:left-0 md:right-auto
                                    md:mb-1 z-30 popover overflow-hidden"></div>
                    </div>

                    {# ── Inline image ──────────────────────────────────
                       Its own picker rather than the paperclip's: an image in
                       the body and a file beside it are different things to
                       the recipient, and only the first is restricted to
                       image/*. Paste and drag-drop reach the same endpoint —
                       see _handleBodyPaste in the controller. #}
                    <button type="button" data-compose--compose-toolbar-action
                            data-action="click->compose--compose#openImagePicker"
                            title="{{ 'compose.image'|trans }}"
                            aria-label="{{ 'compose.image'|trans }}"
                            class="{{ ic }}"><i class="fa-regular fa-image" aria-hidden="true"></i></button>
                    <input type="file" accept="image/*" multiple class="hidden"
                           data-compose--compose-target="imageInput"
                           data-action="change->compose--compose#uploadInlineImage">

                    {# ── Encrypt ───────────────────────────────────────
                       DISABLED, and honestly so. There is no encryption in
                       plMail yet — no ext-openssl requirement, no certificate
                       storage, no key custody — and the seam it will hook into
                       (MessageSendService::buildEmail) is one line in a service
                       nothing here touches. A button that looked live and did
                       nothing would tell the user their mail was encrypted when
                       it was not, which is the one lie a mail client must never
                       tell. So it stays visible and named, greyed, and says why
                       when you hover it.

                       `title` on the wrapper rather than the button: a disabled
                       button does not fire the events a tooltip needs in most
                       browsers, so the title has to live on something that is
                       not disabled. aria-describedby points the screen reader
                       at the same sentence. #}
                    <span class="inline-flex shrink-0"
                          title="{{ 'compose.encrypt_unavailable'|trans }}">
                        <button type="button" disabled
                                aria-describedby="{{ form.vars.id }}_encrypt_why"
                                title="{{ 'compose.encrypt'|trans }}"
                                aria-label="{{ 'compose.encrypt'|trans }}"
                                class="{{ ic }} opacity-40 cursor-not-allowed hover:bg-transparent hover:text-ink-muted">
                            <i class="fa-solid fa-lock" aria-hidden="true"></i>
                        </button>
                        <span id="{{ form.vars.id }}_encrypt_why" class="sr-only">
                            {{ 'compose.encrypt_unavailable'|trans }}
                        </span>
                    </span>

                    {# ── Signature ─────────────────────────────────────
                       Inserts the signature of whoever is currently in From. If
                       the body already holds a [data-pl-signature] block it is
                       replaced in place rather than a second one appended —
                       which is the same operation the From switch performs, and
                       deliberately the same code. #}
                    <button type="button" data-compose--compose-toolbar-action
                            data-action="click->compose--compose#insertSignature"
                            title="{{ 'compose.signature'|trans }}"
                            aria-label="{{ 'compose.signature'|trans }}"
                            class="{{ ic }}"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i></button>

                    {# ── More options ──────────────────────────────────
                       Same dropdown shape as the integration picker below and
                       the schedule menu above: a relative wrapper, a `menu`
                       target that starts hidden, `bottom-full` so it opens
                       upwards out of a window already at the bottom of the
                       screen, and `left-0` below md because this button sits in
                       a strip that scrolls sideways.

                       The two form fields inside it are REAL widgets, not
                       decoration. ComposeType maps both onto the Message and
                       the window renders with `render_rest: false`, so until
                       they are drawn here every autosave binds priority to null
                       and readReceiptRequested to false — that is, the menu
                       being rendered is what makes the fields exist at all.
                       They ride the existing draft/send POSTs; no new route. #}
                    <div class="relative" data-controller="ui--dropdown">
                        <button type="button"
                                data-action="click->ui--dropdown#toggle"
                                title="{{ 'compose.more_options'|trans }}"
                                aria-label="{{ 'compose.more_options'|trans }}"
                                class="{{ ic }}"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></button>

                        <div data-ui--dropdown-target="menu" hidden
                             class="absolute bottom-full mb-1 left-0 md:right-auto z-20
                                    w-64 max-w-[calc(100vw-2rem)] popover py-1">

                            {# Plain text. A toggle, not a submit: what it
                                changes is which surface the body lives in, and
                                the autosave that follows carries the result. #}
                            <button type="button"
                                    data-compose--compose-target="plainToggle"
                                    data-action="click->compose--compose#togglePlainText click->ui--dropdown#close"
                                    aria-pressed="{{ plainText ? 'true' : 'false' }}"
                                    class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-ink-muted
                                           hover:bg-hover hover:text-ink transition-colors text-left">
                                <i class="fa-solid fa-check w-4 text-center {{ plainText ? '' : 'invisible' }}"
                                   data-compose--compose-target="plainCheck" aria-hidden="true"></i>
                                <span>{{ 'compose.plain_text'|trans }}</span>
                            </button>

                            <div class="my-1 border-t border-line"></div>

                            <div class="px-3 py-2">
                                <label for="{{ form.priority.vars.id }}"
                                       class="block text-[10px] font-semibold uppercase tracking-wide text-ink-faint mb-1">
                                    {{ 'compose.priority.label'|trans }}
                                </label>
                                <select id="{{ form.priority.vars.id }}"
                                        name="{{ form.priority.vars.full_name }}"
                                        class="w-full h-9 rounded-lg border border-line bg-surface text-sm px-2 text-ink">
                                    {# The empty option is "no opinion", which
                                       emits no headers at all — see
                                       MessagePriority's docblock on why that is
                                       not the same as Normal. #}
                                    <option value="" {{ form.priority.vars.value ? '' : 'selected' }}>
                                        {{ 'compose.priority.none'|trans }}
                                    </option>
                                    {% for level in ['high', 'normal', 'low'] %}
                                        <option value="{{ level }}" {{ form.priority.vars.value == level ? 'selected' : '' }}>
                                            {{ ('compose.priority.' ~ level)|trans }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <label class="flex items-center gap-2.5 px-3 py-2 text-sm text-ink-muted
                                          hover:bg-hover hover:text-ink transition-colors cursor-pointer">
                                <input type="checkbox"
                                       id="{{ form.readReceiptRequested.vars.id }}"
                                       name="{{ form.readReceiptRequested.vars.full_name }}"
                                       value="1"
                                       {{ form.readReceiptRequested.vars.checked ? 'checked' : '' }}
                                       class="rounded border-line">
                                <span>{{ 'compose.read_receipt'|trans }}</span>
                            </label>
                        </div>
                    </div>
                    </div>

                    {# Attach from a connected service. Sized to what the user
                       actually has: nothing at all with no connections, the
                       provider's own button with one, a menu only once there
                       is a choice to make. #}
                    {% if pickerIntegrations|length == 1 %}
                        {% set only = pickerIntegrations|first %}
                        <button type="button"
                                data-controller="ui--modal"
                                data-ui--modal-title-value="{{ only.name }}"
                                data-ui--modal-size-value="{{ only.provider.isMediaLibrary ? 'full' : 'wide' }}"
                                data-integration-id="{{ only.id }}"
                                data-action="click->compose--compose#openIntegrationPicker"
                                title="{{ 'integration.picker.attach_from'|trans({ '%name%': only.name }) }}"
                                class="{{ ic }}"><i class="{{ only.provider.icon }}"></i></button>
                    {% elseif pickerIntegrations|length > 1 %}
                        <div class="relative" data-controller="ui--dropdown">
                            <button type="button"
                                    data-action="click->ui--dropdown#toggle"
                                    title="{{ 'integration.picker.attach_from_service'|trans }}"
                                    class="{{ ic }}"><i class="fa-solid fa-cloud-arrow-down"></i></button>
                            <div data-ui--dropdown-target="menu" hidden
                                 class="absolute bottom-full mb-1 right-0 md:left-0 md:right-auto z-20 min-w-48 popover py-1">
                                {% for integration in pickerIntegrations %}
                                    <button type="button"
                                            data-controller="ui--modal"
                                            data-ui--modal-title-value="{{ integration.name }}"
                                            data-ui--modal-size-value="{{ integration.provider.isMediaLibrary ? 'full' : 'wide' }}"
                                            data-integration-id="{{ integration.id }}"
                                            data-action="click->compose--compose#openIntegrationPicker click->ui--dropdown#close"
                                            class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-ink-muted hover:bg-hover hover:text-ink transition-colors text-left">
                                        <i class="{{ integration.provider.icon }} w-4 text-center" aria-hidden="true"></i>
                                        <span class="truncate">{{ integration.name }}</span>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <button type="button"
                            data-action="compose--compose#discard"
                            title="{{ 'compose.discard'|trans }}"
                            aria-label="{{ 'compose.discard'|trans }}"
                            class="{{ ic }} hover:text-danger">
                        <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

        </div>{# end collapsible #}

        <input type="hidden" name="{{ form.vars.full_name }}[_token]" value="{{ csrf_token('compose') }}">
        {{ form_end(form, { render_rest: false }) }}

    </div>
</turbo-frame>
