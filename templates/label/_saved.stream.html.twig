{#
Close the modal and refresh the sidebar label list after create/update.

Two targets: the desktop sidebar renders the list as #label-list, the mobile
drawer renders the same list as #label-list-drawer (_partials/_sidebar.html.twig).
Both are in the DOM at once, so both need replacing — the drawer copy keeps its
close-on-click action. Turbo ignores a stream whose target is absent.
#}
{% import '_partials/_sidebar.html.twig' as sidebar %}
{% set labelTree = sidebarCounts.userLabelTree() %}

{% for target, drawerClose in { 'label-list': '', 'label-list-drawer': 'click->sidebar-drawer#close' } %}
    <turbo-stream action="replace" target="{{ target }}">
        <template>
            <div id="{{ target }}" class="rail-hide space-y-0.5">
                {% if labelTree|length == 0 %}
                    <p class="px-3 py-1.5 text-xs text-ink-faint">{{ 'sidebar.labels.none'|trans }}</p>
                {% else %}
                    {% for node in labelTree %}
                        {{ sidebar.label_node(node, 0, drawerClose) }}
                    {% endfor %}
                {% endif %}
            </div>
        </template>
    </turbo-stream>
{% endfor %}
