{#
label/_lists.stream.html.twig
─────────────────────────────────────────────────────────────────────────────
The response to every label mutation: create, rename, delete, show/hide.

Three regions render the label list — the desktop sidebar (#label-list), the
mobile drawer (#label-list-drawer) and the settings page
(#settings-label-list). All three are refreshed unconditionally: a stream
whose target is absent is a no-op, so one response serves the sidebar modal
and the settings page without either needing to know where it was invoked
from. This replaced three near-identical stream templates.

Variables:
  labels         Label[]  tree-ordered, for the settings list
  toastMessage   string|null  translation key
  refreshSidebar bool  also re-render both sidebar copies whole — see
                 LabelController::toggleVisibility()
#}
{% if toastMessage is not empty %}
    {% include '_partials/_toast.stream.html.twig' with { message: toastMessage|trans, type: 'success' } only %}
{% endif %}

<turbo-stream action="replace" target="settings-label-list">
    <template>
        <div id="settings-label-list">
            {% include 'settings/_labels.html.twig' with { labels: labels } %}
        </div>
    </template>
</turbo-stream>

{% import '_partials/_sidebar.html.twig' as sidebar %}
{# Filtered the way the sidebar filters its own render (in_labels). Without it
   the first label change after a page load put back every folder-only label
   that the sidebar had left under its account — and, listed by account (#690),
   every label at all. #}
{% set labelTree = sidebarCounts.userLabelTree()|filter(node => in_labels(node)) %}

{% for target, drawerClose in { 'label-list': '', 'label-list-drawer': 'click->ui--sidebar-drawer#close' } %}
    <turbo-stream action="replace" target="{{ target }}">
        <template>
            <div id="{{ target }}" class="rail-hide space-y-0.5">
                {% if labelTree|length == 0 %}
                    <p class="px-3 py-1.5 text-xs text-ink-faint">{{ (app.user.labelsByAccount ? 'sidebar.labels.none_by_account' : 'sidebar.labels.none')|trans }}</p>
                {% else %}
                    {% for label in labelTree %}
                        {{ sidebar.label_node(label, 0, drawerClose) }}
                    {% endfor %}
                {% endif %}
            </div>
        </template>
    </turbo-stream>
{% endfor %}

{% if refreshSidebar|default(false) %}
    <turbo-stream action="replace" target="sidebar">
        <template>
            {% include '_partials/_sidebar.html.twig' only %}
        </template>
    </turbo-stream>
    <turbo-stream action="replace" target="sidebar-drawer-inner">
        <template>
            {% include '_partials/_sidebar.html.twig' with { _drawerMode: true } only %}
        </template>
    </turbo-stream>
{% endif %}
